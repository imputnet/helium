+  storage_partition_key_to_restore_ = std::move(storage_partition_key);
+}
+
+std::optional<std::pair<std::string, std::string>>
+NavigationEntryImpl::GetStoragePartitionKeyToRestore() const {
+  // A restored entry only has the saved key until it gets a SiteInstance.
+  if (SiteInstanceImpl* site_instance =
+          frame_tree_->frame_entry->site_instance()) {
+    const StoragePartitionConfig& config =
+        site_instance->GetSecurityPrincipal().GetStoragePartitionConfig();
+    return std::make_pair(config.partition_domain(), config.partition_name());
+  }
+  return storage_partition_key_to_restore_;
+}
