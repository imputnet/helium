+PageState PageState::PrefixTopURL(const std::string& prefix) const {
+  ExplodedPageState state;
+  if (data_.empty() || !DecodePageState(data_, &state) ||
+      !state.top.url_string) {
+    return *this;
+  }
+
+  state.top.url_string = base::UTF8ToUTF16(prefix) + *state.top.url_string;
+  return ToPageState(state);
+}
+
+PageState PageState::RemoveTopURLPrefix(size_t prefix_length) const {
+  ExplodedPageState state;
+  if (data_.empty() || !DecodePageState(data_, &state) ||
+      !state.top.url_string || prefix_length > state.top.url_string->size()) {
+    return *this;
+  }
+
+  state.top.url_string = state.top.url_string->substr(prefix_length);
+  return ToPageState(state);
+}
+
 PageState PageState::RemoveReferrer() const {
   if (data_.empty())
     return *this;
