+void AutopushDriver::GetToken(const std::string& app_id,
+                              const std::string& authorized_entity,
+                              const std::string& scope,
+                              base::TimeDelta time_to_live,
+                              GetTokenCallback callback) {
+  if (!IsPushApp(app_id) || !helium::ShouldAccessPushService(*prefs())) {
+    std::move(callback).Run(std::string(), GCMClient::GCM_DISABLED);
+    return;
+  }
+
+  if (const std::string* channel_id =
+          FindChannelID(app_id, authorized_entity)) {
+    const std::string* endpoint =
+        channels().FindDict(*channel_id)->FindString(kEndpointKey);
+    std::move(callback).Run(*endpoint, GCMClient::SUCCESS);
+    return;
+  }
+
+  for (const auto& [channel_id, pending] : pending_registrations_) {
+    if (pending.app_id == app_id &&
+        pending.authorized_entity == authorized_entity) {
+      std::move(callback).Run(std::string(),
+                              GCMClient::ASYNC_OPERATION_PENDING);
+      return;
+    }
+  }
+
+  const std::string channel_id =
+      base::Uuid::GenerateRandomV4().AsLowercaseString();
+  PendingRegistration& registration = pending_registrations_[channel_id];
+  registration.app_id = app_id;
+  registration.authorized_entity = authorized_entity;
+  registration.callback = std::move(callback);
+
+  if (hello_done_) {
+    SendRegister(channel_id);
+  } else {
+    // Don't make the site wait for a reconnect backoff.
+    reconnect_timer_.Stop();
+    MaybeConnect();
+  }
+}
