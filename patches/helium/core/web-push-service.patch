+void AutopushDriver::OnConnectionChanged(
+    net::NetworkChangeNotifier::ConnectionType type) {
+  if (type == net::NetworkChangeNotifier::CONNECTION_NONE) {
+    return;
+  }
+
+  backoff_.Reset();
+  if (hello_done_) {
+    // The socket may not have survived the network change.
+    OnPingTimer();
+  } else if (reconnect_timer_.IsRunning()) {
+    reconnect_timer_.Stop();
+    MaybeConnect();
+  }
+}
+
+PrefService* AutopushDriver::prefs() const {
+  return profile_->GetPrefs();
+}
+
+const base::DictValue& AutopushDriver::channels() const {
+  static const base::NoDestructor<base::DictValue> kEmpty;
+  const base::DictValue* channels =
+      prefs()->GetDict(kStatePref).FindDict(kChannelsKey);
+  return channels ? *channels : *kEmpty;
+}
+
+const std::string* AutopushDriver::FindChannelID(
+    const std::string& app_id,
+    const std::string& authorized_entity) const {
+  for (const auto [channel_id, channel] : channels()) {
+    const base::DictValue& dict = channel.GetDict();
+    if (*dict.FindString(kAppIdKey) == app_id &&
+        *dict.FindString(kEntityKey) == authorized_entity) {
+      return &channel_id;
+    }
+  }
+  return nullptr;
+}
+
+bool AutopushDriver::ShouldConnect() const {
+  return helium::ShouldAccessPushService(*prefs()) &&
+         app_handlers().contains(push_messaging::kAppIdentifierPrefix) &&
+         (!channels().empty() || !pending_registrations_.empty());
+}
+
+void AutopushDriver::MaybeConnect() {
+  if (client_ || reconnect_timer_.IsRunning()) {
+    return;
+  }
+
+  if (helium::ShouldAccessPushService(*prefs())) {
+    // Registrations from a different server are useless, so drop them. Sites
+    // will see their subscription disappear and can subscribe again.
+    const std::string server = helium::GetPushServiceURL(*prefs()).spec();
+    const std::string* stored_server =
+        prefs()->GetDict(kStatePref).FindString(kServerKey);
+    if (!stored_server || *stored_server != server) {
+      ScopedDictPrefUpdate update(prefs(), kStatePref);
+      update->Set(kServerKey, server);
+      update->Remove(kUaidKey);
+      update->Remove(kChannelsKey);
+    }
+  }
+
+  if (ShouldConnect()) {
+    Connect();
+  } else {
+    Disconnect();
+  }
+}
+
+void AutopushDriver::Connect() {
+  server_url_ = helium::GetPushServiceURL(*prefs());
+  client_ = std::make_unique<streaming_client::StreamingWebSocketClient>(
+      server_url_,
+      base::BindRepeating(
+          &content::StoragePartition::GetNetworkContext,
+          base::Unretained(profile_->GetDefaultStoragePartition())),
+      kTrafficAnnotation, this, network::mojom::WebSocketMessageType::TEXT);
+
+  base::ListValue channel_ids;
+  for (const auto [channel_id, channel] : channels()) {
+    channel_ids.Append(channel_id);
+  }
+
+  base::DictValue hello = base::DictValue()
+                              .Set("messageType", "hello")
+                              .Set("use_webpush", true)
+                              .Set("channelIDs", std::move(channel_ids));
+  if (const std::string* uaid =
+          prefs()->GetDict(kStatePref).FindString(kUaidKey)) {
+    hello.Set("uaid", *uaid);
+  }
+
+  // Sending connects the client, and the hello is sent once it's open.
+  Send(std::move(hello));
+  timeout_timer_.Start(FROM_HERE, kRequestTimeout, this,
+                       &AutopushDriver::OnConnectionLost);
+}
+
+void AutopushDriver::Disconnect() {
+  reconnect_timer_.Stop();
+  timeout_timer_.Stop();
+  ping_timer_.Stop();
+  hello_done_ = false;
+
+  if (client_) {
+    client_->Close();
+    // This may be called from within a client callback.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(client_));
+  }
+
+  auto pending = std::move(pending_registrations_);
+  pending_registrations_.clear();
+  for (auto& [channel_id, registration] : pending) {
+    std::move(registration.callback)
+        .Run(std::string(), GCMClient::NETWORK_ERROR);
+  }
+}
+
+void AutopushDriver::OnConnectionLost() {
+  Disconnect();
+  if (!ShouldConnect()) {
+    return;
+  }
+
+  backoff_.InformOfRequest(false);
+  reconnect_timer_.Start(
+      FROM_HERE, backoff_.GetTimeUntilRelease(),
+      base::BindOnce(&AutopushDriver::MaybeConnect, base::Unretained(this)));
+}
+
+void AutopushDriver::OnPrefsChanged() {
+  if (helium::ShouldAccessPushService(*prefs()) && client_ &&
+      helium::GetPushServiceURL(*prefs()) == server_url_) {
+    return;
+  }
+
+  Disconnect();
+  backoff_.Reset();
+  MaybeConnect();
+}
+
+void AutopushDriver::OnPingTimer() {
+  if (Send(base::DictValue())) {
+    timeout_timer_.Start(FROM_HERE, kRequestTimeout, this,
+                         &AutopushDriver::OnConnectionLost);
+  }
+}
+
+bool AutopushDriver::Send(base::DictValue message) {
+  std::optional<std::string> json = base::WriteJson(message);
+  // A failed write reports the error synchronously, which disconnects.
+  client_->Send(std::vector<uint8_t>(json->begin(), json->end()));
+  return client_ != nullptr;
+}
+
+bool AutopushDriver::SendRegister(const std::string& channel_id) {
+  // The authorized entity is the base64url-encoded application server key.
+  const std::string& key =
+      pending_registrations_.at(channel_id).authorized_entity;
+  if (!Send(base::DictValue()
+                .Set("messageType", "register")
+                .Set("channelID", channel_id)
+                .Set("key", key))) {
+    return false;
+  }
+
+  // The connection can stay alive while the server never answers this.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&AutopushDriver::OnRegisterTimeout,
+                     weak_ptr_factory_.GetWeakPtr(), channel_id),
+      kRequestTimeout);
+  return true;
+}
+
+void AutopushDriver::OnRegisterTimeout(const std::string& channel_id) {
+  auto registration = pending_registrations_.extract(channel_id);
+  if (registration.empty()) {
+    return;
+  }
+
+  std::move(registration.mapped().callback)
+      .Run(std::string(), GCMClient::SERVER_ERROR);
+  if (!ShouldConnect()) {
+    Disconnect();
+  }
+}
+
+void AutopushDriver::HandleHello(const base::DictValue& message) {
+  const std::string* uaid = message.FindString("uaid");
+  if (hello_done_ || message.FindInt("status") != 200 || !uaid ||
+      uaid->empty()) {
+    OnConnectionLost();
+    return;
+  }
+
+  const std::string* old_uaid =
+      prefs()->GetDict(kStatePref).FindString(kUaidKey);
+  if (old_uaid && *old_uaid != *uaid) {
+    // The server doesn't know us anymore, so our channels are gone too.
+    ScopedDictPrefUpdate(prefs(), kStatePref)->Remove(kChannelsKey);
+  }
+  ScopedDictPrefUpdate(prefs(), kStatePref)->Set(kUaidKey, *uaid);
+
+  hello_done_ = true;
+  timeout_timer_.Stop();
+  backoff_.InformOfRequest(true);
+
+  if (!ShouldConnect()) {
+    Disconnect();
+    return;
+  }
+
+  ping_timer_.Reset();
+
+  // Sending can disconnect, which clears pending_registrations_.
+  std::vector<std::string> channel_ids;
+  for (const auto& [channel_id, registration] : pending_registrations_) {
+    channel_ids.push_back(channel_id);
+  }
+  for (const std::string& channel_id : channel_ids) {
+    if (!SendRegister(channel_id)) {
+      return;
+    }
+  }
+}
+
+void AutopushDriver::HandleRegister(const base::DictValue& message) {
+  const std::string* channel_id = message.FindString("channelID");
+  if (!channel_id) {
+    return;
+  }
+
+  auto it = pending_registrations_.find(base::ToLowerASCII(*channel_id));
+  if (it == pending_registrations_.end()) {
+    return;
+  }
+
+  const std::string pending_id = it->first;
+  PendingRegistration registration = std::move(it->second);
+  pending_registrations_.erase(it);
+
+  const std::string* endpoint = message.FindString("pushEndpoint");
+  if (message.FindInt("status") != 200 || !endpoint ||
+      !GURL(*endpoint).is_valid()) {
+    std::move(registration.callback)
+        .Run(std::string(), GCMClient::SERVER_ERROR);
+    if (!ShouldConnect()) {
+      Disconnect();
+    }
+    return;
+  }
+
+  ScopedDictPrefUpdate(prefs(), kStatePref)
+      ->EnsureDict(kChannelsKey)
+      ->Set(pending_id, base::DictValue()
+                            .Set(kAppIdKey, registration.app_id)
+                            .Set(kEntityKey, registration.authorized_entity)
+                            .Set(kEndpointKey, *endpoint));
+
+  std::move(registration.callback).Run(*endpoint, GCMClient::SUCCESS);
+}
+
+void AutopushDriver::HandleNotification(const base::DictValue& message) {
+  const std::string* channel_id = message.FindString("channelID");
+  const std::string* version = message.FindString("version");
+  if (!channel_id || !version) {
+    return;
+  }
+
+  const std::string normalized_id = base::ToLowerASCII(*channel_id);
+  if (const base::DictValue* channel = channels().FindDict(normalized_id)) {
+    IncomingMessage incoming;
+    incoming.sender_id = *channel->FindString(kEntityKey);
+    incoming.message_id = *version;
+
+    const std::string* data = message.FindString("data");
+    if (data && !base::Base64UrlDecode(
+                    *data, base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                    &incoming.raw_data)) {
+      return;
+    }
+
+    if (const base::DictValue* headers = message.FindDict("headers")) {
+      for (const auto& [from, to] : kNotificationHeaders) {
+        if (const std::string* value = headers->FindString(from)) {
+          incoming.data[to] = *value;
+        }
+      }
+    }
+
+    DispatchMessage(*channel->FindString(kAppIdKey), incoming);
+  }
+
+  Send(base::DictValue()
+           .Set("messageType", "ack")
+           .Set("updates",
+                base::ListValue().Append(base::DictValue()
+                                             .Set("channelID", *channel_id)
+                                             .Set("version", *version)
+                                             .Set("code", 100))));
+}
+
