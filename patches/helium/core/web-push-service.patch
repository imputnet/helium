+void AutopushDriver::AddInstanceIDData(const std::string& app_id,
+                                       const std::string& instance_id,
+                                       const std::string& extra_data) {
+  if (!IsPushApp(app_id)) {
+    return;
+  }
+
+  ScopedDictPrefUpdate update(prefs(), kStatePref);
+  update->EnsureDict(kInstanceIDsKey)
+      ->Set(app_id, base::DictValue()
+                        .Set(kIdKey, instance_id)
+                        .Set(kExtraKey, extra_data));
+}
+
+void AutopushDriver::RemoveInstanceIDData(const std::string& app_id) {
+  if (!IsPushApp(app_id)) {
+    return;
+  }
+
+  ScopedDictPrefUpdate update(prefs(), kStatePref);
+  update->EnsureDict(kInstanceIDsKey)->Remove(app_id);
+}
+
+void AutopushDriver::GetInstanceIDData(const std::string& app_id,
+                                       GetInstanceIDDataCallback callback) {
+  std::string instance_id;
+  std::string extra_data;
+  const base::DictValue* instance_ids =
+      prefs()->GetDict(kStatePref).FindDict(kInstanceIDsKey);
+  const base::DictValue* data =
+      instance_ids ? instance_ids->FindDict(app_id) : nullptr;
+  if (IsPushApp(app_id) && data) {
+    if (const std::string* id = data->FindString(kIdKey)) {
+      instance_id = *id;
+    }
+    if (const std::string* extra = data->FindString(kExtraKey)) {
+      extra_data = *extra;
+    }
+  }
+
+  // Posted, like other drivers do. It still runs before any InstanceID
+  // operation queued after the InstanceID was created.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(callback), std::move(instance_id),
+                                std::move(extra_data)));
+}
+
+void AutopushDriver::OnMessage(std::vector<uint8_t> message) {
+  std::optional<base::DictValue> dict = base::JSONReader::ReadDict(
+      base::as_string_view(message), base::JSON_PARSE_RFC);
+  if (!dict) {
+    OnConnectionLost();
+    return;
+  }
+
+  if (hello_done_) {
+    timeout_timer_.Stop();
+    ping_timer_.Reset();
+  }
+
+  const std::string* type = dict->FindString("messageType");
+  if (!type) {
+    // Ping reply.
+    return;
+  }
+
+  if (*type == "hello") {
+    HandleHello(*dict);
+  } else if (!hello_done_) {
+    OnConnectionLost();
+  } else if (*type == "register") {
+    HandleRegister(*dict);
+  } else if (*type == "notification") {
+    HandleNotification(*dict);
+  }
+}
