+// GCMDriver that delivers Web Push messages through an autopush-compatible
+// server, such as minipush. Other GCM users see GCM as disabled.
+class AutopushDriver
+    : public GCMDriver,
+      protected InstanceIDHandler,
+      public streaming_client::StreamingWebSocketClient::Delegate,
+      public network::NetworkConnectionTracker::NetworkConnectionObserver {
+ public:
+  AutopushDriver(
+      Profile* profile,
+      const scoped_refptr<base::SequencedTaskRunner>& blocking_task_runner);
+  AutopushDriver(const AutopushDriver&) = delete;
+  AutopushDriver& operator=(const AutopushDriver&) = delete;
+  ~AutopushDriver() override;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // GCMDriver:
+  void Shutdown() override;
+  void AddAppHandler(const std::string& app_id,
+                     GCMAppHandler* handler) override;
+  void RemoveAppHandler(const std::string& app_id) override;
+  void ValidateRegistration(const std::string& app_id,
+                            const std::vector<std::string>& sender_ids,
+                            const std::string& registration_id,
+                            ValidateRegistrationCallback callback) override;
+  void AddConnectionObserver(GCMConnectionObserver* observer) override;
+  void RemoveConnectionObserver(GCMConnectionObserver* observer) override;
+  GCMClient* GetGCMClientForTesting() const override;
+  bool IsStarted() const override;
+  bool IsConnected() const override;
+  void GetGCMStatistics(GetGCMStatisticsCallback callback,
+                        ClearActivityLogs clear_logs) override;
+  void SetGCMRecording(const GCMStatisticsRecordingCallback& callback,
+                       bool recording) override;
+  void SetAccountTokens(
+      const std::vector<GCMClient::AccountTokenInfo>& account_tokens) override;
+  void UpdateAccountMapping(const AccountMapping& account_mapping) override;
+  void RemoveAccountMapping(const CoreAccountId& account_id) override;
+  base::Time GetLastTokenFetchTime() override;
+  void SetLastTokenFetchTime(const base::Time& time) override;
+  InstanceIDHandler* GetInstanceIDHandlerInternal() override;
+  void AddHeartbeatInterval(const std::string& scope, int interval_ms) override;
+  void RemoveHeartbeatInterval(const std::string& scope) override;
+
+ protected:
+  // GCMDriver:
+  GCMClient::Result EnsureStarted(GCMClient::StartMode start_mode) override;
+  void RegisterImpl(const std::string& app_id,
+                    const std::vector<std::string>& sender_ids) override;
+  void UnregisterImpl(const std::string& app_id) override;
+  void SendImpl(const std::string& app_id,
+                const std::string& receiver_id,
+                const OutgoingMessage& message) override;
+  void RecordDecryptionFailure(const std::string& app_id,
+                               GCMDecryptionResult result) override;
+
+  // InstanceIDHandler:
+  void GetToken(const std::string& app_id,
+                const std::string& authorized_entity,
+                const std::string& scope,
+                base::TimeDelta time_to_live,
+                GetTokenCallback callback) override;
+  void ValidateToken(const std::string& app_id,
+                     const std::string& authorized_entity,
+                     const std::string& scope,
+                     const std::string& token,
+                     ValidateTokenCallback callback) override;
+  void DeleteToken(const std::string& app_id,
+                   const std::string& authorized_entity,
+                   const std::string& scope,
+                   DeleteTokenCallback callback) override;
+  void AddInstanceIDData(const std::string& app_id,
+                         const std::string& instance_id,
+                         const std::string& extra_data) override;
+  void RemoveInstanceIDData(const std::string& app_id) override;
+  void GetInstanceIDData(const std::string& app_id,
+                         GetInstanceIDDataCallback callback) override;
+
+ private:
+  struct PendingRegistration {
+    PendingRegistration();
+    PendingRegistration(PendingRegistration&&);
+    PendingRegistration& operator=(PendingRegistration&&);
+    ~PendingRegistration();
+
+    std::string app_id;
+    std::string authorized_entity;
+    GetTokenCallback callback;
+  };
+
+  // streaming_client::StreamingWebSocketClient::Delegate:
+  void OnMessage(std::vector<uint8_t> message) override;
+  void OnConnectionError(const std::string& message,
+                         int net_error,
+                         int response_code) override;
+  void OnDropChannel(bool was_clean,
+                     uint16_t code,
+                     const std::string& reason,
+                     std::optional<base::TimeDelta> elapsed) override;
+  void OnError(const std::string& message) override;
+  void OnClose() override;
+
+  // network::NetworkConnectionTracker::NetworkConnectionObserver:
+  void OnConnectionChanged(
+      net::NetworkChangeNotifier::ConnectionType type) override;
+
+  PrefService* prefs() const;
+  const base::DictValue& channels() const;
+  const std::string* FindChannelID(const std::string& app_id,
+                                   const std::string& authorized_entity) const;
+
+  bool ShouldConnect() const;
+  void MaybeConnect();
+  void Connect();
+  void Disconnect();
+  void OnConnectionLost();
+  void OnPrefsChanged();
+  void OnPingTimer();
+
+  // These return false if sending failed and dropped the connection.
+  bool Send(base::DictValue message);
+  bool SendRegister(const std::string& channel_id);
+  void OnRegisterTimeout(const std::string& channel_id);
+  void HandleHello(const base::DictValue& message);
+  void HandleRegister(const base::DictValue& message);
+  void HandleNotification(const base::DictValue& message);
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar registrar_;
+
+  std::unique_ptr<streaming_client::StreamingWebSocketClient> client_;
+  GURL server_url_;
+  bool hello_done_ = false;
+  std::map<std::string, PendingRegistration> pending_registrations_;
+
+  net::BackoffEntry backoff_;
+  base::OneShotTimer reconnect_timer_;
+  base::OneShotTimer timeout_timer_;
+  base::RetainingOneShotTimer ping_timer_;
+
+  base::WeakPtrFactory<AutopushDriver> weak_ptr_factory_{this};
+};
