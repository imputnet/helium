+void AutopushDriver::ValidateToken(const std::string& app_id,
+                                   const std::string& authorized_entity,
+                                   const std::string& scope,
+                                   const std::string& token,
+                                   ValidateTokenCallback callback) {
+  const std::string* channel_id = FindChannelID(app_id, authorized_entity);
+  std::move(callback).Run(
+      channel_id &&
+      *channels().FindDict(*channel_id)->FindString(kEndpointKey) == token);
+}
+
+void AutopushDriver::DeleteToken(const std::string& app_id,
+                                 const std::string& authorized_entity,
+                                 const std::string& scope,
+                                 DeleteTokenCallback callback) {
+  std::vector<std::string> removed;
+  for (const auto [channel_id, channel] : channels()) {
+    const base::DictValue& dict = channel.GetDict();
+    if (*dict.FindString(kAppIdKey) == app_id &&
+        Matches(authorized_entity, dict.FindString(kEntityKey))) {
+      removed.push_back(channel_id);
+    }
+  }
+
+  if (!removed.empty()) {
+    ScopedDictPrefUpdate update(prefs(), kStatePref);
+    base::DictValue* stored = update->EnsureDict(kChannelsKey);
+    for (const std::string& channel_id : removed) {
+      stored->Remove(channel_id);
+      // The server doesn't need to hear about this if we're offline, since
+      // the channel won't be included in the next hello.
+      if (hello_done_) {
+        Send(base::DictValue()
+                 .Set("messageType", "unregister")
+                 .Set("channelID", channel_id));
+      }
+    }
+  }
+
+  if (!ShouldConnect()) {
+    Disconnect();
+  }
+
+  std::move(callback).Run(GCMClient::SUCCESS);
+}
