 namespace find_in_page {
 
+namespace {
+
+// Quoted searches like "this" only match that exact word, so they skip "This"
+// and "thistle". The closing quote can be left off while typing.
+std::optional<std::u16string_view> GetExactSearch(std::u16string_view text) {
+  if (!text.starts_with(u'"')) {
+    return std::nullopt;
+  }
+
+  text.remove_prefix(1);
+  if (text.ends_with(u'"')) {
+    text.remove_suffix(1);
+  }
+
+  if (text.empty()) {
+    return std::nullopt;
+  }
+
+  return text;
+}
+
+}  // namespace
+
 // static
 int FindTabHelper::find_request_id_counter_ = -1;
 
