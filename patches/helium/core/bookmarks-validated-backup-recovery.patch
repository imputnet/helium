+bool PromoteValidatedBookmarksBackup(const base::FilePath& primary_path,
+                                     const base::FilePath& backup_path) {
+  base::FilePath preserved_path;
+  for (int attempt = 0; attempt < 1000; ++attempt) {
+    const std::string extension =
+        attempt == 0
+            ? "corrupt"
+            : base::StrCat({"corrupt-", base::NumberToString(attempt)});
+    const base::FilePath candidate = primary_path.AddExtensionASCII(extension);
+    if (base::PathExists(candidate)) {
+      continue;
+    }
+    if (!base::Move(primary_path, candidate)) {
+      return false;
+    }
+    preserved_path = candidate;
+    break;
+  }
+  if (preserved_path.empty()) {
+    return false;
+  }
+
+  // The backup has already been read, decrypted, parsed, and decoded
+  // successfully. Promote its on-disk bytes into the primary slot so recovery
+  // does not depend on a later model save, which might never happen or might
+  // fail again while the disk is full. Both paths are in the same directory.
+  if (base::Move(backup_path, primary_path)) {
+    return true;
+  }
+
+  if (!base::Move(preserved_path, primary_path)) {
+    LOG(ERROR) << "Failed to restore Bookmarks primary after backup promotion "
+                  "failure: "
+               << primary_path;
+  }
+  return false;
+}
