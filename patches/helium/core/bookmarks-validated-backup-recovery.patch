+TEST(ModelLoaderTest, RecoverLocalBookmarksFromValidBackup) {
+  base::test::TaskEnvironment task_environment;
+  const base::FilePath temp_dir = base::CreateUniqueTempDirectoryScopedToTest();
+  const base::FilePath primary = temp_dir.AppendASCII("Bookmarks");
+  const base::FilePath backup = primary.ReplaceExtension(kBackupExtension);
+  const base::FilePath encrypted = temp_dir.AppendASCII("BookmarksEncrypted");
+  ASSERT_TRUE(base::WriteFile(primary, "not json"));
+  ASSERT_TRUE(base::CopyFile(
+      GetTestDataDir().AppendASCII("bookmarks/model_with_sync_metadata_1.json"),
+      backup));
+
+  scoped_refptr<const os_crypt_async::Encryptor> encryptor =
+      os_crypt_async::GetTestEncryptorForTesting();
+  base::test::TestFuture<std::unique_ptr<BookmarkLoadDetails>> details_future;
+  ModelLoader::Create()->Load(
+      encryptor, primary, encrypted, base::FilePath(), base::FilePath(),
+      LoadManagedNodeCallback(), base::DoNothing(), base::DoNothing(), {},
+      details_future.GetCallback());
+
+  const std::unique_ptr<BookmarkLoadDetails> details = details_future.Take();
+  ASSERT_NE(nullptr, details);
+  EXPECT_EQ(1u, details->bb_node()->children().size());
+  EXPECT_EQ(1u, details->other_folder_node()->children().size());
+  EXPECT_EQ(1u, details->mobile_folder_node()->children().size());
+  EXPECT_EQ("dummy-sync-metadata-1",
+            details->local_or_syncable_sync_metadata_str());
+  EXPECT_TRUE(base::PathExists(primary));
+  EXPECT_TRUE(base::PathExists(primary.AddExtensionASCII("corrupt")));
+  EXPECT_FALSE(base::PathExists(backup));
+
+  // Recovery must repair the primary on disk immediately. A second load with
+  // no intervening bookmark mutation must therefore succeed without a backup.
+  base::test::TestFuture<std::unique_ptr<BookmarkLoadDetails>>
+      second_details_future;
+  ModelLoader::Create()->Load(
+      encryptor, primary, encrypted, base::FilePath(), base::FilePath(),
+      LoadManagedNodeCallback(), base::DoNothing(), base::DoNothing(), {},
+      second_details_future.GetCallback());
+
+  const std::unique_ptr<BookmarkLoadDetails> second_details =
+      second_details_future.Take();
+  ASSERT_NE(nullptr, second_details);
+  EXPECT_EQ(1u, second_details->bb_node()->children().size());
+  EXPECT_EQ(1u, second_details->other_folder_node()->children().size());
+  EXPECT_EQ(1u, second_details->mobile_folder_node()->children().size());
+  EXPECT_EQ("dummy-sync-metadata-1",
+            second_details->local_or_syncable_sync_metadata_str());
+  EXPECT_FALSE(
+      base::PathExists(primary.AddExtensionASCII("corrupt-1")));
+}
