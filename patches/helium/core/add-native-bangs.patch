+// Loads shared catalogue data using one profile's settings and retry policy.
+// TemplateURLService owns the installed entries.
+class BangManager {
+ public:
+  using Result = scoped_refptr<const Catalogue>;
+  using Callback = base::RepeatingCallback<void(const Result&)>;
+
+  BangManager(
+      PrefService& prefs,
