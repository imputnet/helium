+
+void TemplateURLService::BangsLoadedCallback(
+    const Bangs::BangManager::Result& bangs) {
+  if (!bangs || bangs == bang_catalogue_) {
+    return;
+  }
+
+  CHECK(loaded_);
+  bang_catalogue_ = bangs;
+  bang_weak_ptr_factory_.InvalidateWeakPtrs();
+
+  if (bangs->entries.empty()) {
+    OnBangsPrepared({});
+    return;
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&PrepareBangEntries, bangs,
+                     SearchTermsData::MakeSnapshot(search_terms_data_.get())),
+      base::BindOnce(
+          [](base::WeakPtr<TemplateURLService> service,
+             TemplateURL::OwnedTemplateURLVector entries) {
+            if (service) {
+              service->OnBangsPrepared(std::move(entries));
+            } else {
+              base::ThreadPool::PostTask(
+                  FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+                  base::DoNothingWithBoundArgs(std::move(entries)));
+            }
+          },
+          bang_weak_ptr_factory_.GetWeakPtr()));
+}
+
+void TemplateURLService::OnBangsPrepared(
+    TemplateURL::OwnedTemplateURLVector entries) {
+  TemplateURL::OwnedTemplateURLVector removed;
+  {
+    Scoper scoper(this);
+    if (std::ranges::any_of(template_urls_, [](const auto& turl) {
+          return turl->bang_id() != 0;
+        })) {
+      provider_map_ = std::make_unique<SearchHostToURLsMap>();
+      for (auto& turl : template_urls_) {
+        if (!turl->bang_id()) {
+          continue;
+        }
+        CHECK_NE(turl.get(), GetDefaultSearchProvider());
+        RemoveFromMaps(turl.get(), /*update_host_map=*/false);
+        if (client_) {
+          client_->DeleteAllSearchTermsForKeyword(turl->id());
+        }
+        removed.push_back(std::move(turl));
+      }
+      std::erase(template_urls_, nullptr);
+      provider_map_->Init(template_urls_, search_terms_data());
+      model_mutated_notification_pending_ = true;
+    }
+
+    template_urls_.reserve(template_urls_.size() + entries.size());
+    for (auto& turl : entries) {
+      if (GetTemplateURLForKeyword(turl->keyword())) {
+        continue;
+      }
+      turl->set_id(++next_id_);
+      auto* turl_ptr = turl.get();
+      template_urls_.push_back(std::move(turl));
+      AddToMaps(turl_ptr);
+      model_mutated_notification_pending_ = true;
+    }
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::DoNothingWithBoundArgs(std::move(removed), std::move(entries)));
+}
