+  BangManager(const BangManager&) = delete;
+  BangManager& operator=(const BangManager&) = delete;
+
+  // Reports the catalogue or nullptr on failure. Retries failed network loads.
+  void LoadBangs(Callback callback);
+
+ private:
+  void StartFetch();
+  void OnBangsLoaded(const Result& result);
+
+  const raw_ref<PrefService> prefs_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory_;
+  Callback callback_;
+  net::BackoffEntry backoff_;
+  base::OneShotTimer retry_timer_;
+  base::WeakPtrFactory<BangManager> weak_ptr_factory_{this};
+};
