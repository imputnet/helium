+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+(() => {
+  // On browsers at or above this version, the store's Chrome eligibility check
+  // returns its first argument (a server-provided flag, false by default)
+  // instead of checking the user agent. The flag is never set for Helium, so
+  // the store shows its Chrome nags unless the argument is forced to true.
+  const ELIGIBILITY_VERSION = '142.0.7430.0';
+  // Matches the minified check, whose version-gated branch must return its
+  // default-false argument:
+  // `function(a=!1){... if(... yield check("142.0.7430.0") ...)return a; ...}`
+  const ELIGIBILITY_CHECK_REGEX = new RegExp(
+      String.raw`^(?:async )?function\(([\w$]+)=!1\)` +
+      String.raw`[^]*?\bif\([^;{}]*\b(?:yield|await) [\w$.]+\("` +
+      ELIGIBILITY_VERSION.replaceAll('.', '\\.') +
+      String.raw`"\)[^;{}]*\)return \1[;}]`);
+
+  // Maps each property whose function source contains ELIGIBILITY_VERSION to
+  // its override, or to null if its structure couldn't be verified. Overrides
+  // only apply while there's exactly one candidate.
+  const eligibilityCandidates = new Map();
+  const page = window.default_ChromeWebStoreConsumerFeUi ??= {};
+  window.default_ChromeWebStoreConsumerFeUi = new Proxy(page, {
+    get(target, key, receiver) {
+      if (eligibilityCandidates.size === 1) {
+        const override = eligibilityCandidates.get(key);
+        if (override) {
+          const descriptor = Reflect.getOwnPropertyDescriptor(target, key);
+          // Non-configurable, non-writable data properties must return their
+          // actual value, not a wrapper.
+          if (descriptor?.configurable || descriptor?.writable) {
+            return override;
+          }
+        }
+      }
+      return Reflect.get(target, key, receiver);
+    },
+    // Ordinary assignments also reach this trap through the proxy receiver.
+    defineProperty(target, key, descriptor) {
+      if (!Reflect.defineProperty(target, key, descriptor)) {
+        return false;
+      }
+
+      const value = Reflect.getOwnPropertyDescriptor(target, key)?.value;
+      // A default first parameter makes the function's length 0, which skips
+      // stringifying most functions defined by the page.
+      const source = typeof value === 'function' && value.length === 0 ?
+          Function.prototype.toString.call(value) : '';
+      if (source.includes(ELIGIBILITY_VERSION)) {
+        let override = null;
+        if (ELIGIBILITY_CHECK_REGEX.test(source)) {
+          override = function(...args) {
+            if (eligibilityCandidates.size === 1 &&
+                eligibilityCandidates.get(key) === override) {
+              args[0] = true;
+            }
+            return Reflect.apply(value, this, args);
+          };
+        } else {
+          console.warn('Helium: unverified Chrome eligibility check: ' +
+              String(key));
+        }
+        eligibilityCandidates.set(key, override);
+        if (eligibilityCandidates.size > 1) {
+          console.warn('Helium: ambiguous Chrome eligibility check: ' +
+              Array.from(eligibilityCandidates.keys(), String).join(', '));
+        }
+      } else {
+        eligibilityCandidates.delete(key);
+      }
+
+      return true;
+    },
+    deleteProperty(target, key) {
+      if (!Reflect.deleteProperty(target, key)) {
+        return false;
+      }
+      eligibilityCandidates.delete(key);
+      return true;
+    },
+  });
+})();
