+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_HELIUM_SERVICES_COMPONENT_KEYS_H_
+#define COMPONENTS_HELIUM_SERVICES_COMPONENT_KEYS_H_
+
+#include <stdint.h>
+
+#include <algorithm>
+#include <array>
+
+#include "base/containers/span.h"
+
+namespace helium {
+
+// The SHA256 of the SubjectPublicKeyInfo used to sign opencrlset.
+// The extension id is: djdljekfdkmgooegnajndfmbnjnalnlj
+inline constexpr std::array<uint8_t, 32> kOpenCRLSetPublicKeySHA256 = {
+    0x39, 0x3b, 0x94, 0xa5, 0x3a, 0xc6, 0xee, 0x46, 0xd0, 0x9d, 0x35,
+    0xc1, 0xd9, 0xd0, 0xbd, 0xb9, 0x80, 0xce, 0x19, 0x64, 0xa2, 0xe3,
+    0x16, 0x8e, 0x7e, 0x9e, 0xee, 0xcb, 0x9e, 0x10, 0xae, 0x22,
+};
+
+// Whether a component is signed by Helium's components server instead of
+// published by Google, so it carries no Google publisher proof.
+inline bool IsSignedByHelium(base::span<const uint8_t> public_key_sha256) {
+  return std::ranges::equal(public_key_sha256, kOpenCRLSetPublicKeySHA256);
+}
+
+}  // namespace helium
+
+#endif  // COMPONENTS_HELIUM_SERVICES_COMPONENT_KEYS_H_
