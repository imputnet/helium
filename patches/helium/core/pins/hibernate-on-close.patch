+// Marks a pin whose beforeunload handlers run before it's hibernated.
+class PendingHibernation
+    : public content::WebContentsUserData<PendingHibernation> {
+ public:
+  ~PendingHibernation() override = default;
+
+ private:
+  friend class content::WebContentsUserData<PendingHibernation>;
+
+  explicit PendingHibernation(content::WebContents* contents)
+      : content::WebContentsUserData<PendingHibernation>(*contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PendingHibernation);
+
+// Returns whether windows stay open when their last tab is closed.
+bool KeepsWindowsWithoutTabs() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             "close-window-with-last-tab") == "never";
+}
+
+void CloseWindow(base::WeakPtr<BrowserWindowInterface> browser) {
+  if (browser) {
+    chrome::CloseWindow(browser.get());
+  }
+}
+
+// Returns the tab to activate instead of the `closing` ones: the most recently
+// used unpinned tab, else the most recently used loaded pin. Foreground tabs
+// are skipped, so the active split doesn't stay in front.
+tabs::TabInterface* FindReplacementTab(
+    TabStripModel* model,
+    const std::set<tabs::TabInterface*>& closing) {
+  // Unpinned tabs rank above pins, more recently used tabs above others.
+  auto rank = [](tabs::TabInterface* tab) {
+    return std::pair(!tab->IsPinned(),
+                     tab->GetContents()->GetLastActiveTimeTicks());
+  };
+
+  tabs::TabInterface* best = nullptr;
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(index);
+    if (closing.contains(tab) || model->IsTabInForeground(index) ||
+        model->IsTabCollapsed(index) ||
+        (tab->IsPinned() && IsHibernated(tab->GetContents()))) {
+      continue;
+    }
+    if (!best || rank(tab) > rank(best)) {
+      best = tab;
+    }
+  }
+  return best;
+}
+
+// Hibernates a pin, unless it was unpinned or moved into the foreground since
+// then.
+void HibernateTab(tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!IsPersistentPin(tab) || IsHibernated(tab->GetContents())) {
+    return;
+  }
+  TabStripModel* const model =
+      tab->GetBrowserWindowInterface()->GetTabStripModel();
+  if (model->IsTabInForeground(model->GetIndexOfTab(tab)) ||
+      !performance_manager::PerformanceManager::IsAvailable()) {
+    return;
+  }
+  if (base::WeakPtr<performance_manager::PageNode> page_node =
+          performance_manager::PerformanceManager::
+              GetPrimaryPageNodeForWebContents(tab->GetContents())) {
+    performance_manager::user_tuning::DiscardPage(
+        page_node.get(), ::mojom::LifecycleUnitDiscardReason::EXTERNAL,
+        /*ignore_minimum_time_in_background=*/true);
+  }
+}
+
+// Hibernates a pin like HibernateTab(), but as when closing a tab, the page's
+// beforeunload handlers can ask the user first. The pin is then hibernated by
+// HandleBeforeUnloadFired().
+void RequestHibernation(tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!IsPersistentPin(tab) || IsHibernated(tab->GetContents())) {
+    return;
+  }
+
+  content::WebContents* const contents = tab->GetContents();
+  if (contents->NeedToFireBeforeUnloadOrUnloadEvents()) {
+    PendingHibernation::CreateForWebContents(contents);
+    contents->DispatchBeforeUnload(/*auto_cancel=*/false);
+    return;
+  }
+  HibernateTab(handle);
+}
+
+// Hibernates `tab` once it is no longer visible.
+void ScheduleHibernation(tabs::TabInterface* tab) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RequestHibernation, tab->GetHandle()));
+}
