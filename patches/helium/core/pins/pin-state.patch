+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_pins_util.h"
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/helium_pins_tab_controller.h"
+#include "chrome/browser/ui/tabs/tab_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace helium_pins {
+
+bool HasPersistentPins(BrowserWindowInterface* browser) {
+  return browser && browser->GetType() == BrowserWindowInterface::TYPE_NORMAL;
+}
+
+HeliumPinsTabController* GetPersistentPinController(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller =
+      HeliumPinsTabController::From(tab);
+  return controller && controller->IsLinkedPin() &&
+                 HasPersistentPins(tab->GetBrowserWindowInterface())
+             ? controller
+             : nullptr;
+}
+
+bool IsPersistentPin(tabs::TabInterface* tab) {
+  return GetPersistentPinController(tab) != nullptr;
+}
+
+bool IsHibernated(content::WebContents* contents) {
+  return contents->WasDiscarded() || IsRestoredTabPendingLoad(contents);
+}
+
+GURL GetPinnableUrl(content::WebContents* contents) {
+  const content::NavigationEntry* const entry =
+      contents->GetController().GetLastCommittedEntry();
+
+  // Source views keep their view-source: URL, as in saved sessions.
+  if (entry->IsViewSourceMode()) {
+    return entry->GetVirtualURL();
+  }
+
+  if (!entry->IsInitialEntry() && entry->GetURL().is_valid()) {
+    return entry->GetURL();
+  }
+
+  // The tab hasn't committed its first navigation yet. Like above, this is the
+  // URL loaded rather than the one shown, e.g. chrome://newtab for the New Tab
+  // page.
+  return contents->GetController().GetVisibleEntry()->GetURL();
+}
+
+}  // namespace helium_pins
