+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_PINS_TAB_CONTROLLER_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_PINS_TAB_CONTROLLER_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ref.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace helium_pins {
+
+// Persistent pin state of a tab: its pin list entry and pinned URL. Kept on the
+// tab so it survives discards, and mirrored into session extra data.
+class HeliumPinsTabController {
+ public:
+  explicit HeliumPinsTabController(tabs::TabInterface& tab);
+  HeliumPinsTabController(const HeliumPinsTabController&) = delete;
+  HeliumPinsTabController& operator=(const HeliumPinsTabController&) = delete;
+  ~HeliumPinsTabController();
+
+  DECLARE_USER_DATA(HeliumPinsTabController);
+
+  static HeliumPinsTabController* From(tabs::TabInterface* tab);
+
+  // Holds the pin state from a restored tab's extra_data until the tab's
+  // controller is created.
+  static void StashRestoredState(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  // Returns the session extra data for the tab holding contents, or an empty
+  // map if it isn't a persistent pin.
+  static std::map<std::string, std::string> GetSessionExtraData(
+      content::WebContents* contents);
+
+  tabs::TabInterface& tab() { return *tab_; }
+
+  // Returns whether the tab is pinned and in the profile's pin list.
+  bool IsLinkedPin() const;
+
+  const std::string& pin_id() const { return pin_id_; }
+  const GURL& pinned_url() const { return pinned_url_; }
+
+  // Links the tab to the pin list entry id with the pinned URL url.
+  void SetPin(const std::string& id, const GURL& url);
+
+  // Replaces the pinned URL.
+  void SetPinnedUrl(const GURL& url);
+
+  // Unlinks the tab from the pin list.
+  void ClearPin();
+
+ private:
+  void OnDidInsert(tabs::TabInterface* tab);
+  void OnPinnedStateChanged(tabs::TabInterface* tab, bool pinned);
+
+  // Returns the pin state as session extra data. Values are empty for tabs
+  // without a pin, which clears previously persisted data.
+  std::map<std::string, std::string> GetExtraData() const;
+
+  // Writes the pin state to the session of the window holding the tab.
+  void PersistSessionData();
+
+  const raw_ref<tabs::TabInterface> tab_;
+
+  std::string pin_id_;
+  GURL pinned_url_;
+
+  std::vector<base::CallbackListSubscription> tab_subscriptions_;
+  ui::ScopedUnownedUserData<HeliumPinsTabController> scoped_unowned_user_data_;
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_TAB_CONTROLLER_H_
