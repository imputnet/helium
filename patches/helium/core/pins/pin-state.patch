+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_pins_tab_controller.h"
+
+#include <utility>
+
+#include "base/containers/map_util.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace helium_pins {
+
+namespace {
+
+// Session extra data keys.
+constexpr char kPinIdKey[] = "helium.pinned_tab_id";
+constexpr char kPinnedUrlKey[] = "helium.pinned_tab_url";
+
+std::string FindValue(const std::map<std::string, std::string>& extra_data,
+                      const char* key) {
+  const std::string* const value = base::FindOrNull(extra_data, key);
+  return value ? *value : std::string();
+}
+
+// Carries a restored pin's session extra data until its controller is created.
+class RestoredPinState : public content::WebContentsUserData<RestoredPinState> {
+ public:
+  ~RestoredPinState() override = default;
+
+  const std::map<std::string, std::string>& extra_data() const {
+    return extra_data_;
+  }
+
+ private:
+  friend class content::WebContentsUserData<RestoredPinState>;
+
+  RestoredPinState(content::WebContents* contents,
+                   std::map<std::string, std::string> extra_data)
+      : content::WebContentsUserData<RestoredPinState>(*contents),
+        extra_data_(std::move(extra_data)) {}
+
+  const std::map<std::string, std::string> extra_data_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(RestoredPinState);
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumPinsTabController);
+
+HeliumPinsTabController::HeliumPinsTabController(tabs::TabInterface& tab)
+    : tab_(tab),
+      scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {
+  content::WebContents* const contents = tab.GetContents();
+  if (const RestoredPinState* state =
+          RestoredPinState::FromWebContents(contents)) {
+    pin_id_ = FindValue(state->extra_data(), kPinIdKey);
+    pinned_url_ = GURL(FindValue(state->extra_data(), kPinnedUrlKey));
+    contents->RemoveUserData(RestoredPinState::UserDataKey());
+  }
+
+  tab_subscriptions_.push_back(tab.RegisterDidInsert(base::BindRepeating(
+      &HeliumPinsTabController::OnDidInsert, base::Unretained(this))));
+  tab_subscriptions_.push_back(tab.RegisterPinnedStateChanged(
+      base::BindRepeating(&HeliumPinsTabController::OnPinnedStateChanged,
+                          base::Unretained(this))));
+}
+
+HeliumPinsTabController::~HeliumPinsTabController() = default;
+
+// static
+HeliumPinsTabController* HeliumPinsTabController::From(
+    tabs::TabInterface* tab) {
+  return tab ? Get(tab->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+void HeliumPinsTabController::StashRestoredState(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!FindValue(extra_data, kPinIdKey).empty()) {
+    RestoredPinState::CreateForWebContents(contents, extra_data);
+  }
+}
+
+// static
+std::map<std::string, std::string> HeliumPinsTabController::GetSessionExtraData(
+    content::WebContents* contents) {
+  HeliumPinsTabController* const controller =
+      From(tabs::TabInterface::MaybeGetFromContents(contents));
+  if (!controller || !controller->IsLinkedPin()) {
+    return {};
+  }
+
+  return controller->GetExtraData();
+}
+
+bool HeliumPinsTabController::IsLinkedPin() const {
+  return !pin_id_.empty() && tab_->IsPinned();
+}
+
+void HeliumPinsTabController::SetPin(const std::string& id, const GURL& url) {
+  pin_id_ = id;
+  pinned_url_ = url;
+  PersistSessionData();
+}
+
+void HeliumPinsTabController::SetPinnedUrl(const GURL& url) {
+  pinned_url_ = url;
+  PersistSessionData();
+}
+
+void HeliumPinsTabController::ClearPin() {
+  if (pin_id_.empty() && pinned_url_.is_empty()) {
+    return;
+  }
+
+  pin_id_.clear();
+  pinned_url_ = GURL();
+  PersistSessionData();
+}
+
+void HeliumPinsTabController::OnDidInsert(tabs::TabInterface* tab) {
+  // The tab may have moved to a different window. Drags can insert a pin
+  // without pinning it first, so where a pin ends up is only decided once the
+  // drag is done.
+  if (tab->IsPinned()) {
+    PersistSessionData();
+  }
+}
+
+void HeliumPinsTabController::OnPinnedStateChanged(tabs::TabInterface* tab,
+                                                   bool pinned) {
+  // Session data is only kept for pinned tabs, so a tab that's pinned again,
+  // e.g. during a drag, writes it again.
+  if (pinned) {
+    PersistSessionData();
+  }
+}
+
+std::map<std::string, std::string> HeliumPinsTabController::GetExtraData()
+    const {
+  return {
+      {kPinIdKey, pin_id_},
+      {kPinnedUrlKey, pinned_url_.is_valid() ? pinned_url_.spec() : ""},
+  };
+}
+
+void HeliumPinsTabController::PersistSessionData() {
+  content::WebContents* const contents = tab_->GetContents();
+  SessionService* const session_service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  if (!session_service) {
+    return;
+  }
+
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+
+  for (const auto& [key, value] : GetExtraData()) {
+    session_service->AddTabExtraData(window_id, tab_id, key.c_str(), value);
+  }
+}
+
+}  // namespace helium_pins
