+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_PINS_UTIL_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_PINS_UTIL_H_
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+// Persistent pinned tabs: pins are shared by all normal windows of a profile,
+// survive restarts, and are hibernated instead of closed.
+namespace helium_pins {
+
+class HeliumPinsTabController;
+
+// Returns whether browser keeps persistent pins: only normal windows do.
+bool HasPersistentPins(BrowserWindowInterface* browser);
+
+// Returns the controller of tab if it is pinned, belongs to its profile's pin
+// list, and its window keeps persistent pins.
+HeliumPinsTabController* GetPersistentPinController(tabs::TabInterface* tab);
+bool IsPersistentPin(tabs::TabInterface* tab);
+
+// Returns whether contents is hibernated: discarded, or restored but not
+// loaded yet.
+bool IsHibernated(content::WebContents* contents);
+
+// Returns the URL that pinning the tab holding contents would capture.
+GURL GetPinnableUrl(content::WebContents* contents);
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_UTIL_H_
