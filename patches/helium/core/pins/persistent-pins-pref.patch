+void HeliumPinsService::OnPersistentPinsChanged() {
+  TabStripModelObserver::StopObservingAll(this);
+  UpdatePinnedTabService();
+  ProfileBrowserCollection* const browsers =
+      ProfileBrowserCollection::GetForProfile(profile_);
+
+  if (ArePersistentPinsEnabled(profile_)) {
+    browsers->ForEach([this](BrowserWindowInterface* browser) {
+      if (IsSyncedBrowser(browser)) {
+        AdoptPins(browser);
+      }
+      return true;
+    });
+
+    // Replaces PinnedTabService's snapshot even if no window has pins.
+    SavePins();
+    browsers->ForEach([this](BrowserWindowInterface* browser) {
+      OnBrowserCreated(browser);
+      return true;
+    });
+    return;
+  }
+
+  pins_ = PinList();
+  SavePins();
+}
+
+void HeliumPinsService::AdoptPins(BrowserWindowInterface* browser) {
+  const std::vector<HeliumPinsTabController*> controllers =
+      GetPinnedTabControllers(browser);
+
+  // Pins keep their ids while sharing is off, so the ones that are still open
+  // come back as they were.
+  std::set<std::string> present;
+  for (HeliumPinsTabController* controller : controllers) {
+    const std::string& id = controller->pin_id();
+    if (id.empty()) {
+      continue;
+    }
+
+    if (pins_.Find(id) == pins_.end()) {
+      pins_.insert(pins_.end(), {.id = id, .url = controller->pinned_url()});
+    }
+    present.insert(id);
+  }
+
+  // Tabs pinned meanwhile need ids before their splits are taken in.
+  for (HeliumPinsTabController* controller : controllers) {
+    if (!controller->pin_id().empty()) {
+      continue;
+    }
+
+    const GURL url = GetPinnableUrl(controller->tab().GetContents());
+    const auto match = std::ranges::find_if(pins_, [&](const Pin& pin) {
+      return pin.url == url && !present.contains(pin.id);
+    });
+    if (match != pins_.end()) {
+      controller->SetPin(match->id, match->url);
+    } else {
+      InsertNewPin(browser, controller);
+    }
+    present.insert(controller->pin_id());
+  }
+
+  UpdateSplits(browser);
+}
+
+void HeliumPinsService::UpdatePinnedTabService() {
+  if (prefs_ && !ArePersistentPinsEnabled(profile_)) {
+    pinned_tab_service_ = std::make_unique<PinnedTabService>(profile_);
+  } else {
+    pinned_tab_service_.reset();
+  }
+}
+
 bool HeliumPinsService::IsSyncedBrowser(BrowserWindowInterface* browser) const {
   return HasPersistentPins(browser) && browser->GetProfile() == profile_;
 }
