+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/tabs/helium_pins_list.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class Profile;
+class ProfileBrowserCollection;
+class TabStripModel;
+
+namespace history {
+class HistoryService;
+}  // namespace history
+
+namespace helium_pins {
+
+class HeliumPinsTabController;
+
+// Keeps the pinned tabs of a profile's normal windows in sync with its pin
+// list. Each window has its own tab for every pin, a copy of the pin; missing
+// copies are added hibernated.
+class HeliumPinsService : public KeyedService,
+                          public BrowserCollectionObserver,
+                          public TabStripModelObserver {
+ public:
+  // The pin list is loaded from prefs and saved to them on every change, and
+  // hibernated pins take their titles from history. Without prefs, the profile
+  // starts without pins and they aren't saved.
+  HeliumPinsService(Profile* profile,
+                    PrefService* prefs,
+                    history::HistoryService* history);
+  HeliumPinsService(const HeliumPinsService&) = delete;
+  HeliumPinsService& operator=(const HeliumPinsService&) = delete;
+  ~HeliumPinsService() override;
+
+  // Clears the pin list and unpins the copies of all pins in place, e.g. when
+  // settings are reset.
+  void UnpinAll();
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+
+  // Returns whether browser is a normal window of the profile.
+  bool IsSyncedBrowser(BrowserWindowInterface* browser) const;
+  std::vector<BrowserWindowInterface*> GetSyncedBrowsers() const;
+
+  // Returns the copies of the pin id in all synced windows.
+  std::vector<HeliumPinsTabController*> GetPinCopies(
+      const std::string& id) const;
+
+  void SavePins();
+
+  // Handles the user pinning or unpinning tab in browser.
+  void AddPin(BrowserWindowInterface* browser, tabs::TabInterface* tab);
+  void RemovePin(tabs::TabInterface* tab);
+
+  // Removes the pin id from the pin list and closes its hibernated copies.
+  // Loaded copies and copies in source, the window it was unpinned in, become
+  // regular tabs.
+  void UnpinEverywhere(const std::string& id,
+                       BrowserWindowInterface* source = nullptr);
+  // Takes the order of the pins in browser after the user moved one.
+  void ReorderPins(BrowserWindowInterface* browser);
+
+  // Returns the pin list position for a new pin tab in browser, right
+  // after the pin preceding it there.
+  size_t GetNewPinPosition(BrowserWindowInterface* browser,
+                           tabs::TabInterface* tab);
+
+  // Adds a new pin for the tab of controller to the pin list, right after the
+  // pin preceding it in browser, and links the tab to it. Returns the pin's
+  // id.
+  std::string InsertNewPin(BrowserWindowInterface* browser,
+                           HeliumPinsTabController* controller);
+
+  // Posts a Reconcile() of browser, after delay if given, or adds browser
+  // to the one that is already posted.
+  void ScheduleReconcile(BrowserWindowInterface* browser,
+                         base::TimeDelta delay = base::TimeDelta());
+  void ScheduleReconcileOthers(BrowserWindowInterface* source);
+  void ReconcilePending();
+
+  // Makes the pinned tabs of browser match the pin list.
+  void Reconcile(BrowserWindowInterface* browser);
+
+  // Adds a hibernated copy of pin at index of browser.
+  void InsertHibernatedPin(BrowserWindowInterface* browser,
+                           int index,
+                           const Pin& pin);
+
+  // Gives the hibernated tab at url the title that history has for url,
+  // unless it already has one.
+  void RequestHibernatedTitle(tabs::TabInterface* tab, const GURL& url);
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<PrefService> prefs_;
+  const raw_ptr<history::HistoryService> history_;
+
+  PinList pins_;
+
+  // True while this class modifies tab strips itself.
+  bool applying_changes_ = false;
+
+  std::vector<base::WeakPtr<BrowserWindowInterface>> pending_reconciles_;
+  bool reconcile_scheduled_ = false;
+
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+
+  // History lookups of hibernated pins' titles.
+  base::CancelableTaskTracker history_tasks_;
+
+  base::WeakPtrFactory<HeliumPinsService> weak_factory_{this};
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_SERVICE_H_
