+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_pins_list.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/uuid.h"
+
+namespace helium_pins {
+
+namespace {
+
+// Keys of the pinned tabs preference entries. "url" is shared with
+// PinnedTabCodec, which still reads the list to open pins at startup.
+constexpr char kUrlKey[] = "url";
+constexpr char kIdKey[] = "id";
+
+}  // namespace
+
+std::string CreatePinId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+PinList::PinList() = default;
+PinList::PinList(const PinList&) = default;
+PinList& PinList::operator=(const PinList&) = default;
+PinList::PinList(PinList&&) = default;
+PinList& PinList::operator=(PinList&&) = default;
+PinList::~PinList() = default;
+
+// static
+PinList PinList::FromPref(const base::ListValue& value) {
+  PinList list;
+  for (const base::Value& entry : value) {
+    const base::DictValue* const dict = entry.GetIfDict();
+    const std::string* const url = dict ? dict->FindString(kUrlKey) : nullptr;
+    if (!url) {
+      continue;
+    }
+
+    const GURL pin_url(*url);
+    if (!pin_url.is_valid()) {
+      continue;
+    }
+
+    const std::string* const id = dict->FindString(kIdKey);
+    if (id && !id->empty() && list.Find(*id) == list.end()) {
+      list.pins_.push_back({*id, pin_url});
+    }
+  }
+
+  return list;
+}
+
+base::ListValue PinList::ToPref() const {
+  base::ListValue value;
+  for (const Pin& pin : pins_) {
+    base::DictValue entry =
+        base::DictValue().Set(kUrlKey, pin.url.spec()).Set(kIdKey, pin.id);
+    value.Append(std::move(entry));
+  }
+
+  return value;
+}
+
+PinList::iterator PinList::Find(const std::string& id) {
+  return std::ranges::find(pins_, id, &Pin::id);
+}
+
+PinList::iterator PinList::insert(const_iterator position, Pin pin) {
+  return pins_.insert(position, std::move(pin));
+}
+
+PinList::iterator PinList::erase(const_iterator position) {
+  return pins_.erase(position);
+}
+
+}  // namespace helium_pins
