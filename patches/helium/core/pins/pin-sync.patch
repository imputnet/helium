+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_PINS_LIST_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_PINS_LIST_H_
+
+#include <stddef.h>
+
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium_pins {
+
+// An entry of the pin list.
+struct Pin {
+  std::string id;
+  GURL url;
+};
+
+// Returns a new, unique pin id.
+std::string CreatePinId();
+
+// The pins of a profile, in the order that all of its windows show them. Kept
+// in the pinned tabs preference.
+class PinList {
+ public:
+  using iterator = std::vector<Pin>::iterator;
+  using const_iterator = std::vector<Pin>::const_iterator;
+
+  PinList();
+  PinList(const PinList&);
+  PinList& operator=(const PinList&);
+  PinList(PinList&&);
+  PinList& operator=(PinList&&);
+  ~PinList();
+
+  // Reads the pin list from the value of the pinned tabs preference. Entries
+  // without a valid URL and repeated pin ids are skipped.
+  static PinList FromPref(const base::ListValue& value);
+
+  // Returns the value of the pinned tabs preference for the pin list.
+  base::ListValue ToPref() const;
+
+  // Returns the pin id, or end() if the list doesn't have it.
+  iterator Find(const std::string& id);
+
+  iterator begin() { return pins_.begin(); }
+  iterator end() { return pins_.end(); }
+  const_iterator begin() const { return pins_.begin(); }
+  const_iterator end() const { return pins_.end(); }
+  size_t size() const { return pins_.size(); }
+  Pin& operator[](size_t index) { return pins_[index]; }
+  const Pin& operator[](size_t index) const { return pins_[index]; }
+
+  iterator insert(const_iterator position, Pin pin);
+  iterator erase(const_iterator position);
+
+ private:
+  std::vector<Pin> pins_;
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_LIST_H_
