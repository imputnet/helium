+
+void ReturnToPinnedUrl(tabs::TabInterface* tab) {
+  if (!CanReturnToPinnedUrl(tab)) {
+    return;
+  }
+
+  HeliumPinsTabController* const controller = GetPersistentPinController(tab);
+  if (IsHibernated(tab->GetContents())) {
+    // Don't load a hibernated tab in the background.
+    controller->SetReturnOnActivation(true);
+  } else {
+    controller->ReturnToPinnedUrl();
+  }
+}
+
+bool CanUseCurrentUrlAsPinnedUrl(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller = GetPersistentPinController(tab);
+  if (!controller) {
+    return false;
+  }
+  const GURL url = GetPinnableUrl(tab->GetContents());
+  return url.is_valid() && url != controller->pinned_url();
+}
+
+void UseCurrentUrlAsPinnedUrl(tabs::TabInterface* tab) {
+  if (!CanUseCurrentUrlAsPinnedUrl(tab)) {
+    return;
+  }
+
+  HeliumPinsTabController* const controller = GetPersistentPinController(tab);
+  const GURL url = GetPinnableUrl(tab->GetContents());
+  // The tab is at its new pinned URL, so there's nothing to return to.
+  controller->SetReturnOnActivation(false);
