+bool CanReturnToPinnedUrl(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller = GetPersistentPinController(tab);
+  if (!controller || !controller->pinned_url().is_valid() ||
+      GetPinnableUrl(tab->GetContents()) == controller->pinned_url()) {
+    return false;
+  }
