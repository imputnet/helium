+  if (HeliumPinsService* const pins_service =
+          PinnedTabServiceFactory::GetForProfile(
+              tab->GetBrowserWindowInterface()->GetProfile())) {
+    pins_service->SetPinnedUrl(controller->pin_id(), url);
+  }
+}
