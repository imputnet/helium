+bool HeliumPinsService::ImportLegacySplits(
+    BrowserWindowInterface* browser,
+    const std::vector<HeliumPinsTabController*>& restored) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  bool changed = false;
+  for (HeliumPinsTabController* controller : restored) {
+    const std::optional<split_tabs::SplitTabId> split_id =
+        controller->tab().GetSplit();
+    if (!split_id) {
+      continue;
+    }
+
+    // Each split is imported once, with its first tab.
+    split_tabs::SplitTabData* const data = model->GetSplitData(*split_id);
+    const std::vector<tabs::TabInterface*> members = data->ListTabs();
+    if (members.front() != &controller->tab()) {
+      continue;
+    }
+
+    // Only splits of restored tabs whose pins aren't split yet are imported.
+    std::vector<std::string> ids;
+    for (tabs::TabInterface* member : members) {
+      HeliumPinsTabController* const member_controller =
+          HeliumPinsTabController::From(member);
+      const auto it = std::ranges::contains(restored, member_controller)
+                          ? pins_.Find(member_controller->pin_id())
+                          : pins_.end();
+      if (it == pins_.end() || !it->split.empty()) {
+        break;
+      }
+
+      ids.push_back(it->id);
+    }
+
+    if (ids.size() != members.size()) {
+      continue;
+    }
+
+    // The pins of a split follow each other in the pin list.
+    for (size_t i = 1; i < ids.size(); ++i) {
+      const auto it = pins_.Find(ids[i]);
+      Pin pin = std::move(*it);
+      pins_.erase(it);
+      pins_.insert(pins_.Find(ids[i - 1]) + 1, std::move(pin));
+    }
+
+    for (const std::string& id : ids) {
+      const auto it = pins_.Find(id);
+      it->split = ids.front();
+      it->split_visual_data = *data->visual_data();
+    }
+
+    changed = true;
+  }
+
+  return changed;
+}
