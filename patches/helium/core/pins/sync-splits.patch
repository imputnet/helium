+    const base::DictValue* const dict = value.GetIfDict();
+    const std::string* const id = dict ? dict->FindString(kIdKey) : nullptr;
+    const std::string* const split =
+        dict ? dict->FindString(kSplitKey) : nullptr;
+    const auto it = id && split ? FindPin(*id) : pins_.end();
+    if (it == pins_.end()) {
+      continue;
+    }
+    it->split = *split;
+    const std::string* const layout = dict->FindString(kSplitLayoutKey);
+    it->split_visual_data = split_tabs::SplitTabVisualData(
+        layout && *layout == kStackedLayout
+            ? split_tabs::SplitTabLayout::kStacked
+            : split_tabs::SplitTabLayout::kSideBySide,
+        dict->FindDouble(kSplitRatioKey).value_or(0.5));
+  }
+}
