+void HeliumPinsService::HandleDetachedPins() {
+  std::vector<PinDragTracker::DetachedPin> detached =
+      drag_tracker_.TakeDetachedPins();
+
+  // Pins that become regular tabs, by window, so that they keep their order and
+  // splits.
+  std::map<BrowserWindowInterface*, std::vector<HeliumPinsTabController*>>
+      to_unpin;
+  std::vector<std::string> removed_ids;
+  for (const PinDragTracker::DetachedPin& pin : detached) {
+    tabs::TabInterface* const tab = pin.tab.Get();
+    BrowserWindowInterface* const target =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+
+    // The pin is still being dragged.
+    if (IsSyncedBrowser(target) && !CanChangePins(target)) {
+      drag_tracker_.AddDetachedPin(pin);
+      continue;
+    }
+
+    // Its window gets a copy of the pin again, unless it's unpinned below.
+    if (pin.source) {
+      ScheduleReconcile(pin.source.get());
+    }
+
+    // Pins that were closed or went back to their window stay pins.
+    if (!IsSyncedBrowser(target) || target == pin.source.get()) {
+      continue;
+    }
+
+    // A pin dropped among the pins of another window only moves there.
+    const auto is_copy_in_target = [&](HeliumPinsTabController* copy) {
+      return &copy->tab() != tab &&
+             copy->tab().GetBrowserWindowInterface() == target;
+    };
+    if (tab->IsPinned() &&
+        std::ranges::any_of(GetPinCopies(pin.id), is_copy_in_target)) {
+      continue;
+    }
+
+    // Anywhere else, e.g. in a new window, it becomes a regular tab.
+    to_unpin[target].push_back(HeliumPinsTabController::From(tab));
+    removed_ids.push_back(pin.id);
+  }
+
+  {
+    base::AutoReset<bool> applying_changes(&applying_changes_, true);
+    for (auto& [target, copies] : to_unpin) {
+      UnpinCopies(std::move(copies));
+    }
+  }
+
+  for (const std::string& id : removed_ids) {
+    UnpinEverywhere(id);
+  }
+}
+
+void HeliumPinsService::HandleDraggedPinChanges() {
+  std::vector<tabs::TabHandle> changes = drag_tracker_.TakePinChanges();
+  for (tabs::TabHandle handle : changes) {
+    tabs::TabInterface* const tab = handle.Get();
+    BrowserWindowInterface* const browser =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (!IsSyncedBrowser(browser)) {
+      continue;
+    }
+
+    if (!CanChangePins(browser)) {
+      drag_tracker_.AddPinChange(handle);
+    } else if (tab->IsPinned()) {
+      AddPin(browser, tab);
+    } else {
+      RemovePin(tab);
+    }
+  }
+}
+
+void HeliumPinsService::HandleDraggedReorders() {
+  std::vector<base::WeakPtr<BrowserWindowInterface>> windows =
+      drag_tracker_.TakeReorderedWindows();
+  for (const base::WeakPtr<BrowserWindowInterface>& browser : windows) {
+    if (!browser || browser->IsDeleteScheduled() ||
+        !IsSyncedBrowser(browser.get())) {
+      continue;
+    }
+
+    if (CanChangePins(browser.get())) {
+      ReorderPins(browser.get());
+    } else {
+      drag_tracker_.AddReorderedWindow(browser);
+    }
+  }
+}
+
+void HeliumPinsService::CloseWindowsEmptiedByDrags() {
+  // Tabs can still be dragged back while a drag is going on.
+  if (!std::ranges::all_of(GetSyncedBrowsers(), CanChangePins)) {
+    return;
+  }
+
+  std::vector<PinDragTracker::WindowEmptiedByDrag> windows =
+      drag_tracker_.TakeWindowsEmptiedByDrags();
+  for (const PinDragTracker::WindowEmptiedByDrag& window : windows) {
+    BrowserWindowInterface* const browser = window.browser.get();
+    if (!browser || browser->IsDeleteScheduled()) {
+      continue;
+    }
+
+    // The tabs may have come back later in the drag, e.g. to be pinned.
+    const bool tabs_returned =
+        std::ranges::any_of(window.tabs, [browser](tabs::TabHandle handle) {
+          tabs::TabInterface* const tab = handle.Get();
+          return tab && tab->GetBrowserWindowInterface() == browser;
+        });
+    TabStripModel* const model = browser->GetTabStripModel();
+    if (!tabs_returned && model->IndexOfFirstNonPinnedTab() == model->count()) {
+      chrome::CloseWindow(browser);
+    }
+  }
+}
