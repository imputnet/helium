+    for (HeliumPinsTabController* controller :
+         GetPinnedTabControllers(browser)) {
+      if (!IsHibernated(controller->tab().GetContents())) {
+        pending_removal_->loaded_pins.push_back(controller->tab().GetHandle());
+      }
