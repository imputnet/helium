+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/helium_pins_drag_tracker.h"
+
+#include <algorithm>
+#include <utility>
+
+namespace helium_pins {
+
+PinDragTracker::PinDragTracker() = default;
+
+PinDragTracker::~PinDragTracker() = default;
+
+void PinDragTracker::AddDetachedPin(DetachedPin pin) {
+  if (!std::ranges::contains(detached_pins_, pin.tab, &DetachedPin::tab)) {
+    detached_pins_.push_back(std::move(pin));
+  }
+}
+
+bool PinDragTracker::HasDetachedPin(const std::string& id) const {
+  return std::ranges::contains(detached_pins_, id, &DetachedPin::id);
+}
+
+std::vector<PinDragTracker::DetachedPin> PinDragTracker::TakeDetachedPins() {
+  return std::exchange(detached_pins_, {});
+}
+
+void PinDragTracker::AddPinChange(tabs::TabHandle tab) {
+  if (!std::ranges::contains(pin_changes_, tab)) {
+    pin_changes_.push_back(tab);
+  }
+}
+
+std::vector<tabs::TabHandle> PinDragTracker::TakePinChanges() {
+  return std::exchange(pin_changes_, {});
+}
+
+void PinDragTracker::AddReorderedWindow(
+    base::WeakPtr<BrowserWindowInterface> browser) {
+  if (!std::ranges::contains(reordered_windows_, browser.get(),
+                             &base::WeakPtr<BrowserWindowInterface>::get)) {
+    reordered_windows_.push_back(std::move(browser));
+  }
+}
+
+std::vector<base::WeakPtr<BrowserWindowInterface>>
+PinDragTracker::TakeReorderedWindows() {
+  return std::exchange(reordered_windows_, {});
+}
+
+void PinDragTracker::AddWindowEmptiedByDrag(WindowEmptiedByDrag window) {
+  windows_emptied_by_drags_.push_back(std::move(window));
+}
+
+std::vector<PinDragTracker::WindowEmptiedByDrag>
+PinDragTracker::TakeWindowsEmptiedByDrags() {
+  return std::exchange(windows_emptied_by_drags_, {});
+}
+
+bool PinDragTracker::HasPendingResults() const {
+  return !detached_pins_.empty() || !pin_changes_.empty() ||
+         !reordered_windows_.empty() || !windows_emptied_by_drags_.empty();
+}
+
+}  // namespace helium_pins
