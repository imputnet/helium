+void HeliumPinsService::OnTabWillBeRemoved(tabs::TabInterface* tab, int index) {
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  // Several tabs can be removed at once, so only look before the first one.
+  if (applying_changes_ || !IsSyncedBrowser(browser) ||
+      removing_from_ == browser->GetTabStripModel()) {
+    return;
+  }
+
+  removing_from_ = browser->GetTabStripModel();
+  loaded_pins_before_removal_.clear();
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    if (!IsHibernated(controller->tab().GetContents())) {
+      loaded_pins_before_removal_.push_back(controller->tab().GetHandle());
+    }
+  }
+}
