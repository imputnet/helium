+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_PINS_DRAG_TRACKER_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_PINS_DRAG_TRACKER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+
+namespace helium_pins {
+
+// Keeps what tab drags did to pins until the drags are done. Drags pin, unpin
+// and move tabs between windows as they go, so only their results count.
+class PinDragTracker {
+ public:
+  // A pin that was dragged or moved out of its window.
+  struct DetachedPin {
+    tabs::TabHandle tab;
+    base::WeakPtr<BrowserWindowInterface> source;
+    std::string id;
+  };
+
+  // A window whose last unpinned tabs were dragged out while no pin was loaded.
+  struct WindowEmptiedByDrag {
+    base::WeakPtr<BrowserWindowInterface> browser;
+    std::vector<tabs::TabHandle> tabs;
+  };
+
+  PinDragTracker();
+  PinDragTracker(const PinDragTracker&) = delete;
+  PinDragTracker& operator=(const PinDragTracker&) = delete;
+  ~PinDragTracker();
+
+  // Adds pin, unless its tab was already added.
+  void AddDetachedPin(DetachedPin pin);
+
+  // Returns whether a copy of the pin id was detached.
+  bool HasDetachedPin(const std::string& id) const;
+  std::vector<DetachedPin> TakeDetachedPins();
+
+  // Adds tab, which was pinned or unpinned during a drag, unless it was
+  // already added.
+  void AddPinChange(tabs::TabHandle tab);
+  std::vector<tabs::TabHandle> TakePinChanges();
+
+  // Adds browser, whose pins were moved during a drag, unless it was already
+  // added.
+  void AddReorderedWindow(base::WeakPtr<BrowserWindowInterface> browser);
+  std::vector<base::WeakPtr<BrowserWindowInterface>> TakeReorderedWindows();
+
+  void AddWindowEmptiedByDrag(WindowEmptiedByDrag window);
+  std::vector<WindowEmptiedByDrag> TakeWindowsEmptiedByDrags();
+
+  // Returns whether any results of drags are left to handle.
+  bool HasPendingResults() const;
+
+ private:
+  std::vector<DetachedPin> detached_pins_;
+  std::vector<tabs::TabHandle> pin_changes_;
+  std::vector<base::WeakPtr<BrowserWindowInterface>> reordered_windows_;
+  std::vector<WindowEmptiedByDrag> windows_emptied_by_drags_;
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_DRAG_TRACKER_H_
