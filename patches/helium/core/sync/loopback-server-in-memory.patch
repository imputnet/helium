+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace syncer {
+namespace {
+
+using google::protobuf::MessageLite;
+using google::protobuf::io::CodedInputStream;
+using google::protobuf::io::CodedOutputStream;
+using google::protobuf::io::CopyingInputStreamAdaptor;
+using google::protobuf::io::CopyingOutputStreamAdaptor;
+using google::protobuf::io::ZeroCopyInputStream;
+using google::protobuf::io::ZeroCopyOutputStream;
+
+constexpr uint32_t kFormatVersion = 1;
+// Bounds the size of each update response.
+constexpr int kGetUpdatesBatchSize = 1000;
+
+class ReaderInput final : public google::protobuf::io::CopyingInputStream {
+ public:
+  explicit ReaderInput(LoopbackServerVaultState::Reader reader)
+      : reader_(reader) {}
+
+  int Read(void* buffer, int size) override {
+    if (remaining_.empty()) {
+      remaining_ = reader_();
+    }
+    const size_t count = std::min(remaining_.size(), static_cast<size_t>(size));
+    if (count) {
+      std::memcpy(buffer, remaining_.data(), count);
+    }
+    remaining_ = remaining_.subspan(count);
+    return base::checked_cast<int>(count);
+  }
+
+ private:
+  LoopbackServerVaultState::Reader reader_;
+  base::span<const uint8_t> remaining_;
+};
+
+class WriterOutput final : public google::protobuf::io::CopyingOutputStream {
+ public:
+  explicit WriterOutput(LoopbackServerVaultState::Writer writer)
+      : writer_(writer) {}
+
+  bool Write(const void* buffer, int size) override {
+    return writer_(base::span(static_cast<const uint8_t*>(buffer),
+                              base::checked_cast<size_t>(size)));
+  }
+
+ private:
+  LoopbackServerVaultState::Writer writer_;
+};
+
+enum class RecordResult { kRead, kEnd, kMalformed };
+
+// Rejects records that LoopbackServer would load as something else, such as a
+// bookmark without its specialized entity class.
+std::unique_ptr<LoopbackServerEntity> CreateEntity(
+    const sync_pb::LoopbackServerEntity& record,
+    int64_t last_version_assigned) {
+  const sync_pb::SyncEntity& proto = record.entity();
+  if (record.type() == sync_pb::LoopbackServerEntity::UNKNOWN ||
+      proto.id_string().empty() || proto.version() < 0 ||
+      proto.version() > last_version_assigned) {
+    return nullptr;
+  }
+  std::unique_ptr<LoopbackServerEntity> entity =
+      LoopbackServerEntity::CreateEntityFromProto(record);
+  if (!entity || entity->GetId() != proto.id_string() ||
+      static_cast<int64_t>(entity->GetDataType()) != record.data_type() ||
+      entity->IsDeleted() != proto.deleted() ||
+      (record.type() == sync_pb::LoopbackServerEntity::UNIQUE &&
+       (entity->GetDataType() == BOOKMARKS ||
+        entity->GetDataType() == NIGORI))) {
+    return nullptr;
+  }
+  return entity;
+}
+
+RecordResult ReadRecord(ZeroCopyInputStream& stream, MessageLite& message) {
+  const void* data;
+  int size;
+  if (!stream.Next(&data, &size)) {
+    return RecordResult::kEnd;
+  }
+  stream.BackUp(size);
+  // Keep protobuf's int-sized byte counters local to one record.
+  CodedInputStream input(&stream);
+  int length;
+  if (!input.ReadVarintSizeAsInt(&length)) {
+    return RecordResult::kMalformed;
+  }
+
+  const CodedInputStream::Limit limit = input.PushLimit(length);
+  // A record cut short by the end of the payload would still parse.
+  if (!message.ParseFromCodedStream(&input) || !input.ConsumedEntireMessage() ||
+      input.BytesUntilLimit() != 0) {
+    return RecordResult::kMalformed;
+  }
+  input.PopLimit(limit);
+  return RecordResult::kRead;
+}
+
+bool WriteRecord(ZeroCopyOutputStream& stream, const MessageLite& message) {
+  const size_t size = message.ByteSizeLong();
+  if (!base::IsValueInRangeForNumericType<int>(size)) {
+    return false;
+  }
+  CodedOutputStream output(&stream);
+  output.WriteVarint32(static_cast<uint32_t>(size));
+  message.SerializeWithCachedSizes(&output);
+  return !output.HadError();
+}
+
+}  // namespace
+
+LoopbackServerVaultState::LoopbackServerVaultState() {
+  // The vault is shared by several clients.
+  server_.EnableStrongConsistencyWithConflictDetectionModel();
+  server_.SetMaxGetUpdatesBatchSize(kGetUpdatesBatchSize);
+}
+
+LoopbackServerVaultState::~LoopbackServerVaultState() = default;
+
+bool LoopbackServerVaultState::HasChanges() const {
+  return RequiresSnapshot() || server_.version_ != written_version_ ||
+         !removed_entity_ids_.empty();
+}
+
+bool LoopbackServerVaultState::RequiresSnapshot() const {
+  return server_.store_birthday_ != written_birthday_;
+}
+
+LoopbackServerVaultState::ReadResult LoopbackServerVaultState::Read(
+    Reader reader,
+    bool snapshot) {
+  ReaderInput source(reader);
+  CopyingInputStreamAdaptor stream(&source);
+  sync_pb::LoopbackServerStateHeader header;
+  if (ReadRecord(stream, header) != RecordResult::kRead ||
+      !header.has_format_version()) {
+    return ReadResult::kMalformed;
+  }
+  if (header.format_version() != kFormatVersion) {
+    return ReadResult::kUnsupportedVersion;
+  }
+  if (!header.has_store_birthday() || !header.has_last_version_assigned() ||
+      header.snapshot() != snapshot) {
+    return ReadResult::kMalformed;
+  }
+
+  auto& entities = server_.entities_;
+  if (snapshot) {
+    entities.clear();
+  } else if (header.store_birthday() != server_.store_birthday_ ||
+             header.bookmarks_migrated_to_client_tag_hash() !=
+                 server_.bookmarks_migrated_to_client_tag_hash_ ||
+             header.last_version_assigned() < server_.version_ ||
+             header.keystore_keys_size() <
+                 static_cast<int>(server_.keystore_keys_.size())) {
+    return ReadResult::kMalformed;
+  } else {
+    // Keys are only added.
+    for (size_t i = 0; i < server_.keystore_keys_.size(); ++i) {
+      if (!std::ranges::equal(server_.keystore_keys_[i],
+                              base::as_byte_span(header.keystore_keys(i)))) {
+        return ReadResult::kMalformed;
+      }
+    }
+  }
+  for (const std::string& id : header.removed_entity_ids()) {
+    entities.erase(id);
+  }
+  while (true) {
+    sync_pb::LoopbackServerEntity record;
+    const RecordResult result = ReadRecord(stream, record);
+    if (result == RecordResult::kEnd) {
+      break;
+    }
+    if (result == RecordResult::kMalformed) {
+      return ReadResult::kMalformed;
+    }
+    std::unique_ptr<LoopbackServerEntity> entity =
+        CreateEntity(record, header.last_version_assigned());
+    if (!entity) {
+      return ReadResult::kMalformed;
+    }
+    const std::string id = entity->GetId();
+    entities[id] = std::move(entity);
+  }
+
+  server_.store_birthday_ = header.store_birthday();
+  server_.bookmarks_migrated_to_client_tag_hash_ =
+      header.bookmarks_migrated_to_client_tag_hash();
+  server_.version_ = header.last_version_assigned();
+  server_.keystore_keys_.clear();
+  for (const std::string& key : header.keystore_keys()) {
+    server_.keystore_keys_.emplace_back(key.begin(), key.end());
+  }
+  MarkWritten();
+  return ReadResult::kSuccess;
+}
+
+bool LoopbackServerVaultState::WriteSnapshot(Writer writer) const {
+  return Write(/*snapshot=*/true, writer);
+}
+
+bool LoopbackServerVaultState::WriteDelta(Writer writer) const {
+  CHECK(!RequiresSnapshot());
+  return Write(/*snapshot=*/false, writer);
+}
+
+void LoopbackServerVaultState::MarkWritten() {
+  written_birthday_ = server_.store_birthday_;
+  written_version_ = server_.version_;
+  removed_entity_ids_.clear();
+}
+
+bool LoopbackServerVaultState::Write(bool snapshot, Writer writer) const {
+  sync_pb::LoopbackServerStateHeader header;
+  header.set_format_version(kFormatVersion);
+  header.set_snapshot(snapshot);
+  header.set_store_birthday(server_.store_birthday_);
+  header.set_bookmarks_migrated_to_client_tag_hash(
+      server_.bookmarks_migrated_to_client_tag_hash_);
+  header.set_last_version_assigned(server_.version_);
+  for (const std::vector<uint8_t>& key : server_.keystore_keys_) {
+    header.add_keystore_keys(key.data(), key.size());
+  }
+  if (!snapshot) {
+    for (const std::string& id : removed_entity_ids_) {
+      header.add_removed_entity_ids(id);
+    }
+  }
+
+  WriterOutput sink(writer);
+  CopyingOutputStreamAdaptor stream(&sink);
+  if (!WriteRecord(stream, header)) {
+    return false;
+  }
+  for (const auto& [id, entity] : server_.entities_) {
+    if (!snapshot && entity->GetVersion() <= written_version_) {
+      continue;
+    }
+    sync_pb::LoopbackServerEntity record;
+    entity->SerializeAsLoopbackServerEntity(&record);
+    if (!WriteRecord(stream, record)) {
+      return false;
+    }
+  }
+  return stream.Flush();
+}
+
