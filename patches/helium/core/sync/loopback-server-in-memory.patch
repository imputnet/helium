+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+syntax = "proto2";
+
+option optimize_for = LITE_RUNTIME;
+
+package sync_pb;
+
+// A vault payload is a length-delimited header followed by length-delimited
+// LoopbackServerEntity records. Each record replaces the entity with its ID.
+message LoopbackServerStateHeader {
+  optional uint32 format_version = 1;
+  // Whether the payload replaces the complete state rather than updating it.
+  optional bool snapshot = 2;
+  optional int64 store_birthday = 3;
+  optional int64 last_version_assigned = 4;
+  repeated bytes keystore_keys = 5;
+  // Whether bookmarks are identified by client tag hashes.
+  optional bool bookmarks_migrated_to_client_tag_hash = 7;
+  // Entities removed since the previous payload. Applied before the records.
+  repeated string removed_entity_ids = 6;
+}
