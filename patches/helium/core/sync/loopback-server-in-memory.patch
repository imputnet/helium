+#ifndef COMPONENTS_SYNC_ENGINE_LOOPBACK_SERVER_LOOPBACK_SERVER_STATE_DELTA_H_
+#define COMPONENTS_SYNC_ENGINE_LOOPBACK_SERVER_LOOPBACK_SERVER_STATE_DELTA_H_
+
+#include <cstdint>
+#include <set>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/functional/function_ref.h"
+#include "components/sync/engine/loopback_server/loopback_server.h"
+
+namespace syncer {
+
+// A LoopbackServer whose state is stored as a sequence of payloads: complete
+// snapshots, and deltas holding the entities whose version changed since the
+// previous payload.
+class LoopbackServerVaultState {
+ public:
+  // Returns the next part of a payload, or an empty span at its end. The span
+  // must remain valid until the next call.
+  using Reader = base::FunctionRef<base::span<const uint8_t>()>;
+  // Consumes the next part of a payload; returns false to abort writing.
+  using Writer = base::FunctionRef<bool(base::span<const uint8_t>)>;
+
+  enum class ReadResult {
+    kSuccess,
+    kMalformed,
+    kUnsupportedVersion,
+  };
+
+  LoopbackServerVaultState();
+  LoopbackServerVaultState(const LoopbackServerVaultState&) = delete;
+  LoopbackServerVaultState& operator=(const LoopbackServerVaultState&) = delete;
+  ~LoopbackServerVaultState();
+
+  LoopbackServer& server() { return server_; }
+  size_t entity_count() const { return server_.entities_.size(); }
+
+  // Whether the server changed since the last payload was read or written.
+  bool HasChanges() const;
+  // Whether the changes must be written as a snapshot.
+  bool RequiresSnapshot() const;
+
+  // Applies a snapshot, or a delta when `snapshot` is false. The state must be
+  // discarded on failure.
+  ReadResult Read(Reader reader, bool snapshot);
+  // Writes a snapshot or delta. Call MarkWritten() once it has been stored.
+  bool WriteSnapshot(Writer writer) const;
+  bool WriteDelta(Writer writer) const;
+  void MarkWritten();
+
+ private:
+  bool Write(bool snapshot, Writer writer) const;
+
+  LoopbackServer server_;
+  // The state at the last payload. A new server has none, so its first
+  // payload is a snapshot.
+  int64_t written_birthday_ = 0;
+  int64_t written_version_ = 0;
+  std::set<std::string> removed_entity_ids_;
+};
+
+}  // namespace syncer
+
+#endif  // COMPONENTS_SYNC_ENGINE_LOOPBACK_SERVER_LOOPBACK_SERVER_STATE_DELTA_H_
