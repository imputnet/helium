@@ -146,6 +146,23 @@ LoopbackServerVaultState::LoopbackServer
 
 LoopbackServerVaultState::~LoopbackServerVaultState() = default;
 
+void LoopbackServerVaultState::CollectGarbage(base::Time history_cutoff) {
+  const int64_t cutoff_micros =
+      history_cutoff.ToDeltaSinceWindowsEpoch().InMicroseconds();
+  std::erase_if(server_.entities_, [&](const auto& entry) {
+    const LoopbackServerEntity& entity = *entry.second;
+    if (entity.GetDataType() != HISTORY || entity.IsDeleted()) {
+      return false;
+    }
+    const std::optional<int64_t> visit_time = entity.GetHistoryVisitTime();
+    if (visit_time && *visit_time >= cutoff_micros) {
+      return false;
+    }
+    removed_entity_ids_.insert(entry.first);
+    return true;
+  });
+}
+
 bool LoopbackServerVaultState::HasChanges() const {
   return RequiresSnapshot() || server_.version_ != written_version_ ||
          !removed_entity_ids_.empty();
