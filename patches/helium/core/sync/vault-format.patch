+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+syntax = "proto2";
+
+option optimize_for = LITE_RUNTIME;
+
+package sync_pb;
+
+// The only mutable object. It names the latest commit.
+message SyncVaultHead {
+  optional uint32 format_version = 1;
+  // Absent only for an initialized vault with no commits.
+  optional bytes commit_digest = 2;
+}
+
+// An immutable commit. The first commit of each epoch holds a snapshot of
+// the state; later commits in the epoch hold deltas.
+message SyncVaultCommit {
+  optional uint32 format_version = 1;
+  optional uint64 generation = 2;
+  // Absent only for generation one.
+  optional bytes parent_commit_digest = 3;
+  optional uint32 epoch = 4;
+  optional uint64 epoch_start_generation = 5;
+  // Commits before this generation may have been collected.
+  optional uint64 minimum_retained_generation = 6;
+  // Plaintext bytes of the epoch's snapshot, and of its later deltas so far.
+  optional uint64 epoch_snapshot_bytes = 7;
+  optional uint64 epoch_delta_bytes = 8;
+  // Small payloads are stored in the commit itself, others in encrypted
+  // chunks named by their digests.
+  optional bytes inline_payload = 9;
+  repeated bytes payload_chunk_digests = 10;
+}
+
+// The last authenticated commit, kept in local state to detect rollbacks and
+// forks.
+message SyncVaultCheckpoint {
+  optional uint32 format_version = 1;
+  optional string vault_uuid = 2;
+  optional uint64 generation = 3;
+  optional bytes commit_digest = 4;
+}
