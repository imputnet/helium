+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/sync/engine/sync_vault/sync_vault_format.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/uuid.h"
+
+namespace syncer {
+
+namespace {
+
+bool IsDigest(std::string_view value) {
+  return value.size() == kSyncVaultObjectDigestBytes;
+}
+
+template <typename Message>
+base::expected<Message, SyncVaultFormatError> Parse(
+    base::span<const uint8_t> serialized) {
+  Message message;
+  if (!message.ParseFromArray(serialized.data(), serialized.size()) ||
+      !message.has_format_version()) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  if (message.format_version() != kSyncVaultFormatVersion) {
+    return base::unexpected(SyncVaultFormatError::kUnsupportedVersion);
+  }
+  return message;
+}
+
+}  // namespace
+
+base::expected<sync_pb::SyncVaultHead, SyncVaultFormatError> ParseSyncVaultHead(
+    base::span<const uint8_t> serialized) {
+  auto head = Parse<sync_pb::SyncVaultHead>(serialized);
+  if (head.has_value() && head->has_commit_digest() &&
+      !IsDigest(head->commit_digest())) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  return head;
+}
+
+base::expected<sync_pb::SyncVaultCommit, SyncVaultFormatError>
+ParseSyncVaultCommit(base::span<const uint8_t> serialized) {
+  auto commit = Parse<sync_pb::SyncVaultCommit>(serialized);
+  if (!commit.has_value()) {
+    return commit;
+  }
+  const bool has_parent = commit->generation() > 1;
+  // The retention floor is the previous epoch's start.
+  const bool has_previous_epoch = commit->epoch() > 0;
+  bool valid = commit->generation() > 0 &&
+               commit->epoch_start_generation() > 0 &&
+               commit->epoch_start_generation() <= commit->generation() &&
+               // Each earlier epoch started at a generation of its own.
+               commit->epoch() < commit->epoch_start_generation() &&
+               has_previous_epoch ==
+                   (commit->minimum_retained_generation() > 0) &&
+               commit->minimum_retained_generation() <
+                   commit->epoch_start_generation() &&
+               has_parent == commit->has_parent_commit_digest() &&
+               (!has_parent || IsDigest(commit->parent_commit_digest())) &&
+               commit->has_inline_payload() !=
+                   (commit->payload_chunk_digests_size() > 0);
+  for (const std::string& digest : commit->payload_chunk_digests()) {
+    valid = valid && IsDigest(digest);
+  }
+  if (!valid) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  return commit;
+}
+
+std::optional<sync_pb::SyncVaultCheckpoint> ParseSyncVaultCheckpoint(
+    std::string_view serialized) {
+  sync_pb::SyncVaultCheckpoint checkpoint;
+  if (!checkpoint.ParseFromString(serialized) ||
+      checkpoint.format_version() != kSyncVaultFormatVersion ||
+      !base::Uuid::ParseLowercase(checkpoint.vault_uuid()).is_valid() ||
+      (checkpoint.generation() > 0) != IsDigest(checkpoint.commit_digest())) {
+    return std::nullopt;
+  }
+  return checkpoint;
+}
+
+bool IsValidSyncVaultCommitTransition(std::string_view parent_digest,
+                                      const sync_pb::SyncVaultCommit& parent,
+                                      const sync_pb::SyncVaultCommit& child) {
+  if (child.generation() != parent.generation() + 1 ||
+      child.parent_commit_digest() != parent_digest) {
+    return false;
+  }
+  if (child.epoch() == parent.epoch()) {
+    return child.epoch_start_generation() == parent.epoch_start_generation() &&
+           child.minimum_retained_generation() ==
+               parent.minimum_retained_generation();
+  }
+
+  return child.epoch() == parent.epoch() + 1 &&
+         child.epoch_start_generation() == child.generation() &&
+         child.minimum_retained_generation() ==
+             parent.epoch_start_generation();
+}
+
+std::string GetSyncVaultObjectId(std::string_view digest) {
+  return base::HexEncode(digest);
+}
+
+}  // namespace syncer
