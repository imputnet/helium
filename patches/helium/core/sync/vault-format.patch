+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/sync/engine/sync_vault/sync_vault_format.h"
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/numerics/checked_math.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/uuid.h"
+#include "components/sync/engine/sync_vault/sync_vault.pb.h"
+
+namespace syncer {
+
+namespace {
+
+bool IsValidVaultUuid(const std::string& vault_uuid) {
+  return base::Uuid::ParseLowercase(vault_uuid).is_valid();
+}
+
+std::optional<SyncVaultObjectDigest> ParseObjectDigest(
+    std::string_view serialized) {
+  if (serialized.size() != kSyncVaultObjectDigestBytes) {
+    return std::nullopt;
+  }
+  SyncVaultObjectDigest digest;
+  base::span(digest.bytes).copy_from(base::as_byte_span(serialized));
+  return digest;
+}
+
+bool IsValidCheckpoint(const SyncVaultCheckpoint& checkpoint) {
+  return IsValidVaultUuid(checkpoint.vault_uuid) &&
+         ((checkpoint.generation == 0 && !checkpoint.commit_digest) ||
+          (checkpoint.generation > 0 && checkpoint.commit_digest));
+}
+
+uint64_t PayloadPlaintextSize(const SyncVaultCommit& commit) {
+  if (!commit.inline_payload.empty()) {
+    return commit.inline_payload.size();
+  }
+  return commit.external_payload_size;
+}
+
+bool IsValidCommit(const SyncVaultCommit& commit) {
+  const SyncVaultCommitHeader& header = commit.header;
+  if (header.generation == 0 || header.epoch_start_generation == 0 ||
+      header.epoch_start_generation > header.generation ||
+      header.epoch >= header.epoch_start_generation ||
+      header.minimum_retained_generation > header.epoch_start_generation ||
+      header.epoch_payload_bytes == 0 ||
+      (commit.inline_payload.empty() == commit.payload_chunk_digests.empty())) {
+    return false;
+  }
+  if ((header.generation == 1 &&
+       (commit.parent_commit_digest || header.epoch != 0 ||
+        header.epoch_start_generation != 1)) ||
+      (header.generation > 1 && !commit.parent_commit_digest)) {
+    return false;
+  }
+  if ((header.epoch <= 1 && header.minimum_retained_generation != 0) ||
+      (header.epoch > 1 &&
+       (header.minimum_retained_generation == 0 ||
+        header.minimum_retained_generation >= header.epoch_start_generation))) {
+    return false;
+  }
+  if (!commit.inline_payload.empty()) {
+    return commit.external_payload_size == 0 &&
+           commit.inline_payload.size() <=
+               kSyncVaultMaximumCommitPlaintextBytes &&
+           header.epoch_payload_bytes >= commit.inline_payload.size() &&
+           (header.generation != header.epoch_start_generation ||
+            header.epoch_payload_bytes == commit.inline_payload.size());
+  }
+
+  if (commit.external_payload_size == 0 ||
+      commit.payload_chunk_digests.size() !=
+          1 + (commit.external_payload_size - 1) /
+                  kSyncVaultMaximumPayloadPlaintextBytes) {
+    return false;
+  }
+  std::set<SyncVaultObjectDigest> object_digests;
+  for (const SyncVaultObjectDigest& digest : commit.payload_chunk_digests) {
+    if (!object_digests.insert(digest).second) {
+      return false;
+    }
+  }
+  const uint64_t payload_bytes = commit.external_payload_size;
+  return header.epoch_payload_bytes >= payload_bytes &&
+         (header.generation != header.epoch_start_generation ||
+          header.epoch_payload_bytes == payload_bytes);
+}
+
+template <typename Message>
+SyncVaultSerializeResult SerializeProto(const Message& message,
+                                        size_t maximum_bytes) {
+  const size_t size = message.ByteSizeLong();
+  if (size > maximum_bytes) {
+    return base::unexpected(SyncVaultFormatError::kLimitExceeded);
+  }
+  std::vector<uint8_t> serialized(size);
+  if (!message.SerializeToArray(serialized.data(),
+                                base::checked_cast<int>(size))) {
+    return base::unexpected(SyncVaultFormatError::kInvalidValue);
+  }
+  return serialized;
+}
+
+template <typename Message>
+base::expected<void, SyncVaultFormatError> ParseProto(
+    base::span<const uint8_t> serialized,
+    size_t maximum_bytes,
+    Message* message) {
+  if (serialized.size() > maximum_bytes) {
+    return base::unexpected(SyncVaultFormatError::kLimitExceeded);
+  }
+  if (!message->ParseFromArray(serialized.data(),
+                               base::checked_cast<int>(serialized.size()))) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  return base::ok();
+}
+
+SyncVaultFormatError VersionError(uint32_t version) {
+  return version == kSyncVaultFormatVersion
+             ? SyncVaultFormatError::kMalformed
+             : SyncVaultFormatError::kUnsupportedVersion;
+}
+
+}  // namespace
+
+std::string GetSyncVaultImmutableObjectId(const SyncVaultObjectDigest& digest) {
+  return base::HexEncode(digest.bytes);
+}
+
+SyncVaultSerializeResult SerializeSyncVaultHead(const SyncVaultHead& head) {
+  sync_pb::SyncVaultHead proto;
+  proto.set_format_version(kSyncVaultFormatVersion);
+  if (head.commit_digest) {
+    proto.set_commit_digest(head.commit_digest->bytes.data(),
+                            head.commit_digest->bytes.size());
+  }
+  return SerializeProto(proto, kSyncVaultMaximumMetadataPlaintextBytes);
+}
+
+SyncVaultParseResult<SyncVaultHead> ParseSyncVaultHead(
+    base::span<const uint8_t> serialized) {
+  sync_pb::SyncVaultHead proto;
+  auto parsed =
+      ParseProto(serialized, kSyncVaultMaximumMetadataPlaintextBytes, &proto);
+  if (!parsed.has_value()) {
+    return base::unexpected(parsed.error());
+  }
+  if (!proto.has_format_version()) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  if (proto.format_version() != kSyncVaultFormatVersion) {
+    return base::unexpected(VersionError(proto.format_version()));
+  }
+  std::optional<SyncVaultObjectDigest> commit_digest;
+  if (proto.has_commit_digest()) {
+    commit_digest = ParseObjectDigest(proto.commit_digest());
+    if (!commit_digest) {
+      return base::unexpected(SyncVaultFormatError::kInvalidValue);
+    }
+  }
+  return SyncVaultHead{std::move(commit_digest)};
+}
+
+SyncVaultSerializeResult SerializeSyncVaultCommit(
+    const SyncVaultCommit& commit) {
+  if (!IsValidCommit(commit)) {
+    return base::unexpected(SyncVaultFormatError::kInvalidValue);
+  }
+  sync_pb::SyncVaultCommit proto;
+  proto.set_format_version(kSyncVaultFormatVersion);
+  proto.set_generation(commit.header.generation);
+  if (commit.parent_commit_digest) {
+    proto.set_parent_commit_digest(commit.parent_commit_digest->bytes.data(),
+                                   commit.parent_commit_digest->bytes.size());
+  }
+  proto.set_epoch(commit.header.epoch);
+  proto.set_epoch_start_generation(commit.header.epoch_start_generation);
+  proto.set_minimum_retained_generation(
+      commit.header.minimum_retained_generation);
+  proto.set_epoch_payload_bytes(commit.header.epoch_payload_bytes);
+  if (!commit.inline_payload.empty()) {
+    proto.set_inline_payload(commit.inline_payload.data(),
+                             commit.inline_payload.size());
+  }
+  for (const SyncVaultObjectDigest& digest : commit.payload_chunk_digests) {
+    proto.add_payload_chunk_digests(digest.bytes.data(), digest.bytes.size());
+  }
+  if (!commit.payload_chunk_digests.empty()) {
+    proto.set_external_payload_size(commit.external_payload_size);
+  }
+  return SerializeProto(proto, kSyncVaultMaximumCommitPlaintextBytes);
+}
+
+SyncVaultParseResult<SyncVaultCommit> ParseSyncVaultCommit(
+    base::span<const uint8_t> serialized) {
+  sync_pb::SyncVaultCommit proto;
+  auto parsed =
+      ParseProto(serialized, kSyncVaultMaximumCommitPlaintextBytes, &proto);
+  if (!parsed.has_value()) {
+    return base::unexpected(parsed.error());
+  }
+  if (!proto.has_format_version() || !proto.has_generation() ||
+      !proto.has_epoch() || !proto.has_epoch_start_generation() ||
+      !proto.has_minimum_retained_generation() ||
+      !proto.has_epoch_payload_bytes()) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  if (proto.format_version() != kSyncVaultFormatVersion) {
+    return base::unexpected(VersionError(proto.format_version()));
+  }
+  const bool has_external_payload = proto.payload_chunk_digests_size() > 0;
+  if (proto.has_inline_payload() == has_external_payload ||
+      proto.has_external_payload_size() != has_external_payload) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  SyncVaultCommit commit;
+  commit.header.generation = proto.generation();
+  if (proto.has_parent_commit_digest()) {
+    commit.parent_commit_digest =
+        ParseObjectDigest(proto.parent_commit_digest());
+    if (!commit.parent_commit_digest) {
+      return base::unexpected(SyncVaultFormatError::kInvalidValue);
+    }
+  }
+  commit.header.epoch = proto.epoch();
+  commit.header.epoch_start_generation = proto.epoch_start_generation();
+  commit.header.minimum_retained_generation =
+      proto.minimum_retained_generation();
+  commit.header.epoch_payload_bytes = proto.epoch_payload_bytes();
+  if (proto.has_inline_payload()) {
+    commit.inline_payload.assign(proto.inline_payload().begin(),
+                                 proto.inline_payload().end());
+  }
+  if (proto.has_external_payload_size()) {
+    commit.external_payload_size = proto.external_payload_size();
+  }
+  commit.payload_chunk_digests.reserve(proto.payload_chunk_digests_size());
+  for (const std::string& serialized_digest : proto.payload_chunk_digests()) {
+    std::optional<SyncVaultObjectDigest> object_digest =
+        ParseObjectDigest(serialized_digest);
+    if (!object_digest) {
+      return base::unexpected(SyncVaultFormatError::kInvalidValue);
+    }
+    commit.payload_chunk_digests.push_back(std::move(*object_digest));
+  }
+  if (!IsValidCommit(commit)) {
+    return base::unexpected(SyncVaultFormatError::kInvalidValue);
+  }
+  return commit;
+}
+
+bool IsValidSyncVaultCommitTransition(
+    const SyncVaultObjectDigest& parent_digest,
+    const SyncVaultCommitHeader& parent,
+    const SyncVaultCommit& child) {
+  if (parent.generation == std::numeric_limits<uint64_t>::max() ||
+      child.header.generation != parent.generation + 1 ||
+      child.parent_commit_digest != parent_digest) {
+    return false;
+  }
+
+  if (child.header.epoch == parent.epoch) {
+    const uint64_t child_payload_bytes = PayloadPlaintextSize(child);
+    base::CheckedNumeric<uint64_t> expected_epoch_payload_bytes =
+        parent.epoch_payload_bytes;
+    expected_epoch_payload_bytes += child_payload_bytes;
+    return expected_epoch_payload_bytes.IsValid() &&
+           child.header.generation > child.header.epoch_start_generation &&
+           child.header.epoch_start_generation ==
+               parent.epoch_start_generation &&
+           child.header.minimum_retained_generation ==
+               parent.minimum_retained_generation &&
+           child.header.epoch_payload_bytes ==
+               expected_epoch_payload_bytes.ValueOrDie();
+  }
+
+  return parent.epoch != std::numeric_limits<uint32_t>::max() &&
+         child.header.epoch == parent.epoch + 1 &&
+         child.header.epoch_start_generation == child.header.generation &&
+         child.header.minimum_retained_generation ==
+             (child.header.epoch <= 1 ? 0 : parent.epoch_start_generation);
+}
+
+SyncVaultSerializeResult SerializeSyncVaultCheckpoint(
+    const SyncVaultCheckpoint& checkpoint) {
+  if (!IsValidCheckpoint(checkpoint)) {
+    return base::unexpected(SyncVaultFormatError::kInvalidValue);
+  }
+  sync_pb::SyncVaultCheckpoint proto;
+  proto.set_format_version(kSyncVaultFormatVersion);
+  proto.set_vault_uuid(checkpoint.vault_uuid);
+  proto.set_generation(checkpoint.generation);
+  if (checkpoint.commit_digest) {
+    proto.set_commit_digest(checkpoint.commit_digest->bytes.data(),
+                            checkpoint.commit_digest->bytes.size());
+  }
+  return SerializeProto(proto, kSyncVaultMaximumMetadataPlaintextBytes);
+}
+
+SyncVaultParseResult<SyncVaultCheckpoint> ParseSyncVaultCheckpoint(
+    base::span<const uint8_t> serialized) {
+  sync_pb::SyncVaultCheckpoint proto;
+  auto parsed =
+      ParseProto(serialized, kSyncVaultMaximumMetadataPlaintextBytes, &proto);
+  if (!parsed.has_value()) {
+    return base::unexpected(parsed.error());
+  }
+  if (!proto.has_format_version() || !proto.has_vault_uuid() ||
+      !proto.has_generation()) {
+    return base::unexpected(SyncVaultFormatError::kMalformed);
+  }
+  if (proto.format_version() != kSyncVaultFormatVersion) {
+    return base::unexpected(VersionError(proto.format_version()));
+  }
+  std::optional<SyncVaultObjectDigest> commit_digest;
+  if (proto.has_commit_digest()) {
+    commit_digest = ParseObjectDigest(proto.commit_digest());
+    if (!commit_digest) {
+      return base::unexpected(SyncVaultFormatError::kInvalidValue);
+    }
+  }
+  SyncVaultCheckpoint checkpoint{proto.vault_uuid(), proto.generation(),
+                                 std::move(commit_digest)};
+  if (!IsValidCheckpoint(checkpoint)) {
+    return base::unexpected(SyncVaultFormatError::kInvalidValue);
+  }
+  return checkpoint;
+}
+
+SyncVaultHistoryValidationResult ValidateSyncVaultHistory(
+    const SyncVaultCheckpoint& checkpoint,
+    const SyncVaultCommit& candidate_commit,
+    const SyncVaultObjectDigest& candidate_commit_digest,
+    base::span<const AuthenticatedSyncVaultCommit> newest_first_ancestry) {
+  if (!IsValidCheckpoint(checkpoint) || !IsValidCommit(candidate_commit) ||
+      newest_first_ancestry.size() > kSyncVaultMaximumCommitAncestry) {
+    return SyncVaultHistoryValidationResult::kInvalidHistory;
+  }
+  if (candidate_commit.header.generation < checkpoint.generation) {
+    return SyncVaultHistoryValidationResult::kRollback;
+  }
+  if (candidate_commit.header.generation == checkpoint.generation) {
+    if (!newest_first_ancestry.empty()) {
+      return SyncVaultHistoryValidationResult::kInvalidHistory;
+    }
+    return checkpoint.commit_digest == candidate_commit_digest
+               ? SyncVaultHistoryValidationResult::kAcceptCurrent
+               : SyncVaultHistoryValidationResult::kFork;
+  }
+  if (checkpoint.generation == 0 ||
+      checkpoint.generation <
+          candidate_commit.header.minimum_retained_generation) {
+    return newest_first_ancestry.empty()
+               ? SyncVaultHistoryValidationResult::kAcceptBaseline
+               : SyncVaultHistoryValidationResult::kInvalidHistory;
+  }
+
+  uint64_t expected_generation = candidate_commit.header.generation;
+  SyncVaultObjectDigest expected_commit_digest = candidate_commit_digest;
+  for (size_t index = 0; index < newest_first_ancestry.size(); ++index) {
+    const AuthenticatedSyncVaultCommit& commit = newest_first_ancestry[index];
+    if (commit.generation != expected_generation ||
+        commit.commit_digest != expected_commit_digest) {
+      return SyncVaultHistoryValidationResult::kInvalidHistory;
+    }
+    if (expected_generation == checkpoint.generation + 1) {
+      if (index + 1 != newest_first_ancestry.size()) {
+        return SyncVaultHistoryValidationResult::kInvalidHistory;
+      }
+      return commit.parent_commit_digest == checkpoint.commit_digest
+                 ? SyncVaultHistoryValidationResult::kAcceptDescendant
+                 : SyncVaultHistoryValidationResult::kFork;
+    }
+    if (!commit.parent_commit_digest) {
+      return SyncVaultHistoryValidationResult::kInvalidHistory;
+    }
+    expected_generation--;
+    expected_commit_digest = *commit.parent_commit_digest;
+  }
+  return SyncVaultHistoryValidationResult::kIncompleteHistory;
+}
+
+}  // namespace syncer
