+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_SYNC_ENGINE_SYNC_VAULT_SYNC_VAULT_FORMAT_H_
+#define COMPONENTS_SYNC_ENGINE_SYNC_VAULT_SYNC_VAULT_FORMAT_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+#include "components/sync/engine/sync_vault/sync_vault_limits.h"
+
+namespace syncer {
+
+inline constexpr uint32_t kSyncVaultFormatVersion = 1;
+inline constexpr size_t kSyncVaultObjectDigestBytes = 32;
+inline constexpr uint64_t kSyncVaultEpochCommitTarget = 64;
+inline constexpr size_t kSyncVaultMaximumCommitAncestry =
+    2 * kSyncVaultEpochCommitTarget;
+
+struct SyncVaultObjectDigest {
+  std::array<uint8_t, kSyncVaultObjectDigestBytes> bytes{};
+
+  auto operator<=>(const SyncVaultObjectDigest&) const = default;
+};
+
+enum class SyncVaultFormatError {
+  kMalformed,
+  kUnsupportedVersion,
+  kLimitExceeded,
+  kInvalidValue,
+};
+
+// The fixed mutable head publishes one complete immutable commit. A missing
+// digest represents an initialized vault with no commits.
+struct SyncVaultHead {
+  std::optional<SyncVaultObjectDigest> commit_digest;
+
+  bool operator==(const SyncVaultHead&) const = default;
+};
+
+// Fields needed to construct and validate the next commit. Loaded state keeps
+// this header without retaining the commit's transient payload references.
+struct SyncVaultCommitHeader {
+  uint64_t generation = 0;
+  uint32_t epoch = 0;
+  uint64_t epoch_start_generation = 0;
+  uint64_t minimum_retained_generation = 0;
+  uint64_t epoch_payload_bytes = 0;
+
+  bool operator==(const SyncVaultCommitHeader&) const = default;
+};
+
+// One immutable journal commit. The first commit in each epoch contains a
+// complete state snapshot; later commits contain semantic deltas. The payload
+// is inline unless it is too large for the commit object.
+struct SyncVaultCommit {
+  SyncVaultCommitHeader header;
+  std::optional<SyncVaultObjectDigest> parent_commit_digest;
+  std::vector<uint8_t> inline_payload;
+  uint32_t external_payload_size = 0;
+  std::vector<SyncVaultObjectDigest> payload_chunk_digests;
+
+  bool operator==(const SyncVaultCommit&) const = default;
+};
+
+// This is stored only in OS-protected local state. It is updated after
+// the corresponding head and ancestry have authenticated successfully.
+struct SyncVaultCheckpoint {
+  std::string vault_uuid;
+  uint64_t generation = 0;
+  std::optional<SyncVaultObjectDigest> commit_digest;
+
+  bool operator==(const SyncVaultCheckpoint&) const = default;
+};
+
+using SyncVaultSerializeResult =
+    base::expected<std::vector<uint8_t>, SyncVaultFormatError>;
+template <typename T>
+using SyncVaultParseResult = base::expected<T, SyncVaultFormatError>;
+
+SyncVaultSerializeResult SerializeSyncVaultHead(const SyncVaultHead& head);
+SyncVaultParseResult<SyncVaultHead> ParseSyncVaultHead(
+    base::span<const uint8_t> serialized);
+
+SyncVaultSerializeResult SerializeSyncVaultCommit(
+    const SyncVaultCommit& commit);
+SyncVaultParseResult<SyncVaultCommit> ParseSyncVaultCommit(
+    base::span<const uint8_t> serialized);
+
+// Returns whether `child` can immediately follow `parent`. Both commits must
+// already have passed their individual format validation, and `parent_digest`
+// is the authenticated digest from which `parent` was loaded.
+bool IsValidSyncVaultCommitTransition(
+    const SyncVaultObjectDigest& parent_digest,
+    const SyncVaultCommitHeader& parent,
+    const SyncVaultCommit& child);
+
+SyncVaultSerializeResult SerializeSyncVaultCheckpoint(
+    const SyncVaultCheckpoint& checkpoint);
+SyncVaultParseResult<SyncVaultCheckpoint> ParseSyncVaultCheckpoint(
+    base::span<const uint8_t> serialized);
+
+// Provider object identifiers are canonical encodings of internal ciphertext
+// digests. The provider scopes them by the separately supplied vault UUID.
+std::string GetSyncVaultImmutableObjectId(const SyncVaultObjectDigest& digest);
+
+struct AuthenticatedSyncVaultCommit {
+  SyncVaultObjectDigest commit_digest;
+  uint64_t generation = 0;
+  std::optional<SyncVaultObjectDigest> parent_commit_digest;
+};
+
+enum class SyncVaultHistoryValidationResult {
+  // The candidate is the same generation and record as the checkpoint
+  // Accept it without advancing the checkpoint.
+  kAcceptCurrent,
+  // The ancestry links the newer candidate to the checkpoint.
+  // Accept it and advance the checkpoint after loading its state.
+  kAcceptDescendant,
+  // There is no retained checkpoint commit against which to compare the
+  // candidate. Accept it as the new baseline and advance the checkpoint.
+  kAcceptBaseline,
+  // The candidate generation is older than the checkpoint. Reject and
+  // report a rollback.
+  kRollback,
+  // The candidate conflicts with or does not descend from the
+  // checkpoint. Reject and report a divergent history.
+  kFork,
+  // More ancestry is needed before the candidate can be classified.
+  // Retry after the missing history may have become available.
+  kIncompleteHistory,
+  // The checkpoint, head, or supplied ancestry is structurally
+  // inconsistent. Reject as malformed.
+  kInvalidHistory,
+};
+
+SyncVaultHistoryValidationResult ValidateSyncVaultHistory(
+    const SyncVaultCheckpoint& checkpoint,
+    const SyncVaultCommit& candidate_commit,
+    const SyncVaultObjectDigest& candidate_commit_digest,
+    base::span<const AuthenticatedSyncVaultCommit> newest_first_ancestry);
+
