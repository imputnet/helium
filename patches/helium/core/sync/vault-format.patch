+#ifndef COMPONENTS_SYNC_ENGINE_SYNC_VAULT_SYNC_VAULT_LIMITS_H_
+#define COMPONENTS_SYNC_ENGINE_SYNC_VAULT_SYNC_VAULT_LIMITS_H_
+
+#include <cstddef>
+#include <string_view>
+
+namespace syncer {
+
+// Limits shared by the encrypted vault format and its provider API.
+inline constexpr size_t kSyncVaultContainerOverheadBytes = 28;
+inline constexpr size_t kSyncVaultMaximumEncryptedObjectBytes =
+    16 * 1024 * 1024;
+// Object identifiers are browser-owned fixed names or hexadecimal SHA-256
+// digests.
+inline constexpr size_t kSyncVaultMaximumObjectIdBytes = 64;
+inline constexpr size_t kSyncVaultMaximumRevisionBytes = 4096;
+inline constexpr size_t kSyncVaultMaximumMetadataPlaintextBytes =
+    64 * 1024 - kSyncVaultContainerOverheadBytes;
+inline constexpr size_t kSyncVaultMaximumCommitPlaintextBytes =
+    4 * 1024 * 1024 - kSyncVaultContainerOverheadBytes;
+inline constexpr size_t kSyncVaultMaximumPayloadPlaintextBytes =
+    kSyncVaultMaximumEncryptedObjectBytes - kSyncVaultContainerOverheadBytes;
+
+inline constexpr bool IsValidSyncVaultObjectId(std::string_view value) {
+  return !value.empty() && value.size() <= kSyncVaultMaximumObjectIdBytes;
+}
+
+inline constexpr bool IsValidSyncVaultRevision(std::string_view value) {
+  return !value.empty() && value.size() <= kSyncVaultMaximumRevisionBytes;
+}
+
+}  // namespace syncer
