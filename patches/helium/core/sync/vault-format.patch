+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+syntax = "proto2";
+
+option optimize_for = LITE_RUNTIME;
+
+package sync_pb;
+
+message SyncVaultHead {
+  optional uint32 format_version = 1;
+  // Absent only for an initialized vault with no commits.
+  optional bytes commit_digest = 2;
+}
+
+message SyncVaultCommit {
+  optional uint32 format_version = 1;
+  optional uint64 generation = 2;
+  // Absent only for generation one.
+  optional bytes parent_commit_digest = 3;
+  optional uint32 epoch = 4;
+  optional uint64 epoch_start_generation = 5;
+  optional uint64 minimum_retained_generation = 6;
+  // Cumulative plaintext payload bytes committed in this epoch.
+  optional uint64 epoch_payload_bytes = 7;
+  // Exactly one payload representation is present. Small payloads remain in
+  // this authenticated object; large payloads use encrypted external chunks.
+  optional bytes inline_payload = 8;
+  repeated bytes payload_chunk_digests = 9;
+  optional uint32 external_payload_size = 10;
+}
+
+message SyncVaultCheckpoint {
+  optional uint32 format_version = 1;
+  optional string vault_uuid = 2;
+  optional uint64 generation = 3;
+  optional bytes commit_digest = 4;
+}
