+#include "chrome/browser/ui/webui/sync_internals/private_sync_internals_util.h"
+
+#include <algorithm>
+#include <initializer_list>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/extensions/api/sync_vault_provider/sync_vault_provider_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sync/private_sync/private_sync_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/sync/base/time.h"
+#include "components/sync/engine/sync_status.h"
+#include "components/sync/service/sync_backend_type.h"
+#include "components/sync/service/sync_internals_util.h"
+#include "components/sync/service/sync_service.h"
+#include "extensions/common/extension.h"
+
+namespace {
+
+namespace provider_api = extensions::api::sync_vault_provider;
+
+base::DictValue MakeStat(std::string name,
+                         std::string value,
+                         bool is_good = true) {
+  return base::DictValue()
+      .Set("stat_name", std::move(name))
+      .Set("stat_value", std::move(value))
+      .Set("stat_status", is_good ? "" : "in_bad_state");
+}
+
+base::DictValue MakeSection(std::string title,
+                            bool is_sensitive,
+                            base::ListValue data) {
+  return base::DictValue()
+      .Set("title", std::move(title))
+      .Set("data", std::move(data))
+      .Set("is_sensitive", is_sensitive);
+}
+
+std::string ProviderStateName(
+    std::optional<provider_api::ProviderState> state) {
+  if (!state || *state == provider_api::ProviderState::kNone) {
+    return "UNKNOWN";
+  }
+  return provider_api::ToString(*state);
+}
+
+std::string ReconciliationErrorName(
+    std::optional<browser_sync::private_sync_prefs::ReconciliationError>
+        error) {
+  using Error = browser_sync::private_sync_prefs::ReconciliationError;
+  if (!error) {
+    return "NONE";
+  }
+  switch (*error) {
+    case Error::kAuthenticationRequired:
+      return "AUTHENTICATION_REQUIRED";
+    case Error::kConflict:
+      return "CONFLICT";
+    case Error::kNetwork:
+      return "NETWORK";
+    case Error::kTemporary:
+      return "TEMPORARY";
+    case Error::kQuotaExceeded:
+      return "QUOTA_EXCEEDED";
+    case Error::kAccessDenied:
+      return "ACCESS_DENIED";
+    case Error::kInvalidData:
+      return "INVALID_DATA";
+    case Error::kUnsupported:
+      return "UNSUPPORTED";
+    case Error::kAborted:
+      return "ABORTED";
+    case Error::kRollback:
+      return "ROLLBACK";
+    case Error::kFork:
+      return "FORK";
+    case Error::kIncompleteHistory:
+      return "INCOMPLETE_HISTORY";
+    case Error::kCheckpointPersistence:
+      return "CHECKPOINT_PERSISTENCE";
+  }
+}
+
+std::string DiagnosticTime(base::Time time) {
+  return time.is_null() ? "Never" : syncer::GetTimeDebugString(time);
+}
+
+}  // namespace
+
+base::DictValue ConstructHeliumSyncInternalsAboutInformation(
+    Profile* profile,
+    syncer::SyncService* service,
+    const std::string& channel) {
+  base::DictValue about_info = syncer::sync_ui_util::ConstructAboutInformation(
+      syncer::sync_ui_util::IncludeSensitiveData(true), service, channel,
+      /*include_account_details=*/false);
+
+  base::ListValue* details = about_info.FindList("details");
+  if (!details) {
+    return about_info;
+  }
+
+  PrefService* prefs = profile->GetPrefs();
+  std::optional<browser_sync::private_sync_prefs::Configuration> configuration =
+      browser_sync::private_sync_prefs::ReadConfiguration(*prefs);
+  std::optional<browser_sync::private_sync_prefs::Diagnostics> diagnostics =
+      browser_sync::private_sync_prefs::ReadDiagnostics(*prefs);
+  if (diagnostics && (!configuration ||
+                      diagnostics->vault_uuid != configuration->vault_uuid)) {
+    diagnostics.reset();
+  }
+
+  extensions::SyncVaultProviderService* provider_service =
+      extensions::SyncVaultProviderServiceFactory::GetForBrowserContext(
+          profile);
+  const extensions::Extension* provider =
+      provider_service ? provider_service->GetSelectedProvider() : nullptr;
+  const bool selected_provider_matches =
+      configuration &&
+      configuration->provider.kind ==
+          browser_sync::private_sync::ProviderKind::kExtension &&
+      provider_service &&
+      provider_service->selected_provider_id() == configuration->provider.id;
+  std::optional<provider_api::ProviderState> provider_state;
+  if (selected_provider_matches) {
+    provider_state = provider_service->selected_provider_state();
+  }
+
+  const bool custom_backend_active =
+      service &&
+      service->GetSyncBackendType() == syncer::SyncBackendType::kCustom;
+  base::ListValue private_sync;
+  private_sync.Append(
+      MakeStat("Backend", configuration ? "Extension provider" : "None"));
+  private_sync.Append(MakeStat(
+      "Status",
+      custom_backend_active
+          ? "Active"
+          : (configuration ? "Configured, inactive" : "Not configured"),
+      !configuration || custom_backend_active));
+  if (configuration) {
+    private_sync.Append(MakeStat("Provider",
+                                 provider && selected_provider_matches
+                                     ? provider->name()
+                                     : "Unavailable",
+                                 provider && selected_provider_matches));
+    private_sync.Append(
+        MakeStat("Provider state", ProviderStateName(provider_state),
+                 provider_state == provider_api::ProviderState::kReady));
+    private_sync.Append(MakeStat(
+        "Key recovery",
+        configuration->key_mode ==
+                browser_sync::private_sync_prefs::KeyMode::kAccountBoundEnvelope
+            ? "Provider account"
+            : "Recovery key"));
+  }
+
+  if (diagnostics) {
+    private_sync.Append(
+        MakeStat("Accepted generation",
+                 base::NumberToString(diagnostics->accepted_generation)));
+    private_sync.Append(MakeStat("Commit digest prefix",
+                                 diagnostics->head_digest_prefix.empty()
+                                     ? "Not available"
+                                     : diagnostics->head_digest_prefix));
+    private_sync.Append(MakeStat(
+        "Entities", diagnostics->state_statistics_available
+                        ? base::NumberToString(diagnostics->entity_count)
+                        : "Not available"));
+    private_sync.Append(
+        MakeStat("State size",
+                 diagnostics->state_statistics_available
+                     ? base::NumberToString(diagnostics->state_bytes) + " bytes"
+                     : "Not available"));
+    private_sync.Append(
+        MakeStat("Last attempt", DiagnosticTime(diagnostics->last_attempt)));
+    private_sync.Append(
+        MakeStat("Last success", DiagnosticTime(diagnostics->last_success)));
+    private_sync.Append(
+        MakeStat("Last error", ReconciliationErrorName(diagnostics->last_error),
+                 !diagnostics->last_error));
+  } else if (configuration) {
+    private_sync.Append(MakeStat("Accepted generation", "Not available"));
+    private_sync.Append(MakeStat("Last attempt", "Never"));
+    private_sync.Append(MakeStat("Last success", "Never"));
+    private_sync.Append(MakeStat("Last error", "NONE"));
+  }
+
+  if (service) {
+    syncer::SyncStatus status;
+    if (service->QueryDetailedSyncStatusForDebugging(&status) &&
+        status.retry_time > base::Time::Now()) {
+      private_sync.Append(
+          MakeStat("Retry delay",
+                   base::NumberToString(
+                       (status.retry_time - base::Time::Now()).InSeconds()) +
+                       " seconds"));
+    } else {
+      private_sync.Append(MakeStat("Retry delay", "None"));
+    }
+  }
+
+  details->Insert(details->begin(),
+                  base::Value(MakeSection("Private Sync",
+                                          /*is_sensitive=*/false,
+                                          std::move(private_sync))));
+  if (configuration) {
+    base::ListValue identifiers;
+    identifiers.Append(MakeStat("Provider kind", "extension"));
+    identifiers.Append(MakeStat("Provider ID", configuration->provider.id));
+    identifiers.Append(MakeStat("Vault UUID", configuration->vault_uuid));
+    details->Insert(details->begin() + 1,
+                    base::Value(MakeSection("Private Sync Identifiers",
+                                            /*is_sensitive=*/true,
+                                            std::move(identifiers))));
+  }
+  return about_info;
+}
