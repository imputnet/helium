+std::optional<std::string> SyncVaultProviderService::Respond(
+    const ExtensionId& provider_id,
+    provider_api::ProviderResponse response) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = pending_requests_.find(response.request_id);
+  if (it == pending_requests_.end() || it->second.provider_id != provider_id) {
+    return "Invalid or expired requestId.";
+  }
+  if (response.success.has_value() == response.failure.has_value()) {
+    return "A response must contain exactly one of success or failure.";
+  }
+  PendingRequest& request = it->second;
+
+  // Configuring continues until the provider is ready.
+  if (request.type == RequestType::kConfigure && response.success) {
+    switch (response.success->configuration_state) {
+      case provider_api::ProviderConfigurationState::kConfiguring:
+        request.timeout->Reset();
+        return std::nullopt;
+      case provider_api::ProviderConfigurationState::kPendingUserAction:
+        // The user may take any time, during which the provider's worker
+        // should not be kept alive.
+        request.timeout->Stop();
+        request.keepalives.clear();
+        for (Observer& observer : observers_) {
+          observer.OnProviderWaitingForUser(provider_id);
+        }
+        return std::nullopt;
+      case provider_api::ProviderConfigurationState::kNone:
+      case provider_api::ProviderConfigurationState::kReady:
+        break;
+    }
+  }
+
+  std::optional<std::string> error;
+  Response result = base::unexpected(Failure{Error::kInvalidData});
+  if (response.failure) {
+    result = base::unexpected(Failure{ToError(response.failure->error)});
+    if (response.failure->message) {
+      result.error().message = SanitizeSyncVaultProviderDisplayText(
+          *response.failure->message, kMaximumFailureMessageBytes);
+    }
+  } else if (std::optional<Result> success =
+                 ToResult(request, std::move(*response.success))) {
+    result = std::move(*success);
+  } else {
+    error = "The response does not contain valid results for the request.";
+  }
+  ResponseCallback callback = std::move(request.callback);
+  pending_requests_.erase(it);
+  std::move(callback).Run(std::move(result));
+  return error;
+}
+
+std::optional<std::string> SyncVaultProviderService::NotifyVaultChanged(
+    const ExtensionId& provider_id,
+    const std::string& vault_uuid) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!IsValidVaultUuid(vault_uuid)) {
+    return "Invalid vaultUuid.";
+  }
+  for (Observer& observer : observers_) {
+    observer.OnVaultChanged(provider_id, vault_uuid);
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> SyncVaultProviderService::NotifyProviderStateChanged(
+    const ExtensionId& provider_id,
+    provider_api::ProviderState state) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  switch (state) {
+    case provider_api::ProviderState::kReady:
+      provider_states_[provider_id] = State::kReady;
+      break;
+    case provider_api::ProviderState::kAuthRequired:
+      provider_states_[provider_id] = State::kAuthRequired;
+      break;
+    case provider_api::ProviderState::kOffline:
+      provider_states_[provider_id] = State::kOffline;
+      break;
+    case provider_api::ProviderState::kQuotaExceeded:
+      provider_states_[provider_id] = State::kQuotaExceeded;
+      break;
+    case provider_api::ProviderState::kNone:
+      return "Invalid state.";
+  }
+  for (Observer& observer : observers_) {
+    observer.OnProvidersChanged();
+  }
+  return std::nullopt;
+}
+
+void SyncVaultProviderService::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  registry_observation_.Reset();
+  auto requests = std::move(pending_requests_);
+  for (auto& [request_id, request] : requests) {
+    std::move(request.callback).Run(base::unexpected(Failure{Error::kAborted}));
+  }
+}
+
+void SyncVaultProviderService::Dispatch(const ExtensionId& provider_id,
+                                        RequestId request_id,
+                                        RequestType type,
+                                        const std::string& event_name,
+                                        base::ListValue args,
+                                        ResponseCallback callback,
+                                        size_t max_bytes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::optional<Error> error;
+  if (!registry_observation_.IsObserving() || !GetProvider(provider_id)) {
+    error = Error::kAborted;
+  } else if (!event_router_->ExtensionHasEventListener(provider_id,
+                                                       event_name)) {
+    error = Error::kUnsupported;
+  }
+  if (error) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(std::move(callback), base::unexpected(Failure{*error})));
+    return;
+  }
+
+  PendingRequest& request = pending_requests_[request_id];
+  request.provider_id = provider_id;
+  request.type = type;
+  request.max_bytes = max_bytes;
+  request.callback = std::move(callback);
+  request.timeout = std::make_unique<base::RetainingOneShotTimer>();
+  request.timeout->Start(
+      FROM_HERE, kRequestTimeout,
+      base::BindRepeating(&SyncVaultProviderService::Cancel,
+                          base::Unretained(this), request_id,
+                          Error::kTemporaryError));
+  auto event =
+      std::make_unique<Event>(events::SYNC_VAULT_PROVIDER_REQUEST, event_name,
+                              std::move(args), browser_context_);
+  event->did_dispatch_callback =
+      base::BindRepeating(&SyncVaultProviderService::OnRequestDispatched,
+                          weak_ptr_factory_.GetWeakPtr(), request_id);
+  event_router_->DispatchEventToExtension(provider_id, std::move(event));
+}
+
+void SyncVaultProviderService::OnRequestDispatched(RequestId request_id,
+                                                   const EventTarget& target) {
+  // Keep the provider's service worker alive until it responds.
+  auto it = pending_requests_.find(request_id);
+  if (it == pending_requests_.end() ||
+      target.service_worker_version_id ==
+          blink::mojom::kInvalidServiceWorkerVersionId) {
+    return;
+  }
+  it->second.keepalives.push_back(std::make_unique<ServiceWorkerKeepalive>(
+      browser_context_,
+      WorkerId{
+          target.extension_id,
+          content::ChildProcessId::FromUnsafeValue(target.render_process_id),
+          target.service_worker_version_id, target.worker_thread_id},
+      content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+      Activity::EVENT, kKeepaliveActivity));
+}
+
+void SyncVaultProviderService::Cancel(RequestId request_id, Error error) {
+  auto it = pending_requests_.find(request_id);
+  if (it == pending_requests_.end()) {
+    return;
+  }
+  const ExtensionId provider_id = it->second.provider_id;
+  ResponseCallback callback = std::move(it->second.callback);
+  pending_requests_.erase(it);
+  if (GetProvider(provider_id) &&
+      event_router_->ExtensionHasEventListener(
+          provider_id, provider_api::OnCancelRequested::kEventName)) {
+    provider_api::RequestCancellation cancellation;
+    cancellation.request_id = request_id;
+    event_router_->DispatchEventToExtension(
+        provider_id, std::make_unique<Event>(
+                         events::SYNC_VAULT_PROVIDER_REQUEST,
+                         provider_api::OnCancelRequested::kEventName,
+                         provider_api::OnCancelRequested::Create(cancellation),
+                         browser_context_));
+  }
+  std::move(callback).Run(base::unexpected(Failure{error}));
+}
+
+std::optional<Host::Result> SyncVaultProviderService::ToResult(
+    const PendingRequest& request,
+    provider_api::ProviderSuccess success) const {
+  Result result;
+  switch (request.type) {
+    case RequestType::kConfigure:
+    case RequestType::kCreateVault:
+    case RequestType::kCollectEpochs:
+      return result;
+    case RequestType::kListVaults:
+      if (!success.vaults) {
+        return std::nullopt;
+      }
+      for (provider_api::VaultInfo& vault : *success.vaults) {
+        std::optional<std::string> name = SanitizeSyncVaultProviderDisplayText(
+            vault.display_name, kMaximumDisplayNameBytes);
+        if (!name || !IsValidVaultUuid(vault.vault_uuid)) {
+          return std::nullopt;
+        }
+        result.vaults.push_back({std::move(vault.vault_uuid), *name});
+      }
+      return result;
+    case RequestType::kReadObject:
+      if (!success.data || success.data->size() > request.max_bytes ||
+          !success.revision ||
+          !syncer::IsValidSyncVaultRevision(*success.revision)) {
+        return std::nullopt;
+      }
+      result.data = std::move(*success.data);
+      result.revision = std::move(*success.revision);
+      return result;
+    case RequestType::kWriteObject:
+      if (!success.revision ||
+          !syncer::IsValidSyncVaultRevision(*success.revision)) {
+        return std::nullopt;
+      }
+      result.revision = std::move(*success.revision);
+      return result;
+    case RequestType::kWrapKey:
+      if (!success.key_envelope || success.key_envelope->empty() ||
+          success.key_envelope->size() >
+              syncer::kSyncVaultMaximumMetadataPlaintextBytes) {
+        return std::nullopt;
+      }
+      result.key_envelope = std::move(*success.key_envelope);
+      return result;
+    case RequestType::kUnwrapKey:
+      if (!success.vault_key ||
+          success.vault_key->size() !=
+              syncer::SyncVaultCryptographer::kVaultKeySize) {
+        return std::nullopt;
+      }
+      result.vault_key = std::move(*success.vault_key);
+      return result;
+  }
+}
+
+const Extension* SyncVaultProviderService::GetProvider(
+    const ExtensionId& provider_id) const {
+  const Extension* extension =
+      extension_registry_->enabled_extensions().GetByID(provider_id);
+  return extension && SyncVaultProviderInfo::Get(extension) ? extension
+                                                            : nullptr;
+}
+
+void SyncVaultProviderService::OnExtensionLoaded(
+    content::BrowserContext* browser_context,
+    const Extension* extension) {
+  if (SyncVaultProviderInfo::Get(extension)) {
+    for (Observer& observer : observers_) {
+      observer.OnProvidersChanged();
+    }
+  }
+}
+
+void SyncVaultProviderService::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const Extension* extension,
+    UnloadedExtensionReason reason) {
+  if (!SyncVaultProviderInfo::Get(extension)) {
+    return;
+  }
+  provider_states_.erase(extension->id());
+  CancelRequests(extension->id());
+  for (Observer& observer : observers_) {
+    observer.OnProvidersChanged();
+  }
+}
