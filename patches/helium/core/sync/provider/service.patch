+bool IsValidVaultUuid(const std::string& value) {
+  return base::Uuid::ParseLowercase(value).is_valid();
+}
+
+Host::Error ToError(provider_api::SyncVaultProviderError error) {
+  switch (error) {
+    case provider_api::SyncVaultProviderError::kAuthRequired:
+      return Host::Error::kAuthRequired;
+    case provider_api::SyncVaultProviderError::kNotFound:
+      return Host::Error::kNotFound;
+    case provider_api::SyncVaultProviderError::kConflict:
+      return Host::Error::kConflict;
+    case provider_api::SyncVaultProviderError::kNetworkError:
+      return Host::Error::kNetworkError;
+    case provider_api::SyncVaultProviderError::kTemporaryError:
+      return Host::Error::kTemporaryError;
+    case provider_api::SyncVaultProviderError::kQuotaExceeded:
+      return Host::Error::kQuotaExceeded;
+    case provider_api::SyncVaultProviderError::kAccessDenied:
+      return Host::Error::kAccessDenied;
+    case provider_api::SyncVaultProviderError::kUnsupported:
+      return Host::Error::kUnsupported;
+    case provider_api::SyncVaultProviderError::kAborted:
+      return Host::Error::kAborted;
+    case provider_api::SyncVaultProviderError::kNone:
+    case provider_api::SyncVaultProviderError::kInvalidData:
+      return Host::Error::kInvalidData;
+  }
+}
