+std::vector<Host::Provider> SyncVaultProviderService::GetProviders() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::vector<Provider> providers;
+  for (const auto& extension : extension_registry_->enabled_extensions()) {
+    const SyncVaultProviderInfo* info =
+        SyncVaultProviderInfo::Get(extension.get());
+    if (!info) {
+      continue;
+    }
+    Provider provider{
+        Kind::kExtension, extension->id(), extension->name(),
+        ExtensionIconSource::GetIconURL(
+            extension.get(), extension_misc::EXTENSION_ICON_MEDIUM,
+            ExtensionIconSet::Match::kBigger, /*grayscale=*/false)};
+    if (info->account_key()) {
+      provider.account_key_reason = info->account_key()->reason;
+    }
+    providers.push_back(std::move(provider));
+  }
+  return providers;
+}
