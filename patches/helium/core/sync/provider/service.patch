+void SyncVaultProviderService::Configure(const std::string& provider_id,
+                                         ResponseCallback callback) {
+  provider_api::ProviderRequest request;
+  request.request_id = NextRequestId();
+  Dispatch(provider_id, request.request_id, RequestType::kConfigure,
+           provider_api::OnConfigureRequested::kEventName,
+           provider_api::OnConfigureRequested::Create(request),
+           std::move(callback));
+}
