+// Hosts private sync providers as extensions that declare the
+// "sync_vault_provider" manifest key: sends them requests as events, and
+// relays their responses and notifications.
+class SyncVaultProviderService : public KeyedService,
+                                 public ExtensionRegistryObserver,
+                                 public browser_sync::PrivateSyncProviderHost {
+ public:
+  explicit SyncVaultProviderService(content::BrowserContext* browser_context);
+  ~SyncVaultProviderService() override;
+  SyncVaultProviderService(const SyncVaultProviderService&) = delete;
+  SyncVaultProviderService& operator=(const SyncVaultProviderService&) = delete;
+
+  // browser_sync::PrivateSyncProviderHost:
+  std::vector<Provider> GetProviders() const override;
+  std::optional<State> GetProviderState(
+      const std::string& provider_id) const override;
+  void Configure(const std::string& provider_id,
+                 ResponseCallback callback) override;
+  void ListVaults(const std::string& provider_id,
+                  ResponseCallback callback) override;
+  void CreateVault(const std::string& provider_id,
+                   const std::string& vault_uuid,
+                   const std::string& name,
+                   ResponseCallback callback) override;
+  void ReadObject(const std::string& provider_id,
+                  const std::string& vault_uuid,
+                  const std::string& object_id,
+                  size_t max_bytes,
+                  ResponseCallback callback) override;
+  void WriteObject(const std::string& provider_id,
+                   const std::string& vault_uuid,
+                   const std::string& object_id,
+                   std::vector<uint8_t> data,
+                   std::optional<std::string> expected_revision,
+                   std::optional<uint32_t> retention_epoch,
+                   ResponseCallback callback) override;
+  void CollectEpochs(const std::string& provider_id,
+                     const std::string& vault_uuid,
+                     uint32_t minimum_retained_epoch,
+                     ResponseCallback callback) override;
+  void WrapKey(const std::string& provider_id,
+               const std::string& vault_uuid,
+               std::vector<uint8_t> vault_key,
+               ResponseCallback callback) override;
+  void UnwrapKey(const std::string& provider_id,
+                 const std::string& vault_uuid,
+                 std::vector<uint8_t> key_envelope,
+                 ResponseCallback callback) override;
+  void CancelRequests(const std::string& provider_id) override;
+  void AddObserver(Observer* observer) override;
+  void RemoveObserver(Observer* observer) override;
+  base::WeakPtr<PrivateSyncProviderHost> GetWeakPtr() override;
+
+  // Called by the extension API; return an error for the caller.
+  std::optional<std::string> Respond(
+      const ExtensionId& provider_id,
+      api::sync_vault_provider::ProviderResponse response);
+  std::optional<std::string> NotifyVaultChanged(const ExtensionId& provider_id,
+                                                const std::string& vault_uuid);
+  std::optional<std::string> NotifyProviderStateChanged(
+      const ExtensionId& provider_id,
+      api::sync_vault_provider::ProviderState state);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  using RequestId = int;
+  enum class RequestType {
+    kConfigure,
+    kListVaults,
+    kCreateVault,
+    kReadObject,
+    kWriteObject,
+    kCollectEpochs,
+    kWrapKey,
+    kUnwrapKey,
+  };
+  struct PendingRequest {
+    PendingRequest();
+    PendingRequest(PendingRequest&&);
+    PendingRequest& operator=(PendingRequest&&);
+    ~PendingRequest();
+
+    ExtensionId provider_id;
+    RequestType type;
+    size_t max_bytes = 0;
+    ResponseCallback callback;
+    // Retains its task when stopped, so that a configure request can resume
+    // its timeout after waiting for the user.
+    std::unique_ptr<base::RetainingOneShotTimer> timeout;
+    std::vector<std::unique_ptr<ServiceWorkerKeepalive>> keepalives;
+  };
+
+  void Dispatch(const ExtensionId& provider_id,
+                RequestId request_id,
+                RequestType type,
+                const std::string& event_name,
+                base::ListValue args,
+                ResponseCallback callback,
+                size_t max_bytes = 0);
+  RequestId NextRequestId() { return next_request_id_++; }
+  void OnRequestDispatched(RequestId request_id, const EventTarget& target);
+  // Fails the request, and tells the provider that it is no longer needed.
+  void Cancel(RequestId request_id, Error error);
+  std::optional<Result> ToResult(
+      const PendingRequest& request,
+      api::sync_vault_provider::ProviderSuccess success) const;
+  const Extension* GetProvider(const ExtensionId& provider_id) const;
+
+  // ExtensionRegistryObserver:
+  void OnExtensionLoaded(content::BrowserContext* browser_context,
+                         const Extension* extension) override;
+  void OnExtensionUnloaded(content::BrowserContext* browser_context,
+                           const Extension* extension,
+                           UnloadedExtensionReason reason) override;
+
+  raw_ptr<content::BrowserContext> browser_context_;
+  raw_ptr<EventRouter> event_router_;
+  raw_ptr<ExtensionRegistry> extension_registry_;
+  std::map<ExtensionId, State> provider_states_;
+  std::map<RequestId, PendingRequest> pending_requests_;
+  RequestId next_request_id_ = 1;
+  base::ObserverList<Observer> observers_;
+  base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+      registry_observation_{this};
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<SyncVaultProviderService> weak_ptr_factory_{this};
+};
+
+class SyncVaultProviderServiceFactory : public ProfileKeyedServiceFactory {
+ public:
+  static SyncVaultProviderServiceFactory* GetInstance();
+  static SyncVaultProviderService* GetForBrowserContext(
+      content::BrowserContext* context);
+
+ private:
+  friend class base::NoDestructor<SyncVaultProviderServiceFactory>;
+
+  SyncVaultProviderServiceFactory();
+  ~SyncVaultProviderServiceFactory() override;
+
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_API_SYNC_VAULT_PROVIDER_SYNC_VAULT_PROVIDER_SERVICE_H_
