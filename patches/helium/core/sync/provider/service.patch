+std::optional<Host::State> SyncVaultProviderService::GetProviderState(
+    const std::string& provider_id) const {
+  auto it = provider_states_.find(provider_id);
+  if (it == provider_states_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
