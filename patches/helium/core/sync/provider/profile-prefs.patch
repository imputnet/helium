+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/sync/private_sync/private_sync_prefs.h"
+
+#include <optional>
+#include <string_view>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/notreached.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "components/crx_file/id_util.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace browser_sync::private_sync_prefs {
+
+namespace {
+
+using Kind = PrivateSyncProviderHost::Kind;
+
+constexpr char kVersionField[] = "version";
+constexpr char kProviderKindField[] = "provider_kind";
+constexpr char kProviderIdField[] = "provider_id";
+constexpr char kVaultUuidField[] = "vault_uuid";
+constexpr char kVaultNameField[] = "vault_name";
+constexpr char kEncryptedVaultKeyField[] = "encrypted_vault_key";
+
+constexpr char kExtensionKind[] = "extension";
+
+// Each kind of provider must be stored, read back and validated here.
+std::string_view KindToString(Kind kind) {
+  switch (kind) {
+    case Kind::kExtension:
+      return kExtensionKind;
+  }
+  NOTREACHED();
+}
+
+std::optional<Kind> KindFromString(std::string_view kind) {
+  if (kind == kExtensionKind) {
+    return Kind::kExtension;
+  }
+
+  return std::nullopt;
+}
+
+bool IsValidProviderId(Kind kind, std::string_view id) {
+  switch (kind) {
+    case Kind::kExtension:
+      return crx_file::id_util::IdIsValid(id);
+  }
+  NOTREACHED();
+}
+
+// Encrypted values are never empty.
+std::optional<std::vector<uint8_t>> DecodeEncrypted(std::string_view value) {
+  std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(value);
+  if (!decoded || decoded->empty()) {
+    return std::nullopt;
+  }
+
+  return decoded;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kConfiguration);
+  registry->RegisterStringPref(kCheckpoint, std::string());
+  registry->RegisterIntegerPref(kBlockedReason,
+                                static_cast<int>(BlockedReason::kNone));
+}
+
+std::optional<Configuration> ReadConfiguration(const PrefService& prefs) {
+  const base::DictValue& value = prefs.GetDict(kConfiguration);
+  const std::string* provider_kind = value.FindString(kProviderKindField);
+  const std::string* provider_id = value.FindString(kProviderIdField);
+  const std::string* vault_uuid = value.FindString(kVaultUuidField);
+  const std::string* encrypted_key = value.FindString(kEncryptedVaultKeyField);
+  const std::optional<Kind> kind =
+      provider_kind ? KindFromString(*provider_kind) : std::nullopt;
+  if (value.FindInt(kVersionField) != kConfigurationVersion || !kind ||
+      !provider_id || !IsValidProviderId(*kind, *provider_id) || !vault_uuid ||
+      !base::Uuid::ParseLowercase(*vault_uuid).is_valid() || !encrypted_key) {
+    return std::nullopt;
+  }
+
+  std::optional<std::vector<uint8_t>> key = DecodeEncrypted(*encrypted_key);
+  if (!key || !ReadEncryptedCheckpoint(prefs)) {
+    return std::nullopt;
+  }
+
+  const std::string* vault_name = value.FindString(kVaultNameField);
+  return Configuration{*kind, *provider_id, *vault_uuid,
+                       vault_name ? *vault_name : std::string(),
+                       std::move(*key)};
+}
+
+void WriteConfiguration(PrefService& prefs,
+                        const Configuration& configuration,
+                        const std::vector<uint8_t>& encrypted_checkpoint) {
+  ClearConfiguration(prefs);
+  WriteEncryptedCheckpoint(prefs, encrypted_checkpoint);
+  prefs.SetDict(
+      kConfiguration,
+      base::DictValue()
+          .Set(kVersionField, kConfigurationVersion)
+          .Set(kProviderKindField, KindToString(configuration.provider_kind))
+          .Set(kProviderIdField, configuration.provider_id)
+          .Set(kVaultUuidField, configuration.vault_uuid)
+          .Set(kVaultNameField, configuration.vault_name)
+          .Set(kEncryptedVaultKeyField,
+               base::Base64Encode(configuration.encrypted_vault_key)));
+}
+
+void ClearConfiguration(PrefService& prefs) {
+  prefs.ClearPref(kConfiguration);
+  prefs.ClearPref(kCheckpoint);
+  prefs.ClearPref(kBlockedReason);
+}
+
+bool IsConfigured(const PrefService& prefs) {
+  return ReadConfiguration(prefs).has_value();
+}
+
+std::optional<std::vector<uint8_t>> ReadEncryptedCheckpoint(
+    const PrefService& prefs) {
+  return DecodeEncrypted(prefs.GetString(kCheckpoint));
+}
+
+void WriteEncryptedCheckpoint(PrefService& prefs,
+                              const std::vector<uint8_t>& checkpoint) {
+  prefs.SetString(kCheckpoint, base::Base64Encode(checkpoint));
+}
+
+BlockedReason GetBlockedReason(const PrefService& prefs) {
+  const int value = prefs.GetInteger(kBlockedReason);
+  // kNone is never stored, so a stored value that reads as kNone is not an
+  // integer.
+  if (value == static_cast<int>(BlockedReason::kNone)) {
+    return prefs.HasPrefPath(kBlockedReason) ? BlockedReason::kIntegrityError
+                                             : BlockedReason::kNone;
+  }
+
+  if (value < 0 || value > static_cast<int>(BlockedReason::kMaxValue)) {
+    return BlockedReason::kIntegrityError;
+  }
+
+  return static_cast<BlockedReason>(value);
+}
+
+void SetBlockedReason(PrefService& prefs, BlockedReason reason) {
+  if (reason == BlockedReason::kNone) {
+    prefs.ClearPref(kBlockedReason);
+    return;
+  }
+
+  prefs.SetInteger(kBlockedReason, static_cast<int>(reason));
+}
+
+}  // namespace browser_sync::private_sync_prefs
