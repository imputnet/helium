+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PREFS_H_
+#define CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PREFS_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/sync/private_sync/private_sync_provider_host.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace browser_sync::private_sync_prefs {
+
+inline constexpr char kConfiguration[] = "helium.private_sync.configuration";
+// The vault's last authenticated commit, encrypted with OSCrypt.
+inline constexpr char kCheckpoint[] = "helium.private_sync.checkpoint";
+// Set when private sync stopped until the user retries.
+inline constexpr char kBlockedReason[] = "helium.private_sync.blocked_reason";
+
+// A configuration written by a newer browser is not read, but is kept until
+// the user disconnects or sets up private sync again.
+inline constexpr int kConfigurationVersion = 1;
+
+struct Configuration {
+  PrivateSyncProviderHost::Kind provider_kind;
+  std::string provider_id;
+  std::string vault_uuid;
+  // Only shown to the user.
+  std::string vault_name;
+  // Encrypted with OSCrypt.
+  std::vector<uint8_t> encrypted_vault_key;
+
+  bool operator==(const Configuration&) const = default;
+};
+
+// These values are persisted.
+enum class BlockedReason {
+  kNone = 0,
+  // The vault was rolled back, forked, or holds data that cannot be read.
+  kIntegrityError = 1,
+  // The vault was written by a newer browser.
+  kUnsupportedVersion = 2,
+  kMaxValue = kUnsupportedVersion,
+};
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+// A configuration is only read with its checkpoint, so that rollbacks are
+// always detected.
+std::optional<Configuration> ReadConfiguration(const PrefService& prefs);
+// Replaces the configuration and its checkpoint, and clears the old vault's
+// state.
+void WriteConfiguration(PrefService& prefs,
+                        const Configuration& configuration,
+                        const std::vector<uint8_t>& encrypted_checkpoint);
+void ClearConfiguration(PrefService& prefs);
+bool IsConfigured(const PrefService& prefs);
+
+std::optional<std::vector<uint8_t>> ReadEncryptedCheckpoint(
+    const PrefService& prefs);
+void WriteEncryptedCheckpoint(PrefService& prefs,
+                              const std::vector<uint8_t>& checkpoint);
+
+BlockedReason GetBlockedReason(const PrefService& prefs);
+void SetBlockedReason(PrefService& prefs, BlockedReason reason);
+
+}  // namespace browser_sync::private_sync_prefs
+
+#endif  // CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PREFS_H_
