+#ifndef CHROME_BROWSER_SYNC_EXTENSION_SYNC_EXTENSION_SYNC_VAULT_TRANSPORT_H_
+#define CHROME_BROWSER_SYNC_EXTENSION_SYNC_EXTENSION_SYNC_VAULT_TRANSPORT_H_
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/extensions/api/sync_vault_provider/sync_vault_provider_service.h"
+#include "components/sync/engine/sync_vault/sync_vault_async_transport.h"
+
+namespace browser_sync {
+
+// Converts extension broker messages into the provider-neutral asynchronous
+// vault contract. Request IDs never cross this boundary.
+class ExtensionSyncVaultTransport final
+    : public syncer::SyncVaultAsyncTransport {
+ public:
+  static std::unique_ptr<syncer::SyncVaultTransport> Create(
+      extensions::SyncVaultProviderService* service,
+      std::string vault_uuid);
+  static std::unique_ptr<syncer::SyncVaultAsyncTransport> Open(
+      extensions::SyncVaultProviderService* service,
+      std::string vault_uuid);
+
+  Request ReadObject(std::string id,
+                     size_t maximum,
+                     ReadCallback callback) override;
+  Request WriteObject(std::string id,
+                      std::optional<std::string> revision,
+                      std::vector<uint8_t> data,
+                      std::optional<uint32_t> epoch,
+                      WriteCallback callback) override;
+  Request CollectEpochsBefore(uint32_t epoch,
+                              CollectCallback callback) override;
+
+ private:
+  ExtensionSyncVaultTransport(
+      base::WeakPtr<extensions::SyncVaultProviderService> service,
+      std::string provider_id,
+      std::string vault_uuid);
+  bool IsAvailable() const;
+  Request OwnRequest(int request_id);
+  base::WeakPtr<extensions::SyncVaultProviderService> service_;
+  const std::string provider_id_;
+  const std::string vault_uuid_;
+};
+
+}  // namespace browser_sync
+
+#endif  // CHROME_BROWSER_SYNC_EXTENSION_SYNC_EXTENSION_SYNC_VAULT_TRANSPORT_H_
