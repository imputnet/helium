+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/sync/extension_sync/extension_sync_vault_transport.h"
+
+#include <limits>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "base/notreached.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/uuid.h"
+#include "content/public/browser/browser_thread.h"
+#include "extensions/common/extension.h"
+
+namespace browser_sync {
+namespace {
+namespace api = extensions::api::sync_vault_provider;
+using Service = extensions::SyncVaultProviderService;
+using Error = syncer::SyncVaultTransportError;
+
+Error MapFailure(const Service::ProviderFailure& failure) {
+  switch (failure.error) {
+    case api::SyncVaultProviderError::kAuthRequired:
+      return Error::kAuthenticationRequired;
+    case api::SyncVaultProviderError::kConflict:
+      return Error::kConflict;
+    case api::SyncVaultProviderError::kNetworkError:
+      return Error::kNetworkError;
+    case api::SyncVaultProviderError::kTemporaryError:
+      return Error::kTemporaryError;
+    case api::SyncVaultProviderError::kQuotaExceeded:
+      return Error::kQuotaExceeded;
+    case api::SyncVaultProviderError::kAccessDenied:
+      return Error::kAccessDenied;
+    case api::SyncVaultProviderError::kUnsupported:
+      return Error::kUnsupported;
+    case api::SyncVaultProviderError::kAborted:
+      return Error::kAborted;
+    case api::SyncVaultProviderError::kNotFound:
+    case api::SyncVaultProviderError::kInvalidData:
+    case api::SyncVaultProviderError::kNone:
+      return Error::kInvalidData;
+  }
+  NOTREACHED();
+}
+}  // namespace
+
+std::unique_ptr<syncer::SyncVaultTransport> ExtensionSyncVaultTransport::Create(
+    Service* service,
+    std::string uuid) {
+  auto provider = Open(service, std::move(uuid));
+  return provider ? syncer::MakeSynchronousVaultTransport(std::move(provider))
+                  : nullptr;
+}
+
+std::unique_ptr<syncer::SyncVaultAsyncTransport>
+ExtensionSyncVaultTransport::Open(Service* service, std::string uuid) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!service || !base::Uuid::ParseLowercase(uuid).is_valid() ||
+      !service->GetSelectedProvider()) {
+    return nullptr;
+  }
+  return base::WrapUnique(new ExtensionSyncVaultTransport(
+      service->GetWeakPtr(), service->GetSelectedProvider()->id(),
+      std::move(uuid)));
+}
+
+ExtensionSyncVaultTransport::ExtensionSyncVaultTransport(
+    base::WeakPtr<Service> service,
+    std::string provider_id,
+    std::string uuid)
+    : service_(std::move(service)),
+      provider_id_(std::move(provider_id)),
+      vault_uuid_(std::move(uuid)) {}
+
+bool ExtensionSyncVaultTransport::IsAvailable() const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return service_ && service_->GetSelectedProvider() &&
+         service_->GetSelectedProvider()->id() == provider_id_;
+}
+
+ExtensionSyncVaultTransport::Request ExtensionSyncVaultTransport::OwnRequest(
+    int id) {
+  return Request(base::BindOnce(
+      [](base::WeakPtr<Service> service, int id) {
+        if (service && id) {
+          service->CancelRequest(id);
+        }
+      },
+      service_, id));
+}
+
+ExtensionSyncVaultTransport::Request ExtensionSyncVaultTransport::ReadObject(
+    std::string id,
+    size_t maximum,
+    ReadCallback callback) {
+  if (!IsAvailable()) {
+    std::move(callback).Run(base::unexpected(Error::kAborted));
+    return {};
+  }
+  if (maximum > std::numeric_limits<int>::max()) {
+    std::move(callback).Run(base::unexpected(Error::kInvalidData));
+    return {};
+  }
+  return OwnRequest(service_->ReadObject(
+      vault_uuid_, id, base::checked_cast<int>(maximum),
+      base::BindOnce(
+          [](ReadCallback callback, Service::Response response) {
+            if (!response.has_value()) {
+              if (response.error().error ==
+                  api::SyncVaultProviderError::kNotFound) {
+                std::move(callback).Run(std::nullopt);
+              } else {
+                std::move(callback).Run(
+                    base::unexpected(MapFailure(response.error())));
+              }
+              return;
+            }
+            std::move(callback).Run(syncer::OpaqueSyncVaultObject{
+                std::move(*response->success->data),
+                std::move(*response->success->revision)});
+          },
+          std::move(callback))));
+}
+
+ExtensionSyncVaultTransport::Request ExtensionSyncVaultTransport::WriteObject(
+    std::string id,
+    std::optional<std::string> revision,
+    std::vector<uint8_t> data,
+    std::optional<uint32_t> epoch,
+    WriteCallback callback) {
+  if (!IsAvailable()) {
+    std::move(callback).Run(base::unexpected(Error::kAborted));
+    return {};
+  }
+  if (epoch && *epoch > std::numeric_limits<int>::max()) {
+    std::move(callback).Run(base::unexpected(Error::kInvalidData));
+    return {};
+  }
+  return OwnRequest(service_->WriteObject(
+      vault_uuid_, id, std::move(data), std::move(revision),
+      epoch ? std::make_optional(base::checked_cast<int>(*epoch))
+            : std::nullopt,
+      base::BindOnce(
+          [](WriteCallback callback, Service::Response response) {
+            if (!response.has_value()) {
+              std::move(callback).Run(
+                  base::unexpected(MapFailure(response.error())));
+              return;
+            }
+            std::move(callback).Run(std::move(*response->success->revision));
+          },
+          std::move(callback))));
+}
+
+ExtensionSyncVaultTransport::Request
+ExtensionSyncVaultTransport::CollectEpochsBefore(uint32_t epoch,
+                                                 CollectCallback callback) {
+  if (!IsAvailable()) {
+    std::move(callback).Run(base::unexpected(Error::kAborted));
+    return {};
+  }
+  if (epoch == 0 || epoch > std::numeric_limits<int>::max()) {
+    std::move(callback).Run(base::unexpected(Error::kInvalidData));
+    return {};
+  }
+  return OwnRequest(service_->CollectEpochs(
+      vault_uuid_, base::checked_cast<int>(epoch),
+      base::BindOnce(
+          [](CollectCallback callback, Service::Response response) {
+            if (!response.has_value()) {
+              std::move(callback).Run(
+                  base::unexpected(MapFailure(response.error())));
+              return;
+            }
+            std::move(callback).Run(base::ok());
+          },
+          std::move(callback))));
+}
+
+}  // namespace browser_sync
