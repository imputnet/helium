+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PROVIDER_HOST_H_
+#define CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PROVIDER_HOST_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list_types.h"
+#include "base/types/expected.h"
+#include "url/gurl.h"
+
+namespace browser_sync {
+
+// The private sync providers available on a platform. Desktop providers are
+// extensions; other platforms can host providers differently.
+class PrivateSyncProviderHost {
+ public:
+  // Persisted with the configuration, together with the provider's ID.
+  enum class Kind {
+    kExtension,
+  };
+
+  enum class Error {
+    kAuthRequired,
+    kNotFound,
+    kConflict,
+    kNetworkError,
+    kTemporaryError,
+    kQuotaExceeded,
+    kAccessDenied,
+    kInvalidData,
+    kUnsupported,
+    kAborted,
+  };
+
+  // What a provider last reported about its account.
+  enum class State {
+    kReady,
+    kAuthRequired,
+    kOffline,
+    kQuotaExceeded,
+  };
+
+  struct Provider {
+    Kind kind;
+    std::string id;
+    std::string name;
+    // An image of the provider, if it has one.
+    GURL icon_url;
+    // Set when the provider can keep vault keys for the user's account, with
+    // its explanation for the user.
+    std::optional<std::string> account_key_reason;
+  };
+
+  struct Vault {
+    std::string uuid;
+    std::string name;
+  };
+
+  struct Failure {
+    Error error;
+    std::optional<std::string> message;
+  };
+
+  // The fields that the request produces.
+  struct Result {
+    Result();
+    Result(Result&&);
+    Result& operator=(Result&&);
+    ~Result();
+
+    std::vector<Vault> vaults;
+    std::vector<uint8_t> data;
+    std::string revision;
+    std::vector<uint8_t> key_envelope;
+    std::vector<uint8_t> vault_key;
+  };
+
+  using Response = base::expected<Result, Failure>;
+  using ResponseCallback = base::OnceCallback<void(Response)>;
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // Providers were added or removed, or changed their state.
+    virtual void OnProvidersChanged() {}
+    // A provider that is configuring is waiting for the user, for example to
+    // sign in.
+    virtual void OnProviderWaitingForUser(const std::string& provider_id) {}
+    virtual void OnVaultChanged(const std::string& provider_id,
+                                const std::string& vault_uuid) {}
+  };
+
+  virtual ~PrivateSyncProviderHost() = default;
+
+  virtual std::vector<Provider> GetProviders() const = 0;
+  virtual std::optional<State> GetProviderState(
+      const std::string& provider_id) const = 0;
+
+  // Requests fail with kAborted when the provider goes away or the request is
+  // canceled, and with kTemporaryError when the provider does not respond in
+  // time. Configuring does not time out while it waits for the user.
+  virtual void Configure(const std::string& provider_id,
+                         ResponseCallback callback) = 0;
+  virtual void ListVaults(const std::string& provider_id,
+                          ResponseCallback callback) = 0;
+  virtual void CreateVault(const std::string& provider_id,
+                           const std::string& vault_uuid,
+                           const std::string& name,
+                           ResponseCallback callback) = 0;
+  virtual void ReadObject(const std::string& provider_id,
+                          const std::string& vault_uuid,
+                          const std::string& object_id,
+                          size_t max_bytes,
+                          ResponseCallback callback) = 0;
+  virtual void WriteObject(const std::string& provider_id,
+                           const std::string& vault_uuid,
+                           const std::string& object_id,
+                           std::vector<uint8_t> data,
+                           std::optional<std::string> expected_revision,
+                           std::optional<uint32_t> retention_epoch,
+                           ResponseCallback callback) = 0;
+  virtual void CollectEpochs(const std::string& provider_id,
+                             const std::string& vault_uuid,
+                             uint32_t minimum_retained_epoch,
+                             ResponseCallback callback) = 0;
+  virtual void WrapKey(const std::string& provider_id,
+                       const std::string& vault_uuid,
+                       std::vector<uint8_t> vault_key,
+                       ResponseCallback callback) = 0;
+  virtual void UnwrapKey(const std::string& provider_id,
+                         const std::string& vault_uuid,
+                         std::vector<uint8_t> key_envelope,
+                         ResponseCallback callback) = 0;
+  // Cancels the provider's pending requests.
+  virtual void CancelRequests(const std::string& provider_id) = 0;
+
+  virtual void AddObserver(Observer* observer) = 0;
+  virtual void RemoveObserver(Observer* observer) = 0;
+  virtual base::WeakPtr<PrivateSyncProviderHost> GetWeakPtr() = 0;
+};
+
+}  // namespace browser_sync
+
+#endif  // CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_PROVIDER_HOST_H_
