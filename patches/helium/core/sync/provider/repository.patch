+#ifndef CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_REPOSITORY_H_
+#define CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_REPOSITORY_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/observer_list.h"
+#include "chrome/browser/sync/private_sync/private_sync_prefs.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class Profile;
+class PrefService;
+class ProfileKeyedServiceFactory;
+
+namespace browser_sync::private_sync {
+
+// Profile-owned access to private sync's persisted state. Only changes to
+// provider, vault, key, or key mode are configuration transitions.
+class Repository : public KeyedService {
+ public:
+  using Configuration = private_sync_prefs::Configuration;
+  using Diagnostics = private_sync_prefs::Diagnostics;
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnVaultConfigurationChanged() {}
+    virtual void OnVaultCheckpointChanged() {}
+    virtual void OnVaultDiagnosticsChanged() {}
+  };
+  static Repository* Get(Profile* profile);
+  static ProfileKeyedServiceFactory* GetFactory();
+  explicit Repository(PrefService& prefs);
+  ~Repository() override;
+
+  const std::optional<Configuration>& configuration() const {
+    return configuration_;
+  }
+  const std::optional<Diagnostics>& diagnostics() const { return diagnostics_; }
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  void InstallConfiguration(Configuration configuration);
+  bool ClearConfiguration(const Configuration& expected);
+  void WriteDiagnostics(const Configuration& expected, Diagnostics diagnostics);
+  // Merge one backend result with retained health state. Returns true only
+  // when this result first latches a blocking reconciliation error.
+  bool RecordReconciliation(const Configuration& expected,
+                            Diagnostics diagnostics);
+  void ClearDiagnostics();
+  void Flush(base::OnceClosure callback);
+  void Shutdown() override;
+
+ private:
+  void OnConfigurationPrefChanged();
+  void OnDiagnosticsPrefChanged();
+  const raw_ref<PrefService> prefs_;
+  std::optional<Configuration> configuration_;
+  std::optional<Diagnostics> diagnostics_;
+  PrefChangeRegistrar registrar_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace browser_sync::private_sync
+
+#endif  // CHROME_BROWSER_SYNC_PRIVATE_SYNC_PRIVATE_SYNC_REPOSITORY_H_
