+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/sync/private_sync/private_sync_repository.h"
+
+#include "base/functional/bind.h"
+#include "components/prefs/pref_service.h"
+
+namespace browser_sync::private_sync {
+namespace {
+
+bool SameConfiguration(const std::optional<Repository::Configuration>& a,
+                       const std::optional<Repository::Configuration>& b) {
+  if (!a || !b) {
+    return a.has_value() == b.has_value();
+  }
+  return a->provider == b->provider && a->vault_uuid == b->vault_uuid &&
+         a->key_mode == b->key_mode &&
+         a->encrypted_vault_key == b->encrypted_vault_key;
+}
+
+}  // namespace
+
+Repository::Repository(PrefService& prefs)
+    : prefs_(prefs),
+      configuration_(private_sync_prefs::ReadConfiguration(prefs)),
+      diagnostics_(private_sync_prefs::ReadDiagnostics(prefs)) {
+  registrar_.Init(&prefs);
+  registrar_.Add(private_sync_prefs::kConfiguration,
+                 base::BindRepeating(&Repository::OnConfigurationPrefChanged,
+                                     base::Unretained(this)));
+  registrar_.Add(private_sync_prefs::kDiagnostics,
+                 base::BindRepeating(&Repository::OnDiagnosticsPrefChanged,
+                                     base::Unretained(this)));
+}
+
+Repository::~Repository() = default;
+
+void Repository::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void Repository::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void Repository::InstallConfiguration(Configuration configuration) {
+  if (!SameConfiguration(configuration_, configuration)) {
+    private_sync_prefs::ClearDiagnostics(&*prefs_);
+  }
+  private_sync_prefs::WriteConfiguration(&*prefs_, configuration);
+}
+
+bool Repository::ClearConfiguration(const Configuration& expected) {
+  if (!configuration_ || !SameConfiguration(configuration_, expected)) {
+    return false;
+  }
+  private_sync_prefs::ClearConfiguration(&*prefs_);
+  private_sync_prefs::ClearDiagnostics(&*prefs_);
+  return true;
+}
+
+void Repository::WriteDiagnostics(const Configuration& expected,
+                                  Diagnostics diagnostics) {
+  if (!configuration_ || !SameConfiguration(configuration_, expected) ||
+      configuration_->vault_uuid != diagnostics.vault_uuid) {
+    return;
+  }
+  private_sync_prefs::WriteDiagnostics(&*prefs_, diagnostics);
+}
+
+bool Repository::RecordReconciliation(const Configuration& expected,
+                                      Diagnostics diagnostics) {
+  if (!configuration_ || !SameConfiguration(configuration_, expected) ||
+      configuration_->vault_uuid != diagnostics.vault_uuid) {
+    return false;
+  }
+  const bool matching_previous =
+      diagnostics_ && diagnostics_->vault_uuid == diagnostics.vault_uuid;
+  const bool was_blocked = private_sync_prefs::HasBlockingReconciliationError(
+      *prefs_, diagnostics.vault_uuid);
+  if (was_blocked) {
+    // An unreadable persisted block requires an explicit diagnostics reset.
+    if (!matching_previous || !diagnostics_->last_error ||
+        !private_sync_prefs::IsBlockingReconciliationError(
+            *diagnostics_->last_error)) {
+      return false;
+    }
+    diagnostics.last_error = diagnostics_->last_error;
+  }
+  if (diagnostics.last_error && matching_previous) {
+    diagnostics.last_success = diagnostics_->last_success;
+    diagnostics.state_statistics_available =
+        diagnostics_->state_statistics_available;
+    diagnostics.entity_count = diagnostics_->entity_count;
+    diagnostics.state_bytes = diagnostics_->state_bytes;
+  }
+  const bool now_blocked = diagnostics.last_error &&
+                           private_sync_prefs::IsBlockingReconciliationError(
+                               *diagnostics.last_error);
+  WriteDiagnostics(expected, std::move(diagnostics));
+  return now_blocked && !was_blocked;
+}
+
+void Repository::ClearDiagnostics() {
+  private_sync_prefs::ClearDiagnostics(&*prefs_);
+}
+
+void Repository::Flush(base::OnceClosure callback) {
+  prefs_->CommitPendingWrite(std::move(callback));
+}
+
+void Repository::OnConfigurationPrefChanged() {
+  auto next = private_sync_prefs::ReadConfiguration(*prefs_);
+  const bool same_identity = SameConfiguration(configuration_, next);
+  const bool same_checkpoint =
+      configuration_ && next &&
+      configuration_->encrypted_checkpoint == next->encrypted_checkpoint;
+  configuration_ = std::move(next);
+  if (!same_identity) {
+    observers_.Notify(&Observer::OnVaultConfigurationChanged);
+  } else if (!same_checkpoint && configuration_) {
+    observers_.Notify(&Observer::OnVaultCheckpointChanged);
+  }
+}
+
+void Repository::OnDiagnosticsPrefChanged() {
+  diagnostics_ = private_sync_prefs::ReadDiagnostics(*prefs_);
+  observers_.Notify(&Observer::OnVaultDiagnosticsChanged);
+}
+
+void Repository::Shutdown() {
+  registrar_.RemoveAll();
+}
+
+}  // namespace browser_sync::private_sync
