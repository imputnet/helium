+namespace syncer {
+
+// One vault connection, used and destroyed on its owning sequence. Callbacks
+// may run synchronously. Destroying a request cancels it; destroying a
+// completed request is harmless. The provider must never invoke a callback
+// twice.
+class SyncVaultAsyncTransport {
+ public:
+  using Request = base::ScopedClosureRunner;
+  using ReadCallback = base::OnceCallback<void(SyncVaultTransport::ReadResult)>;
+  using WriteCallback =
+      base::OnceCallback<void(SyncVaultTransport::WriteResult)>;
+  using CollectCallback =
+      base::OnceCallback<void(SyncVaultTransport::CollectResult)>;
+  virtual ~SyncVaultAsyncTransport() = default;
+
+  virtual Request ReadObject(std::string object_id,
+                             size_t maximum_bytes,
+                             ReadCallback callback) = 0;
+  virtual Request WriteObject(std::string object_id,
+                              std::optional<std::string> expected_revision,
+                              std::vector<uint8_t> data,
+                              std::optional<uint32_t> retention_epoch,
+                              WriteCallback callback) = 0;
+  virtual Request CollectEpochsBefore(uint32_t minimum_retained_epoch,
+                                      CollectCallback callback) = 0;
+};
+
+// Construct on the provider sequence, then transfer to the Sync sequence.
+// Only this compatibility adapter waits for asynchronous provider operations.
+std::unique_ptr<SyncVaultTransport> MakeSynchronousVaultTransport(
+    std::unique_ptr<SyncVaultAsyncTransport> provider);
+
