+
+class [[maybe_unused,
+        nodiscard]] SyncVaultTransportScopedAllowBaseSyncPrimitives
+    : public base::ScopedAllowBaseSyncPrimitives {};
+
+namespace {
+
+class Connection : public base::RefCountedDeleteOnSequence<Connection> {
+ public:
+  explicit Connection(std::unique_ptr<SyncVaultAsyncTransport> provider)
+      : base::RefCountedDeleteOnSequence<Connection>(
+            base::SequencedTaskRunner::GetCurrentDefault()),
+        provider(std::move(provider)),
+        runner(base::SequencedTaskRunner::GetCurrentDefault()) {}
+  std::unique_ptr<SyncVaultAsyncTransport> provider;
+  const scoped_refptr<base::SequencedTaskRunner> runner;
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<Connection>;
+  friend class base::DeleteHelper<Connection>;
+  ~Connection() = default;
+};
+
+template <typename Result>
+class PendingCall : public base::RefCountedThreadSafe<PendingCall<Result>>,
+                    public CancelationSignal::Observer {
+ public:
+  explicit PendingCall(scoped_refptr<base::SequencedTaskRunner> runner)
+      : request_(nullptr, base::OnTaskRunnerDeleter(std::move(runner))) {}
+
+  void Complete(Result result) {
+    base::AutoLock lock(lock_);
+    if (!result_) {
+      result_ = std::move(result);
+      completed_.Signal();
+    }
+  }
+  void InstallRequest(SyncVaultAsyncTransport::Request request) {
+    request_.reset(new SyncVaultAsyncTransport::Request(std::move(request)));
+  }
+  bool HasResult() {
+    base::AutoLock lock(lock_);
+    return result_.has_value();
+  }
+  void ReleaseRequest() { request_.reset(); }
+
+  Result Wait(CancelationSignal* signal) {
+    bool registered = signal && signal->TryRegisterHandler(this);
+    if (signal && !registered) {
+      OnCancelationSignalReceived();
+    }
+    {
+      SyncVaultTransportScopedAllowBaseSyncPrimitives allow_wait;
+      if (!completed_.TimedWait(base::Minutes(2) + base::Seconds(5),
+                                FROM_HERE)) {
+        Complete(base::unexpected(SyncVaultTransportError::kTemporaryError));
+      }
+    }
+    if (registered) {
+      signal->UnregisterHandler(this);
+    }
+    base::AutoLock lock(lock_);
+    return std::move(*result_);
+  }
+  void OnCancelationSignalReceived() override {
+    Complete(base::unexpected(SyncVaultTransportError::kAborted));
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<PendingCall<Result>>;
+  ~PendingCall() override = default;
+  base::Lock lock_;
+  base::WaitableEvent completed_;
+  std::optional<Result> result_ GUARDED_BY(lock_);
+  std::unique_ptr<SyncVaultAsyncTransport::Request, base::OnTaskRunnerDeleter>
+      request_;
+};
+
+class CollectionCall : public base::RefCountedDeleteOnSequence<CollectionCall> {
+ public:
+  CollectionCall(scoped_refptr<Connection> connection,
+                 SyncVaultTransport::CollectCallback callback)
+      : base::RefCountedDeleteOnSequence<CollectionCall>(connection->runner),
+        connection_(std::move(connection)),
+        callback_(std::move(callback)) {}
+  void Start(uint32_t epoch) {
+    if (finished_) {
+      return;
+    }
+    auto request = connection_->provider->CollectEpochsBefore(
+        epoch,
+        base::BindOnce(&CollectionCall::Complete, base::WrapRefCounted(this)));
+    if (!finished_) {
+      request_ = std::move(request);
+    }
+  }
+  void Cancel() {
+    Complete(base::unexpected(SyncVaultTransportError::kAborted));
+  }
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<CollectionCall>;
+  friend class base::DeleteHelper<CollectionCall>;
+  ~CollectionCall() = default;
+  void Complete(SyncVaultTransport::CollectResult result) {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    request_.RunAndReset();
+    std::move(callback_).Run(std::move(result));
+  }
+  scoped_refptr<Connection> connection_;
+  SyncVaultTransport::CollectCallback callback_;
+  SyncVaultAsyncTransport::Request request_;
+  bool finished_ = false;
+};
+
+class SynchronousVaultTransport final : public SyncVaultTransport {
+ public:
+  explicit SynchronousVaultTransport(scoped_refptr<Connection> connection)
+      : connection_(std::move(connection)) {}
+  ~SynchronousVaultTransport() override {
+    if (collection_) {
+      connection_->runner->PostTask(
+          FROM_HERE, base::BindOnce(&CollectionCall::Cancel, collection_));
+    }
+  }
+  void SetCancelationSignal(CancelationSignal* signal) override {
+    CHECK(signal);
+    CHECK(!signal_);
+    signal_ = signal;
+  }
+  ReadResult ReadObject(const std::string& id, size_t maximum) override {
+    return Run<ReadResult>(base::BindOnce(
+        [](std::string id, size_t maximum, SyncVaultAsyncTransport* provider,
+           SyncVaultAsyncTransport::ReadCallback callback) {
+          return provider->ReadObject(std::move(id), maximum,
+                                      std::move(callback));
+        },
+        id, maximum));
+  }
+  WriteResult WriteObject(const std::string& id,
+                          std::optional<std::string> revision,
+                          std::vector<uint8_t> data,
+                          std::optional<uint32_t> epoch) override {
+    return Run<WriteResult>(base::BindOnce(
+        [](std::string id, std::optional<std::string> revision,
+           std::vector<uint8_t> data, std::optional<uint32_t> epoch,
+           SyncVaultAsyncTransport* provider,
+           SyncVaultAsyncTransport::WriteCallback callback) {
+          return provider->WriteObject(std::move(id), std::move(revision),
+                                       std::move(data), epoch,
+                                       std::move(callback));
+        },
+        id, std::move(revision), std::move(data), epoch));
+  }
+  void CollectEpochsBefore(uint32_t epoch, CollectCallback callback) override {
+    if (!base::SequencedTaskRunner::HasCurrentDefault()) {
+      // Setup verification may use a one-off ThreadPool task. Collection
+      // belongs to the long-lived engine sequence, where replies can return.
+      std::move(callback).Run(
+          base::unexpected(SyncVaultTransportError::kUnsupported));
+      return;
+    }
+    if (collection_) {
+      connection_->runner->PostTask(
+          FROM_HERE, base::BindOnce(&CollectionCall::Cancel, collection_));
+    }
+    collection_ = base::MakeRefCounted<CollectionCall>(
+        connection_,
+        base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                           std::move(callback)));
+    connection_->runner->PostTask(
+        FROM_HERE, base::BindOnce(&CollectionCall::Start, collection_, epoch));
+  }
+
+ private:
+  template <typename Result>
+  Result Run(base::OnceCallback<SyncVaultAsyncTransport::Request(
+                 SyncVaultAsyncTransport*,
+                 base::OnceCallback<void(Result)>)> start) {
+    CHECK(!connection_->runner->RunsTasksInCurrentSequence());
+    if (signal_ && signal_->IsSignalled()) {
+      return base::unexpected(SyncVaultTransportError::kAborted);
+    }
+    auto call = base::MakeRefCounted<PendingCall<Result>>(connection_->runner);
+    if (!connection_->runner->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](scoped_refptr<Connection> connection,
+                   scoped_refptr<PendingCall<Result>> call,
+                   decltype(start) start) {
+                  if (call->HasResult()) {
+                    return;
+                  }
+                  call->InstallRequest(std::move(start).Run(
+                      connection->provider.get(),
+                      base::BindOnce(&PendingCall<Result>::Complete, call)));
+                },
+                connection_, call, std::move(start)))) {
+      call->Complete(base::unexpected(SyncVaultTransportError::kAborted));
+    }
+    Result result = call->Wait(signal_);
+    connection_->runner->PostTask(
+        FROM_HERE, base::BindOnce(&PendingCall<Result>::ReleaseRequest, call));
+    return result;
+  }
+  scoped_refptr<Connection> connection_;
+  scoped_refptr<CollectionCall> collection_;
+  raw_ptr<CancelationSignal> signal_ = nullptr;
+};
+
+}  // namespace
+
+std::unique_ptr<SyncVaultTransport> MakeSynchronousVaultTransport(
+    std::unique_ptr<SyncVaultAsyncTransport> provider) {
+  CHECK(provider);
+  return std::make_unique<SynchronousVaultTransport>(
+      base::MakeRefCounted<Connection>(std::move(provider)));
+}
