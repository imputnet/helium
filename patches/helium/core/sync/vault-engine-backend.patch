+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/sync/engine/sync_vault/sync_vault_connection_manager.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/notreached.h"
+#include "base/time/time.h"
+#include "components/history/core/common/history_expiration.h"
+#include "components/sync/engine/loopback_server/loopback_server_state_delta.h"
+#include "components/sync/protocol/sync.pb.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_status_code.h"
+
+namespace syncer {
+
+namespace {
+
+// Commits that lose a race with another client are retried this many times.
+constexpr int kMaximumTransactionAttempts = 5;
+// Providers may not report changes from other clients, so poll for them.
+constexpr base::TimeDelta kPollInterval = base::Minutes(15);
+
+}  // namespace
+
+SyncVaultConnectionManager::SyncVaultConnectionManager(
+    std::unique_ptr<SyncVaultStore> vault_store,
+    SyncVaultDiagnosticsCallback diagnostics_callback)
+    : vault_store_(std::move(vault_store)),
+      diagnostics_callback_(std::move(diagnostics_callback)) {
+  CHECK(vault_store_);
+}
+
+SyncVaultConnectionManager::~SyncVaultConnectionManager() = default;
+
+HttpResponse SyncVaultConnectionManager::PostBuffer(
+    const std::string& buffer_in,
+    std::string* buffer_out,
+    const signin::AccessTokenInfo& /*access_token_info*/) {
+  buffer_out->clear();
+  sync_pb::ClientToServerMessage message;
+  if (!message.ParseFromString(buffer_in)) {
+    return HttpResponse::ForHttpStatusCode(net::HTTP_BAD_REQUEST);
+  }
+
+  // A commit's conditional head write detects concurrent changes itself, so
+  // a loaded state does not need to be refreshed first.
+  bool refresh =
+      !vault_store_->IsLoaded() ||
+      message.message_contents() != sync_pb::ClientToServerMessage::COMMIT;
+  for (int attempt = 0; attempt < kMaximumTransactionAttempts; ++attempt) {
+    const bool refreshed = refresh;
+    refresh = true;
+    if (refreshed) {
+      auto loaded = vault_store_->Load();
+      if (!loaded.has_value()) {
+        return ResponseForVaultError(loaded.error());
+      }
+    }
+    LoopbackServerVaultState& state = vault_store_->state();
+    state.CollectGarbage(base::Time::Now() -
+                         history::kHistoryExpirationThreshold);
+
+    sync_pb::ClientToServerResponse response;
+    const net::HttpStatusCode status =
+        state.server().HandleCommand(message, &response);
+    if (status != net::HTTP_OK) {
+      // The command may have been applied partially.
+      vault_store_->Discard();
+      if (refreshed) {
+        return HttpResponse::ForHttpStatusCode(status);
+      }
+      continue;
+    }
+    if (state.HasChanges()) {
+      SyncVaultStore::Result committed = vault_store_->Commit();
+      if (!committed.has_value()) {
+        if (committed.error() == SyncVaultStoreError::kConflict) {
+          continue;
+        }
+        return ResponseForVaultError(committed.error());
+      }
+    } else if (!refreshed) {
+      // Nothing was written, so check that the response was not based on an
+      // outdated state.
+      auto loaded = vault_store_->Load();
+      if (!loaded.has_value()) {
+        return ResponseForVaultError(loaded.error());
+      }
+      if (*loaded) {
+        continue;
+      }
+    }
+
+    response.mutable_client_command()->set_set_sync_poll_interval(
+        kPollInterval.InSeconds());
+    if (!response.SerializeToString(buffer_out)) {
+      buffer_out->clear();
+      return HttpResponse::ForHttpStatusCode(net::HTTP_INTERNAL_SERVER_ERROR);
+    }
+    if (diagnostics_callback_) {
+      diagnostics_callback_.Run(
+          std::nullopt, vault_store_->checkpoint(),
+          SyncVaultStateDiagnostics{state.entity_count(),
+                                    vault_store_->payload_bytes()});
+    }
+    return HttpResponse::ForHttpStatusCode(net::HTTP_OK);
+  }
+  return ResponseForVaultError(SyncVaultStoreError::kConflict);
+}
+
+HttpResponse SyncVaultConnectionManager::ResponseForVaultError(
+    SyncVaultStoreError error) {
+  if (diagnostics_callback_) {
+    diagnostics_callback_.Run(error, vault_store_->checkpoint(), std::nullopt);
+  }
+  switch (error) {
+    case SyncVaultStoreError::kAuthenticationRequired:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_UNAUTHORIZED);
+    case SyncVaultStoreError::kConflict:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_CONFLICT);
+    case SyncVaultStoreError::kNetworkError:
+    case SyncVaultStoreError::kTemporaryError:
+    case SyncVaultStoreError::kIncompleteHistory:
+      return HttpResponse::ForNetError(net::ERR_FAILED);
+    case SyncVaultStoreError::kQuotaExceeded:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_INSUFFICIENT_STORAGE);
+    case SyncVaultStoreError::kAccessDenied:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_FORBIDDEN);
+    case SyncVaultStoreError::kAborted:
+      return HttpResponse::ForNetError(net::ERR_ABORTED);
+    case SyncVaultStoreError::kRollback:
+    case SyncVaultStoreError::kFork:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_PRECONDITION_FAILED);
+    case SyncVaultStoreError::kUnsupported:
+    case SyncVaultStoreError::kInvalidData:
+    case SyncVaultStoreError::kAuthenticationFailed:
+    case SyncVaultStoreError::kUnsupportedVersion:
+    case SyncVaultStoreError::kCheckpointPersistenceFailed:
+      return HttpResponse::ForHttpStatusCode(net::HTTP_UNPROCESSABLE_CONTENT);
+  }
+  NOTREACHED();
+}
+
+}  // namespace syncer
