+SyncVaultState::SyncVaultState(
+    std::optional<std::vector<uint8_t>> data,
+    SyncVaultHead head,
+    std::optional<SyncVaultCommitHeader> commit_header,
+    std::string head_revision,
+    base::UnguessableToken store_token,
+    size_t state_size)
+    : data_(std::move(data)),
+      state_size_(data_ ? data_->size() : state_size),
+      head_(std::move(head)),
+      commit_header_(std::move(commit_header)),
+      head_revision_(std::move(head_revision)),
+      store_token_(store_token) {}
+
+// static
+SyncVaultStore::CreateResult SyncVaultStore::Create(
+    std::unique_ptr<SyncVaultTransport> transport,
+    std::unique_ptr<SyncVaultStateCodec> state_codec,
+    base::span<const uint8_t> vault_key,
+    std::string vault_uuid,
+    std::optional<SyncVaultCheckpoint> checkpoint,
+    PersistCheckpointCallback persist_checkpoint_callback) {
+  if (!transport || !state_codec || !persist_checkpoint_callback) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  auto cryptographer =
+      SyncVaultCryptographer::Create(vault_key, std::move(vault_uuid));
+  if (!cryptographer.has_value()) {
+    return base::unexpected(MapCryptoError(cryptographer.error()));
+  }
+  if (checkpoint &&
+      checkpoint->vault_uuid != cryptographer.value()->vault_uuid()) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  SyncVaultCheckpoint effective_checkpoint = checkpoint.value_or(
+      SyncVaultCheckpoint{cryptographer.value()->vault_uuid(), 0, {}});
+  if (!SerializeSyncVaultCheckpoint(effective_checkpoint).has_value()) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  return base::WrapUnique(new SyncVaultStore(
+      std::move(transport), std::move(state_codec),
+      std::move(cryptographer.value()), std::move(effective_checkpoint),
+      std::move(persist_checkpoint_callback)));
+}
