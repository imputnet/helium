+SyncVaultStore::ReadResult SyncVaultStore::ReadState() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  HeadResult head = ReadHead();
+  if (!head.has_value()) {
+    return base::unexpected(head.error());
+  }
+  return ReadStateForHead(std::move(head->head), std::move(head->revision),
+                          nullptr);
+}
+
+SyncVaultStore::RefreshResult SyncVaultStore::RefreshState(
+    SyncVaultState* loaded_state) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!loaded_state || !OwnsState(*loaded_state)) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  HeadResult current = ReadHead();
+  if (!current.has_value()) {
+    return base::unexpected(current.error());
+  }
+  if (current->head == loaded_state->head()) {
+    loaded_state->head_revision_ = std::move(current->revision);
+    return RefreshOutcome::kUnchanged;
+  }
+  ReadResult refreshed = ReadStateForHead(
+      std::move(current->head), std::move(current->revision), loaded_state);
+  if (!refreshed.has_value()) {
+    return base::unexpected(refreshed.error());
+  }
+  *loaded_state = std::move(refreshed.value());
+  return RefreshOutcome::kChanged;
+}
+
+SyncVaultStore::ReadResult SyncVaultStore::ReadStateForHead(
+    SyncVaultHead head,
+    std::string head_revision,
+    const SyncVaultState* loaded_state) {
+  if (!head.commit_digest) {
+    if (checkpoint_.generation != 0) {
+      return base::unexpected(SyncVaultStoreError::kRollback);
+    }
+    return SyncVaultState({}, std::move(head), std::nullopt,
+                          std::move(head_revision), store_token_);
+  }
+
+  AuthenticatedHeadResult authenticated = AuthenticateHead(head);
+  if (!authenticated.has_value()) {
+    return base::unexpected(authenticated.error());
+  }
+  CHECK(!authenticated->commits_newest_first.empty());
+  const SyncVaultCommit& latest_commit =
+      authenticated->commits_newest_first.front().commit;
+
+  std::vector<uint8_t> state;
+  const bool can_apply_incrementally =
+      loaded_state && loaded_state->has_materialized_state() &&
+      loaded_state->generation() > 0 && !loaded_state->data().empty() &&
+      loaded_state->generation() < latest_commit.header.generation &&
+      loaded_state->generation() >=
+          latest_commit.header.epoch_start_generation &&
+      checkpoint_.generation == loaded_state->generation() &&
+      checkpoint_.commit_digest == loaded_state->head().commit_digest &&
+      authenticated->commits_newest_first.size() ==
+          latest_commit.header.generation - loaded_state->generation();
+  if (can_apply_incrementally) {
+    CHECK(loaded_state->head().commit_digest);
+    SyncVaultObjectDigest expected_parent = *loaded_state->head().commit_digest;
+    SyncVaultCommitHeader parent = loaded_state->commit_header().value();
+    for (auto it = authenticated->commits_newest_first.rbegin();
+         it != authenticated->commits_newest_first.rend(); ++it) {
+      SyncVaultCommit& commit = it->commit;
+      if (!IsValidSyncVaultCommitTransition(expected_parent, parent, commit)) {
+        return base::unexpected(SyncVaultStoreError::kMalformedObject);
+      }
+      expected_parent = it->object_digest;
+      parent = commit.header;
+    }
+    if (head.commit_digest != expected_parent) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    StateDataResult applied = ApplyCommitPayloads(
+        loaded_state->data(), authenticated->commits_newest_first);
+    if (!applied.has_value()) {
+      return base::unexpected(applied.error());
+    }
+    state = std::move(applied.value());
+  } else if (loaded_state && loaded_state->has_materialized_state() &&
+             loaded_state->head() == head) {
+    state = loaded_state->data();
+  } else {
+    StateDataResult reconstructed = ReconstructState(&authenticated.value());
+    if (!reconstructed.has_value()) {
+      return base::unexpected(reconstructed.error());
+    }
+    state = std::move(reconstructed.value());
+  }
+
+  const SyncVaultCommit& accepted_commit =
+      authenticated->commits_newest_first.front().commit;
+  if (accepted_commit.header.generation > checkpoint_.generation &&
+      !AdvanceCheckpoint(head, accepted_commit.header)) {
+    return base::unexpected(SyncVaultStoreError::kCheckpointPersistenceFailed);
+  }
+  MaybeCollectEpochs(accepted_commit);
+  return SyncVaultState(std::move(state), std::move(head),
+                        accepted_commit.header, std::move(head_revision),
+                        store_token_);
+}
+
+base::expected<void, SyncVaultStoreError>
+SyncVaultStore::VerifyInitializedVault() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  HeadResult head = ReadHead();
+  if (!head.has_value()) {
+    return base::unexpected(head.error());
+  }
+  if (!head->head.commit_digest) {
+    if (checkpoint_.generation != 0) {
+      return base::unexpected(SyncVaultStoreError::kRollback);
+    }
+    return base::ok();
+  }
+  AuthenticatedHeadResult authenticated = AuthenticateHead(head->head);
+  if (!authenticated.has_value()) {
+    return base::unexpected(authenticated.error());
+  }
+  return base::ok();
+}
+
+SyncVaultStore::ReadResult SyncVaultStore::InitializeEmptyVaultAndReadState() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  HeadResult existing = ReadHead();
+  if (existing.has_value()) {
+    return ReadStateForHead(std::move(existing->head),
+                            std::move(existing->revision), nullptr);
+  }
+  if (existing.error() != SyncVaultStoreError::kIncompleteHistory) {
+    return base::unexpected(existing.error());
+  }
+  WriteResult initialization = InitializeVault();
+  if (!initialization.has_value()) {
+    return base::unexpected(initialization.error());
+  }
+  return ReadState();
+}
