+constexpr char kHeadObjectId[] = "head";
+constexpr size_t kMaximumHeadBytes =
+    kSyncVaultMaximumMetadataPlaintextBytes + kSyncVaultContainerOverheadBytes;
+constexpr size_t kMaximumCommitBytes =
+    kSyncVaultMaximumCommitPlaintextBytes + kSyncVaultContainerOverheadBytes;
+// Payloads are written and read one chunk at a time, which bounds the memory
+// needed for large snapshots. Small payloads stay in their commit, which
+// keeps the commits loaded to catch up small as well.
+constexpr size_t kPayloadChunkBytes = 4 * 1024 * 1024;
+constexpr size_t kMaximumInlinePayloadBytes = 64 * 1024;
+// Write a new snapshot once the deltas outgrow the last one, or this.
+constexpr uint64_t kMinimumEpochDeltaBytes = 256 * 1024 * 1024;
+// Epochs are limited to kSyncVaultEpochCommitTarget commits, and the
+// previous epoch is retained.
+constexpr uint64_t kMaximumCommitAncestry = 2 * kSyncVaultEpochCommitTarget;
+constexpr base::TimeDelta kEpochCollectionRetryDelay = base::Minutes(1);
+
+SyncVaultStoreError MapTransportError(SyncVaultTransportError error) {
+  switch (error) {
+    case SyncVaultTransportError::kAuthenticationRequired:
+      return SyncVaultStoreError::kAuthenticationRequired;
+    case SyncVaultTransportError::kConflict:
+      return SyncVaultStoreError::kConflict;
+    case SyncVaultTransportError::kNetworkError:
+      return SyncVaultStoreError::kNetworkError;
+    case SyncVaultTransportError::kTemporaryError:
+      return SyncVaultStoreError::kTemporaryError;
+    case SyncVaultTransportError::kQuotaExceeded:
+      return SyncVaultStoreError::kQuotaExceeded;
+    case SyncVaultTransportError::kAccessDenied:
+      return SyncVaultStoreError::kAccessDenied;
+    case SyncVaultTransportError::kInvalidData:
+      return SyncVaultStoreError::kInvalidData;
+    case SyncVaultTransportError::kUnsupported:
+      return SyncVaultStoreError::kUnsupported;
+    case SyncVaultTransportError::kAborted:
+      return SyncVaultStoreError::kAborted;
+  }
+  NOTREACHED();
+}
+
+SyncVaultStoreError MapCryptoError(SyncVaultCryptoError error) {
+  return error == SyncVaultCryptoError::kAuthenticationFailed
+             ? SyncVaultStoreError::kAuthenticationFailed
+             : SyncVaultStoreError::kInvalidData;
+}
+
+SyncVaultStoreError MapFormatError(SyncVaultFormatError error) {
+  return error == SyncVaultFormatError::kUnsupportedVersion
+             ? SyncVaultStoreError::kUnsupportedVersion
+             : SyncVaultStoreError::kInvalidData;
+}
+
+// A failed write may still have been applied.
+bool IsAmbiguousWriteError(SyncVaultTransportError error) {
+  return error == SyncVaultTransportError::kNetworkError ||
+         error == SyncVaultTransportError::kTemporaryError;
+}
+
+std::string Digest(base::span<const uint8_t> data) {
+  const auto digest = crypto::hash::Sha256(data);
+  return std::string(base::as_string_view(digest));
+}
+
+std::vector<uint8_t> Serialize(const google::protobuf::MessageLite& message) {
+  std::vector<uint8_t> data(message.ByteSizeLong());
+  CHECK(message.SerializeToArray(data.data(), data.size()));
+  return data;
+}
