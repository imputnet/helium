+// static
+base::expected<std::unique_ptr<SyncVaultStore>, SyncVaultStoreError>
+SyncVaultStore::Create(std::unique_ptr<SyncVaultTransport> transport,
+                       base::span<const uint8_t> vault_key,
+                       std::string vault_uuid,
+                       std::optional<sync_pb::SyncVaultCheckpoint> checkpoint,
+                       PersistCheckpointCallback persist_checkpoint) {
+  CHECK(transport);
+  CHECK(persist_checkpoint);
+  if (checkpoint && checkpoint->vault_uuid() != vault_uuid) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  if (!checkpoint) {
+    checkpoint.emplace();
+    checkpoint->set_format_version(kSyncVaultFormatVersion);
+    checkpoint->set_vault_uuid(vault_uuid);
+    checkpoint->set_generation(0);
+  }
+  auto cryptographer =
+      SyncVaultCryptographer::Create(vault_key, std::move(vault_uuid));
+  if (!cryptographer.has_value()) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  return base::WrapUnique(new SyncVaultStore(
+      std::move(transport), std::move(cryptographer.value()),
+      std::move(*checkpoint), std::move(persist_checkpoint)));
+}
+
+SyncVaultStore::SyncVaultStore(
+    std::unique_ptr<SyncVaultTransport> transport,
+    std::unique_ptr<SyncVaultCryptographer> cryptographer,
+    sync_pb::SyncVaultCheckpoint checkpoint,
+    PersistCheckpointCallback persist_checkpoint)
+    : transport_(std::move(transport)),
+      cryptographer_(std::move(cryptographer)),
+      checkpoint_(std::move(checkpoint)),
+      persist_checkpoint_(std::move(persist_checkpoint)) {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
