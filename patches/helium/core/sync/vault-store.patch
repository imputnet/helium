+
+namespace syncer {
+
+class CancelationSignal;
+class LoopbackServerVaultState;
+
+enum class SyncVaultStoreError {
+  kAuthenticationRequired,
+  kConflict,
+  kNetworkError,
+  kTemporaryError,
+  kQuotaExceeded,
+  kAccessDenied,
+  kUnsupported,
+  kAborted,
+  // The vault holds data that cannot be read, or the provider misbehaved.
+  kInvalidData,
+  // The vault key does not decrypt the vault.
+  kAuthenticationFailed,
+  kUnsupportedVersion,
+  // The vault is older than, or diverges from, the local checkpoint.
+  kRollback,
+  kFork,
+  // The vault is not initialized, or history it refers to is missing.
+  kIncompleteHistory,
+  kCheckpointPersistenceFailed,
+};
+
+// Keeps a LoopbackServer's state in an encrypted journal of immutable
+// commits, published by conditionally replacing a single head object.
+class SyncVaultStore {
+ public:
+  using Result = base::expected<void, SyncVaultStoreError>;
+  using PersistCheckpointCallback =
+      base::RepeatingCallback<bool(const sync_pb::SyncVaultCheckpoint&)>;
+
+  // `checkpoint` is the last commit this profile authenticated, if any.
+  static base::expected<std::unique_ptr<SyncVaultStore>, SyncVaultStoreError>
+  Create(std::unique_ptr<SyncVaultTransport> transport,
+         base::span<const uint8_t> vault_key,
+         std::string vault_uuid,
+         std::optional<sync_pb::SyncVaultCheckpoint> checkpoint,
+         PersistCheckpointCallback persist_checkpoint);
+
+  SyncVaultStore(const SyncVaultStore&) = delete;
+  SyncVaultStore& operator=(const SyncVaultStore&) = delete;
+  ~SyncVaultStore();
+
+  void SetCancelationSignal(CancelationSignal* cancelation_signal);
+
+  // Creates an empty head unless the vault already has one.
+  Result Initialize();
+  // Checks that the key decrypts the vault's head and latest commit, and
+  // checkpoints them.
+  Result Verify();
+
+  // Brings the state up to date with the vault's head, and returns whether it
+  // changed.
+  base::expected<bool, SyncVaultStoreError> Load();
+  bool IsLoaded() const { return !!state_; }
+  // The state as of the last successful Load() or Commit().
+  LoopbackServerVaultState& state() { return *state_; }
+  // Publishes the state's changes. On failure the state is discarded, and
+  // must be loaded again.
+  Result Commit();
+  // Discards the state, which must be loaded again.
+  void Discard();
+
+  const sync_pb::SyncVaultCheckpoint& checkpoint() const { return checkpoint_; }
+  // Payload bytes of the current snapshot and the deltas after it.
+  uint64_t payload_bytes() const {
+    return head_commit_.epoch_snapshot_bytes() +
+           head_commit_.epoch_delta_bytes();
+  }
+
+ private:
+  struct Head {
+    // Empty for a vault without commits.
+    std::string commit_digest;
+    std::string revision;
+  };
+  struct CommitEntry {
+    std::string digest;
+    sync_pb::SyncVaultCommit commit;
+  };
+
+  SyncVaultStore(std::unique_ptr<SyncVaultTransport> transport,
+                 std::unique_ptr<SyncVaultCryptographer> cryptographer,
+                 sync_pb::SyncVaultCheckpoint checkpoint,
+                 PersistCheckpointCallback persist_checkpoint);
+
+  base::expected<Head, SyncVaultStoreError> ReadHead();
+  Result WriteHead(const std::string& commit_digest);
+  base::expected<sync_pb::SyncVaultCommit, SyncVaultStoreError> ReadCommit(
+      const std::string& digest);
+  // Reads the head's commit and the commits after the checkpoint, newest
+  // first, verifying that they descend from it.
+  base::expected<std::vector<CommitEntry>, SyncVaultStoreError> ReadNewCommits(
+      const std::string& head_digest);
+  Result ReadPayload(const sync_pb::SyncVaultCommit& commit);
+  // Writes the state's snapshot or delta, and returns its size.
+  base::expected<uint64_t, SyncVaultStoreError> WritePayload(
+      bool snapshot,
+      sync_pb::SyncVaultCommit& commit);
+
+  base::expected<std::vector<uint8_t>, SyncVaultStoreError> ReadImmutableObject(
+      SyncVaultObjectRole role,
+      const std::string& digest,
+      size_t maximum_bytes);
+  // Returns the digest that names the encrypted object.
+  base::expected<std::string, SyncVaultStoreError> WriteImmutableObject(
+      SyncVaultObjectRole role,
+      base::span<const uint8_t> plaintext,
+      uint32_t epoch);
+
+  Result WriteCommit();
+  Result AdvanceCheckpoint(const CommitEntry& entry);
+  void MaybeCollectEpochs();
+  void OnEpochsCollected(uint32_t minimum_retained_epoch,
+                         SyncVaultTransport::CollectResult result);
+
+  std::unique_ptr<SyncVaultTransport> transport_;
+  std::unique_ptr<SyncVaultCryptographer> cryptographer_;
+  sync_pb::SyncVaultCheckpoint checkpoint_;
+  PersistCheckpointCallback persist_checkpoint_;
+
+  // The loaded state and the head it corresponds to.
+  std::unique_ptr<LoopbackServerVaultState> state_;
+  Head head_;
+  // `head_`'s commit without its payload.
+  sync_pb::SyncVaultCommit head_commit_;
+
+  uint32_t collected_epochs_before_ = 0;
+  bool collection_in_progress_ = false;
+  base::TimeTicks next_collection_attempt_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<SyncVaultStore> weak_ptr_factory_{this};
+};
+
+}  // namespace syncer
