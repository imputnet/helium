+void SyncVaultStore::SetCancelationSignal(
+    CancelationSignal* cancelation_signal) {
+  transport_->SetCancelationSignal(cancelation_signal);
+}
+
+SyncVaultStore::Result SyncVaultStore::Initialize() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  sync_pb::SyncVaultHead head;
+  head.set_format_version(kSyncVaultFormatVersion);
+  auto encrypted =
+      cryptographer_->Encrypt(SyncVaultObjectRole::kHead, Serialize(head));
+  if (!encrypted.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted.error()));
+  }
+  auto written = transport_->WriteObject(kHeadObjectId, std::nullopt,
+                                         std::move(*encrypted), std::nullopt);
+  if (written.has_value()) {
+    return base::ok();
+  }
+  if (written.error() != SyncVaultTransportError::kConflict &&
+      !IsAmbiguousWriteError(written.error())) {
+    return base::unexpected(MapTransportError(written.error()));
+  }
+  // The head exists already, possibly from this write.
+  return Verify();
+}
+
+SyncVaultStore::Result SyncVaultStore::Verify() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto head = ReadHead();
+  if (!head.has_value()) {
+    return base::unexpected(head.error());
+  }
+  if (head->commit_digest.empty()) {
+    return base::ok();
+  }
+  auto commits = ReadNewCommits(head->commit_digest);
+  if (!commits.has_value()) {
+    return base::unexpected(commits.error());
+  }
+  return AdvanceCheckpoint(commits->front());
+}
+
+base::expected<bool, SyncVaultStoreError> SyncVaultStore::Load() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto head = ReadHead();
+  if (!head.has_value()) {
+    return base::unexpected(head.error());
+  }
+  if (state_ && head->commit_digest == head_.commit_digest) {
+    head_.revision = std::move(head->revision);
+    return false;
+  }
+  if (head->commit_digest.empty()) {
+    state_ = std::make_unique<LoopbackServerVaultState>();
+    head_ = std::move(*head);
+    head_commit_.Clear();
+    return true;
+  }
+
+  auto new_commits = ReadNewCommits(head->commit_digest);
+  if (!new_commits.has_value()) {
+    return base::unexpected(new_commits.error());
+  }
+  std::vector<CommitEntry>& commits = *new_commits;
+  const uint64_t epoch_start = commits.front().commit.epoch_start_generation();
+
+  // Apply the new commits to the loaded state when they follow it, and
+  // otherwise rebuild it from the latest snapshot.
+  const bool follows_state =
+      state_ && !head_.commit_digest.empty() &&
+      IsValidSyncVaultCommitTransition(head_.commit_digest, head_commit_,
+                                       commits.back().commit);
+  if (!follows_state) {
+    // Do not keep the old state in memory while building the new one.
+    state_.reset();
+    while (commits.back().commit.generation() > epoch_start) {
+      const std::string digest = commits.back().commit.parent_commit_digest();
+      auto parent = ReadCommit(digest);
+      if (!parent.has_value()) {
+        return base::unexpected(parent.error());
+      }
+      if (!IsValidSyncVaultCommitTransition(digest, *parent,
+                                            commits.back().commit)) {
+        return base::unexpected(SyncVaultStoreError::kInvalidData);
+      }
+      commits.push_back({digest, std::move(*parent)});
+    }
+    while (commits.back().commit.generation() < epoch_start) {
+      commits.pop_back();
+    }
+    state_ = std::make_unique<LoopbackServerVaultState>();
+  }
+  for (auto it = commits.rbegin(); it != commits.rend(); ++it) {
+    Result applied = ReadPayload(it->commit);
+    if (!applied.has_value()) {
+      state_.reset();
+      return base::unexpected(applied.error());
+    }
+  }
+
+  CommitEntry& latest = commits.front();
+  latest.commit.clear_inline_payload();
+  latest.commit.clear_payload_chunk_digests();
+  head_ = std::move(*head);
+  head_commit_ = latest.commit;
+  Result advanced = AdvanceCheckpoint(latest);
+  if (!advanced.has_value()) {
+    state_.reset();
+    return base::unexpected(advanced.error());
+  }
+  MaybeCollectEpochs();
+  return true;
+}
+
+SyncVaultStore::Result SyncVaultStore::Commit() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(state_);
+  Result result = WriteCommit();
+  if (!result.has_value()) {
+    state_.reset();
+  }
+  return result;
+}
+
+void SyncVaultStore::Discard() {
+  state_.reset();
+}
+
+SyncVaultStore::Result SyncVaultStore::WriteCommit() {
+  const bool has_commits = !head_.commit_digest.empty();
+  const uint64_t epoch_commits =
+      has_commits ? head_commit_.generation() -
+                        head_commit_.epoch_start_generation() + 1
+                  : 0;
+  const bool snapshot = !has_commits || state_->RequiresSnapshot() ||
+                        epoch_commits >= kSyncVaultEpochCommitTarget ||
+                        head_commit_.epoch_delta_bytes() >=
+                            std::max(kMinimumEpochDeltaBytes,
+                                     head_commit_.epoch_snapshot_bytes());
+
+  sync_pb::SyncVaultCommit commit;
+  commit.set_format_version(kSyncVaultFormatVersion);
+  commit.set_generation(head_commit_.generation() + 1);
+  if (has_commits) {
+    commit.set_parent_commit_digest(head_.commit_digest);
+  }
+  if (snapshot) {
+    // Each snapshot starts an epoch. The previous epoch is kept so that
+    // profiles which loaded it can still catch up from their checkpoint.
+    commit.set_epoch(has_commits ? head_commit_.epoch() + 1 : 0);
+    commit.set_epoch_start_generation(commit.generation());
+    commit.set_minimum_retained_generation(
+        has_commits ? head_commit_.epoch_start_generation() : 0);
+  } else {
+    commit.set_epoch(head_commit_.epoch());
+    commit.set_epoch_start_generation(head_commit_.epoch_start_generation());
+    commit.set_minimum_retained_generation(
+        head_commit_.minimum_retained_generation());
+    commit.set_epoch_snapshot_bytes(head_commit_.epoch_snapshot_bytes());
+  }
+
+  auto payload_bytes = WritePayload(snapshot, commit);
+  if (!payload_bytes.has_value()) {
+    return base::unexpected(payload_bytes.error());
+  }
+  if (snapshot) {
+    commit.set_epoch_snapshot_bytes(*payload_bytes);
+    commit.set_epoch_delta_bytes(0);
+  } else {
+    commit.set_epoch_delta_bytes(head_commit_.epoch_delta_bytes() +
+                                 *payload_bytes);
+  }
+
+  auto digest = WriteImmutableObject(SyncVaultObjectRole::kCommit,
+                                     Serialize(commit), commit.epoch());
+  if (!digest.has_value()) {
+    return base::unexpected(digest.error());
+  }
+  Result head_written = WriteHead(*digest);
+  if (!head_written.has_value()) {
+    return head_written;
+  }
+
+  state_->MarkWritten();
+  commit.clear_inline_payload();
+  commit.clear_payload_chunk_digests();
+  head_commit_ = commit;
+  Result advanced = AdvanceCheckpoint({std::move(*digest), std::move(commit)});
+  if (!advanced.has_value()) {
+    return advanced;
+  }
+  MaybeCollectEpochs();
+  return base::ok();
+}
+
+base::expected<SyncVaultStore::Head, SyncVaultStoreError>
+SyncVaultStore::ReadHead() {
+  auto object = transport_->ReadObject(kHeadObjectId, kMaximumHeadBytes);
+  if (!object.has_value()) {
+    return base::unexpected(MapTransportError(object.error()));
+  }
+  if (!object->has_value()) {
+    return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+  }
+  if (!IsValidSyncVaultRevision((*object)->revision)) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  auto plaintext =
+      cryptographer_->Decrypt(SyncVaultObjectRole::kHead, (*object)->data);
+  if (!plaintext.has_value()) {
+    return base::unexpected(MapCryptoError(plaintext.error()));
+  }
+  auto head = ParseSyncVaultHead(*plaintext);
+  if (!head.has_value()) {
+    return base::unexpected(MapFormatError(head.error()));
+  }
+
+  // The head is only empty before the first commit.
+  if (head->commit_digest().empty() && checkpoint_.generation() != 0) {
+    return base::unexpected(SyncVaultStoreError::kRollback);
+  }
+
+  return Head{head->commit_digest(), std::move((*object)->revision)};
+}
+
+SyncVaultStore::Result SyncVaultStore::WriteHead(
+    const std::string& commit_digest) {
+  sync_pb::SyncVaultHead head;
+  head.set_format_version(kSyncVaultFormatVersion);
+  head.set_commit_digest(commit_digest);
+  auto encrypted =
+      cryptographer_->Encrypt(SyncVaultObjectRole::kHead, Serialize(head));
+  if (!encrypted.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted.error()));
+  }
+  auto written = transport_->WriteObject(kHeadObjectId, head_.revision,
+                                         std::move(*encrypted), std::nullopt);
+  if (!written.has_value() && IsAmbiguousWriteError(written.error())) {
+    auto current = ReadHead();
+    if (current.has_value() && current->commit_digest == commit_digest) {
+      written = std::move(current->revision);
+    }
+  }
+  if (!written.has_value()) {
+    return base::unexpected(MapTransportError(written.error()));
+  }
+  if (!IsValidSyncVaultRevision(*written)) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  head_ = {commit_digest, std::move(*written)};
+  return base::ok();
+}
+
+base::expected<sync_pb::SyncVaultCommit, SyncVaultStoreError>
+SyncVaultStore::ReadCommit(const std::string& digest) {
+  auto plaintext = ReadImmutableObject(SyncVaultObjectRole::kCommit, digest,
+                                       kMaximumCommitBytes);
+  if (!plaintext.has_value()) {
+    return base::unexpected(plaintext.error());
+  }
+  auto commit = ParseSyncVaultCommit(*plaintext);
+  if (!commit.has_value()) {
+    return base::unexpected(MapFormatError(commit.error()));
+  }
+  return std::move(*commit);
+}
+
+base::expected<std::vector<SyncVaultStore::CommitEntry>, SyncVaultStoreError>
+SyncVaultStore::ReadNewCommits(const std::string& head_digest) {
+  auto latest = ReadCommit(head_digest);
+  if (!latest.has_value()) {
+    return base::unexpected(latest.error());
+  }
+  const uint64_t checkpoint_generation = checkpoint_.generation();
+  const uint64_t latest_generation = latest->generation();
+  if (latest_generation < checkpoint_generation) {
+    return base::unexpected(SyncVaultStoreError::kRollback);
+  }
+  if (latest_generation == checkpoint_generation &&
+      head_digest != checkpoint_.commit_digest()) {
+    return base::unexpected(SyncVaultStoreError::kFork);
+  }
+  std::vector<CommitEntry> commits;
+  commits.push_back({head_digest, std::move(*latest)});
+  // Without the checkpoint's commit to link to, accept the head as is.
+  if (latest_generation == checkpoint_generation ||
+      checkpoint_generation == 0 ||
+      checkpoint_generation <
+          commits.front().commit.minimum_retained_generation()) {
+    return commits;
+  }
+  if (latest_generation - checkpoint_generation > kMaximumCommitAncestry) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  while (commits.back().commit.generation() > checkpoint_generation + 1) {
+    const std::string digest = commits.back().commit.parent_commit_digest();
+    auto parent = ReadCommit(digest);
+    if (!parent.has_value()) {
+      return base::unexpected(parent.error());
+    }
+    if (!IsValidSyncVaultCommitTransition(digest, *parent,
+                                          commits.back().commit)) {
+      return base::unexpected(SyncVaultStoreError::kInvalidData);
+    }
+    commits.push_back({digest, std::move(*parent)});
+  }
+  if (commits.back().commit.parent_commit_digest() !=
+      checkpoint_.commit_digest()) {
+    return base::unexpected(SyncVaultStoreError::kFork);
+  }
+  return commits;
+}
+
+SyncVaultStore::Result SyncVaultStore::ReadPayload(
+    const sync_pb::SyncVaultCommit& commit) {
+  bool inline_payload_read = false;
+  int next_chunk = 0;
+  std::vector<uint8_t> chunk;
+  std::optional<SyncVaultStoreError> error;
+  auto reader = [&]() -> base::span<const uint8_t> {
+    if (commit.has_inline_payload()) {
+      if (inline_payload_read) {
+        return {};
+      }
+      inline_payload_read = true;
+      return base::as_byte_span(commit.inline_payload());
+    }
+    if (error || next_chunk == commit.payload_chunk_digests_size()) {
+      return {};
+    }
+    auto plaintext =
+        ReadImmutableObject(SyncVaultObjectRole::kPayload,
+                            commit.payload_chunk_digests(next_chunk++),
+                            kSyncVaultMaximumEncryptedObjectBytes);
+    if (!plaintext.has_value()) {
+      error = plaintext.error();
+      return {};
+    }
+    chunk = std::move(*plaintext);
+    return chunk;
+  };
+  const LoopbackServerVaultState::ReadResult result = state_->Read(
+      reader, commit.generation() == commit.epoch_start_generation());
+  if (error) {
+    return base::unexpected(*error);
+  }
+  switch (result) {
+    case LoopbackServerVaultState::ReadResult::kSuccess:
+      if (next_chunk != commit.payload_chunk_digests_size()) {
+        return base::unexpected(SyncVaultStoreError::kInvalidData);
+      }
+      return base::ok();
+    case LoopbackServerVaultState::ReadResult::kMalformed:
+      return base::unexpected(SyncVaultStoreError::kInvalidData);
+    case LoopbackServerVaultState::ReadResult::kUnsupportedVersion:
+      return base::unexpected(SyncVaultStoreError::kUnsupportedVersion);
+  }
+  NOTREACHED();
+}
+
+base::expected<uint64_t, SyncVaultStoreError> SyncVaultStore::WritePayload(
+    bool snapshot,
+    sync_pb::SyncVaultCommit& commit) {
+  std::vector<uint8_t> buffer;
+  uint64_t total_bytes = 0;
+  std::optional<SyncVaultStoreError> error;
+  auto flush = [&] {
+    auto digest = WriteImmutableObject(SyncVaultObjectRole::kPayload, buffer,
+                                       commit.epoch());
+    if (!digest.has_value()) {
+      error = digest.error();
+      return false;
+    }
+    commit.add_payload_chunk_digests(std::move(*digest));
+    buffer.clear();
+    return true;
+  };
+  auto writer = [&](base::span<const uint8_t> bytes) {
+    total_bytes += bytes.size();
+    while (!bytes.empty()) {
+      if (buffer.size() == kPayloadChunkBytes && !flush()) {
+        return false;
+      }
+      const size_t count =
+          std::min(bytes.size(), kPayloadChunkBytes - buffer.size());
+      buffer.insert(buffer.end(), bytes.begin(), bytes.begin() + count);
+      bytes = bytes.subspan(count);
+    }
+    return true;
+  };
+  const bool written =
+      snapshot ? state_->WriteSnapshot(writer) : state_->WriteDelta(writer);
+  if (error) {
+    return base::unexpected(*error);
+  }
+  if (!written) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  if (commit.payload_chunk_digests_size() == 0 &&
+      buffer.size() <= kMaximumInlinePayloadBytes) {
+    commit.set_inline_payload(buffer.data(), buffer.size());
+  } else if (!flush()) {
+    return base::unexpected(*error);
+  }
+  return total_bytes;
+}
+
+base::expected<std::vector<uint8_t>, SyncVaultStoreError>
+SyncVaultStore::ReadImmutableObject(SyncVaultObjectRole role,
+                                    const std::string& digest,
+                                    size_t maximum_bytes) {
+  auto object =
+      transport_->ReadObject(GetSyncVaultObjectId(digest), maximum_bytes);
+  if (!object.has_value()) {
+    return base::unexpected(MapTransportError(object.error()));
+  }
+  if (!object->has_value()) {
+    return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+  }
+  if (Digest((*object)->data) != digest) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  auto plaintext = cryptographer_->Decrypt(role, (*object)->data);
+  if (!plaintext.has_value()) {
+    return base::unexpected(MapCryptoError(plaintext.error()));
+  }
+  return std::move(*plaintext);
+}
+
+base::expected<std::string, SyncVaultStoreError>
+SyncVaultStore::WriteImmutableObject(SyncVaultObjectRole role,
+                                     base::span<const uint8_t> plaintext,
+                                     uint32_t epoch) {
+  auto encrypted = cryptographer_->Encrypt(role, plaintext);
+  if (!encrypted.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted.error()));
+  }
+  std::string digest = Digest(*encrypted);
+  const std::string object_id = GetSyncVaultObjectId(digest);
+  auto written = transport_->WriteObject(object_id, std::nullopt,
+                                         std::move(*encrypted), epoch);
+  if (written.has_value()) {
+    return digest;
+  }
+  if (written.error() != SyncVaultTransportError::kConflict &&
+      !IsAmbiguousWriteError(written.error())) {
+    return base::unexpected(MapTransportError(written.error()));
+  }
+  // The object may exist already, as its name is its content's digest.
+  auto existing =
+      transport_->ReadObject(object_id, kSyncVaultMaximumEncryptedObjectBytes);
+  if (existing.has_value() && existing->has_value() &&
+      Digest((*existing)->data) == digest) {
+    return digest;
+  }
+  return base::unexpected(MapTransportError(written.error()));
+}
+
+SyncVaultStore::Result SyncVaultStore::AdvanceCheckpoint(
+    const CommitEntry& entry) {
+  if (entry.commit.generation() <= checkpoint_.generation()) {
+    return base::ok();
+  }
+  sync_pb::SyncVaultCheckpoint checkpoint = checkpoint_;
+  checkpoint.set_generation(entry.commit.generation());
+  checkpoint.set_commit_digest(entry.digest);
+  if (!persist_checkpoint_.Run(checkpoint)) {
+    return base::unexpected(SyncVaultStoreError::kCheckpointPersistenceFailed);
+  }
+  checkpoint_ = std::move(checkpoint);
+  return base::ok();
+}
+
+void SyncVaultStore::MaybeCollectEpochs() {
+  // Objects from before the previous epoch are no longer referenced.
+  if (head_commit_.epoch() <= 1) {
+    return;
+  }
+  const uint32_t minimum_retained_epoch = head_commit_.epoch() - 1;
+  if (collected_epochs_before_ >= minimum_retained_epoch ||
+      collection_in_progress_ ||
+      base::TimeTicks::Now() < next_collection_attempt_) {
+    return;
+  }
+  collection_in_progress_ = true;
+  transport_->CollectEpochsBefore(
+      minimum_retained_epoch,
+      base::BindOnce(&SyncVaultStore::OnEpochsCollected,
+                     weak_ptr_factory_.GetWeakPtr(), minimum_retained_epoch));
+}
+
+void SyncVaultStore::OnEpochsCollected(
+    uint32_t minimum_retained_epoch,
+    SyncVaultTransport::CollectResult result) {
+  collection_in_progress_ = false;
+  if (result.has_value()) {
+    collected_epochs_before_ = minimum_retained_epoch;
+  } else {
+    next_collection_attempt_ =
+        base::TimeTicks::Now() + kEpochCollectionRetryDelay;
+  }
+}
+
