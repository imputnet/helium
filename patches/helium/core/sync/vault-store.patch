+SyncVaultStore::StateDataResult SyncVaultStore::ReconstructState(
+    AuthenticatedHead* authenticated) const {
+  CHECK(authenticated);
+  CHECK(!authenticated->commits_newest_first.empty());
+  const uint64_t epoch_start_generation =
+      authenticated->commits_newest_first.front()
+          .commit.header.epoch_start_generation;
+  const uint32_t epoch =
+      authenticated->commits_newest_first.front().commit.header.epoch;
+  while (authenticated->commits_newest_first.back().commit.header.generation >
+         epoch_start_generation) {
+    const CommitEntry& child = authenticated->commits_newest_first.back();
+    if (child.commit.header.generation ==
+            child.commit.header.epoch_start_generation ||
+        !child.commit.parent_commit_digest) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    CommitObjectResult parent_result =
+        ReadCommit(*child.commit.parent_commit_digest);
+    if (!parent_result.has_value()) {
+      return base::unexpected(parent_result.error());
+    }
+    SyncVaultCommit parent = std::move(parent_result.value());
+    if (!IsValidSyncVaultCommitTransition(*child.commit.parent_commit_digest,
+                                          parent.header, child.commit) ||
+        parent.header.epoch != epoch) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    SyncVaultObjectDigest parent_commit_digest =
+        *child.commit.parent_commit_digest;
+    authenticated->commits_newest_first.push_back(
+        {std::move(parent_commit_digest), std::move(parent)});
+  }
+
+  const auto snapshot = std::ranges::find_if(
+      authenticated->commits_newest_first,
+      [epoch_start_generation](const CommitEntry& entry) {
+        return entry.commit.header.generation == epoch_start_generation;
+      });
+  if (snapshot == authenticated->commits_newest_first.end()) {
+    return base::unexpected(SyncVaultStoreError::kMalformedObject);
+  }
+  StateDataResult state = TakePayload(&snapshot->commit);
+  if (!state.has_value()) {
+    return base::unexpected(state.error());
+  }
+  SyncVaultStateValidationResult snapshot_validation =
+      state_codec_->ValidateSnapshot(state.value());
+  if (!snapshot_validation.has_value()) {
+    return base::unexpected(
+        MapStateDeltaReadError(snapshot_validation.error()));
+  }
+  const size_t delta_count =
+      std::distance(authenticated->commits_newest_first.begin(), snapshot);
+  if (delta_count == 0) {
+    return state;
+  }
+  return ApplyCommitPayloads(
+      state.value(),
+      base::span(authenticated->commits_newest_first).first(delta_count));
+}
+
+SyncVaultStore::StateDataResult SyncVaultStore::ApplyCommitPayloads(
+    base::span<const uint8_t> base_state,
+    base::span<CommitEntry> newest_first) const {
+  auto reconstruction = state_codec_->StartReconstruction(base_state);
+  if (!reconstruction.has_value()) {
+    return base::unexpected(MapStateDeltaReadError(reconstruction.error()));
+  }
+  for (auto it = newest_first.rbegin(); it != newest_first.rend(); ++it) {
+    StateDataResult payload = TakePayload(&it->commit);
+    if (!payload.has_value()) {
+      return base::unexpected(payload.error());
+    }
+    auto applied = (*reconstruction)->ApplyDelta(*payload);
+    if (!applied.has_value()) {
+      return base::unexpected(MapStateDeltaReadError(applied.error()));
+    }
+  }
+  auto applied = (*reconstruction)->Finish();
+  if (!applied.has_value()) {
+    return base::unexpected(MapStateDeltaReadError(applied.error()));
+  }
+  return std::move(applied.value());
+}
+
+SyncVaultStore::CommitResult SyncVaultStore::CommitMutation(
+    const SyncVaultState& base_state,
+    std::optional<std::vector<uint8_t>> delta,
+    size_t resulting_state_size,
+    SnapshotCallback snapshot) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!OwnsState(base_state) || !snapshot ||
+      base_state.generation() == std::numeric_limits<uint64_t>::max() ||
+      resulting_state_size == 0) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  const bool use_delta = base_state.generation() > 0 && delta &&
+                         !delta->empty() &&
+                         delta->size() < resulting_state_size;
+  const SyncVaultCommitHeader* base_commit =
+      base_state.commit_header() ? &*base_state.commit_header() : nullptr;
+  const uint64_t base_generation = base_state.generation();
+  const uint64_t base_epoch_payload_bytes =
+      base_commit ? base_commit->epoch_payload_bytes : 0;
+  const uint64_t commits_in_epoch =
+      base_commit ? base_generation - base_commit->epoch_start_generation + 1
+                  : 0;
+  const uint64_t pending_payload_bytes = base::checked_cast<uint64_t>(
+      use_delta ? delta->size() : resulting_state_size);
+  const uint64_t state_bytes =
+      base::checked_cast<uint64_t>(resulting_state_size);
+  const uint64_t epoch_payload_target = base::ClampAdd(
+      state_bytes, std::max(kMinimumEpochHistoryBytes, state_bytes));
+  const bool byte_target_reached =
+      base_epoch_payload_bytes >= epoch_payload_target ||
+      pending_payload_bytes >= epoch_payload_target - base_epoch_payload_bytes;
+  const bool start_new_epoch =
+      base_commit &&
+      (!use_delta || commits_in_epoch >= kSyncVaultEpochCommitTarget ||
+       byte_target_reached);
+  if (start_new_epoch &&
+      base_commit->epoch == std::numeric_limits<uint32_t>::max()) {
+    return base::unexpected(SyncVaultStoreError::kObjectTooLarge);
+  }
+  std::vector<uint8_t> payload_storage;
+  if (!use_delta || start_new_epoch) {
+    auto state = std::move(snapshot).Run();
+    if (!state || state->size() != resulting_state_size) {
+      return base::unexpected(SyncVaultStoreError::kInvalidData);
+    }
+    auto validation = state_codec_->ValidateSnapshot(*state);
+    if (!validation.has_value()) {
+      return base::unexpected(MapStateDeltaWriteError(validation.error()));
+    }
+    payload_storage = std::move(*state);
+  } else {
+    payload_storage = std::move(*delta);
+  }
+  base::span<const uint8_t> payload(payload_storage);
+
+  SyncVaultCommit commit;
+  commit.header.generation = base_generation + 1;
+  commit.parent_commit_digest = base_state.head().commit_digest;
+  commit.header.epoch = start_new_epoch
+                            ? base_commit->epoch + 1
+                            : (base_commit ? base_commit->epoch : 0);
+  commit.header.epoch_start_generation =
+      start_new_epoch || !base_commit ? commit.header.generation
+                                      : base_commit->epoch_start_generation;
+  commit.header.minimum_retained_generation =
+      start_new_epoch
+          ? (commit.header.epoch <= 1 ? 0 : base_commit->epoch_start_generation)
+          : (base_commit ? base_commit->minimum_retained_generation : 0);
+  base::CheckedNumeric<uint64_t> epoch_payload_bytes =
+      start_new_epoch ? 0 : base_epoch_payload_bytes;
+  epoch_payload_bytes += payload.size();
+  if (!epoch_payload_bytes.IsValid()) {
+    return base::unexpected(SyncVaultStoreError::kObjectTooLarge);
+  }
+  commit.header.epoch_payload_bytes = epoch_payload_bytes.ValueOrDie();
+
+  SyncVaultSerializeResult serialized_commit =
+      base::unexpected(SyncVaultFormatError::kLimitExceeded);
+  if (payload.size() < kSyncVaultMaximumCommitPlaintextBytes) {
+    commit.inline_payload.assign(payload.begin(), payload.end());
+    serialized_commit = SerializeSyncVaultCommit(commit);
+  }
+  if (!serialized_commit.has_value() &&
+      serialized_commit.error() == SyncVaultFormatError::kLimitExceeded) {
+    std::vector<uint8_t>().swap(commit.inline_payload);
+    for (size_t offset = 0; offset < payload.size();) {
+      const size_t chunk_size = std::min(
+          payload.size() - offset, kSyncVaultMaximumPayloadPlaintextBytes);
+      auto encrypted = cryptographer_->Encrypt(
+          SyncVaultObjectRole::kPayload, payload.subspan(offset, chunk_size));
+      if (!encrypted.has_value()) {
+        return base::unexpected(MapCryptoError(encrypted.error()));
+      }
+      const SyncVaultObjectDigest object_digest =
+          ContentDigest(encrypted.value());
+      WriteResult write = WriteImmutableObject(
+          object_digest, std::move(encrypted.value()), commit.header.epoch);
+      if (!write.has_value()) {
+        return base::unexpected(write.error());
+      }
+      commit.payload_chunk_digests.push_back(object_digest);
+      offset += chunk_size;
+    }
+    commit.external_payload_size = base::checked_cast<uint32_t>(payload.size());
+  } else if (!serialized_commit.has_value()) {
+    return base::unexpected(MapFormatError(serialized_commit.error()));
+  }
+  if (commit.inline_payload.empty()) {
+    serialized_commit = SerializeSyncVaultCommit(commit);
+    if (!serialized_commit.has_value()) {
+      return base::unexpected(MapFormatError(serialized_commit.error()));
+    }
+  }
+
+  auto encrypted_commit = cryptographer_->Encrypt(SyncVaultObjectRole::kCommit,
+                                                  serialized_commit.value());
+  if (!encrypted_commit.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted_commit.error()));
+  }
+  const SyncVaultObjectDigest commit_digest =
+      ContentDigest(encrypted_commit.value());
+  WriteResult commit_write = WriteImmutableObject(
+      commit_digest, std::move(encrypted_commit.value()), commit.header.epoch);
+  if (!commit_write.has_value()) {
+    return base::unexpected(commit_write.error());
+  }
+
+  SyncVaultHead new_head{commit_digest};
+  auto serialized_head = SerializeSyncVaultHead(new_head);
+  if (!serialized_head.has_value()) {
+    return base::unexpected(MapFormatError(serialized_head.error()));
+  }
+  auto encrypted_head = cryptographer_->Encrypt(SyncVaultObjectRole::kHead,
+                                                serialized_head.value());
+  if (!encrypted_head.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted_head.error()));
+  }
+  WriteResult head_write =
+      WriteObject(kHeadObjectId, base_state.head_revision(),
+                  std::move(encrypted_head.value()), std::nullopt);
+  std::string committed_head_revision;
+  if (!head_write.has_value()) {
+    if (head_write.error() == SyncVaultStoreError::kConflict) {
+      return base::unexpected(SyncVaultStoreError::kConflict);
+    }
+    if (!IsAmbiguousWriteError(head_write.error())) {
+      return base::unexpected(head_write.error());
+    }
+    HeadResult current = ReadHead();
+    if (!current.has_value() || current->head != new_head) {
+      return base::unexpected(head_write.error());
+    }
+    committed_head_revision = std::move(current->revision);
+  } else {
+    committed_head_revision = std::move(head_write.value());
+  }
+  if (!AdvanceCheckpoint(new_head, commit.header)) {
+    return base::unexpected(SyncVaultStoreError::kCheckpointPersistenceFailed);
+  }
+  MaybeCollectEpochs(commit);
+  return SyncVaultState(std::nullopt, std::move(new_head), commit.header,
+                        std::move(committed_head_revision), store_token_,
+                        resulting_state_size);
+}
+
+SyncVaultStore::ObjectResult SyncVaultStore::ReadObject(
+    const std::string& object_id,
+    size_t maximum_bytes) const {
+  SyncVaultTransport::ReadResult result =
+      transport_->ReadObject(object_id, maximum_bytes);
+  if (!result.has_value()) {
+    return base::unexpected(MapTransportError(result.error()));
+  }
+  if (result->has_value() &&
+      (result->value().data.size() > maximum_bytes ||
+       !IsValidSyncVaultRevision(result->value().revision))) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  return std::move(result.value());
+}
+
+SyncVaultStore::WriteResult SyncVaultStore::WriteObject(
+    const std::string& object_id,
+    std::optional<std::string> expected_revision,
+    std::vector<uint8_t> data,
+    std::optional<uint32_t> retention_epoch) {
+  SyncVaultTransport::WriteResult result =
+      transport_->WriteObject(object_id, std::move(expected_revision),
+                              std::move(data), retention_epoch);
+  if (!result.has_value()) {
+    return base::unexpected(MapTransportError(result.error()));
+  }
+  if (!IsValidSyncVaultRevision(result.value())) {
+    return base::unexpected(SyncVaultStoreError::kInvalidData);
+  }
+  return std::move(result.value());
+}
+
+SyncVaultStore::HeadResult SyncVaultStore::ReadHead() {
+  ObjectResult object =
+      ReadObject(kHeadObjectId, kMaximumMetadataContainerBytes);
+  if (!object.has_value()) {
+    return base::unexpected(object.error());
+  }
+  if (!object->has_value()) {
+    return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+  }
+  auto plaintext =
+      cryptographer_->Decrypt(SyncVaultObjectRole::kHead, object->value().data);
+  if (!plaintext.has_value()) {
+    return base::unexpected(MapCryptoError(plaintext.error()));
+  }
+  auto head = ParseSyncVaultHead(plaintext.value());
+  if (!head.has_value()) {
+    return base::unexpected(MapFormatError(head.error()));
+  }
+  return VersionedHead{std::move(head.value()),
+                       std::move(object->value().revision)};
+}
+
+SyncVaultStore::AuthenticatedHeadResult SyncVaultStore::AuthenticateHead(
+    const SyncVaultHead& head) const {
+  if (!head.commit_digest) {
+    return base::unexpected(SyncVaultStoreError::kMalformedObject);
+  }
+  CommitObjectResult latest_result = ReadCommit(*head.commit_digest);
+  if (!latest_result.has_value()) {
+    return base::unexpected(latest_result.error());
+  }
+  SyncVaultCommit latest = std::move(latest_result.value());
+
+  const bool is_current_checkpoint =
+      latest.header.generation <= checkpoint_.generation;
+  if (is_current_checkpoint) {
+    const SyncVaultHistoryValidationResult validation =
+        ValidateSyncVaultHistory(checkpoint_, latest, *head.commit_digest, {});
+    if (validation == SyncVaultHistoryValidationResult::kRollback) {
+      return base::unexpected(SyncVaultStoreError::kRollback);
+    }
+    if (validation != SyncVaultHistoryValidationResult::kAcceptCurrent) {
+      return base::unexpected(SyncVaultStoreError::kFork);
+    }
+  }
+
+  AuthenticatedHead authenticated;
+  authenticated.commits_newest_first.push_back(
+      {*head.commit_digest, std::move(latest)});
+  if (is_current_checkpoint) {
+    return authenticated;
+  }
+  const uint64_t latest_generation =
+      authenticated.commits_newest_first.front().commit.header.generation;
+  const uint64_t minimum_retained_generation =
+      authenticated.commits_newest_first.front()
+          .commit.header.minimum_retained_generation;
+  if (checkpoint_.generation == 0 ||
+      checkpoint_.generation < minimum_retained_generation) {
+    if (ValidateSyncVaultHistory(
+            checkpoint_, authenticated.commits_newest_first.front().commit,
+            *head.commit_digest,
+            {}) != SyncVaultHistoryValidationResult::kAcceptBaseline) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    return authenticated;
+  }
+  if (latest_generation - checkpoint_.generation >
+      kSyncVaultMaximumCommitAncestry) {
+    return base::unexpected(SyncVaultStoreError::kObjectTooLarge);
+  }
+
+  std::vector<AuthenticatedSyncVaultCommit> ancestry;
+  SyncVaultObjectDigest commit_digest = *head.commit_digest;
+  while (true) {
+    const SyncVaultCommit& commit =
+        authenticated.commits_newest_first.back().commit;
+    ancestry.push_back(
+        {commit_digest, commit.header.generation, commit.parent_commit_digest});
+    if (commit.header.generation == checkpoint_.generation + 1) {
+      break;
+    }
+    if (commit.header.generation <= checkpoint_.generation + 1 ||
+        ancestry.size() >= kSyncVaultMaximumCommitAncestry ||
+        !commit.parent_commit_digest) {
+      return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+    }
+
+    commit_digest = *commit.parent_commit_digest;
+    CommitObjectResult parent_result = ReadCommit(commit_digest);
+    if (!parent_result.has_value()) {
+      return base::unexpected(parent_result.error());
+    }
+    SyncVaultCommit parent = std::move(parent_result.value());
+    if (!IsValidSyncVaultCommitTransition(commit_digest, parent.header,
+                                          commit)) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    authenticated.commits_newest_first.push_back(
+        {commit_digest, std::move(parent)});
+  }
+
+  switch (ValidateSyncVaultHistory(
+      checkpoint_, authenticated.commits_newest_first.front().commit,
+      *head.commit_digest, ancestry)) {
+    case SyncVaultHistoryValidationResult::kAcceptDescendant:
+      return authenticated;
+    case SyncVaultHistoryValidationResult::kRollback:
+      return base::unexpected(SyncVaultStoreError::kRollback);
+    case SyncVaultHistoryValidationResult::kFork:
+      return base::unexpected(SyncVaultStoreError::kFork);
+    case SyncVaultHistoryValidationResult::kIncompleteHistory:
+      return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+    case SyncVaultHistoryValidationResult::kAcceptCurrent:
+    case SyncVaultHistoryValidationResult::kAcceptBaseline:
+    case SyncVaultHistoryValidationResult::kInvalidHistory:
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+  }
+  NOTREACHED();
+}
+
+bool SyncVaultStore::OwnsState(const SyncVaultState& state) const {
+  return state.store_token_ == store_token_;
+}
+
+SyncVaultStore::CommitObjectResult SyncVaultStore::ReadCommit(
+    const SyncVaultObjectDigest& commit_digest) const {
+  ObjectResult result = ReadObject(GetSyncVaultImmutableObjectId(commit_digest),
+                                   kSyncVaultMaximumEncryptedObjectBytes);
+  if (!result.has_value()) {
+    return base::unexpected(result.error());
+  }
+  if (!result->has_value()) {
+    return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+  }
+  if (!HasValidContentAddress(commit_digest, result->value().data)) {
+    return base::unexpected(SyncVaultStoreError::kAuthenticationFailed);
+  }
+  auto plaintext = cryptographer_->Decrypt(SyncVaultObjectRole::kCommit,
+                                           result->value().data);
+  if (!plaintext.has_value()) {
+    return base::unexpected(MapCryptoError(plaintext.error()));
+  }
+  auto commit = ParseSyncVaultCommit(plaintext.value());
+  if (!commit.has_value()) {
+    return base::unexpected(MapFormatError(commit.error()));
+  }
+  return std::move(commit.value());
+}
+
+SyncVaultStore::WriteResult SyncVaultStore::InitializeVault() {
+  SyncVaultHead initial_head;
+  auto serialized_head = SerializeSyncVaultHead(initial_head);
+  if (!serialized_head.has_value()) {
+    return base::unexpected(MapFormatError(serialized_head.error()));
+  }
+  auto encrypted_head = cryptographer_->Encrypt(SyncVaultObjectRole::kHead,
+                                                serialized_head.value());
+  if (!encrypted_head.has_value()) {
+    return base::unexpected(MapCryptoError(encrypted_head.error()));
+  }
+  WriteResult head_write =
+      WriteObject(kHeadObjectId, std::nullopt,
+                  std::move(encrypted_head.value()), std::nullopt);
+  if (head_write.has_value()) {
+    return head_write;
+  }
+  if (head_write.error() != SyncVaultStoreError::kConflict &&
+      !IsAmbiguousWriteError(head_write.error())) {
+    return base::unexpected(head_write.error());
+  }
+  HeadResult existing_head = ReadHead();
+  if (!existing_head.has_value()) {
+    return base::unexpected(head_write.error());
+  }
+  if (existing_head->head.commit_digest) {
+    return base::unexpected(SyncVaultStoreError::kConflict);
+  }
+  return std::move(existing_head->revision);
+}
+
+SyncVaultStore::WriteResult SyncVaultStore::WriteImmutableObject(
+    const SyncVaultObjectDigest& object_digest,
+    std::vector<uint8_t> encrypted_data,
+    uint32_t retention_epoch) {
+  const std::string object_id = GetSyncVaultImmutableObjectId(object_digest);
+  WriteResult write = WriteObject(object_id, std::nullopt,
+                                  std::move(encrypted_data), retention_epoch);
+  if (write.has_value()) {
+    return write;
+  }
+  if (write.error() != SyncVaultStoreError::kConflict &&
+      !IsAmbiguousWriteError(write.error())) {
+    return base::unexpected(write.error());
+  }
+  ObjectResult existing =
+      ReadObject(object_id, kSyncVaultMaximumEncryptedObjectBytes);
+  if (existing.has_value() && existing->has_value() &&
+      HasValidContentAddress(object_digest, existing->value().data)) {
+    return existing->value().revision;
+  }
+  return base::unexpected(write.error());
+}
+
+bool SyncVaultStore::AdvanceCheckpoint(const SyncVaultHead& head,
+                                       const SyncVaultCommitHeader& commit) {
+  SyncVaultCheckpoint next{cryptographer_->vault_uuid(), commit.generation,
+                           head.commit_digest};
+  if (!persist_checkpoint_callback_.Run(next)) {
+    return false;
+  }
+  checkpoint_ = std::move(next);
+  return true;
+}
+
+void SyncVaultStore::MaybeCollectEpochs(const SyncVaultCommit& commit) {
+  if (commit.header.epoch <= 1) {
+    return;
+  }
+  const uint32_t minimum_retained_epoch = commit.header.epoch - 1;
+  if (last_collection_floor_ &&
+      *last_collection_floor_ >= minimum_retained_epoch) {
+    return;
+  }
+  if (collection_in_progress_ ||
+      base::TimeTicks::Now() < next_collection_attempt_) {
+    return;
+  }
+  collection_in_progress_ = true;
+  transport_->CollectEpochsBefore(
+      minimum_retained_epoch,
+      base::BindOnce(
+          [](base::WeakPtr<SyncVaultStore> store, uint32_t floor,
+             SyncVaultTransport::CollectResult result) {
+            if (!store) {
+              return;
+            }
+            store->collection_in_progress_ = false;
+            if (result.has_value()) {
+              store->last_collection_floor_ = floor;
+              store->next_collection_attempt_ = {};
+            } else {
+              store->next_collection_attempt_ =
+                  base::TimeTicks::Now() + base::Minutes(1);
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr(), minimum_retained_epoch));
+}
