+SyncVaultStore::StateDataResult SyncVaultStore::TakePayload(
+    SyncVaultCommit* commit) const {
+  CHECK(commit);
+  if (!commit->inline_payload.empty()) {
+    return std::move(commit->inline_payload);
+  }
+  std::vector<uint8_t> payload;
+  payload.reserve(commit->external_payload_size);
+  size_t remaining_bytes = commit->external_payload_size;
+  std::vector<SyncVaultObjectDigest> chunk_digests =
+      std::move(commit->payload_chunk_digests);
+  for (const SyncVaultObjectDigest& chunk_digest : chunk_digests) {
+    const size_t chunk_size =
+        std::min(remaining_bytes, kSyncVaultMaximumPayloadPlaintextBytes);
+    ObjectResult object =
+        ReadObject(GetSyncVaultImmutableObjectId(chunk_digest),
+                   kSyncVaultMaximumEncryptedObjectBytes);
+    if (!object.has_value()) {
+      return base::unexpected(object.error());
+    }
+    if (!object->has_value()) {
+      return base::unexpected(SyncVaultStoreError::kIncompleteHistory);
+    }
+    if (!HasValidContentAddress(chunk_digest, object->value().data)) {
+      return base::unexpected(SyncVaultStoreError::kAuthenticationFailed);
+    }
+    auto plaintext = cryptographer_->Decrypt(SyncVaultObjectRole::kPayload,
+                                             object->value().data);
+    if (!plaintext.has_value()) {
+      return base::unexpected(MapCryptoError(plaintext.error()));
+    }
+    if (plaintext->size() != chunk_size) {
+      return base::unexpected(SyncVaultStoreError::kMalformedObject);
+    }
+    payload.insert(payload.end(), plaintext->begin(), plaintext->end());
+    remaining_bytes -= chunk_size;
+  }
+  CHECK_EQ(remaining_bytes, 0u);
+  return payload;
+}
