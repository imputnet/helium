+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/url_formatter/url_cleaner.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/fixed_flat_set.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+
+namespace url_formatter {
+
+GURL StripTrackingParameters(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_query()) {
+    return url;
+  }
+
+  static constexpr auto kTrackingParameters =
+      base::MakeFixedFlatSet<std::string_view>({
+          "dclid",
+          "fbclid",
+          "gbraid",
+          "gclid",
+          "igshid",
+          "li_fat_id",
+          "mc_cid",
+          "mc_eid",
+          "msclkid",
+          "srsltid",
+          "ttclid",
+          "twclid",
+          "utm_campaign",
+          "utm_content",
+          "utm_creative_format",
+          "utm_id",
+          "utm_marketing_tactic",
+          "utm_medium",
+          "utm_source",
+          "utm_source_platform",
+          "utm_term",
+          "wbraid",
+      });
+
+  auto parameters = base::SplitStringPiece(
+      url.query(), "&", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  const auto removed = std::erase_if(parameters, [&url](std::string_view part) {
+    const std::string key = base::ToLowerASCII(base::UnescapeURLComponent(
+        part.substr(0, part.find('=')), base::UnescapeRule::NORMAL));
+    if (kTrackingParameters.contains(key)) {
+      return true;
+    }
+    // "si" also has functional uses, so only remove known share identifiers.
+    return key == "si" &&
+           (url.DomainIs("youtube.com") || url.DomainIs("youtu.be") ||
+            url.DomainIs("open.spotify.com"));
+  });
+  if (!removed) {
+    return url;
+  }
+
+  const std::string query = base::JoinString(parameters, "&");
+  GURL::Replacements replacements;
+  if (parameters.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace url_formatter
