+IN_PROC_BROWSER_TEST_F(RenderViewContextMenuViewsBrowserTest,
+                       CopyCleanLinkKeepsOrdinaryCopyIntact) {
+  content::ContextMenuParams params;
+  params.page_url = GURL("https://example.com/");
+  params.link_url =
+      GURL("https://example.org/path?utm_source=track&id=42#part");
+  params.unfiltered_link_url = params.link_url;
+  auto* clipboard = ui::Clipboard::GetForCurrentThread();
+
+  TestRenderViewContextMenuViews menu(GetPrimaryMainFrame(), params);
+  menu.Init();
+  const auto copy = menu.menu_model().GetIndexOfCommandId(
+      IDC_CONTENT_CONTEXT_COPYLINKLOCATION);
+  const auto clean = menu.menu_model().GetIndexOfCommandId(IDC_COPY_CLEAN_LINK);
+  ASSERT_TRUE(copy.has_value());
+  ASSERT_TRUE(clean.has_value());
+  EXPECT_EQ(*copy + 1, *clean);
+  ASSERT_TRUE(menu.IsCommandIdEnabled(IDC_COPY_CLEAN_LINK));
+  menu.ExecuteCommand(IDC_COPY_CLEAN_LINK, 0);
+  EXPECT_EQ("https://example.org/path?id=42#part",
+            ui::clipboard_test_util::ReadAsciiText(
+                clipboard, ui::ClipboardBuffer::kCopyPaste, nullptr));
+
+  TestRenderViewContextMenuViews original_menu(GetPrimaryMainFrame(), params);
+  original_menu.Init();
+  original_menu.ExecuteCommand(IDC_CONTENT_CONTEXT_COPYLINKLOCATION, 0);
+  EXPECT_EQ(params.link_url.spec(),
+            ui::clipboard_test_util::ReadAsciiText(
+                clipboard, ui::ClipboardBuffer::kCopyPaste, nullptr));
+}
