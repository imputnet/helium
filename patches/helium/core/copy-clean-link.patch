+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/url_formatter/url_cleaner.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace url_formatter {
+namespace {
+
+TEST(UrlCleanerTest, RemovesKnownTrackingParameters) {
+  for (const char* key : {"dclid",
+                          "fbclid",
+                          "gbraid",
+                          "gclid",
+                          "igshid",
+                          "li_fat_id",
+                          "mc_cid",
+                          "mc_eid",
+                          "msclkid",
+                          "srsltid",
+                          "ttclid",
+                          "twclid",
+                          "utm_campaign",
+                          "utm_content",
+                          "utm_creative_format",
+                          "utm_id",
+                          "utm_marketing_tactic",
+                          "utm_medium",
+                          "utm_source",
+                          "utm_source_platform",
+                          "utm_term",
+                          "wbraid"}) {
+    SCOPED_TRACE(key);
+    const GURL input(std::string("https://example.com/path?") + key + "=track");
+    EXPECT_EQ("https://example.com/path",
+              StripTrackingParameters(input).spec());
+  }
+}
+
+TEST(UrlCleanerTest, PreservesFunctionalUrlComponents) {
+  const struct {
+    const char* input;
+    const char* expected;
+  } cases[] = {
+      {"https://example.com/?utm_source=a&q=hello&utm_medium=b#section",
+       "https://example.com/?q=hello#section"},
+      {"https://example.com/?q=a&utm_source=x&q=b&fbclid=y",
+       "https://example.com/?q=a&q=b"},
+      {"https://example.com/?utm_source=x&utm_source=y&UTM_SOURCE=z",
+       "https://example.com/"},
+      {"https://example.com/?utm_source&fbclid=&q=", "https://example.com/?q="},
+      {"https://example.com/?%75tm_source=x&FBCLID=y&q=%26%3D%2f+%20",
+       "https://example.com/?q=%26%3D%2f+%20"},
+      {"https://example.com/?q=%75tm_source%3Dx%26fbclid%3Dy&gclid=z",
+       "https://example.com/?q=%75tm_source%3Dx%26fbclid%3Dy"},
+      {"https://example.com/?utm_source=x&flag&=value&q=a=b",
+       "https://example.com/?flag&=value&q=a=b"},
+      {"https://example.com/?&utm_source=x&&q=1&",
+       "https://example.com/?&&q=1&"},
+      {"https://example.com/?utm_source=x&", "https://example.com/?"},
+      {"https://example.com/?utm_source=x#", "https://example.com/#"},
+      {"https://example.com/?utm_source=x#/route?q=1&fbclid=fragment",
+       "https://example.com/#/route?q=1&fbclid=fragment"},
+      {"https://example.com/?utm_source=x#:~:text=hello",
+       "https://example.com/#:~:text=hello"},
+      {"http://example.com:8080/a%2Fb?utm_source=x&q=%FF%00#%E2%82%AC",
+       "http://example.com:8080/a%2Fb?q=%FF%00#%E2%82%AC"},
+      {"https://person:password@example.com/?utm_source=x&q=1",
+       "https://person:password@example.com/?q=1"},
+      {"https://[2001:db8::1]:8443/path?utm_source=x&id=42",
+       "https://[2001:db8::1]:8443/path?id=42"},
+      {"https://xn--bcher-kva.example/?utm_source=x&q=%C3%A9",
+       "https://xn--bcher-kva.example/?q=%C3%A9"},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.input);
+    const GURL cleaned = StripTrackingParameters(GURL(test.input));
+    EXPECT_EQ(test.expected, cleaned.spec());
+    EXPECT_EQ(cleaned, StripTrackingParameters(cleaned));
+  }
+}
+
+TEST(UrlCleanerTest, LeavesUnrecognizedParametersAndSchemesUnchanged) {
+  for (const char* input :
+       {"",
+        "not a url",
+        "https://",
+        "https://example.com/",
+        "https://example.com/?",
+        "https://example.com/?&&",
+        "https://example.com/?ref=1&source=2&id=3&si=4&feature=5",
+        "https://example.com/?utm_custom=1&utm_source_extra=2",
+        "https://example.com/?utm%ZZ_source=x&%00utm_source=x",
+        "https://example.com/?utm%255fsource=x",
+        "https://example.com/?q=first;utm_source=second",
+        "https://example.com/utm_source=x#utm_source=y",
+        "https://example.com/"
+        "?redirect=https%3A%2F%2Fexample.org%2F%3Ffbclid%3Dx",
+        "file:///tmp/file?utm_source=x",
+        "ftp://example.com/?utm_source=x",
+        "mailto:person@example.com?utm_source=x",
+        "javascript:alert('utm_source=x')",
+        "data:text/plain,?utm_source=x",
+        "chrome://settings/?utm_source=x",
+        "blob:https://example.com/id?utm_source=x"}) {
+    SCOPED_TRACE(input);
+    const GURL url(input);
+    EXPECT_EQ(url, StripTrackingParameters(url));
+  }
+}
+
+TEST(UrlCleanerTest, RemovesShareIdsOnlyOnKnownHosts) {
+  for (const char* host :
+       {"youtube.com", "www.youtube.com", "music.youtube.com", "youtu.be",
+        "open.spotify.com"}) {
+    SCOPED_TRACE(host);
+    const std::string prefix = std::string("https://") + host + "/watch";
+    EXPECT_EQ(prefix + "?v=video&t=30&list=playlist",
+              StripTrackingParameters(
+                  GURL(prefix + "?v=video&si=one&t=30&SI=two&list=playlist"))
+                  .spec());
+  }
+  for (const char* host : {"example.com", "notyoutube.com",
+                           "youtube.com.example.com", "youtu.be.example.com",
+                           "open.spotify.com.example.com", "spotify.com"}) {
+    SCOPED_TRACE(host);
+    const GURL url(std::string("https://") + host + "/?si=functional");
+    EXPECT_EQ(url, StripTrackingParameters(url));
+  }
+}
+
+TEST(UrlCleanerTest, HandlesManyRepeatedParameters) {
+  std::string input = "https://example.com/?";
+  std::string expected = input;
+  for (int i = 0; i < 10000; ++i) {
+    if (i) {
+      input += '&';
+      expected += '&';
+    }
+    input += "utm_source=x&item=" + std::to_string(i);
+    expected += "item=" + std::to_string(i);
+  }
+  EXPECT_EQ(expected, StripTrackingParameters(GURL(input)).spec());
+}
+
+}  // namespace
+}  // namespace url_formatter
