+#ifndef COMPONENTS_URL_FORMATTER_URL_CLEANER_H_
+#define COMPONENTS_URL_FORMATTER_URL_CLEANER_H_
+
+class GURL;
+
+namespace url_formatter {
+
+// Removes known tracking query parameters from HTTP(S) URLs. Other URL
+// components and the encoding and order of retained parameters are preserved.
+GURL StripTrackingParameters(const GURL& url);
+
+}  // namespace url_formatter
