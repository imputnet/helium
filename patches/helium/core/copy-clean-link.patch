+IN_PROC_BROWSER_TEST_F(RenderViewContextMenuViewsBrowserTest,
+                       CopyCleanLinkOmniboxPreservesPageAndSelection) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL(
+      "/title1.html?utm_source=track&id=42#part");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  auto* view =
+      static_cast<OmniboxViewViews*>(BrowserWindow::FromBrowser(browser())
+                                         ->GetLocationBar()
+                                         ->GetOmniboxView());
+  view->SetSelectedRange(gfx::Range(2, 5));
+  const auto text = view->GetText();
+  const auto selection = view->GetSelectedRange();
+  ASSERT_TRUE(view->IsCommandIdEnabled(IDC_COPY_CLEAN_LINK));
+  view->ExecuteCommand(IDC_COPY_CLEAN_LINK, 0);
+  EXPECT_EQ(embedded_test_server()->GetURL("/title1.html?id=42#part").spec(),
+            ui::clipboard_test_util::ReadAsciiText(
+                ui::Clipboard::GetForCurrentThread(),
+                ui::ClipboardBuffer::kCopyPaste, nullptr));
+  EXPECT_EQ(
+      url,
+      browser()->GetTabStripModel()->GetActiveWebContents()->GetVisibleURL());
+  EXPECT_EQ(text, view->GetText());
+  EXPECT_EQ(selection, view->GetSelectedRange());
+
+  view->SelectAll(false);
+  view->ExecuteCommand(
+      std::to_underlying(ui::TouchEditable::MenuCommands::kCopy), 0);
+  EXPECT_EQ(url.spec(), ui::clipboard_test_util::ReadAsciiText(
+                            ui::Clipboard::GetForCurrentThread(),
+                            ui::ClipboardBuffer::kCopyPaste, nullptr));
+}
