+// Store extensions are checked through Helium services, which only need to
+// know which extensions to check. Rebuild each request from their ids,
+// versions and update check flags, leaving out everything else that
+// update_client would say about the device, browser, profile, and how the
+// extensions are used.
+class MinimalProtocolSerializer final
+    : public update_client::ProtocolSerializer {
+ public:
+  std::string Serialize(
+      const update_client::protocol_request::Request& request) const override {
+    update_client::protocol_request::Request minimal;
+    minimal.protocol_version = request.protocol_version;
+    minimal.session_id = request.session_id;
+    minimal.request_id = request.request_id;
+    minimal.updatername = request.updatername;
+    for (const auto& app : request.apps) {
+      auto& minimal_app = minimal.apps.emplace_back();
+      minimal_app.app_id = app.app_id;
+      minimal_app.version = app.version;
+      minimal_app.update_check = app.update_check;
+    }
+    return update_client::ProtocolSerializerJSON().Serialize(minimal);
+  }
+};
+
+class MinimalProtocolHandlerFactory final
+    : public update_client::ProtocolHandlerFactory {
+ public:
+  std::unique_ptr<update_client::ProtocolParser> CreateParser() const override {
+    return std::make_unique<update_client::ProtocolParserJSON>();
+  }
+  std::unique_ptr<update_client::ProtocolSerializer> CreateSerializer()
+      const override {
+    return std::make_unique<MinimalProtocolSerializer>();
+  }
+};
+
