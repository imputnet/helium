+void HeliumNoiseTokenData::RegenerateTokens(
+    BrowserContext* context,
+    const std::optional<StoragePartitionConfig>& storage_partition_config) {
+  // Tokens are created again the next time they're needed.
+  HeliumNoiseTokenData* data = GetBrowserTokens(context);
+  if (storage_partition_config) {
+    data->session_tokens_.erase(*storage_partition_config);
+  } else {
+    data->session_tokens_.clear();
+  }
 }
 
