+#include "content/browser/helium_noise/noise_token_data.h"
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/rand_util.h"
+#include "base/unguessable_token.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/content_browser_client.h"
+#include "content/public/common/content_client.h"
+#include "crypto/hash.h"
+#include "net/base/schemeful_site.h"
+#include "third_party/blink/public/common/storage_key/storage_key.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace content {
+
+namespace {
+const void* const kBrowserContextNoiseTokenKeys =
+    &kBrowserContextNoiseTokenKeys;
+
+// FNV constants
+// https://datatracker.ietf.org/doc/html/draft-eastlake-fnv#name-fnv-constants
+constexpr uint64_t kFnvPrime = 0x00000100000001b3;
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325;
+
+// Derives a token by combining a browser context token with a site-specific
+// string. This makes tokens unique per-site, but consistent within
+// the same BrowserContext.
+blink::HeliumNoiseToken DeriveTokenFromSite(blink::HeliumNoiseToken token,
+                                            std::string_view site) {
+  uint64_t token_hash = kFnvOffset;
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+
+  hasher.Update(base::U64ToLittleEndian(token.Value()));
+  hasher.Update(base::as_byte_span(site));
+
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+
+  token_hash ^= base::U64FromLittleEndian(base::span(digest).first<8>());
+  token_hash *= kFnvPrime;
+
+  return blink::HeliumNoiseToken(token_hash);
+}
+}  // namespace
+
+HeliumNoiseTokenData::HeliumNoiseTokenData() {
+  session_tokens_[blink::HeliumNoiseFeature::kCanvas] =
+      blink::HeliumNoiseToken(base::RandUint64());
+  session_tokens_[blink::HeliumNoiseFeature::kAudio] =
+      blink::HeliumNoiseToken(base::RandUint64());
+}
+
+// static
+HeliumNoiseTokenData* HeliumNoiseTokenData::GetBrowserTokens(
+    BrowserContext* context) {
+  HeliumNoiseTokenData* data = static_cast<HeliumNoiseTokenData*>(
+      context->GetUserData(&kBrowserContextNoiseTokenKeys));
+
+  if (data != nullptr) {
+    return data;
+  }
+
+  return RegenerateTokens(context);
+}
+
+// static
+blink::HeliumNoiseTokenMap HeliumNoiseTokenData::GetTokens(
+    BrowserContext* context,
+    const net::SchemefulSite& top_level_site) {
+  HeliumNoiseTokenData* data = GetBrowserTokens(context);
+
+  std::string site = !top_level_site.opaque()
+                         ? top_level_site.Serialize()
+                         : base::UnguessableToken::Create().ToString();
+
+  blink::HeliumNoiseTokenMap result;
+  for (const auto& [feature, session_token] : data->session_tokens_) {
+    result.insert({feature, DeriveTokenFromSite(session_token, site)});
+  }
+
+  return result;
+}
+
+// static
+blink::HeliumNoiseTokenMap HeliumNoiseTokenData::GetTokensForMainFrame(
+    BrowserContext* context,
+    const url::Origin& origin) {
+  // An origin without a precursor results in an opaque origin, which falls
+  // back to a random token in GetTokens().
+  const url::Origin site_origin =
+      url::Origin::Create(origin.GetTupleOrPrecursorTupleIfOpaque().GetURL());
+  if (!GetContentClient()->browser()->HeliumNoiseEnabled(
+          context, site_origin.GetURL())) {
+    return blink::HeliumNoiseTokenMap();
+  }
+
+  return GetTokens(context, net::SchemefulSite(site_origin));
+}
+
+// static
+blink::HeliumNoiseTokenMap HeliumNoiseTokenData::GetTokensForWorker(
+    BrowserContext* context,
+    const blink::StorageKey& storage_key) {
+  // Use the StorageKey that third-party storage partitioning would produce, so
+  // that third-party workers stay keyed by the embedding site even when
+  // partitioning is disabled.
+  const blink::StorageKey partitioned_key =
+      storage_key.CopyWithForceEnabledThirdPartyStoragePartitioning();
+
+  // Noising settings are keyed by the top-level origin, which StorageKey
+  // doesn't store. A first-party StorageKey only guarantees that the worker's
+  // origin is same-site with the top-level frame, but that origin is usually
+  // the top-level origin itself, so use it as the closest match. Otherwise,
+  // fall back to the top-level site.
+  const GURL top_level_url = partitioned_key.IsFirstPartyContext()
+                                 ? partitioned_key.origin().GetURL()
+                                 : partitioned_key.top_level_site().GetURL();
+  if (!GetContentClient()->browser()->HeliumNoiseEnabled(context,
+                                                         top_level_url)) {
+    return blink::HeliumNoiseTokenMap();
+  }
+
+  return GetTokens(context, partitioned_key.top_level_site());
+}
+
+// static
+HeliumNoiseTokenData* HeliumNoiseTokenData::RegenerateTokens(
+    BrowserContext* context) {
+  auto new_data = std::make_unique<HeliumNoiseTokenData>();
+  HeliumNoiseTokenData* result = new_data.get();
+  context->SetUserData(&kBrowserContextNoiseTokenKeys,
+                       std::move(new_data));
+
+  return result;
+}
+
+}  // namespace content
