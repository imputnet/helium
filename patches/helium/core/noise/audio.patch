+void AudioBuffer::JitterAudioData(ExecutionContext* context) {
+  AudioReadbackNoise noise(context);
+  if (!noise.enabled()) {
+    return;
+  }
+
+  // Every channel has to be added before any of them is jittered.
+  for (const auto& channel : channels_) {
+    noise.AddSource(channel->AsSpan());
+  }
+
+  uint64_t index = 0;
+  for (const auto& channel : channels_) {
+    for (float& sample : channel->AsSpan()) {
+      sample = noise.Jitter(sample, index++);
+    }
+  }
+}
