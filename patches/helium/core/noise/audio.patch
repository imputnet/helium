+AudioReadbackNoise::AudioReadbackNoise(ExecutionContext* context) {
+  if (!context ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoiseAudio)) {
+    return;
+  }
+
+  const HeliumNoiseTokenMap& tokens = context->GetHeliumNoiseTokens();
+  if (auto it = tokens.find(HeliumNoiseFeature::kAudio); it != tokens.end()) {
+    hash_.emplace(it->second);
+  }
+}
+
+void AudioReadbackNoise::AddSource(float value) {
+  DCHECK(enabled());
+  hash_->Update(std::bit_cast<uint32_t>(value));
+}
+
+void AudioReadbackNoise::AddSource(base::span<const float> values) {
+  for (float value : values) {
+    AddSource(value);
+  }
+}
+
+float AudioReadbackNoise::Jitter(float value, uint64_t index) const {
+  DCHECK(enabled());
+  // |hash_| already covers all of the data being read back, so only the
+  // position is needed to give equal values different noise.
+  HeliumNoiseHash hash = *hash_;
+  hash.Update(index);
+  const int steps = hash.GetValueBelow(kMaxAudioJitterSteps + 1);
+  const float jitter =
+      (hash.GetValueBelow(2) ? steps : -steps) * kAudioJitterStep;
+  return value * (1.0f + jitter);
+}
+
+void AudioReadbackNoise::JitterInPlace(base::span<float> values) {
+  AddSource(values);
+  for (size_t i = 0; i < values.size(); ++i) {
+    values[i] = Jitter(values[i], i);
+  }
+}
