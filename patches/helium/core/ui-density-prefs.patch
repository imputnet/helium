+HeliumUiDensity GetHeliumUiDensity() {
+  // Read once, so that the whole session uses the same sizes.
+  static const HeliumUiDensity density = [] {
+    PrefService* local_state =
+        g_browser_process ? g_browser_process->local_state() : nullptr;
+    if (local_state && local_state->GetInteger(prefs::kHeliumUiDensity) ==
+                           std::to_underlying(HeliumUiDensity::kSpacious)) {
+      return HeliumUiDensity::kSpacious;
+    }
+    return HeliumUiDensity::kDefault;
+  }();
+  return density;
+}
