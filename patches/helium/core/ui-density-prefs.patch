+// The size of the browser UI. Stored in prefs::kHeliumUiDensity, keep in sync
+// with uiDensityOptions_ in a11y_page.ts.
+enum class HeliumUiDensity {
+  kDefault = 0,
+  kSpacious = 1,
+};
+
+// Returns the density the browser was started with.
+HeliumUiDensity GetHeliumUiDensity();
+
+// Returns whether the browser was started with the spacious density.
+inline bool IsSpaciousUiDensity() {
+  return GetHeliumUiDensity() == HeliumUiDensity::kSpacious;
+}
