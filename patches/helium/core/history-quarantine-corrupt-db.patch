+
+base::FilePath SQLiteSidecarPath(const base::FilePath& database_path,
+                                 base::FilePath::StringType suffix) {
+  return base::FilePath(database_path.value() + suffix);
 }
+
+bool QuarantineHistoryDatabaseFiles(const base::FilePath& history_path) {
+  if (!base::PathExists(history_path)) {
+    return false;
+  }
 
+  const base::FilePath quarantine_path = history_path.AddExtensionASCII(
+      base::StrCat({"corrupt-", base::NumberToString(
+                                    base::Time::Now()
+                                        .ToDeltaSinceWindowsEpoch()
+                                        .InMicroseconds())}));
+
+  using FilePair = std::pair<base::FilePath, base::FilePath>;
+  std::vector<FilePair> files;
+  auto add_sidecar = [&](base::FilePath::StringType suffix) {
+    base::FilePath source = SQLiteSidecarPath(history_path, suffix);
+    if (base::PathExists(source)) {
+      files.emplace_back(source, SQLiteSidecarPath(quarantine_path, suffix));
+    }
+  };
+
+  // Move sidecars first and the primary database last. If any move fails,
+  // restore everything already moved so the original database set remains
+  // under its primary stem.
+  add_sidecar(FILE_PATH_LITERAL("-journal"));
+  add_sidecar(FILE_PATH_LITERAL("-wal"));
+  add_sidecar(FILE_PATH_LITERAL("-shm"));
+  files.emplace_back(history_path, quarantine_path);
+
+  size_t moved_count = 0;
+  for (; moved_count < files.size(); ++moved_count) {
+    if (!base::Move(files[moved_count].first, files[moved_count].second)) {
+      break;
+    }
+  }
+  if (moved_count == files.size()) {
+    return true;
+  }
+
+  while (moved_count > 0) {
+    --moved_count;
+    if (!base::Move(files[moved_count].second, files[moved_count].first)) {
+      LOG(ERROR) << "Failed to restore History database file after quarantine "
+                    "failure: "
+                 << files[moved_count].first;
+    }
+  }
+  return false;
+}
