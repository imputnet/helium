+    'STYLE',
+    'NOSCRIPT',
+    'TEMPLATE',
+    'CODE',
+    'KBD',
+    'SAMP',
+    'PRE',
+    'SVG',
+    'MATH',
+    'IFRAME',
+    'OBJECT',
+    'EMBED',
+    'CANVAS',
+    'VIDEO',
+    'AUDIO',
