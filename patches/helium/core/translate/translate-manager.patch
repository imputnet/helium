+// Whether translating from |source_lang| to |target_lang| needs the network,
+// as far as the provider knows.
+bool TranslationNeedsNetwork(const PrefService& prefs,
+                             const std::string& source_lang,
+                             const std::string& target_lang) {
+  const TranslationProvider* provider = GetTranslationProvider(prefs);
+  return !provider || provider->SendsTextOffDevice() ||
+         provider->GetPairState(source_lang, target_lang) ==
+             TranslationProvider::PairState::kNeedsSetup;
+}
