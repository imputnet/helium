+void TranslateManager::ConfirmTranslationSetup(
+    std::string source_lang,
+    std::string target_lang,
+    const TranslationProvider::Setup& setup,
+    TranslationProvider::StartSetupCallback start_setup,
+    TranslationProvider::PrepareCallback callback) {
+  translate_client_->ConfirmTranslationSetup(source_lang, target_lang, setup,
+                                             std::move(start_setup),
+                                             std::move(callback));
+}
+
+void TranslateManager::OnTranslationPrepared(
+    std::string source_lang,
+    std::string target_lang,
+    TranslationProvider::PrepareResult result) {
+  if (!translate_driver_->HasCurrentPage()) {
+    return;
+  }
+
+  if (result == TranslationProvider::PrepareResult::kDeclined) {
+    // Back to offering the translation, rather than showing it in progress.
+    translate_client_->ShowTranslateUI(
+        translate::TRANSLATE_STEP_BEFORE_TRANSLATE, source_lang, target_lang,
+        TranslateErrors::NONE, false);
+    return;
+  }
+
+  const TranslationProvider* provider =
+      GetTranslationProvider(*translate_client_->GetPrefs());
+  if (result != TranslationProvider::PrepareResult::kReady || !provider) {
+    const TranslateErrors error =
+        result == TranslationProvider::PrepareResult::kUnsupported
+            ? TranslateErrors::UNSUPPORTED_LANGUAGE
+            : TranslateErrors::NETWORK;
+    translate_client_->ShowTranslateUI(
+        translate::TRANSLATE_STEP_TRANSLATE_ERROR, source_lang, target_lang,
+        error, false);
+    NotifyTranslateError(error);
+    GetActiveTranslateMetricsLogger()->LogTranslationFinished(false, error);
+    return;
+  }
+
+  const TranslationBatchLimits limits = provider->GetBatchLimits();
+  std::string script = base::StringPrintf(
+      "var batchLimits = {maxSegments: %zu, maxCharacters: %zu};\n",
+      limits.max_segments, limits.max_characters);
+  script.append(ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+      IDR_HELIUM_TRANSLATE_JS));
+  DoTranslatePage(script, source_lang, target_lang);
+}
