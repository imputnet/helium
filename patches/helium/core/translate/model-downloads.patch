+  std::move(callback).Run();
+}
+
+std::vector<const helium::TranslationPack*>
+BergamotTranslationProvider::GetRoute(const std::string& source_lang,
+                                      const std::string& target_lang) const {
+  if (const helium::TranslationPack* pack =
+          FindPack(source_lang, target_lang)) {
+    return {pack};
+  }
+
+  const helium::TranslationPack* to_pivot =
+      FindPack(source_lang, kPivotLanguage);
+  const helium::TranslationPack* from_pivot =
+      FindPack(kPivotLanguage, target_lang);
+  if (to_pivot && from_pivot) {
+    return {to_pivot, from_pivot};
+  }
+
+  return {};
+}
+
+void BergamotTranslationProvider::OnDownloadedPacksFound(
+    std::vector<const helium::TranslationPack*> packs) {
+  // Packs that were deleted, or downloaded before their use was recorded, get
+  // a fresh start.
+  base::DictValue last_used;
+  const base::DictValue& old_last_used =
+      local_state_->GetDict(prefs::kTranslationModelsLastUsed);
+  for (const helium::TranslationPack* pack : packs) {
+    const std::string key = GetPackKey(pack->source_lang, pack->target_lang);
+    const base::Value* time = old_last_used.Find(key);
+    last_used.Set(key,
+                  time ? time->Clone() : base::TimeToValue(base::Time::Now()));
+  }
+
+  local_state_->SetDict(prefs::kTranslationModelsLastUsed,
+                        std::move(last_used));
+  RegisterPacks(std::move(packs));
+}
+
+void BergamotTranslationProvider::MarkPacksUsed(
+    const std::vector<const helium::TranslationPack*>& packs) {
+  ScopedDictPrefUpdate update(local_state_, prefs::kTranslationModelsLastUsed);
+  for (const helium::TranslationPack* pack : packs) {
+    update->Set(GetPackKey(pack->source_lang, pack->target_lang),
+                base::TimeToValue(base::Time::Now()));
+  }
+}
+
+void BergamotTranslationProvider::RegisterPacks(
+    std::vector<const helium::TranslationPack*> packs) {
+  for (const helium::TranslationPack* pack : packs) {
+    if (!registered_packs_.emplace(pack->source_lang, pack->target_lang)
+             .second) {
+      OnPackRegistered(pack);
+      continue;
+    }
+
+    base::MakeRefCounted<component_updater::ComponentInstaller>(
+        std::make_unique<BergamotPackInstallerPolicy>(
+            *pack, base::BindRepeating(
+                       &BergamotTranslationProvider::OnPackReady,
+                       weak_ptr_factory_.GetWeakPtr(),
+                       LanguagePair(pack->source_lang, pack->target_lang))))
+        ->Register(
+            component_updater_,
+            base::BindOnce(&BergamotTranslationProvider::OnPackRegistered,
+                           weak_ptr_factory_.GetWeakPtr(), pack));
+  }
+}
+
+void BergamotTranslationProvider::InstallPacks(
+    std::vector<const helium::TranslationPack*> packs,
+    SetupProgressCallback progress_callback,
+    InstallCallback callback) {
+  const int download_id = next_download_id_++;
+  Download& download = downloads_[download_id];
+  download.progress_callback = std::move(progress_callback);
+  for (const helium::TranslationPack* pack : packs) {
+    download
+        .bytes[crx_file::id_util::GenerateIdFromHash(pack->public_key_sha)] = {
+        base::ByteSize(), kPackDownloadSize};
+  }
+
+  auto barrier = base::BarrierCallback<bool>(
+      packs.size(),
+      base::BindOnce(
+          [](base::WeakPtr<BergamotTranslationProvider> provider,
+             int download_id, InstallCallback callback,
+             const std::vector<bool>& results) {
+            if (provider) {
+              provider->downloads_.erase(download_id);
+            }
+
+            std::move(callback).Run(std::ranges::all_of(
+                results, [](bool installed) { return installed; }));
+          },
+          weak_ptr_factory_.GetWeakPtr(), download_id, std::move(callback)));
+
+  for (const helium::TranslationPack* pack : packs) {
+    installing_.emplace(LanguagePair(pack->source_lang, pack->target_lang),
+                        barrier);
+  }
+
+  RegisterPacks(std::move(packs));
+}
+
+void BergamotTranslationProvider::OnPackRegistered(
+    const helium::TranslationPack* pack) {
+  // Only packs that are being installed need to be downloaded right away.
+  if (!installing_.contains(
+          LanguagePair(pack->source_lang, pack->target_lang))) {
+    return;
+  }
+
+  BergamotPackInstallerPolicy::UpdateOnDemand(
+      component_updater_, *pack,
+      base::BindOnce(&BergamotTranslationProvider::OnPackUpdated,
+                     weak_ptr_factory_.GetWeakPtr(), pack));
+}
+
+void BergamotTranslationProvider::OnPackUpdated(
+    const helium::TranslationPack* pack,
+    bool success) {
+  // The pack is ready by now if it was installed.
+  const LanguagePair languages(pack->source_lang, pack->target_lang);
+  const bool installed = success && installed_packs_.contains(languages);
+  auto [begin, end] = installing_.equal_range(languages);
+  std::vector<InstallCallback> callbacks;
+  for (auto it = begin; it != end; ++it) {
+    callbacks.push_back(std::move(it->second));
+  }
+
+  installing_.erase(begin, end);
+  for (InstallCallback& callback : callbacks) {
+    std::move(callback).Run(installed);
+  }
+}
+
+void BergamotTranslationProvider::OnEvent(
+    const update_client::CrxUpdateItem& item) {
+  if (item.downloaded_bytes < 0 || item.total_bytes <= 0) {
+    return;
+  }
+
+  for (auto& [id, download] : downloads_) {
+    auto it = download.bytes.find(item.id);
+    if (it == download.bytes.end()) {
+      continue;
+    }
+
+    it->second = {base::ByteSize(static_cast<uint64_t>(item.downloaded_bytes)),
+                  base::ByteSize(static_cast<uint64_t>(item.total_bytes))};
+    base::ByteSize downloaded;
+    base::ByteSize total;
+    for (const auto& [pack_id, bytes] : download.bytes) {
+      downloaded += bytes.first;
+      total += bytes.second;
+    }
+
+    download.progress_callback.Run(downloaded, total);
+  }
+}
+
+void BergamotTranslationProvider::OnPackReady(
+    LanguagePair languages,
+    const base::FilePath& install_dir) {
+  installed_packs_[std::move(languages)] = install_dir;
+
+  // The service is launched again with the new pack when it's next needed.
+  OnServiceDisconnected();
+}
