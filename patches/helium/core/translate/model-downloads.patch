+void BergamotTranslationProvider::RemoveDownloadedModel(
+    const std::string& source_lang,
+    const std::string& target_lang,
+    base::OnceClosure callback) {
+  if (const helium::TranslationPack* pack =
+          FindPack(source_lang, target_lang)) {
+    const LanguagePair languages(source_lang, target_lang);
+    // Unregistering the component deletes its files.
+    if (registered_packs_.erase(languages)) {
+      component_updater_->UnregisterComponent(
+          crx_file::id_util::GenerateIdFromHash(pack->public_key_sha));
+    }
+
+    installed_packs_.erase(languages);
+    ScopedDictPrefUpdate(local_state_, prefs::kTranslationModelsLastUsed)
+        ->Remove(GetPackKey(source_lang, target_lang));
+
+    // The service is launched again without the pack when it's next needed.
