+// Installs one of the translation packs from Helium services.
+class BergamotPackInstallerPolicy : public ComponentInstallerPolicy {
+ public:
+  using ReadyCallback = base::RepeatingCallback<void(const base::FilePath&)>;
+
+  BergamotPackInstallerPolicy(const helium::TranslationPack& pack,
+                              ReadyCallback ready_callback)
+      : pack_(pack), ready_callback_(std::move(ready_callback)) {}
+  ~BergamotPackInstallerPolicy() override = default;
+
+  static base::FilePath GetInstallDir(const helium::TranslationPack& pack) {
+    return base::FilePath(FILE_PATH_LITERAL("TranslationModels"))
+        .AppendASCII(base::StrCat({pack.source_lang, "-", pack.target_lang}));
+  }
+
+  static void UpdateOnDemand(ComponentUpdateService* component_updater,
+                             const helium::TranslationPack& pack,
+                             base::OnceCallback<void(bool)> callback) {
+    component_updater->GetOnDemandUpdater().OnDemandUpdate(
+        crx_file::id_util::GenerateIdFromHash(pack.public_key_sha),
+        OnDemandUpdater::Priority::FOREGROUND,
+        base::BindOnce(
+            [](base::OnceCallback<void(bool)> callback,
+               update_client::Error error) {
+              std::move(callback).Run(error == update_client::Error::NONE);
+            },
+            std::move(callback)));
+  }
+
+  // ComponentInstallerPolicy:
+  bool SupportsGroupPolicyEnabledComponentUpdates() const override {
+    return false;
+  }
+
+  bool RequiresNetworkEncryption() const override { return false; }
+
+  update_client::CrxInstaller::Result OnCustomInstall(
+      const base::DictValue& manifest,
+      const base::FilePath& install_dir) override {
+    return update_client::CrxInstaller::Result(0);
+  }
+
+  void OnCustomUninstall() override {}
+
+  // Matches what BergamotClient loads.
+  bool VerifyInstallation(const base::DictValue& manifest,
+                          const base::FilePath& install_dir) const override {
+    auto exists = [&](const char* name) {
+      return base::PathExists(install_dir.AppendASCII(name));
+    };
+
+    return exists("model.bin") && exists("lex.bin") &&
+           (exists("vocab.spm") ||
+            (exists("srcvocab.spm") && exists("trgvocab.spm")));
+  }
+
+  void ComponentReady(const base::Version& version,
+                      const base::FilePath& install_dir,
+                      base::DictValue manifest) override {
+    ready_callback_.Run(install_dir);
+  }
+
+  base::FilePath GetRelativeInstallDir() const override {
+    return GetInstallDir(*pack_);
+  }
+
+  void GetHash(std::vector<uint8_t>* hash) const override {
+    hash->assign(pack_->public_key_sha.begin(), pack_->public_key_sha.end());
+  }
+
+  std::string GetName() const override {
+    return base::StrCat({"Translation Model (", pack_->source_lang, "-",
+                         pack_->target_lang, ")"});
+  }
+
+  update_client::InstallerAttributes GetInstallerAttributes() const override {
+    return {};
+  }
+
+ private:
+  const raw_ref<const helium::TranslationPack> pack_;
+  const ReadyCallback ready_callback_;
+};
