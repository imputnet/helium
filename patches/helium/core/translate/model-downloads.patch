+translate::TranslationProvider::PairState
+BergamotTranslationProvider::GetPairState(
+    const std::string& source_lang,
+    const std::string& target_lang) const {
+  const std::vector<const helium::TranslationPack*> route =
+      GetRoute(source_lang, target_lang);
+  if (route.empty()) {
+    return PairState::kUnsupported;
+  }
+
+  const bool installed =
+      std::ranges::all_of(route, [&](const helium::TranslationPack* pack) {
+        return installed_packs_.contains(
+            LanguagePair(pack->source_lang, pack->target_lang));
+      });
+  return installed ? PairState::kReady : PairState::kNeedsSetup;
+}
+
+void BergamotTranslationProvider::PrepareTranslation(
+    const std::string& source_lang,
+    const std::string& target_lang,
+    const PrefService& prefs,
+    ConfirmSetupCallback confirm_setup,
+    PrepareCallback callback) {
+  std::vector<const helium::TranslationPack*> missing_packs =
+      GetRoute(source_lang, target_lang);
+  if (missing_packs.empty()) {
+    std::move(callback).Run(PrepareResult::kUnsupported);
+    return;
+  }
+
+  MarkPacksUsed(missing_packs);
+  std::erase_if(missing_packs, [&](const helium::TranslationPack* pack) {
+    return installed_packs_.contains(
+        LanguagePair(pack->source_lang, pack->target_lang));
+  });
+  if (missing_packs.empty()) {
+    std::move(callback).Run(PrepareResult::kReady);
+    return;
+  }
+
+  // The packs come from Helium services, which the user has to allow.
+  if (!helium::ShouldAccessComponentUpdateService(prefs)) {
+    std::move(callback).Run(PrepareResult::kFailed);
+    return;
+  }
+
+  Setup setup;
+  setup.download_size = kPackDownloadSize * missing_packs.size();
+  std::move(confirm_setup)
+      .Run(setup,
+           base::BindOnce(&BergamotTranslationProvider::InstallPacks,
+                          weak_ptr_factory_.GetWeakPtr(),
+                          std::move(missing_packs)),
+           std::move(callback));
+}
