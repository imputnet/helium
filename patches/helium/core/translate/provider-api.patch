+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/translate/core/browser/translation_provider.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "components/prefs/pref_service.h"
+#include "components/translate/core/browser/translate_pref_names.h"
+#include "components/translate/core/common/translate_features.h"
+
+namespace translate {
+
+namespace {
+
+std::vector<std::unique_ptr<TranslationProvider>>& GetProviders() {
+  static base::NoDestructor<std::vector<std::unique_ptr<TranslationProvider>>>
+      providers;
+  return *providers;
+}
+
+// Spreads the flat |translations| back over the runs in |shape|.
+void OnTextsTranslated(
+    std::vector<std::vector<bool>> shape,
+    TranslationSession::TranslateCallback callback,
+    const std::optional<std::vector<std::u16string>>& translations,
+    const std::string& source_lang,
+    TranslateErrors error) {
+  if (!translations) {
+    std::move(callback).Run(std::nullopt, source_lang, error);
+    return;
+  }
+
+  TranslationResult result;
+  result.reserve(shape.size());
+  auto translation = translations->begin();
+  for (const std::vector<bool>& runs : shape) {
+    std::vector<std::u16string>& segment = result.emplace_back();
+    segment.reserve(runs.size());
+    for (bool translate : runs) {
+      if (!translate) {
+        segment.emplace_back();
+        continue;
+      }
+
+      if (translation == translations->end()) {
+        std::move(callback).Run(std::nullopt, source_lang,
+                                TranslateErrors::TRANSLATION_ERROR);
+        return;
+      }
+
+      segment.push_back(*translation++);
+    }
+  }
+
+  if (translation != translations->end()) {
+    std::move(callback).Run(std::nullopt, source_lang,
+                            TranslateErrors::TRANSLATION_ERROR);
+    return;
+  }
+
+  std::move(callback).Run(result, source_lang, error);
+}
+
+}  // namespace
+
+TranslationSegment::TranslationSegment() = default;
+TranslationSegment::TranslationSegment(TranslationSegment&&) = default;
+TranslationSegment& TranslationSegment::operator=(TranslationSegment&&) =
+    default;
+TranslationSegment::~TranslationSegment() = default;
+
+TranslationRequest::TranslationRequest() = default;
+TranslationRequest::TranslationRequest(TranslationRequest&&) = default;
+TranslationRequest& TranslationRequest::operator=(TranslationRequest&&) =
+    default;
+TranslationRequest::~TranslationRequest() = default;
+
+void PlainTextTranslationSession::Translate(const TranslationRequest& request,
+                                            TranslateCallback callback) {
+  std::vector<std::u16string> texts;
+  std::vector<std::vector<bool>> shape;
+  shape.reserve(request.segments.size());
+  for (const TranslationSegment& segment : request.segments) {
+    std::vector<bool>& runs = shape.emplace_back();
+    for (const TranslationRun& run : segment.runs) {
+      runs.push_back(run.translate);
+      if (run.translate) {
+        texts.push_back(run.text);
+      }
+    }
+  }
+
+  TranslateTexts(request.source_lang, request.target_lang, std::move(texts),
+                 base::BindOnce(&OnTextsTranslated, std::move(shape),
+                                std::move(callback)));
+}
+
+TranslationProvider::PairState TranslationProvider::GetPairState(
+    const std::string& source_lang,
+    const std::string& target_lang) const {
+  return PairState::kReady;
+}
+
+void TranslationProvider::PrepareTranslation(const std::string& source_lang,
+                                             const std::string& target_lang,
+                                             const PrefService& prefs,
+                                             ConfirmSetupCallback confirm_setup,
+                                             PrepareCallback callback) {
+  std::move(callback).Run(PrepareResult::kReady);
+}
+
+TranslationBatchLimits TranslationProvider::GetBatchLimits() const {
+  return {};
+}
+
+void RegisterTranslationProvider(
+    std::unique_ptr<TranslationProvider> provider) {
+  GetProviders().push_back(std::move(provider));
+}
+
+bool HasTranslationProvider() {
+  return base::FeatureList::IsEnabled(kHeliumTranslate) &&
+         !GetProviders().empty();
+}
+
+std::vector<TranslationProvider*> GetTranslationProviders() {
+  std::vector<TranslationProvider*> providers;
+  if (!HasTranslationProvider()) {
+    return providers;
+  }
+
+  for (const auto& provider : GetProviders()) {
+    providers.push_back(provider.get());
+  }
+
+  return providers;
+}
+
+TranslationProvider* GetDefaultTranslationProvider() {
+  const std::vector<TranslationProvider*> providers = GetTranslationProviders();
+  const auto it = std::ranges::find_if(
+      providers,
+      [](TranslationProvider* provider) { return provider->IsAvailable(); });
+  return it == providers.end() ? nullptr : *it;
+}
+
+TranslationProvider* GetTranslationProvider(const PrefService& prefs) {
+  const std::string& id = prefs.GetString(prefs::kTranslationProvider);
+  const std::vector<TranslationProvider*> providers = GetTranslationProviders();
+  const auto it = std::ranges::find_if(
+      providers,
+      [&](TranslationProvider* provider) { return provider->GetId() == id; });
+  if (it == providers.end()) {
+    return GetDefaultTranslationProvider();
+  }
+
+  // Not another one, which may send text where the user didn't want it.
+  return (*it)->IsAvailable() ? *it : nullptr;
+}
+
+}  // namespace translate
