+
+#ifndef COMPONENTS_ON_DEVICE_TRANSLATION_BERGAMOT_TRANSLATION_PROVIDER_H_
+#define COMPONENTS_ON_DEVICE_TRANSLATION_BERGAMOT_TRANSLATION_PROVIDER_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/weak_ptr.h"
+#include "components/on_device_translation/public/mojom/on_device_translation_service.mojom.h"
+#include "components/on_device_translation/public/mojom/translator.mojom.h"
+#include "components/translate/core/browser/translation_provider.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace on_device_translation {
+
+// Translates pages with bergamot in the on-device translation service, using
+// Firefox's models from |models_dir|. The model that translates from one
+// language to another is in |models_dir|/<from>/<to>, named like Firefox's
+// without their languages: model.bin, lex.bin, and vocab.spm or
+// srcvocab.spm and trgvocab.spm.
+class BergamotTranslationProvider : public translate::TranslationProvider {
+ public:
+  explicit BergamotTranslationProvider(base::FilePath models_dir);
+  ~BergamotTranslationProvider() override;
+
+  BergamotTranslationProvider(const BergamotTranslationProvider&) = delete;
+  BergamotTranslationProvider& operator=(const BergamotTranslationProvider&) =
+      delete;
+
+  // translate::TranslationProvider:
+  std::string GetId() const override;
+  std::u16string GetName() const override;
+  bool IsAvailable() const override;
+  bool SendsTextOffDevice() const override;
+  std::unique_ptr<translate::TranslationSession> StartSession(
+      const GURL& url) override;
+
+ private:
+  class Session;
+
+  using LanguagePair = std::pair<std::string, std::string>;
+  using TextsCallback = translate::PlainTextTranslationSession::TextsCallback;
+
+  // Translates for all sessions, which share the service and its translators.
+  void Translate(const std::string& source_lang,
+                 const std::string& target_lang,
+                 std::vector<std::u16string> texts,
+                 TextsCallback callback);
+
+  void LaunchService(
+      std::vector<std::pair<LanguagePair, base::FilePath>> packages);
+  void OnServiceDisconnected();
+
+  const base::FilePath models_dir_;
+
+  mojo::Remote<mojom::OnDeviceTranslationService> service_;
+  std::map<LanguagePair, mojo::Remote<mojom::OnDeviceTranslator>> translators_;
+  // Requests that wait for the service to launch, if it is launching.
+  std::vector<base::OnceClosure> pending_requests_;
+  bool launching_ = false;
+
+  base::WeakPtrFactory<BergamotTranslationProvider> weak_ptr_factory_{this};
+};
+
+}  // namespace on_device_translation
+
+#endif  // COMPONENTS_ON_DEVICE_TRANSLATION_BERGAMOT_TRANSLATION_PROVIDER_H_
