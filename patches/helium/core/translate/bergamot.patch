+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/bergamot/helium/bergamot_engine.h"
+
+#include <cstring>
+#include <exception>
+#include <utility>
+
+#include "common/logging.h"
+#include "translator/parser.h"
+#include "translator/response_options.h"
+#include "translator/service.h"
+#include "translator/translation_model.h"
+
+namespace bergamot {
+
+namespace {
+
+using marian::bergamot::AlignedMemory;
+using marian::bergamot::BlockingService;
+using marian::bergamot::MemoryBundle;
+using marian::bergamot::Response;
+using marian::bergamot::ResponseOptions;
+using marian::bergamot::TranslationModel;
+
+// Matches what Firefox uses for its models, with sentences on their own lines
+// split by ICU, and without the alignments that are only needed for HTML.
+// The vocabularies are loaded from memory, but marian looks at their names to
+// tell whether they're factored.
+constexpr char kModelConfig[] = R"(
+vocabs:
+  - source.spm
+  - target.spm
+beam-size: 1
+normalize: 1.0
+word-penalty: 0
+max-length-break: 128
+mini-batch-words: 1024
+workspaces: 128
+max-length-factor: 2.0
+skip-cost: true
+cpu-threads: 0
+quiet: true
+quiet-translation: true
+gemm-precision: int8shiftAlphaAll
+check-bytearray: true
+ssplit-mode: paragraph
+)";
+
+AlignedMemory CopyToAlignedMemory(std::string_view bytes, size_t alignment) {
+  AlignedMemory memory(bytes.size(), alignment);
+  std::memcpy(memory.begin(), bytes.data(), bytes.size());
+  return memory;
+}
+
+}  // namespace
+
+class Model {
+ public:
+  explicit Model(std::shared_ptr<TranslationModel> model)
+      : model_(std::move(model)) {}
+
+  const std::shared_ptr<TranslationModel>& get() const { return model_; }
+
+ private:
+  std::shared_ptr<TranslationModel> model_;
+};
+
+Engine::Engine() {
+  // Marian calls std::abort() on errors otherwise.
+  marian::setThrowExceptionOnAbort(true);
+  try {
+    service_ = std::make_unique<BlockingService>(BlockingService::Config());
+  } catch (const std::exception&) {
+  }
+}
+
+Engine::~Engine() = default;
+
+// static
+std::shared_ptr<Model> Engine::LoadModel(std::string_view model,
+                                         std::string_view shortlist,
+                                         std::string_view source_vocab,
+                                         std::string_view target_vocab) {
+  if (model.empty() || shortlist.empty() || source_vocab.empty()) {
+    return nullptr;
+  }
+
+  try {
+    MemoryBundle memory;
+    // intgemm needs the model to be aligned to 256 bytes, and the rest to 64.
+    memory.models.push_back(CopyToAlignedMemory(model, 256));
+    memory.shortlist = CopyToAlignedMemory(shortlist, 64);
+    auto source = std::make_shared<AlignedMemory>(
+        CopyToAlignedMemory(source_vocab, 64));
+    auto target = target_vocab.empty()
+                      ? source
+                      : std::make_shared<AlignedMemory>(
+                            CopyToAlignedMemory(target_vocab, 64));
+    memory.vocabs = {std::move(source), std::move(target)};
+
+    return std::make_shared<Model>(std::make_shared<TranslationModel>(
+        marian::bergamot::parseOptionsFromString(kModelConfig,
+                                                 /*validate=*/false),
+        std::move(memory)));
+  } catch (const std::exception&) {
+    return nullptr;
+  }
+}
+
+std::optional<std::vector<std::string>> Engine::Translate(
+    const std::shared_ptr<Model>& model,
+    const std::shared_ptr<Model>& pivot_model,
+    std::vector<std::string> texts) {
+  if (!service_ || !model) {
+    return std::nullopt;
+  }
+
+  try {
+    const std::vector<ResponseOptions> options(texts.size());
+    std::vector<Response> responses =
+        pivot_model ? service_->pivotMultiple(model->get(), pivot_model->get(),
+                                              std::move(texts), options)
+                    : service_->translateMultiple(model->get(),
+                                                  std::move(texts), options);
+
+    std::vector<std::string> translations;
+    translations.reserve(responses.size());
+    for (Response& response : responses) {
+      translations.push_back(std::move(response.target.text));
+    }
+
+    return translations;
+  } catch (const std::exception&) {
+    return std::nullopt;
+  }
+}
+
+}  // namespace bergamot
