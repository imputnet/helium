+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/on_device_translation/bergamot_translation_provider.h"
+
+#include <memory>
+#include <optional>
+
+#include "base/files/file_enumerator.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "components/on_device_translation/service/file_operation_proxy_impl.h"
+#include "components/translate/core/common/translate_errors.h"
+#include "content/public/browser/service_process_host.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+
+namespace on_device_translation {
+
+namespace {
+
+using Packages =
+    std::vector<std::pair<std::pair<std::string, std::string>, base::FilePath>>;
+
+// Must match kAutoDetectionLanguage in translate_agent.cc.
+constexpr char kAutoLanguage[] = "auto";
+
+std::vector<base::FilePath> GetSubdirectories(const base::FilePath& dir) {
+  std::vector<base::FilePath> subdirectories;
+  base::FileEnumerator enumerator(dir, /*recursive=*/false,
+                                  base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = enumerator.Next(); !path.empty();
+       path = enumerator.Next()) {
+    subdirectories.push_back(std::move(path));
+  }
+
+  return subdirectories;
+}
+
+Packages FindPackages(const base::FilePath& models_dir) {
+  Packages packages;
+  for (const base::FilePath& source_dir : GetSubdirectories(models_dir)) {
+    for (const base::FilePath& target_dir : GetSubdirectories(source_dir)) {
+      packages.emplace_back(
+          std::make_pair(source_dir.BaseName().AsUTF8Unsafe(),
+                         target_dir.BaseName().AsUTF8Unsafe()),
+          target_dir);
+    }
+  }
+
+  return packages;
+}
+
+void OnTranslated(
+    size_t text_count,
+    const std::string& source_lang,
+    translate::PlainTextTranslationSession::TextsCallback callback,
+    const std::optional<std::vector<std::string>>& outputs) {
+  if (!outputs || outputs->size() != text_count) {
+    std::move(callback).Run(std::nullopt, source_lang,
+                            translate::TranslateErrors::TRANSLATION_ERROR);
+    return;
+  }
+
+  std::vector<std::u16string> translations;
+  translations.reserve(outputs->size());
+  for (const std::string& output : *outputs) {
+    translations.push_back(base::UTF8ToUTF16(output));
+  }
+
+  std::move(callback).Run(std::move(translations), source_lang,
+                          translate::TranslateErrors::NONE);
+}
+
+}  // namespace
+
+// Lets each page's session share the provider's service.
+class BergamotTranslationProvider::Session
+    : public translate::PlainTextTranslationSession {
+ public:
+  explicit Session(base::WeakPtr<BergamotTranslationProvider> provider)
+      : provider_(std::move(provider)) {}
+
+ protected:
+  // translate::PlainTextTranslationSession:
+  void TranslateTexts(const std::string& source_lang,
+                      const std::string& target_lang,
+                      std::vector<std::u16string> texts,
+                      TextsCallback callback) override {
+    if (!provider_) {
+      std::move(callback).Run(std::nullopt, source_lang,
+                              translate::TranslateErrors::TRANSLATION_ERROR);
+      return;
+    }
+
+    provider_->Translate(source_lang, target_lang, std::move(texts),
+                         std::move(callback));
+  }
+
+ private:
+  base::WeakPtr<BergamotTranslationProvider> provider_;
+};
+
+BergamotTranslationProvider::BergamotTranslationProvider(
+    base::FilePath models_dir)
+    : models_dir_(std::move(models_dir)) {}
+
+BergamotTranslationProvider::~BergamotTranslationProvider() = default;
+
+std::string BergamotTranslationProvider::GetId() const {
+  return "bergamot";
+}
+
+std::u16string BergamotTranslationProvider::GetName() const {
+  return u"Bergamot";
+}
+
+bool BergamotTranslationProvider::IsAvailable() const {
+  return true;
+}
+
+bool BergamotTranslationProvider::SendsTextOffDevice() const {
+  return false;
+}
+
+std::unique_ptr<translate::TranslationSession>
+BergamotTranslationProvider::StartSession(const GURL& url) {
+  return std::make_unique<Session>(weak_ptr_factory_.GetWeakPtr());
+}
+
+void BergamotTranslationProvider::Translate(const std::string& source_lang,
+                                            const std::string& target_lang,
+                                            std::vector<std::u16string> texts,
+                                            TextsCallback callback) {
+  // TODO: detect the language, since models only exist for specific ones.
+  if (source_lang == kAutoLanguage) {
+    std::move(callback).Run(std::nullopt, source_lang,
+                            translate::TranslateErrors::UNKNOWN_LANGUAGE);
+    return;
+  }
+
+  if (!service_) {
+    pending_requests_.push_back(base::BindOnce(
+        &BergamotTranslationProvider::Translate, weak_ptr_factory_.GetWeakPtr(),
+        source_lang, target_lang, std::move(texts), std::move(callback)));
+    if (!launching_) {
+      launching_ = true;
+      base::ThreadPool::PostTaskAndReplyWithResult(
+          FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+          base::BindOnce(&FindPackages, models_dir_),
+          base::BindOnce(&BergamotTranslationProvider::LaunchService,
+                         weak_ptr_factory_.GetWeakPtr()));
+    }
+
+    return;
+  }
+
+  const LanguagePair languages(source_lang, target_lang);
+  mojo::Remote<mojom::OnDeviceTranslator>& translator = translators_[languages];
+  if (!translator) {
+    // Requests are queued until the translator is created. If that fails,
+    // the translator disconnects, and they fail with it.
+    service_->CreateTranslator(
+        source_lang, target_lang, translator.BindNewPipeAndPassReceiver(),
+        base::DoNothingAs<void(mojom::CreateTranslatorResult)>());
+    translator.reset_on_disconnect();
+  }
+
+  std::vector<std::string> inputs;
+  inputs.reserve(texts.size());
+  for (const std::u16string& text : texts) {
+    inputs.push_back(base::UTF16ToUTF8(text));
+  }
+
+  translator->TranslateBatch(
+      std::move(inputs), mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                             base::BindOnce(&OnTranslated, texts.size(),
+                                            source_lang, std::move(callback)),
+                             std::optional<std::vector<std::string>>()));
+}
+
+void BergamotTranslationProvider::LaunchService(Packages packages) {
+  launching_ = false;
+  content::ServiceProcessHost::Launch(
+      service_.BindNewPipeAndPassReceiver(),
+      content::ServiceProcessHost::Options()
+          .WithDisplayName("Helium Translation Service")
+          .Pass());
+  service_.set_disconnect_handler(
+      base::BindOnce(&BergamotTranslationProvider::OnServiceDisconnected,
+                     base::Unretained(this)));
+
+  auto config = mojom::OnDeviceTranslationServiceConfig::New();
+  std::vector<base::FilePath> package_paths;
+  for (auto& [languages, path] : packages) {
+    config->packages.push_back(mojom::OnDeviceTranslationLanguagePackage::New(
+        languages.first, languages.second));
+    package_paths.push_back(std::move(path));
+  }
+
+  // The proxy opens files from |package_paths| for the sandboxed service, on
+  // a sequence that can block.
+  scoped_refptr<base::SequencedTaskRunner> task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE});
+  task_runner->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](mojo::PendingReceiver<mojom::FileOperationProxy> receiver,
+             scoped_refptr<base::SequencedTaskRunner> task_runner,
+             std::vector<base::FilePath> package_paths) {
+            mojo::MakeSelfOwnedReceiver(
+                std::make_unique<FileOperationProxyImpl>(
+                    std::move(task_runner), std::move(package_paths)),
+                std::move(receiver));
+          },
+          config->file_operation_proxy.InitWithNewPipeAndPassReceiver(),
+          task_runner, std::move(package_paths)));
+  service_->SetServiceConfig(std::move(config));
+
+  for (base::OnceClosure& request : std::exchange(pending_requests_, {})) {
+    std::move(request).Run();
+  }
+}
+
+void BergamotTranslationProvider::OnServiceDisconnected() {
+  // Models may have been added since, so they're found again on relaunch.
+  service_.reset();
+  translators_.clear();
+}
+
+}  // namespace on_device_translation
