+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "ssplit.h"
+
+#include "third_party/icu/source/common/unicode/locid.h"
+#include "third_party/icu/source/common/unicode/utext.h"
+
+namespace ug::ssplit {
+
+namespace {
+
+std::string_view TrimWhitespace(std::string_view text) {
+  constexpr std::string_view kWhitespace = " \t\n\v\f\r";
+  const size_t start = text.find_first_not_of(kWhitespace);
+  if (start == std::string_view::npos) {
+    return {};
+  }
+
+  return text.substr(start, text.find_last_not_of(kWhitespace) - start + 1);
+}
+
+}  // namespace
+
+SentenceStream::SentenceStream(std::string_view text,
+                               const SentenceSplitter&,
+                               splitmode mode)
+    : text_(text) {
+  // ICU always breaks at newlines, so it handles paragraphs on their own
+  // lines. Wrapped text is split at its newlines too.
+  if (mode == splitmode::one_sentence_per_line) {
+    return;
+  }
+
+  UErrorCode status = U_ZERO_ERROR;
+  iterator_.reset(
+      icu::BreakIterator::createSentenceInstance(icu::Locale::getRoot(), status));
+  // The iterator keeps a shallow copy of |utext|, and indexes |text_| in
+  // bytes.
+  UText* utext = utext_openUTF8(nullptr, text_.data(), text_.size(), &status);
+  if (U_SUCCESS(status)) {
+    iterator_->setText(utext, status);
+  }
+
+  utext_close(utext);
+  if (U_FAILURE(status)) {
+    iterator_.reset();
+  }
+}
+
+SentenceStream::~SentenceStream() = default;
+
+size_t SentenceStream::NextBreak() {
+  if (!iterator_) {
+    const size_t newline = text_.find('\n', position_);
+    return newline == std::string_view::npos ? text_.size() : newline + 1;
+  }
+
+  const int32_t next = iterator_->following(position_);
+  return next == icu::BreakIterator::DONE ? text_.size() : next;
+}
+
+bool SentenceStream::operator>>(std::string_view& sentence) {
+  while (position_ < text_.size()) {
+    const size_t end = NextBreak();
+    const std::string_view piece =
+        TrimWhitespace(text_.substr(position_, end - position_));
+    position_ = end;
+    if (!piece.empty()) {
+      sentence = piece;
+      return true;
+    }
+  }
+
+  return false;
+}
+
+}  // namespace ug::ssplit
