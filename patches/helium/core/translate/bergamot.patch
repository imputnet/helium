+  # The same reduced feature set that Firefox builds as wasm, without threads.
+  defines = [
+    "COMPILE_CPU=1",
+    "USE_RUY_SGEMM=1",
+    "USE_SENTENCEPIECE",
+    "WASM_COMPATIBLE_SOURCE",
+    "WITHOUT_EXCEPTIONS",
