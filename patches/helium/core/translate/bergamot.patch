+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// Replaces ssplit-cpp, which needs pcre2, with ICU's sentence breaking. This
+// is also what Firefox does, through Intl.Segmenter.
+
+#pragma once
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "third_party/icu/source/common/unicode/brkiter.h"
+
+namespace ug::ssplit {
+
+// ICU has no use for the moses prefix lists that ssplit loads.
+class SentenceSplitter {
+ public:
+  void load(const std::string&) {}
+  void loadFromSerialized(std::string_view) {}
+};
+
+class SentenceStream {
+ public:
+  enum class splitmode {
+    one_sentence_per_line,
+    one_paragraph_per_line,
+    wrapped_text,
+  };
+
+  SentenceStream(std::string_view text,
+                 const SentenceSplitter& splitter,
+                 splitmode mode);
+  ~SentenceStream();
+
+  // Sets |sentence| to the next non-empty sentence, without surrounding
+  // whitespace. Returns false once there are none left.
+  bool operator>>(std::string_view& sentence);
+
+ private:
+  size_t NextBreak();
+
+  std::string_view text_;
+  size_t position_ = 0;
+  // Unset when every line is a sentence.
+  std::unique_ptr<icu::BreakIterator> iterator_;
+};
+
+}  // namespace ug::ssplit
