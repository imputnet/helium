+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/on_device_translation/service/bergamot_client.h"
+
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/strings/string_view_util.h"
+
+namespace on_device_translation {
+
+namespace {
+
+// Models are only available to and from English.
+constexpr char kPivotLanguage[] = "en";
+
+// The files in each package, as Firefox calls them without their languages.
+constexpr char kModelFile[] = "model.bin";
+constexpr char kShortlistFile[] = "lex.bin";
+constexpr char kVocabFile[] = "vocab.spm";
+constexpr char kSourceVocabFile[] = "srcvocab.spm";
+constexpr char kTargetVocabFile[] = "trgvocab.spm";
+
+std::string_view AsStringView(const base::MemoryMappedFile* file) {
+  return file ? base::as_string_view(file->bytes()) : std::string_view();
+}
+
+}  // namespace
+
+BergamotClient::Translator::Translator(
+    bergamot::Engine& engine,
+    std::shared_ptr<bergamot::Model> model,
+    std::shared_ptr<bergamot::Model> pivot_model)
+    : engine_(engine),
+      model_(std::move(model)),
+      pivot_model_(std::move(pivot_model)) {}
+
+BergamotClient::Translator::~Translator() = default;
+
+std::optional<std::vector<std::string>> BergamotClient::Translator::Translate(
+    std::vector<std::string> texts) {
+  return engine_->Translate(model_, pivot_model_, std::move(texts));
+}
+
+BergamotClient::BergamotClient() = default;
+
+BergamotClient::~BergamotClient() = default;
+
+void BergamotClient::SetConfig(
+    mojom::OnDeviceTranslationServiceConfigPtr config) {
+  translators_.clear();
+  models_.clear();
+  package_indices_.clear();
+
+  file_operation_proxy_.reset();
+  file_operation_proxy_.Bind(std::move(config->file_operation_proxy));
+  for (uint32_t i = 0; i < config->packages.size(); ++i) {
+    const auto& package = config->packages[i];
+    package_indices_.emplace(
+        LanguagePair(package->language1, package->language2), i);
+  }
+}
+
+bool BergamotClient::CanTranslate(const std::string& source_lang,
+                                  const std::string& target_lang) const {
+  return !GetRoute(source_lang, target_lang).empty();
+}
+
+base::expected<BergamotClient::Translator*, mojom::CreateTranslatorResult>
+BergamotClient::GetTranslator(const std::string& source_lang,
+                              const std::string& target_lang) {
+  const LanguagePair languages(source_lang, target_lang);
+  if (auto it = translators_.find(languages); it != translators_.end()) {
+    return it->second.get();
+  }
+
+  const std::vector<LanguagePair> route = GetRoute(source_lang, target_lang);
+  if (route.empty()) {
+    return base::unexpected(
+        mojom::CreateTranslatorResult::kErrorFailedToCreateTranslator);
+  }
+
+  std::shared_ptr<bergamot::Model> model = GetModel(route[0]);
+  std::shared_ptr<bergamot::Model> pivot_model;
+  if (route.size() > 1) {
+    pivot_model = GetModel(route[1]);
+  }
+
+  if (!model || (route.size() > 1 && !pivot_model)) {
+    return base::unexpected(
+        mojom::CreateTranslatorResult::kErrorFailedToInitialize);
+  }
+
+  auto translator = std::make_unique<Translator>(engine_, std::move(model),
+                                                 std::move(pivot_model));
+  Translator* translator_ptr = translator.get();
+  translators_.emplace(languages, std::move(translator));
+  return translator_ptr;
+}
+
+std::vector<BergamotClient::LanguagePair> BergamotClient::GetRoute(
+    const std::string& source_lang,
+    const std::string& target_lang) const {
+  const LanguagePair direct(source_lang, target_lang);
+  if (package_indices_.contains(direct)) {
+    return {direct};
+  }
+
+  const LanguagePair to_pivot(source_lang, kPivotLanguage);
+  const LanguagePair from_pivot(kPivotLanguage, target_lang);
+  if (package_indices_.contains(to_pivot) &&
+      package_indices_.contains(from_pivot)) {
+    return {to_pivot, from_pivot};
+  }
+
+  return {};
+}
+
+std::shared_ptr<bergamot::Model> BergamotClient::GetModel(
+    const LanguagePair& languages) {
+  if (auto it = models_.find(languages); it != models_.end()) {
+    return it->second;
+  }
+
+  const uint32_t package_index = package_indices_.at(languages);
+  auto map_file =
+      [&](const char* name) -> std::unique_ptr<base::MemoryMappedFile> {
+    base::File file;
+    file_operation_proxy_->Open(package_index, base::FilePath::FromASCII(name),
+                                &file);
+    auto mapped_file = std::make_unique<base::MemoryMappedFile>();
+    if (!file.IsValid() || !mapped_file->Initialize(std::move(file))) {
+      return nullptr;
+    }
+
+    return mapped_file;
+  };
+
+  // The vocabulary is either shared by both languages, or split in two.
+  std::unique_ptr<base::MemoryMappedFile> source_vocab = map_file(kVocabFile);
+  std::unique_ptr<base::MemoryMappedFile> target_vocab;
+  if (!source_vocab) {
+    source_vocab = map_file(kSourceVocabFile);
+    target_vocab = map_file(kTargetVocabFile);
+    if (!target_vocab) {
+      return nullptr;
+    }
+  }
+
+  // The engine copies what it needs, so the files can be unmapped after.
+  std::unique_ptr<base::MemoryMappedFile> model = map_file(kModelFile);
+  std::unique_ptr<base::MemoryMappedFile> shortlist = map_file(kShortlistFile);
+  std::shared_ptr<bergamot::Model> loaded_model = bergamot::Engine::LoadModel(
+      AsStringView(model.get()), AsStringView(shortlist.get()),
+      AsStringView(source_vocab.get()), AsStringView(target_vocab.get()));
+  if (loaded_model) {
+    models_.emplace(languages, loaded_model);
+  }
+
+  return loaded_model;
+}
+
+}  // namespace on_device_translation
