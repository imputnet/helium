+namespace on_device_translation {
+
+// Translates with bergamot-translator and Firefox's models. Each package
+// holds the model that translates from its first language to its second.
+// Languages without a model between them are translated through English.
+class BergamotClient {
+ public:
+  class Translator {
+   public:
+    Translator(bergamot::Engine& engine,
+               std::shared_ptr<bergamot::Model> model,
+               std::shared_ptr<bergamot::Model> pivot_model);
+    ~Translator();
+
+    Translator(const Translator&) = delete;
+    Translator& operator=(const Translator&) = delete;
+
+    std::optional<std::vector<std::string>> Translate(
+        std::vector<std::string> texts);
+
+   private:
+    const raw_ref<bergamot::Engine> engine_;
+    const std::shared_ptr<bergamot::Model> model_;
+    const std::shared_ptr<bergamot::Model> pivot_model_;
+  };
+
+  BergamotClient();
+  ~BergamotClient();
+
+  BergamotClient(const BergamotClient&) = delete;
+  BergamotClient& operator=(const BergamotClient&) = delete;
+
+  void SetConfig(mojom::OnDeviceTranslationServiceConfigPtr config);
+
+  bool CanTranslate(const std::string& source_lang,
+                    const std::string& target_lang) const;
+
+  // The translator is owned by this client.
+  base::expected<Translator*, mojom::CreateTranslatorResult> GetTranslator(
+      const std::string& source_lang,
+      const std::string& target_lang);
+
+ private:
+  using LanguagePair = std::pair<std::string, std::string>;
+
+  // Returns the packages to translate with in order, which is empty if there
+  // are none.
+  std::vector<LanguagePair> GetRoute(const std::string& source_lang,
+                                     const std::string& target_lang) const;
+
+  std::shared_ptr<bergamot::Model> GetModel(const LanguagePair& languages);
+
+  bergamot::Engine engine_;
+  mojo::Remote<mojom::FileOperationProxy> file_operation_proxy_;
+  std::map<LanguagePair, uint32_t> package_indices_;
+  std::map<LanguagePair, std::shared_ptr<bergamot::Model>> models_;
+  std::map<LanguagePair, std::unique_ptr<Translator>> translators_;
+};
+
+}  // namespace on_device_translation
+
+#endif  // COMPONENTS_ON_DEVICE_TRANSLATION_SERVICE_BERGAMOT_CLIENT_H_
