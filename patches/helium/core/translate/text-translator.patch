+class TranslationProvider;
+class TranslationSession;
+
+// Passes page text from TranslateAgent to the TranslationProvider.
+class TextTranslatorHost final
+    : public content::DocumentService<mojom::TextTranslator> {
+ public:
+  // Binds |receiver| for the primary main frame if a provider is available.
+  static void Create(content::RenderFrameHost* render_frame_host,
+                     mojo::PendingReceiver<mojom::TextTranslator> receiver);
+
+  TextTranslatorHost(const TextTranslatorHost&) = delete;
+  TextTranslatorHost& operator=(const TextTranslatorHost&) = delete;
+
+  // mojom::TextTranslator:
+  void TranslateText(const std::string& source_lang,
+                     const std::string& target_lang,
+                     std::vector<mojom::TextSegmentPtr> segments,
+                     TranslateTextCallback callback) override;
+
+ private:
+  TextTranslatorHost(content::RenderFrameHost& render_frame_host,
+                     mojo::PendingReceiver<mojom::TextTranslator> receiver,
+                     TranslationProvider& provider);
+  ~TextTranslatorHost() override;
+
+  // The provider chosen when the page connected. The page keeps using it, so
+  // its text can't move to another provider, e.g. off the device, unnoticed.
+  const raw_ref<TranslationProvider> provider_;
+
+  // Started with the first batch of the document.
+  std::unique_ptr<TranslationSession> session_;
+};
+
+}  // namespace translate
+
+#endif  // COMPONENTS_TRANSLATE_CONTENT_BROWSER_TEXT_TRANSLATOR_HOST_H_
