+void TranslateAgent::PumpTextTranslation() {
+  if (text_request_in_flight_) {
+    return;
+  }
+
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+
+  // Executing script may spin a nested run loop that detaches the frame and
+  // deletes |this|.
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  v8::Isolate* isolate = main_frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Value> request =
+      main_frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+          world_id_,
+          WebScriptSource(
+              WebString::FromAscii("cr.googleTranslate.takeTextRequest()")),
+          blink::BackForwardCacheAware::kAllow);
+  if (!weak_this) {
+    return;
+  }
+
+  // Null means there is nothing to translate right now. The Google Translate
+  // Element has no takeTextRequest(), so its pump stops here too.
+  if (request.IsEmpty() || request->IsNullOrUndefined()) {
+    const bool active =
+        ExecuteScriptAndGetBoolResult("cr.googleTranslate.textActive", false);
+    if (weak_this && active) {
+      ScheduleTextTranslationPump(kTextTranslatePollDelayMs);
+    }
+
+    return;
+  }
+
+  v8::Local<v8::Context> context =
+      main_frame->GetScriptContextFromWorldId(isolate, world_id_);
+  std::vector<mojom::TextSegmentPtr> segments;
+  bool valid = !context.IsEmpty();
+  if (valid) {
+    v8::Context::Scope context_scope(context);
+    valid =
+        gin::ConvertFromV8(isolate, request, &segments) && !segments.empty();
+  }
+
+  if (!valid) {
+    SendTextTranslateResponse(std::nullopt, std::string(),
+                              TranslateErrors::UNEXPECTED_SCRIPT_ERROR);
+    if (weak_this) {
+      ScheduleTextTranslationPump(kTextTranslatePollDelayMs);
+    }
+
+    return;
+  }
+
+  text_request_in_flight_ = true;
+  const int request_id = ++text_request_id_;
+  // Fail the batch if the browser drops the request or doesn't reply.
+  GetTextTranslator()->TranslateText(
+      source_lang_, target_lang_, std::move(segments),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&TranslateAgent::OnTextTranslateResponse,
+                         weak_method_factory_.GetWeakPtr(), request_id),
+          std::nullopt, std::string(), TranslateErrors::TRANSLATION_ERROR));
+  translate_task_runner_->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TranslateAgent::OnTextTranslateResponse,
+                     weak_method_factory_.GetWeakPtr(), request_id,
+                     std::optional<TextTranslations>(), std::string(),
+                     TranslateErrors::TRANSLATION_TIMEOUT),
+      AdjustDelay(kTextTranslateTimeoutMs));
+}
+
+void TranslateAgent::ScheduleTextTranslationPump(int delay_in_milliseconds) {
+  translate_task_runner_->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TranslateAgent::PumpTextTranslation,
+                     weak_method_factory_.GetWeakPtr()),
+      AdjustDelay(delay_in_milliseconds));
+}
+
+void TranslateAgent::OnTextTranslateResponse(
+    int request_id,
+    const std::optional<TextTranslations>& translations,
+    const std::string& source_lang,
+    TranslateErrors error) {
+  if (!text_request_in_flight_ || request_id != text_request_id_) {
+    return;
+  }
+
+  text_request_in_flight_ = false;
+
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  SendTextTranslateResponse(translations, source_lang, error);
+  if (!weak_this) {
+    return;
+  }
+
+  ScheduleTextTranslationPump(0);
+}
+
+void TranslateAgent::SendTextTranslateResponse(
+    const std::optional<TextTranslations>& translations,
+    const std::string& source_lang,
+    TranslateErrors error) {
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+
+  std::string translations_json = "null";
+  if (translations && error == TranslateErrors::NONE) {
+    base::ListValue list;
+    for (const std::vector<std::u16string>& segment : *translations) {
+      base::ListValue runs;
+      for (const std::u16string& run : segment) {
+        runs.Append(run);
+      }
+
+      list.Append(std::move(runs));
+    }
+
+    translations_json = base::WriteJson(list).value_or("null");
+  }
+
+  // Not ASCII-only, so ExecuteScript() can't be used.
+  const std::string script =
+      base::StrCat({"cr.googleTranslate.onTextResponse(", translations_json,
+                    ",", base::NumberToString(static_cast<int>(error)), ",",
+                    base::GetQuotedJSONString(source_lang), ")"});
+  main_frame->ExecuteScriptInIsolatedWorld(
+      world_id_, WebScriptSource(WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+}
+
+const mojo::Remote<mojom::TextTranslator>& TranslateAgent::GetTextTranslator() {
+  if (text_translator_ && !text_translator_.is_connected()) {
+    text_translator_.reset();
+  }
+
+  if (!text_translator_) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        text_translator_.BindNewPipeAndPassReceiver(translate_task_runner_));
+  }
+
+  return text_translator_;
+}
