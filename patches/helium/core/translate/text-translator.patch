+#include "url/gurl.h"
+
+namespace translate {
+
+namespace {
+
+// The page script only sends segments with something to translate.
+bool IsValidSegment(const mojom::TextSegmentPtr& segment) {
+  return std::ranges::any_of(segment->runs, [](const mojom::TextRunPtr& run) {
+    return run->translate;
+  });
+}
+
+TranslationSegment ToTranslationSegment(mojom::TextSegment& segment) {
+  TranslationSegment result;
+  result.runs.reserve(segment.runs.size());
+  for (mojom::TextRunPtr& run : segment.runs) {
+    result.runs.push_back({std::move(run->text), run->translate});
+  }
+
+  result.element = std::move(segment.element);
+  result.attribute = std::move(segment.attribute);
+  return result;
+}
+
+}  // namespace
+
+// static
+void TextTranslatorHost::Create(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<mojom::TextTranslator> receiver) {
+  CHECK(render_frame_host);
+  TranslationProvider* provider = GetTranslationProvider();
+  if (!render_frame_host->IsInPrimaryMainFrame() || !provider) {
+    return;
+  }
+
+  // Owned by the document. See DocumentService.
+  new TextTranslatorHost(*render_frame_host, std::move(receiver), *provider);
+}
+
+TextTranslatorHost::TextTranslatorHost(
+    content::RenderFrameHost& render_frame_host,
+    mojo::PendingReceiver<mojom::TextTranslator> receiver,
+    TranslationProvider& provider)
+    : DocumentService(render_frame_host, std::move(receiver)),
+      provider_(provider) {}
+
+TextTranslatorHost::~TextTranslatorHost() = default;
+
+void TextTranslatorHost::TranslateText(
+    const std::string& source_lang,
+    const std::string& target_lang,
+    std::vector<mojom::TextSegmentPtr> segments,
+    TranslateTextCallback callback) {
+  const TranslationBatchLimits limits = provider_->GetBatchLimits();
+  size_t characters = 0;
+  for (const mojom::TextSegmentPtr& segment : segments) {
+    for (const mojom::TextRunPtr& run : segment->runs) {
+      characters += run->text.size();
+    }
+  }
+
+  // The page script is given the provider's limits and keeps to them.
+  const bool within_limits = segments.size() <= limits.max_segments &&
+                             characters <= limits.max_characters;
+  if (segments.empty() || !within_limits ||
+      !std::ranges::all_of(segments, IsValidSegment)) {
+    ReportBadMessageAndDeleteThis("Invalid text translation batch");
+    return;
+  }
+
+  if (target_lang.empty()) {
+    std::move(callback).Run(std::nullopt, std::string(),
+                            TranslateErrors::UNSUPPORTED_LANGUAGE);
+    return;
+  }
+
+  if (source_lang == target_lang) {
+    std::move(callback).Run(std::nullopt, std::string(),
+                            TranslateErrors::IDENTICAL_LANGUAGES);
+    return;
+  }
+
+  // Fail rather than fall back to another provider if it became unavailable.
+  if (!provider_->IsAvailable()) {
+    std::move(callback).Run(std::nullopt, std::string(),
+                            TranslateErrors::INITIALIZATION_ERROR);
+    return;
+  }
+
+  if (!session_) {
+    session_ =
+        provider_->StartSession(render_frame_host().GetLastCommittedURL());
+  }
+
+  TranslationRequest request;
+  request.source_lang = source_lang;
+  request.target_lang = target_lang;
+  request.segments.reserve(segments.size());
+  for (mojom::TextSegmentPtr& segment : segments) {
+    request.segments.push_back(ToTranslationSegment(*segment));
+  }
+
+  session_->Translate(request, std::move(callback));
+}
+
+}  // namespace translate
