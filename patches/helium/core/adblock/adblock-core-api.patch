+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_HELIUM_ADBLOCK_CORE_HELIUM_ADBLOCK_CLIENT_H_
+#define COMPONENTS_HELIUM_ADBLOCK_CORE_HELIUM_ADBLOCK_CLIENT_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+}
+
+namespace helium_adblock {
+
+class HeliumAdBlockService;
+
+// Embedder interface for HeliumAdBlockService. The service owns its client;
+// the client outlives every callback the service hands to it.
+class HeliumAdBlockClient {
+ public:
+  // Accessors for assets packaged into the app, keyed by their bundled path
+  // (for example "assets/assets.json" or "assets/filters/easylist.txt").
+  // Both callbacks must be callable from any thread.
+  struct BundledListReader {
+    base::RepeatingCallback<bool(const std::string& path)> has;
+    base::RepeatingCallback<std::optional<std::string>(const std::string& path)>
+        read;
+  };
+
+  virtual ~HeliumAdBlockClient() = default;
+
+  // Called once after the service is fully constructed.
+  virtual void OnServiceCreated(HeliumAdBlockService*) {}
+
+  virtual scoped_refptr<network::SharedURLLoaderFactory>
+  GetURLLoaderFactory() = 0;
+
+  virtual std::string GetApplicationLocale() = 0;
+
+  virtual bool IsMobilePlatform() const { return false; }
+
+  // Directory that contains the bundled filter catalog and engine resources.
+  virtual base::FilePath GetBundledAssetsRoot() = 0;
+
+  virtual BundledListReader GetBundledListReader() = 0;
+};
+
+}  // namespace helium_adblock
+
+#endif  // COMPONENTS_HELIUM_ADBLOCK_CORE_HELIUM_ADBLOCK_CLIENT_H_
