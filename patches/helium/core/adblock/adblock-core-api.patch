+#ifndef COMPONENTS_HELIUM_ADBLOCK_CORE_ADBLOCK_TYPES_H_
+#define COMPONENTS_HELIUM_ADBLOCK_CORE_ADBLOCK_TYPES_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+namespace helium_adblock {
+
+enum class SourceUpdateState {
+  kBundled,
+  kDownloaded,
+  kPending,
+  kStale,
+  kFailed,
+};
+
+struct SourceState {
+  std::string id;
+  std::string title;
+  std::string group;
+  std::string parent;
+  std::optional<GURL> url;
+  bool built_in = true;
+  bool catalog_default = false;
+  bool preferred = false;
+  std::optional<bool> explicit_override;
+  bool effective_enabled = false;
+  bool bundled_available = false;
+  SourceUpdateState update_state = SourceUpdateState::kPending;
+  base::TimeDelta update_after = base::Days(7);
+  bool updating = false;
+  base::Time last_successful_update;
+  std::string failure_category;
+};
+
+struct ServiceState {
+  bool enabled = false;
+  bool ready = false;
+  bool updating = false;
+  bool converting = false;
+  int update_total = 0;
+  int update_completed = 0;
+  std::string generation_id;
+  std::string failure_category;
+};
+
+struct NetworkMatchResult {
+  bool blocked = false;
+  bool important = false;
+  bool has_exception = false;
+  std::string redirect;
+  std::string rewritten_url;
+};
+
+}  // namespace helium_adblock
+
+#endif  // COMPONENTS_HELIUM_ADBLOCK_CORE_ADBLOCK_TYPES_H_
