+#include "gin/try_catch.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/scheduler/web_agent_group_scheduler.h"
+#include "third_party/blink/public/platform/web_isolated_world_info.h"
+#include "third_party/blink/public/platform/web_security_origin.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include "ui/base/resource/resource_bundle.h"
+#include "url/gurl.h"
+#include "v8/include/v8.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr size_t kMaximumInjectedScriptSize = 1024 * 1024;
+
+void EnsureIsolatedWorldInitialized() {
+  static bool initialized = false;
+  if (initialized) {
+    return;
+  }
+  initialized = true;
+
+  blink::WebIsolatedWorldInfo world_info;
+  world_info.security_origin = blink::WebSecurityOrigin::Create(
+      GURL("chrome://helium-adblock"));
+  world_info.content_security_policy = blink::WebString::FromUtf8("");
+  world_info.human_readable_name = "Helium AdBlock";
+  blink::SetIsolatedWorldInfo(ISOLATED_WORLD_ID_HELIUM_ADBLOCK, world_info);
+}
+
+}  // namespace
+
+HeliumAdBlockAgent::HeliumAdBlockAgent(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<HeliumAdBlockAgent>(render_frame),
+      resources_ready_(std::make_unique<base::OneShotEvent>()) {
+  resources_ready_->Signal();
+}
+
+HeliumAdBlockAgent::~HeliumAdBlockAgent() = default;
+
+void HeliumAdBlockAgent::DidCommitProvisionalLoad(
+    ui::PageTransition transition) {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  host_.reset();
+  document_resources_.reset();
+  resources_ready_ = std::make_unique<base::OneShotEvent>();
+  GetHost()->GetDocumentResources(
+      base::BindOnce(&HeliumAdBlockAgent::OnDocumentResources,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void HeliumAdBlockAgent::DidCreateScriptContext(
+    v8::Local<v8::Context> context,
+    int world_id) {
+  if (world_id != ISOLATED_WORLD_ID_HELIUM_ADBLOCK) {
+    return;
+  }
+  v8::Isolate* isolate =
+      render_frame()->GetWebFrame()->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  gin::TryCatch try_catch(isolate);
+  try_catch.SetVerbose(true);
+  v8::Context::Scope context_scope(context);
+  v8::Local<v8::Object> native = v8::Object::New(isolate);
+  v8::Local<v8::Function> get_generic_selectors;
+  if (!gin::CreateFunctionTemplate(
+           isolate,
+           base::BindRepeating(
+               &HeliumAdBlockAgent::RequestGenericSelectors,
+               weak_ptr_factory_.GetWeakPtr()))
+           ->GetFunction(context)
+           .ToLocal(&get_generic_selectors)) {
+    return;
+  }
+  if (!native
+           ->CreateDataProperty(
+               context, gin::StringToSymbol(isolate, "getGenericSelectors"),
+               get_generic_selectors)
+           .FromMaybe(false)) {
+    return;
+  }
+  context->Global()
+      ->CreateDataProperty(
+          context, gin::StringToSymbol(isolate, "heliumAdBlockNative"), native)
+      .Check();
+}
+
+void HeliumAdBlockAgent::OnDestruct() {
+  delete this;
+}
+
+void HeliumAdBlockAgent::RunScriptsAtDocumentStart() {
+  if (resources_ready_->is_signaled()) {
+    ApplyRules();
+    return;
+  }
+  resources_ready_->Post(
+      FROM_HERE,
+      base::BindOnce(&HeliumAdBlockAgent::ApplyRules,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+void HeliumAdBlockAgent::RequestGenericSelectors(
+    std::vector<std::string> classes,
+    std::vector<std::string> ids,
+    std::vector<std::string> exceptions) {
+  GetHost()->GetGenericSelectors(
+      std::move(classes), std::move(ids), std::move(exceptions),
+      base::BindOnce(&HeliumAdBlockAgent::OnGenericSelectors,
+                     weak_ptr_factory_.GetWeakPtr()));
+}
+
+chrome::mojom::HeliumAdBlockCosmeticFilterHost*
+HeliumAdBlockAgent::GetHost() {
+  if (!host_.is_bound()) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        host_.BindNewPipeAndPassReceiver());
+    host_.reset_on_disconnect();
+  }
+  return host_.get();
+}
+
+void HeliumAdBlockAgent::OnDocumentResources(const std::string& resources) {
+  document_resources_ = resources;
+  resources_ready_->Signal();
+}
+
+void HeliumAdBlockAgent::ApplyRules() {
+  if (!document_resources_ || document_resources_->empty()) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame || frame->IsProvisional()) {
+    return;
+  }
+
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(*document_resources_, base::JSON_PARSE_RFC);
+  base::DictValue* data = parsed ? parsed->GetIfDict() : nullptr;
+  if (!data) {
+    return;
+  }
+  if (const std::string* injected_script = data->FindString("injected_script");
+      injected_script &&
+      injected_script->size() <= kMaximumInjectedScriptSize) {
+    InjectPageScript(*injected_script);
+  }
+
+  EnsureIsolatedWorldInitialized();
+  std::string runtime_script =
+      ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+          IDR_HELIUM_ADBLOCK_COSMETIC_FILTER_JS);
+  if (runtime_script.empty()) {
+    return;
+  }
+  frame->ExecuteScriptInIsolatedWorld(
+      ISOLATED_WORLD_ID_HELIUM_ADBLOCK,
+      blink::WebScriptSource(blink::WebString::FromUtf8(runtime_script)),
+      blink::BackForwardCacheAware::kAllow);
+  CallRuntime("onCosmetic", std::move(*parsed));
+}
+
+void HeliumAdBlockAgent::OnGenericSelectors(
+    const std::vector<std::string>& selectors) {
+  base::ListValue values;
+  for (const std::string& selector : selectors) {
+    values.Append(selector);
+  }
+  CallRuntime("onGeneric", base::Value(std::move(values)));
+}
+
+void HeliumAdBlockAgent::CallRuntime(std::string_view method,
+                                    base::Value argument) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+
+  v8::Isolate* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Context> context = frame->GetScriptContextFromWorldId(
+      isolate, ISOLATED_WORLD_ID_HELIUM_ADBLOCK);
+  if (context.IsEmpty()) {
+    return;
+  }
+  gin::TryCatch try_catch(isolate);
+  try_catch.SetVerbose(true);
+  v8::Context::Scope context_scope(context);
+
+  v8::Local<v8::Value> runtime_value;
+  if (!context->Global()
+           ->Get(context,
+                 gin::StringToSymbol(isolate, "__heliumAdBlockRuntime"))
+           .ToLocal(&runtime_value) ||
+      !runtime_value->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> runtime = runtime_value.As<v8::Object>();
+  v8::Local<v8::Value> method_value;
+  if (!runtime->Get(context, gin::StringToSymbol(isolate, method))
+           .ToLocal(&method_value) ||
+      !method_value->IsFunction()) {
+    return;
+  }
+
+  v8::Local<v8::Value> argv[] = {
+      content::V8ValueConverter::Create()->ToV8Value(argument, context)};
+  frame->RequestExecuteV8Function(context, method_value.As<v8::Function>(),
+                                  runtime, /*argc=*/1, argv, {});
+}
+
+void HeliumAdBlockAgent::InjectPageScript(std::string script) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (frame) {
+    frame->ExecuteScript(
+        blink::WebScriptSource(blink::WebString::FromUtf8(script)));
+  }
+}
+
