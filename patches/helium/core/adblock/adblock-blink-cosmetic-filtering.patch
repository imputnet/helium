+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/helium_adblock/helium_adblock_cosmetic_filter_host.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/helium_adblock/helium_adblock_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/helium_adblock/core/helium_adblock_service.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/render_frame_host.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr size_t kMaximumSelectorValues = 4096;
+constexpr size_t kMaximumSelectorLength = 1024;
+
+bool IsValidSelectorInput(const std::vector<std::string>& values) {
+  if (values.size() > kMaximumSelectorValues) {
+    return false;
+  }
+  for (const std::string& value : values) {
+    if (value.size() > kMaximumSelectorLength) {
+      return false;
+    }
+  }
+  return true;
+}
+
+HeliumAdBlockService* GetService(
+    content::RenderFrameHost& render_frame_host) {
+  Profile* profile =
+      Profile::FromBrowserContext(render_frame_host.GetBrowserContext());
+  return profile ? HeliumAdBlockServiceFactory::GetForProfile(profile)
+                 : nullptr;
+}
+
+GURL GetDocumentURL(content::RenderFrameHost& render_frame_host) {
+  GURL url = render_frame_host.GetLastCommittedURL();
+  if (url.SchemeIs(url::kAboutScheme)) {
+    url = render_frame_host.GetLastCommittedOrigin().GetURL();
+  }
+  return url;
+}
+
+}  // namespace
+
+// static
+void HeliumAdBlockCosmeticFilterHost::Create(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<chrome::mojom::HeliumAdBlockCosmeticFilterHost>
+        receiver) {
+  new HeliumAdBlockCosmeticFilterHost(*render_frame_host, std::move(receiver));
+}
+
+HeliumAdBlockCosmeticFilterHost::HeliumAdBlockCosmeticFilterHost(
+    content::RenderFrameHost& render_frame_host,
+    mojo::PendingReceiver<chrome::mojom::HeliumAdBlockCosmeticFilterHost>
+        receiver)
+    : DocumentService(render_frame_host, std::move(receiver)),
+      service_(GetService(render_frame_host)),
+      off_the_record_(
+          render_frame_host.GetBrowserContext()->IsOffTheRecord()) {}
+
+HeliumAdBlockCosmeticFilterHost::~HeliumAdBlockCosmeticFilterHost() = default;
+
+void HeliumAdBlockCosmeticFilterHost::GetDocumentResources(
+    GetDocumentResourcesCallback callback) {
+  const GURL url = GetDocumentURL(render_frame_host());
+  if (!service_ || !url.SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run(std::string());
+    return;
+  }
+  service_->GetDocumentCosmeticResources(
+      url, off_the_record_,
+      base::BindOnce(
+          [](GetDocumentResourcesCallback callback, std::string resources) {
+            std::move(callback).Run(resources);
+          },
+          std::move(callback)));
+}
+
+void HeliumAdBlockCosmeticFilterHost::GetGenericSelectors(
+    const std::vector<std::string>& classes,
+    const std::vector<std::string>& ids,
+    const std::vector<std::string>& exceptions,
+    GetGenericSelectorsCallback callback) {
+  const GURL url = GetDocumentURL(render_frame_host());
+  if (!service_ || !url.SchemeIsHTTPOrHTTPS() ||
+      !IsValidSelectorInput(classes) || !IsValidSelectorInput(ids) ||
+      !IsValidSelectorInput(exceptions)) {
+    std::move(callback).Run({});
+    return;
+  }
+  service_->GetGenericSelectors(
+      url, classes, ids, exceptions, off_the_record_,
+      base::BindOnce(
+          [](GetGenericSelectorsCallback callback,
+             std::vector<std::string> selectors) {
+            std::move(callback).Run(selectors);
+          },
+          std::move(callback)));
+}
+
+}  // namespace helium_adblock
