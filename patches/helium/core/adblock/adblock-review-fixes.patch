+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/helium_adblock/helium_adblock_websocket.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/helium_adblock/helium_adblock_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/helium_adblock/core/helium_adblock_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/mojom/websocket.mojom.h"
+
+namespace helium_adblock {
+namespace {
+
+using WebSocketFactory = content::ContentBrowserClient::WebSocketFactory;
+
+void OnWebSocketMatched(
+    WebSocketFactory factory,
+    GURL url,
+    std::vector<network::mojom::HttpHeaderPtr> additional_headers,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::WebSocketAuthenticationHandler>
+        authentication_handler,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> header_client,
+    NetworkMatchResult result) {
+  if (result.blocked) {
+    mojo::Remote<network::mojom::WebSocketHandshakeClient>(
+        std::move(handshake_client))
+        ->OnFailure(std::string(), net::ERR_BLOCKED_BY_CLIENT, -1);
+    return;
+  }
+
+  if (!result.rewritten_url.empty()) {
+    GURL rewritten_url(result.rewritten_url);
+    if (rewritten_url.SchemeIsWSOrWSS()) {
+      url = std::move(rewritten_url);
+    }
+  }
+
+  std::move(factory).Run(
+      url, std::move(additional_headers), std::move(handshake_client),
+      std::move(authentication_handler), std::move(header_client));
+}
+
+void MatchWebSocket(
+    base::WeakPtr<Profile> profile,
+    GURL document_url,
+    WebSocketFactory factory,
+    const GURL& url,
+    std::vector<network::mojom::HttpHeaderPtr> additional_headers,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::WebSocketAuthenticationHandler>
+        authentication_handler,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> header_client) {
+  if (!profile) {
+    std::move(factory).Run(
+        url, std::move(additional_headers), std::move(handshake_client),
+        std::move(authentication_handler), std::move(header_client));
+    return;
+  }
+
+  HeliumAdBlockService* service =
+      HeliumAdBlockServiceFactory::GetForProfile(profile.get());
+  if (!service) {
+    std::move(factory).Run(
+        url, std::move(additional_headers), std::move(handshake_client),
+        std::move(authentication_handler), std::move(header_client));
+    return;
+  }
+
+  service->MatchRequest(
+      url, document_url, "websocket", net::HttpRequestHeaders::kGetMethod,
+      profile->IsOffTheRecord(),
+      base::BindOnce(&OnWebSocketMatched, std::move(factory), url,
+                     std::move(additional_headers), std::move(handshake_client),
+                     std::move(authentication_handler),
+                     std::move(header_client)));
+}
+
+}  // namespace
+
+bool ShouldInterceptWebSocket(content::RenderFrameHost* frame) {
+  if (!frame) {
+    return false;
+  }
+  Profile* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  if (!profile) {
+    return false;
+  }
+  HeliumAdBlockService* service =
+      HeliumAdBlockServiceFactory::GetForProfile(profile);
+  return service && service->IsEnabledForURL(frame->GetLastCommittedURL(),
+                                             profile->IsOffTheRecord());
+}
+
+WebSocketFactory MaybeWrapWebSocketFactory(content::RenderFrameHost* frame,
+                                           WebSocketFactory factory) {
+  if (!ShouldInterceptWebSocket(frame)) {
+    return factory;
+  }
+  Profile* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  return base::BindOnce(&MatchWebSocket, profile->GetWeakPtr(),
+                        frame->GetLastCommittedURL(), std::move(factory));
+}
+
+}  // namespace helium_adblock
