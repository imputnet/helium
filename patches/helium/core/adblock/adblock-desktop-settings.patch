+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/helium_adblock_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/helium_adblock/helium_adblock_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/helium_adblock/core/adblock_types.h"
+#include "content/public/browser/web_ui.h"
+#include "url/gurl.h"
+
+namespace settings {
+namespace {
+
+const char* UpdateStateToString(
+    helium_adblock::SourceUpdateState update_state) {
+  switch (update_state) {
+    case helium_adblock::SourceUpdateState::kBundled:
+      return "bundled";
+    case helium_adblock::SourceUpdateState::kDownloaded:
+      return "downloaded";
+    case helium_adblock::SourceUpdateState::kPending:
+      return "pending";
+    case helium_adblock::SourceUpdateState::kStale:
+      return "stale";
+    case helium_adblock::SourceUpdateState::kFailed:
+      return "failed";
+  }
+  return "pending";
+}
+
+}  // namespace
+
+HeliumAdBlockHandler::HeliumAdBlockHandler(Profile* profile)
+    : service_(helium_adblock::HeliumAdBlockServiceFactory::GetForProfile(
+          profile)) {
+  CHECK(service_);
+}
+
+HeliumAdBlockHandler::~HeliumAdBlockHandler() {
+  StopObserving();
+}
+
+void HeliumAdBlockHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getHeliumAdBlockState",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleGetState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setHeliumAdBlockEnabled",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleSetEnabled,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setHeliumAdBlockSourceEnabled",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleSetSourceEnabled,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "addHeliumAdBlockCustomSource",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleAddCustomSource,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "removeHeliumAdBlockCustomSource",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleRemoveCustomSource,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "refreshHeliumAdBlockSources",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleRefresh,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "resetHeliumAdBlockToDefaults",
+      base::BindRepeating(&HeliumAdBlockHandler::HandleResetToDefaults,
+                          base::Unretained(this)));
+}
+
+void HeliumAdBlockHandler::OnJavascriptAllowed() {
+  if (!observing_) {
+    service_->AddObserver(this);
+    observing_ = true;
+  }
+}
+
+void HeliumAdBlockHandler::OnJavascriptDisallowed() {
+  StopObserving();
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void HeliumAdBlockHandler::OnHeliumAdBlockStateChanged(
+    const helium_adblock::ServiceState&) {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("helium-adblock-state-changed", CreateStateValue());
+  }
+}
+
+void HeliumAdBlockHandler::HandleGetState(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  ResolveJavascriptCallback(args[0], CreateStateValue());
+}
+
+void HeliumAdBlockHandler::HandleSetEnabled(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  service_->SetEnabled(
+      args[1].GetBool(),
+      base::BindOnce(&HeliumAdBlockHandler::ResolveMutation,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HeliumAdBlockHandler::HandleSetSourceEnabled(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 3u);
+  service_->SetSourceEnabled(
+      args[1].GetString(), args[2].GetBool(),
+      base::BindOnce(&HeliumAdBlockHandler::ResolveMutation,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HeliumAdBlockHandler::HandleAddCustomSource(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  service_->AddCustomSource(
+      GURL(args[1].GetString()),
+      base::BindOnce(&HeliumAdBlockHandler::ResolveMutation,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HeliumAdBlockHandler::HandleRemoveCustomSource(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  service_->RemoveCustomSource(
+      args[1].GetString(),
+      base::BindOnce(&HeliumAdBlockHandler::ResolveMutation,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HeliumAdBlockHandler::HandleRefresh(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  service_->Refresh(
+      true, base::BindOnce(&HeliumAdBlockHandler::ResolveMutation,
+                          weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void HeliumAdBlockHandler::HandleResetToDefaults(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  service_->ResetToDefaults(base::BindOnce(
+      &HeliumAdBlockHandler::ResolveMutation, weak_ptr_factory_.GetWeakPtr(),
+      args[0].Clone()));
+}
+
+base::Value HeliumAdBlockHandler::CreateStateValue() const {
+  const helium_adblock::ServiceState& state = service_->GetState();
+  base::ListValue sources;
+  for (const helium_adblock::SourceState& source : service_->GetSources()) {
+    base::DictValue value;
+    value.Set("id", source.id);
+    value.Set("title", source.title);
+    value.Set("group", source.group);
+    value.Set("builtIn", source.built_in);
+    value.Set("effectiveEnabled", source.effective_enabled);
+    value.Set("updating", source.updating);
+    value.Set("updateState", UpdateStateToString(source.update_state));
+    value.Set("failureCategory", source.failure_category);
+    if (source.url) {
+      value.Set("url", source.url->spec());
+    }
+    sources.Append(std::move(value));
+  }
+
+  base::DictValue value;
+  value.Set("enabled", state.enabled);
+  value.Set("ready", state.ready);
+  value.Set("updating", state.updating);
+  value.Set("converting", state.converting);
+  value.Set("updateTotal", state.update_total);
+  value.Set("updateCompleted", state.update_completed);
+  value.Set("failureCategory", state.failure_category);
+  value.Set("sources", std::move(sources));
+  return base::Value(std::move(value));
+}
+
+void HeliumAdBlockHandler::ResolveMutation(base::Value callback_id,
+                                           bool success) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, base::Value(success));
+  }
+}
+
+void HeliumAdBlockHandler::StopObserving() {
+  if (observing_) {
+    service_->RemoveObserver(this);
+    observing_ = false;
+  }
+}
+
+}  // namespace settings
