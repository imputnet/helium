+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface AdBlockSource {
+  id: string;
+  title: string;
+  group: string;
+  url?: string;
+  builtIn: boolean;
+  effectiveEnabled: boolean;
+  updating: boolean;
+  updateState: 'bundled'|'downloaded'|'pending'|'stale'|'failed';
+  failureCategory: string;
+}
+
+export interface AdBlockState {
+  enabled: boolean;
+  ready: boolean;
+  updating: boolean;
+  converting: boolean;
+  updateTotal: number;
+  updateCompleted: number;
+  failureCategory: string;
+  sources: AdBlockSource[];
+}
+
+export interface AdBlockBrowserProxy {
+  getState(): Promise<AdBlockState>;
+  setEnabled(enabled: boolean): Promise<boolean>;
+  setSourceEnabled(id: string, enabled: boolean): Promise<boolean>;
+  addCustomSource(url: string): Promise<boolean>;
+  removeCustomSource(id: string): Promise<boolean>;
+  refresh(): Promise<boolean>;
+  resetToDefaults(): Promise<boolean>;
+}
+
+export class AdBlockBrowserProxyImpl implements AdBlockBrowserProxy {
+  getState() {
+    return sendWithPromise<AdBlockState>('getHeliumAdBlockState');
+  }
+
+  setEnabled(enabled: boolean) {
+    return sendWithPromise<boolean>('setHeliumAdBlockEnabled', enabled);
+  }
+
+  setSourceEnabled(id: string, enabled: boolean) {
+    return sendWithPromise<boolean>(
+        'setHeliumAdBlockSourceEnabled', id, enabled);
+  }
+
+  addCustomSource(url: string) {
+    return sendWithPromise<boolean>('addHeliumAdBlockCustomSource', url);
+  }
+
+  removeCustomSource(id: string) {
+    return sendWithPromise<boolean>('removeHeliumAdBlockCustomSource', id);
+  }
+
+  refresh() {
+    return sendWithPromise<boolean>('refreshHeliumAdBlockSources');
+  }
+
+  resetToDefaults() {
+    return sendWithPromise<boolean>('resetHeliumAdBlockToDefaults');
+  }
+
+  static getInstance(): AdBlockBrowserProxy {
+    return instance || (instance = new AdBlockBrowserProxyImpl());
+  }
+
+  static setInstance(obj: AdBlockBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: AdBlockBrowserProxy|null = null;
