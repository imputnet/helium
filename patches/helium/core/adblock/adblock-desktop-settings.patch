+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_HELIUM_ADBLOCK_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_HELIUM_ADBLOCK_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/helium_adblock/core/helium_adblock_service.h"
+
+class Profile;
+
+namespace settings {
+
+class HeliumAdBlockHandler final : public SettingsPageUIHandler,
+                                   public helium_adblock::ServiceObserver {
+ public:
+  explicit HeliumAdBlockHandler(Profile* profile);
+  HeliumAdBlockHandler(const HeliumAdBlockHandler&) = delete;
+  HeliumAdBlockHandler& operator=(const HeliumAdBlockHandler&) = delete;
+  ~HeliumAdBlockHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // helium_adblock::ServiceObserver:
+  void OnHeliumAdBlockStateChanged(
+      const helium_adblock::ServiceState& state) override;
+
+ private:
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetEnabled(const base::ListValue& args);
+  void HandleSetSourceEnabled(const base::ListValue& args);
+  void HandleAddCustomSource(const base::ListValue& args);
+  void HandleRemoveCustomSource(const base::ListValue& args);
+  void HandleRefresh(const base::ListValue& args);
+  void HandleResetToDefaults(const base::ListValue& args);
+
+  base::Value CreateStateValue() const;
+  void ResolveMutation(base::Value callback_id, bool success);
+  void StopObserving();
+
+  raw_ptr<helium_adblock::HeliumAdBlockService> service_;
+  bool observing_ = false;
+  base::WeakPtrFactory<HeliumAdBlockHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace settings
