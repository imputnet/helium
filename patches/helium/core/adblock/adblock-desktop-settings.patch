+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '../settings_page/settings_subpage.js';
+import '../settings_shared.css.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_collapse/cr_collapse.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toast/cr_toast.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import type {CrToastElement} from 'chrome://resources/cr_elements/cr_toast/cr_toast.js';
+import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {WebUiListenerMixin} from 'chrome://resources/cr_elements/web_ui_listener_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {AdBlockBrowserProxy, AdBlockSource, AdBlockState} from './adblock_browser_proxy.js';
+import {AdBlockBrowserProxyImpl} from './adblock_browser_proxy.js';
+import {getTemplate} from './adblock_page.html.js';
+
+const SettingsAdBlockPageElementBase =
+    WebUiListenerMixin(I18nMixin(PolymerElement));
+
+export class SettingsAdBlockPageElement extends
+    SettingsAdBlockPageElementBase {
+  static get is() {
+    return 'settings-adblock-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      state_: Object,
+      mutating_: {
+        type: Boolean,
+        value: false,
+      },
+      customSourceUrl_: {
+        type: String,
+        value: '',
+      },
+    };
+  }
+
+  declare private state_: AdBlockState|null;
+  declare private mutating_: boolean;
+  declare private customSourceUrl_: string;
+
+  private browserProxy_: AdBlockBrowserProxy =
+      AdBlockBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'helium-adblock-state-changed',
+        (state: AdBlockState) => this.state_ = state);
+    this.browserProxy_.getState().then(state => this.state_ = state);
+  }
+
+  private async runMutation_(operation: Promise<boolean>) {
+    this.mutating_ = true;
+    try {
+      if (!await operation) {
+        this.showError_();
+        this.state_ = await this.browserProxy_.getState();
+      }
+    } catch {
+      this.showError_();
+      this.state_ = await this.browserProxy_.getState();
+    } finally {
+      this.mutating_ = false;
+    }
+  }
+
+  private showError_() {
+    this.shadowRoot!.querySelector<CrToastElement>('#errorToast')!.show();
+  }
+
+  private onEnabledChanged_(event: Event) {
+    const enabled = (event.currentTarget as CrToggleElement).checked;
+    this.runMutation_(this.browserProxy_.setEnabled(enabled));
+  }
+
+  private onSourceChanged_(event: Event) {
+    const toggle = event.currentTarget as CrToggleElement;
+    const id = toggle.dataset['sourceId'];
+    if (id) {
+      this.runMutation_(
+          this.browserProxy_.setSourceEnabled(id, toggle.checked));
+    }
+  }
+
+  private onCustomSourceKeydown_(event: KeyboardEvent) {
+    if (event.key === 'Enter' &&
+        !this.addCustomSourceDisabled_(
+            this.state_, this.mutating_, this.customSourceUrl_)) {
+      this.onAddCustomSource_();
+    }
+  }
+
+  private onAddCustomSource_() {
+    const input =
+        this.shadowRoot!.querySelector<CrInputElement>('#customSource')!;
+    const url = input.value.trim();
+    if (!this.isValidCustomSource_(url)) {
+      this.showError_();
+      return;
+    }
+    this.customSourceUrl_ = '';
+    this.runMutation_(this.browserProxy_.addCustomSource(url));
+  }
+
+  private onRemoveCustomSource_(event: Event) {
+    const id = (event.currentTarget as HTMLElement).dataset['sourceId'];
+    if (id) {
+      this.runMutation_(this.browserProxy_.removeCustomSource(id));
+    }
+  }
+
+  private onRefresh_() {
+    this.runMutation_(this.browserProxy_.refresh());
+  }
+
+  private onResetToDefaults_() {
+    this.runMutation_(this.browserProxy_.resetToDefaults());
+  }
+
+  private builtInSources_(sources?: AdBlockSource[]): AdBlockSource[] {
+    return (sources ?? []).filter(source => source.builtIn);
+  }
+
+  private customSources_(sources?: AdBlockSource[]): AdBlockSource[] {
+    return (sources ?? []).filter(source => !source.builtIn);
+  }
+
+  private sourceDescription_(source: AdBlockSource): string {
+    if (source.updating) {
+      return this.i18n('adBlockSourceUpdating');
+    }
+    if (source.updateState === 'failed') {
+      return this.i18n('adBlockSourceFailed');
+    }
+    switch (source.updateState) {
+      case 'bundled':
+        return this.i18n('adBlockSourceBundled');
+      case 'downloaded':
+        return this.i18n('adBlockSourceDownloaded');
+      case 'stale':
+        return this.i18n('adBlockSourceStale');
+      case 'pending':
+        return this.i18n('adBlockSourcePending');
+    }
+  }
+
+  private statusText_(state: AdBlockState|null): string {
+    if (!state) {
+      return this.i18n('adBlockStatusLoading');
+    }
+    if (!state.enabled) {
+      return this.i18n('adBlockStatusOff');
+    }
+    if (state.converting) {
+      return this.i18n('adBlockStatusApplying');
+    }
+    if (state.updating) {
+      return this.i18n(
+          'adBlockStatusUpdating', state.updateCompleted, state.updateTotal);
+    }
+    if (!state.ready) {
+      return this.i18n('adBlockStatusStarting');
+    }
+    return this.i18n('adBlockStatusReady');
+  }
+
+  private controlsDisabled_(state: AdBlockState|null, mutating: boolean) {
+    return !state || mutating;
+  }
+
+  private sourceDisabled_(
+      source: AdBlockSource, state: AdBlockState|null, mutating: boolean) {
+    return this.controlsDisabled_(state, mutating) || source.updating;
+  }
+
+  private addCustomSourceDisabled_(
+      state: AdBlockState|null, mutating: boolean, url: string) {
+    return this.controlsDisabled_(state, mutating) ||
+        !this.isValidCustomSource_(url);
+  }
+
+  private isValidCustomSource_(value: string): boolean {
+    try {
+      return new URL(value).protocol === 'https:';
+    } catch {
+      return false;
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-adblock-page': SettingsAdBlockPageElement;
+  }
+}
+
+customElements.define(
+    SettingsAdBlockPageElement.is, SettingsAdBlockPageElement);
