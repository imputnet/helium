+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Writes a grd packaging a compressed helium-filters snapshot."""
+
+import json
+import sys
+
+_HEADER = '''<?xml version="1.0" encoding="UTF-8"?>
+<grit latest_public_release="0" current_release="1">
+  <outputs>
+    <output filename="grit/adblock_filters.h" type="rc_header">
+      <emit emit_type='prepend'></emit>
+    </output>
+    <output filename="grit/adblock_filters_map.cc"
+            type="resource_file_map_source" />
+    <output filename="grit/adblock_filters_map.h"
+            type="resource_map_header" />
+    <output filename="adblock_filters.pak" type="data_package" />
+  </outputs>
+  <release seq="1">
+    <includes>
+'''
+
+_INCLUDE = ('      <include name="IDR_HELIUM_ADBLOCK_FILTER_{index}" '
+            'file="${{root_src_dir}}/third_party/helium_filters/{path}" '
+            'resource_path="{path}" use_base_dir="false" type="BINDATA" '
+            'compress="brotli" />\n')
+
+_BUNDLED_ASSETS = '''      <include name="IDR_HELIUM_ADBLOCK_CATALOG"
+               file="${root_src_dir}/third_party/helium_filters/assets/assets.json"
+               resource_path="assets/assets.json" use_base_dir="false"
+               type="BINDATA" compress="brotli" />
+      <include name="IDR_HELIUM_ADBLOCK_RESOURCES"
+               file="${root_src_dir}/third_party/helium_filters/resources.json"
+               resource_path="resources.json" use_base_dir="false"
+               type="BINDATA" compress="brotli" />
+'''
+
+_FOOTER = '''    </includes>
+  </release>
+</grit>
+'''
+
+
+def main():
+    manifest_path, grd_path = sys.argv[1:]
+    with open(manifest_path, encoding='utf-8') as manifest_file:
+        manifest = json.load(manifest_file)
+    paths = sorted(name for name in manifest['files']
+                   if name.startswith('assets/filters/'))
+    with open(grd_path, 'w', encoding='utf-8') as grd:
+        grd.write(_HEADER)
+        grd.write(_BUNDLED_ASSETS)
+        for index, path in enumerate(paths):
+            grd.write(_INCLUDE.format(index=index, path=path))
+        grd.write(_FOOTER)
+
+
+if __name__ == '__main__':
+    main()
