+# Copyright 2026 The Helium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//components/helium_adblock/features.gni")
+import("//tools/grit/grit_rule.gni")
+
+assert(enable_native_adblock)
+
+helium_filters_dir = "//third_party/helium_filters"
+adblock_resources_json = "$helium_filters_dir/resources.json"
+adblock_filters_grd = "$target_gen_dir/adblock_filters.grd"
+
+action("adblock_filters_grd") {
+  script = "make_filters_grd.py"
+  inputs = [
+    "$helium_filters_dir/assets/assets.json",
+    "$helium_filters_dir/manifest.json",
+    adblock_resources_json,
+  ]
+  outputs = [ adblock_filters_grd ]
+  args = [
+    rebase_path("$helium_filters_dir/manifest.json", root_build_dir),
+    rebase_path(adblock_filters_grd, root_build_dir),
+  ]
+}
+
+grit("adblock_filters") {
+  source = adblock_filters_grd
+
+  # Required because the .grd is generated.
+  enable_input_discovery_for_gn_analyze = false
+  use_brotli = true
+
+  output_dir = "$target_gen_dir/adblock_filters"
+  outputs = [
+    "grit/adblock_filters.h",
+    "grit/adblock_filters_map.cc",
+    "grit/adblock_filters_map.h",
+    "adblock_filters.pak",
+  ]
+  deps = [ ":adblock_filters_grd" ]
+}
+
+if (!is_android && !is_ios) {
+  if (is_mac) {
+    bundle_data("adblock_desktop_catalog") {
+      sources = [ "$helium_filters_dir/assets/assets.json" ]
+      outputs = [
+        "{{bundle_resources_dir}}/helium_adblock/assets/{{source_file_part}}",
+      ]
+    }
+
+    bundle_data("adblock_desktop_resources") {
+      sources = [ adblock_resources_json ]
+      outputs = [
+        "{{bundle_resources_dir}}/helium_adblock/{{source_file_part}}",
+      ]
+    }
+  } else {
+    copy("adblock_desktop_catalog") {
+      sources = [ "$helium_filters_dir/assets/assets.json" ]
+      outputs = [
+        "$root_out_dir/resources/helium_adblock/assets/{{source_file_part}}",
+      ]
+    }
+
+    copy("adblock_desktop_resources") {
+      sources = [ adblock_resources_json ]
+      outputs = [
+        "$root_out_dir/resources/helium_adblock/{{source_file_part}}",
+      ]
+    }
+  }
+
+  group("adblock_desktop_assets") {
+    public_deps = [
+      ":adblock_desktop_catalog",
+      ":adblock_desktop_resources",
+    ]
+  }
+}
