+
+// Platform-agnostic ad and tracker blocking service. The embedder provides
+// bundled asset access, a network loader, and locale information through
+// HeliumAdBlockClient.
+//
+// Configuration mutations (toggles, custom sources, site exceptions) are
+// applied to an authoritative in-memory configuration synchronously,
+// persisted to prefs immediately, and compiled asynchronously. Concurrent
+// mutation requests coalesce into the next compile instead of failing.
+class HeliumAdBlockService : public KeyedService {
+ public:
+  using CompletionCallback = base::OnceCallback<void(bool success)>;
+
+  HeliumAdBlockService(PrefService* prefs,
+                       const base::FilePath& state_directory,
+                       std::unique_ptr<HeliumAdBlockClient> client);
+  ~HeliumAdBlockService() override;
+
+  HeliumAdBlockClient* client() { return client_.get(); }
+
+  const ServiceState& GetState() const;
+  void AddObserver(ServiceObserver* observer);
+  void RemoveObserver(ServiceObserver* observer);
+
+  void SetEnabled(bool enabled, CompletionCallback completion);
+  const std::vector<SourceState>& GetSources() const;
+  void SetSourceEnabled(std::string id,
+                        bool enabled,
+                        CompletionCallback completion);
+  void AddCustomSource(GURL url, CompletionCallback completion);
+  void RemoveCustomSource(std::string id, CompletionCallback completion);
+  void Refresh(bool force, CompletionCallback completion);
+  // Removes every filter-list override and custom source, and re-applies the
+  // catalog and regional defaults.
+  void ResetToDefaults(CompletionCallback completion);
+
+  bool IsEnabledForURL(const GURL& url, bool off_the_record) const;
+  void SetSiteException(const GURL& url,
+                        bool disabled,
+                        bool off_the_record,
+                        CompletionCallback completion);
+
+  using MatchCallback = base::OnceCallback<void(NetworkMatchResult)>;
+  using StringCallback = base::OnceCallback<void(std::string)>;
+  using StringListCallback = base::OnceCallback<void(std::vector<std::string>)>;
+  void MatchRequest(const GURL& url,
+                    const GURL& document_url,
+                    std::string request_type,
+                    std::string method,
+                    bool off_the_record,
+                    MatchCallback callback);
+  void GetDocumentCosmeticResources(const GURL& url,
+                                    bool off_the_record,
+                                    StringCallback callback);
+  void GetGenericSelectors(const GURL& url,
+                           std::vector<std::string> classes,
+                           std::vector<std::string> ids,
+                           std::vector<std::string> exceptions,
+                           bool off_the_record,
+                           StringListCallback callback);
+
+  // Called by the embedder when the incognito session ends; drops
+  // session-scoped site exceptions.
+  void OnIncognitoSessionEnded();
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  using MatchCacheKey =
+      std::tuple<GURL, std::string, std::string, std::string>;
+
+  void StartInitialLoad();
+  void LoadDesiredConfigurationFromPrefs();
+  void PersistOverrides();
+  void PersistCustomSources();
+  void PersistSiteExceptions();
+  // Reflects the desired configuration in `sources_` so observers see toggles
+  // immediately, before the asynchronous compile commits.
+  void ApplyDesiredStateToSources();
+
+  void RequestRebuild(CompletionCallback completion);
+  void MaybeStartRebuild();
+  void FinishRebuild(GenerationFailure failure, std::string failure_detail);
+  void OnGenerationCompiled(EngineConfiguration configuration,
+                            CompiledGeneration generation);
+  void CommitGeneration(EngineConfiguration configuration,
+                        CompiledGeneration generation);
+  void OnGenerationActivated(
+      EngineConfiguration configuration,
+      CompiledGeneration generation,
+      EngineActivationResult result);
+  void FinalizeCommit(const EngineConfiguration& configuration,
+                      CompiledGeneration generation);
+
+  void StartRefreshCycle(bool force);
