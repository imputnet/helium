+rust::Slice<const uint8_t> AsRustSlice(std::string_view contents) {
+  return rust::Slice<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(contents.data()), contents.size());
+}
+
+std::string CustomTitle(std::string_view contents, const GURL& url) {
+  std::string title =
+      static_cast<std::string>(list_metadata(AsRustSlice(contents)).title);
+  if (!title.empty() && title.size() <= 256) {
+    return title;
+  }
+  return std::string(url.host());
+}
+
