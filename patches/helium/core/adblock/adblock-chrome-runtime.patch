+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/helium_adblock/helium_adblock_client_chrome.h"
+
+#include <optional>
+#include <string>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/path_service.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/helium_adblock/resources/adblock_filters/grit/adblock_filters_map.h"
+#include "content/public/browser/storage_partition.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace helium_adblock {
+namespace {
+
+std::optional<int> FindBundledResourceId(const std::string& path) {
+  for (const webui::ResourcePath& resource : kAdblockFilters) {
+    if (path == resource.path) {
+      return resource.id;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> ReadBundledResource(const std::string& path) {
+  std::optional<int> resource_id = FindBundledResourceId(path);
+  if (!resource_id) {
+    return std::nullopt;
+  }
+  return ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(
+      *resource_id);
+}
+
+}  // namespace
+
+HeliumAdBlockClientChrome::HeliumAdBlockClientChrome(Profile* profile)
+    : profile_(profile) {
+  CHECK(profile_);
+  CHECK_EQ(profile_, profile_->GetOriginalProfile());
+}
+
+HeliumAdBlockClientChrome::~HeliumAdBlockClientChrome() = default;
+
+scoped_refptr<network::SharedURLLoaderFactory>
+HeliumAdBlockClientChrome::GetURLLoaderFactory() {
+  return profile_->GetDefaultStoragePartition()
+      ->GetURLLoaderFactoryForBrowserProcess();
+}
+
+std::string HeliumAdBlockClientChrome::GetApplicationLocale() {
+  return g_browser_process->GetApplicationLocale();
+}
+
+bool HeliumAdBlockClientChrome::IsMobilePlatform() const {
+  return BUILDFLAG(IS_ANDROID);
+}
+
+base::FilePath HeliumAdBlockClientChrome::GetBundledAssetsRoot() {
+  base::FilePath resources_directory;
+  if (!base::PathService::Get(chrome::DIR_RESOURCES, &resources_directory)) {
+    return base::FilePath();
+  }
+  return resources_directory.AppendASCII("helium_adblock");
+}
+
+HeliumAdBlockClient::BundledListReader
+HeliumAdBlockClientChrome::GetBundledListReader() {
+  return {
+      .has = base::BindRepeating([](const std::string& path) {
+        return FindBundledResourceId(path).has_value();
+      }),
+      .read = base::BindRepeating(&ReadBundledResource),
+  };
+}
+
+}  // namespace helium_adblock
