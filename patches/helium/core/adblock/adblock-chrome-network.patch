+
+// Applies Helium's network filtering before requests reach Chromium's network
+// service. One proxy is created for each content URLLoaderFactory and lives as
+// long as its Mojo connection.
+class HeliumAdBlockURLLoaderFactory final
+    : public network::SelfDeletingURLLoaderFactory,
+      public ProfileObserver {
+ public:
+  HeliumAdBlockURLLoaderFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+      Profile* profile,
+      HeliumAdBlockService* service,
+      url::Origin request_initiator,
+      net::IsolationInfo isolation_info,
+      base::SelfDeletingPassKey pass_key);
+  HeliumAdBlockURLLoaderFactory(const HeliumAdBlockURLLoaderFactory&) = delete;
+  HeliumAdBlockURLLoaderFactory& operator=(
+      const HeliumAdBlockURLLoaderFactory&) = delete;
+
+  static void MaybeProxyRequest(
+      content::BrowserContext* browser_context,
+      const url::Origin& request_initiator,
+      const net::IsolationInfo& isolation_info,
+      network::URLLoaderFactoryBuilder& factory_builder);
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  ~HeliumAdBlockURLLoaderFactory() override;
+
+  GURL GetDocumentURL(const network::ResourceRequest& request) const;
+  void OnRequestMatched(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      network::ResourceRequest request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      net::MutableNetworkTrafficAnnotationTag traffic_annotation,
+      NetworkMatchResult result);
+  void ForwardRequest(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation);
+  void OnTargetFactoryDisconnected();
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<HeliumAdBlockService> service_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  const bool off_the_record_;
+  const url::Origin request_initiator_;
+  const net::IsolationInfo isolation_info_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_factory_;
+  base::WeakPtrFactory<HeliumAdBlockURLLoaderFactory> weak_ptr_factory_{this};
+};
+
