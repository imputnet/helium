+#include "url/url_constants.h"
+
+namespace helium_adblock {
+namespace {
+
+struct RedirectWriteData {
+  mojo::Remote<network::mojom::URLLoaderClient> client;
+  std::string data;
+  std::unique_ptr<mojo::DataPipeProducer> producer;
+};
+
+void OnRedirectDataWritten(std::unique_ptr<RedirectWriteData> write_data,
+                           MojoResult result) {
+  if (result != MOJO_RESULT_OK) {
+    write_data->client->OnComplete(
+        network::URLLoaderCompletionStatus(net::ERR_FAILED));
+    return;
+  }
+
+  network::URLLoaderCompletionStatus status(net::OK);
+  status.encoded_data_length = base::ByteSize(write_data->data.size());
+  status.encoded_body_length = base::ByteSize(write_data->data.size());
+  status.decoded_body_length = base::ByteSize(write_data->data.size());
+  write_data->client->OnComplete(status);
+}
+
+void SendBlockedResponse(
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+      ->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+}
+
+void SendRedirectResponse(
+    const GURL& redirect_url,
+    const std::string& method,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client) {
+  std::string data;
+  auto response = network::mojom::URLResponseHead::New();
+  net::Error result = net::DataURL::BuildResponse(
+      redirect_url, method, &response->mime_type, &response->charset, &data,
+      &response->headers);
+
+  mojo::Remote<network::mojom::URLLoaderClient> client_remote(
+      std::move(client));
+  if (result != net::OK) {
+    client_remote->OnComplete(network::URLLoaderCompletionStatus(result));
+    return;
+  }
+
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  if (mojo::CreateDataPipe(nullptr, producer, consumer) != MOJO_RESULT_OK) {
+    client_remote->OnComplete(
+        network::URLLoaderCompletionStatus(net::ERR_INSUFFICIENT_RESOURCES));
+    return;
+  }
+
+  client_remote->OnReceiveResponse(std::move(response), std::move(consumer),
+                                   std::nullopt);
+
+  auto write_data = std::make_unique<RedirectWriteData>();
+  write_data->client = std::move(client_remote);
+  write_data->data = std::move(data);
+  write_data->producer =
+      std::make_unique<mojo::DataPipeProducer>(std::move(producer));
+
+  mojo::DataPipeProducer* producer_ptr = write_data->producer.get();
+  std::string_view contents(write_data->data);
+  producer_ptr->Write(
+      std::make_unique<mojo::StringDataSource>(
+          contents, mojo::StringDataSource::AsyncWritingMode::
+                        STRING_STAYS_VALID_UNTIL_COMPLETION),
+      base::BindOnce(&OnRedirectDataWritten, std::move(write_data)));
+}
+
+std::string RequestTypeForDestination(
+    network::mojom::RequestDestination destination) {
+  using RequestDestination = network::mojom::RequestDestination;
+  switch (destination) {
+    case RequestDestination::kDocument:
+      return "document";
+    case RequestDestination::kFrame:
+    case RequestDestination::kIframe:
+    case RequestDestination::kFencedframe:
+      return "subdocument";
+    case RequestDestination::kImage:
+      return "image";
+    case RequestDestination::kAudio:
+    case RequestDestination::kTrack:
+    case RequestDestination::kVideo:
+      return "media";
+    case RequestDestination::kFont:
+      return "font";
+    case RequestDestination::kScript:
+    case RequestDestination::kServiceWorker:
+    case RequestDestination::kSharedWorker:
+    case RequestDestination::kWorker:
+    case RequestDestination::kAudioWorklet:
+    case RequestDestination::kPaintWorklet:
+    case RequestDestination::kSpeculationRules:
+    case RequestDestination::kJson:
+    case RequestDestination::kText:
+      return "script";
+    case RequestDestination::kStyle:
+      return "stylesheet";
+    case RequestDestination::kEmpty:
+      return "xmlhttprequest";
+    case RequestDestination::kEmbed:
+    case RequestDestination::kObject:
+      return "object";
+    case RequestDestination::kXslt:
+      return "xslt";
+    case RequestDestination::kManifest:
+    case RequestDestination::kReport:
+    case RequestDestination::kWebBundle:
+    case RequestDestination::kWebIdentity:
+    case RequestDestination::kCompressionDictionary:
+    case RequestDestination::kEmailVerification:
+      return "other";
+  }
+  return "other";
+}
+
+GURL OriginURL(const std::optional<url::Origin>& origin) {
+  return origin && !origin->opaque() ? origin->GetURL() : GURL();
+}
+
+}  // namespace
+
+HeliumAdBlockURLLoaderFactory::HeliumAdBlockURLLoaderFactory(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> target_factory,
+    Profile* profile,
+    HeliumAdBlockService* service,
+    url::Origin request_initiator,
+    net::IsolationInfo isolation_info,
+    base::SelfDeletingPassKey pass_key)
+    : network::SelfDeletingURLLoaderFactory(std::move(receiver), pass_key),
+      profile_(profile),
+      service_(service),
+      off_the_record_(profile->IsOffTheRecord()),
+      request_initiator_(std::move(request_initiator)),
+      isolation_info_(std::move(isolation_info)) {
+  profile_observation_.Observe(profile_);
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(base::BindOnce(
+      &HeliumAdBlockURLLoaderFactory::OnTargetFactoryDisconnected,
+      base::Unretained(this)));
+}
+
+HeliumAdBlockURLLoaderFactory::~HeliumAdBlockURLLoaderFactory() = default;
+
+// static
+void HeliumAdBlockURLLoaderFactory::MaybeProxyRequest(
+    content::BrowserContext* browser_context,
+    const url::Origin& request_initiator,
+    const net::IsolationInfo& isolation_info,
+    network::URLLoaderFactoryBuilder& factory_builder) {
+  if (!base::FeatureList::IsEnabled(kHeliumAdBlock)) {
+    return;
+  }
+
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  HeliumAdBlockService* service =
+      HeliumAdBlockServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+
+  auto [receiver, remote] = factory_builder.Append();
+  base::MakeSelfDeleting<HeliumAdBlockURLLoaderFactory>(
+      std::move(receiver), std::move(remote), profile, service,
+      request_initiator, isolation_info);
+}
+
+void HeliumAdBlockURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  GURL document_url = GetDocumentURL(request);
+  if (!request.url.SchemeIsHTTPOrHTTPS() ||
+      !service_->IsEnabledForURL(document_url, off_the_record_)) {
+    ForwardRequest(std::move(loader), request_id, options, request,
+                   std::move(client), traffic_annotation);
+    return;
+  }
+
+  service_->MatchRequest(
+      request.url, document_url, RequestTypeForDestination(request.destination),
+      request.method, off_the_record_,
+      base::BindOnce(&HeliumAdBlockURLLoaderFactory::OnRequestMatched,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(loader),
+                     request_id, options, request, std::move(client),
+                     traffic_annotation));
+}
+
+void HeliumAdBlockURLLoaderFactory::OnProfileWillBeDestroyed(
+    Profile* profile) {
+  CHECK_EQ(profile_, profile);
+  if (off_the_record_) {
+    service_->OnIncognitoSessionEnded();
+  }
+  profile_observation_.Reset();
+  profile_ = nullptr;
+  service_ = nullptr;
+  DisconnectReceiversAndDestroy();
+}
+
+GURL HeliumAdBlockURLLoaderFactory::GetDocumentURL(
+    const network::ResourceRequest& request) const {
+  if (request.destination == network::mojom::RequestDestination::kDocument) {
+    return request.url;
+  }
+  if (GURL initiator = OriginURL(request.request_initiator);
+      !initiator.is_empty()) {
+    return initiator;
+  }
+  if (!request_initiator_.opaque()) {
+    return request_initiator_.GetURL();
+  }
+  if (GURL frame = OriginURL(isolation_info_.frame_origin());
+      !frame.is_empty()) {
+    return frame;
+  }
+  return OriginURL(isolation_info_.top_frame_origin());
+}
+
+void HeliumAdBlockURLLoaderFactory::OnRequestMatched(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    network::ResourceRequest request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    net::MutableNetworkTrafficAnnotationTag traffic_annotation,
+    NetworkMatchResult result) {
+  if (result.blocked && !result.has_exception) {
+    GURL redirect_url(result.redirect);
+    if (redirect_url.SchemeIs(url::kDataScheme)) {
+      SendRedirectResponse(redirect_url, request.method, std::move(client));
+    } else {
+      SendBlockedResponse(std::move(client));
+    }
+    return;
+  }
+
+  if (!result.has_exception && !result.rewritten_url.empty()) {
+    GURL rewritten_url(result.rewritten_url);
+    if (rewritten_url.SchemeIsHTTPOrHTTPS()) {
+      request.url = std::move(rewritten_url);
+    }
+  }
+
+  ForwardRequest(std::move(loader), request_id, options, request,
+                 std::move(client), traffic_annotation);
+}
+
+void HeliumAdBlockURLLoaderFactory::ForwardRequest(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  target_factory_->CreateLoaderAndStart(std::move(loader), request_id, options,
+                                        request, std::move(client),
+                                        traffic_annotation);
+}
+
+void HeliumAdBlockURLLoaderFactory::OnTargetFactoryDisconnected() {
+  DisconnectReceiversAndDestroy();
+}
+
+}  // namespace helium_adblock
