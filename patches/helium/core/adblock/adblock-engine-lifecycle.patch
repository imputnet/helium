+std::string Digest(std::string_view value) {
+  return base::HexEncodeLower(crypto::SHA256HashString(value));
+}
+
+const SourceCacheMetadata* FindMetadata(
+    const std::vector<SourceCacheMetadata>& metadata,
+    std::string_view id) {
+  auto found = std::ranges::find(metadata, id, &SourceCacheMetadata::id);
+  return found == metadata.end() ? nullptr : &*found;
+}
+
+rust::Slice<const uint8_t> AsRustSlice(std::string_view contents) {
+  return rust::Slice<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(contents.data()), contents.size());
+}
+
+base::TimeDelta DeclaredRefreshInterval(std::string_view contents,
+                                        base::TimeDelta catalog_interval) {
+  const uint32_t expires_hours =
+      list_metadata(AsRustSlice(contents)).expires_hours;
+  return expires_hours > 0 ? base::Hours(expires_hours) : catalog_interval;
+}
+
+}  // namespace
+
+AdBlockEngineWorker::AdBlockEngineWorker(base::FilePath directory,
+                                         base::FilePath assets_root)
+    : directory_(std::move(directory)),
+      assets_root_(std::move(assets_root)),
+      source_cache_(directory_.AppendASCII("Sources")),
+      source_metadata_(source_cache_.LoadMetadata()),
+      resolver_ready_(install_domain_resolver()) {}
+
+AdBlockEngineWorker::~AdBlockEngineWorker() = default;
+
+EngineActivationResult AdBlockEngineWorker::Activate(
+    std::vector<uint8_t> serialized,
+    std::string resources_json,
+    std::string fingerprint,
+    bool persist) {
+  if (!resolver_ready_) {
+    return {.error = "domain resolver is not installed"};
+  }
+  auto engine = new_engine();
+  OperationResult deserialized =
+      engine->deserialize(rust::Slice<const uint8_t>(serialized.data(),
+                                                     serialized.size()));
+  if (!deserialized.success) {
+    return {.error = static_cast<std::string>(deserialized.error)};
+  }
+  OperationResult resources = engine->load_resources_json(resources_json);
+  if (!resources.success) {
+    return {.error = static_cast<std::string>(resources.error)};
+  }
+
+  if (persist) {
+    base::DictValue manifest;
+    manifest.Set("engine_version", kEngineVersion);
+    manifest.Set("format_version", kAdBlockGenerationFormatVersion);
+    manifest.Set("fingerprint", fingerprint);
+    manifest.Set("engine_digest",
+                 Digest(std::string_view(
+                     reinterpret_cast<const char*>(serialized.data()),
+                     serialized.size())));
+    std::string manifest_json;
+    if (!base::CreateDirectory(directory_) ||
+        !base::JSONWriter::Write(manifest, &manifest_json) ||
+        !base::ImportantFileWriter::WriteFileAtomically(
+            directory_.AppendASCII("engine.bin"),
+            std::string_view(reinterpret_cast<const char*>(serialized.data()),
+                             serialized.size()),
+            "HeliumAdBlockEngine")) {
+      return {.persistence_error = true,
+              .error = "failed to persist engine"};
+    }
+    if (!base::ImportantFileWriter::WriteFileAtomically(
+            directory_.AppendASCII("generation.json"), manifest_json,
+            "HeliumAdBlockGeneration")) {
+      return {.persistence_error = true,
+              .error = "failed to publish generation manifest"};
+    }
+  }
+
+  engine_ = std::move(engine);
+  return {.success = true};
+}
+
+bool AdBlockEngineWorker::CacheSource(std::string id,
+                                      GURL source_url,
+                                      bool mobile,
+                                      std::string contents,
+                                      SourceValidators validators) {
+  const FilterListPreprocessorEnvironment environment = {
+      .mobile = mobile,
+      .ublock = true,
+  };
+  if (!PreprocessFilterList(contents, source_url, environment).has_value()) {
+    return false;
+  }
+  SourceCacheMetadata metadata;
+  metadata.id = std::move(id);
+  metadata.validators = std::move(validators);
+  metadata.last_success = base::Time::Now();
+  metadata.expiry = GetJitteredRefreshTime(
+      metadata.last_success, DeclaredRefreshInterval(contents, base::Days(7)));
+  metadata.last_result = SourceResult::kSuccess;
+  return source_cache_.Commit(std::move(metadata), contents, &source_metadata_);
+}
+
+bool AdBlockEngineWorker::RemoveSource(std::string id) {
+  return source_cache_.Remove(id, &source_metadata_);
+}
+
+SourceValidators AdBlockEngineWorker::ValidatorsFor(std::string id) const {
+  const SourceCacheMetadata* found = FindMetadata(source_metadata_, id);
+  return found ? found->validators : SourceValidators{};
+}
+
+DownloadApplyResult AdBlockEngineWorker::ApplyFilterListDownload(
+    std::string id,
+    GURL source_url,
+    bool mobile,
+    SourceDownloadResult result,
+    base::TimeDelta catalog_interval) {
+  if (result.status == SourceDownloadResult::Status::kSuccess) {
+    const FilterListPreprocessorEnvironment environment = {
+        .mobile = mobile,
+        .ublock = true,
+    };
+    if (!PreprocessFilterList(result.contents, source_url, environment)
+             .has_value()) {
+      result.status = SourceDownloadResult::Status::kInvalidData;
+      result.contents.clear();
+    }
+  }
+  return ApplyDownload(std::move(id), std::move(result), catalog_interval);
+}
+
+DownloadApplyResult AdBlockEngineWorker::ApplyDownload(
+    std::string id,
+    SourceDownloadResult result,
+    base::TimeDelta catalog_interval) {
+  SourceCacheMetadata updated;
+  if (const SourceCacheMetadata* found = FindMetadata(source_metadata_, id)) {
+    updated = *found;
+  }
+  updated.id = std::move(id);
+  const base::Time now = base::Time::Now();
+  switch (result.status) {
+    case SourceDownloadResult::Status::kSuccess:
+      updated.validators = std::move(result.validators);
+      updated.last_success = now;
+      updated.expiry = GetJitteredRefreshTime(
+          now, DeclaredRefreshInterval(result.contents, catalog_interval));
+      updated.last_result = SourceResult::kSuccess;
+      if (source_cache_.Commit(std::move(updated), result.contents,
+                               &source_metadata_)) {
+        return {.persisted = true, .source_available = true};
+      }
+      return {};
+    case SourceDownloadResult::Status::kNotModified: {
+      const SourceCacheMetadata* existing =
+          FindMetadata(source_metadata_, updated.id);
+      std::optional<std::string> contents =
+          existing ? source_cache_.LoadContents(*existing) : std::nullopt;
+      if (!contents) {
+        updated.last_result = SourceResult::kInvalidData;
+        return {.persisted = source_cache_.RecordResult(
+                    std::move(updated), &source_metadata_)};
+      }
+      updated.last_success = now;
+      updated.expiry = GetJitteredRefreshTime(
+          now, DeclaredRefreshInterval(*contents, catalog_interval));
+      updated.last_result = SourceResult::kNotModified;
+      return {.persisted = source_cache_.RecordResult(
+                  std::move(updated), &source_metadata_),
+              .source_available = true};
+    }
+    case SourceDownloadResult::Status::kNetworkError:
+      updated.last_result = SourceResult::kNetworkError;
+      return {.persisted = source_cache_.RecordResult(
+                  std::move(updated), &source_metadata_)};
+    case SourceDownloadResult::Status::kInvalidData:
+      updated.last_result = SourceResult::kInvalidData;
+      return {.persisted = source_cache_.RecordResult(
+                  std::move(updated), &source_metadata_)};
+  }
+}
+
+DownloadApplyResult AdBlockEngineWorker::ApplyCatalogDownload(
+    SourceDownloadResult result) {
+  if (result.status == SourceDownloadResult::Status::kSuccess) {
+    std::optional<SourceCatalog> remote =
+        SourceCatalog::Parse(result.contents);
+    size_t minimum = 1;
+    std::string bundled_json;
+    if (base::ReadFileToStringWithMaxSize(GetBundledCatalogPath(assets_root_),
+                                         &bundled_json, 1024 * 1024)) {
+      if (std::optional<SourceCatalog> bundled =
+              SourceCatalog::Parse(bundled_json)) {
+        minimum = std::max<size_t>(1, bundled->entries().size() / 2);
+      }
+    }
+    if (!remote || remote->entries().size() < minimum) {
+      result.status = SourceDownloadResult::Status::kInvalidData;
+      result.contents.clear();
+    }
+  }
+  return ApplyDownload(kCatalogCacheId, std::move(result), base::Days(7));
+}
+
+NetworkMatchResult AdBlockEngineWorker::MatchRequest(
+    GURL url,
+    GURL document_url,
+    std::string request_type,
+    std::string method) const {
+  NetworkMatchResult response;
+  if (!engine_ || !url.is_valid() || !document_url.is_valid()) {
+    return response;
+  }
+  const bool third_party =
+      !net::registry_controlled_domains::SameDomainOrHost(
+          url, document_url,
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  MatchResult match = (*engine_)->matches(
+      url.spec(), std::string(url.host()), std::string(document_url.host()),
+      request_type, third_party, method);
+  response.blocked = match.blocked;
+  response.important = match.important;
+  response.has_exception = match.has_exception;
+  if (match.has_redirect) {
+    response.redirect = static_cast<std::string>(match.redirect);
+  }
+  if (match.has_rewritten_url) {
+    response.rewritten_url = static_cast<std::string>(match.rewritten_url);
+  }
+  return response;
+}
+
+std::string AdBlockEngineWorker::DocumentCosmeticResources(GURL url) const {
+  if (!engine_ || !url.is_valid()) {
+    return {};
+  }
+  StringResult result = (*engine_)->document_cosmetic_resources(url.spec());
+  if (!result.success) {
+    DLOG(ERROR) << "helium-adblock: cosmetic resource serialization failed: "
+                << static_cast<std::string>(result.error);
+    return {};
+  }
+  return static_cast<std::string>(result.value);
+}
+
+std::vector<std::string> AdBlockEngineWorker::GenericSelectors(
+    std::vector<std::string> classes,
+    std::vector<std::string> ids,
+    std::vector<std::string> exceptions) const {
+  if (!engine_) {
+    return {};
+  }
+  StringListResult result =
+      (*engine_)->generic_selectors(classes, ids, exceptions);
+  if (!result.success) {
+    DLOG(ERROR) << "helium-adblock: generic selector query failed: "
+                << static_cast<std::string>(result.error);
+    return {};
+  }
+  std::vector<std::string> selectors;
+  selectors.reserve(result.value.size());
+  for (const rust::String& selector : result.value) {
+    selectors.push_back(static_cast<std::string>(selector));
+  }
+  return selectors;
+}
