+
+constexpr uint8_t kTrustedScriptletPermission = 1;
+constexpr char kCatalogCacheId[] = "catalog-snapshot";
+
+std::string Digest(std::string_view value) {
+  return base::HexEncodeLower(crypto::SHA256HashString(value));
+}
+
+void AppendFingerprintField(std::string_view value, std::string* output) {
+  output->append(base::NumberToString(value.size()));
+  output->push_back(':');
+  output->append(value);
+}
+
+std::optional<std::string> ReadUTF8File(const base::FilePath& path,
+                                        size_t maximum_size) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, maximum_size) ||
+      !base::IsStringUTF8(contents)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+std::optional<std::string> ReadBundledUTF8(
+    const base::FilePath& path,
+    std::string_view resource_path,
+    size_t maximum_size,
+    const HeliumAdBlockClient::BundledListReader& bundled_resources) {
+  std::optional<std::string> contents = ReadUTF8File(path, maximum_size);
+  if (!contents) {
+    contents = bundled_resources.read.Run(std::string(resource_path));
+  }
+  if (!contents || contents->size() > maximum_size ||
+      !base::IsStringUTF8(*contents)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+std::optional<std::string> GetString(const base::DictValue& dict,
+                                     std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? std::optional<std::string>(*value) : std::nullopt;
+}
+
+SourceUpdateState CacheState(const SourceCacheMetadata* metadata,
+                             bool bundled,
+                             base::Time now) {
+  if (!metadata) {
+    return bundled ? SourceUpdateState::kBundled : SourceUpdateState::kPending;
+  }
+  if (metadata->last_result == SourceResult::kNetworkError ||
+      metadata->last_result == SourceResult::kInvalidData ||
+      metadata->last_result == SourceResult::kUnsupported) {
+    return SourceUpdateState::kFailed;
+  }
+  if (!metadata->expiry.is_null() && metadata->expiry < now) {
+    return SourceUpdateState::kStale;
+  }
+  return SourceUpdateState::kDownloaded;
+}
+
+std::string SourceFailureName(SourceResult result) {
+  switch (result) {
+    case SourceResult::kNetworkError:
+      return "network";
+    case SourceResult::kInvalidData:
+      return "invalid_data";
+    case SourceResult::kUnsupported:
+      return "unsupported";
+    default:
+      return {};
+  }
+}
+
+const SourceCacheMetadata* FindMetadata(
+    const std::vector<SourceCacheMetadata>& metadata,
+    std::string_view id) {
+  auto found = std::ranges::find(metadata, id, &SourceCacheMetadata::id);
+  return found == metadata.end() ? nullptr : &*found;
+}
+
+std::string PreprocessErrorName(FilterListPreprocessError error) {
+  switch (error) {
+    case FilterListPreprocessError::kInvalidSourceUrl:
+      return "invalid_source_url";
+    case FilterListPreprocessError::kInputTooLarge:
+      return "input_too_large";
+    case FilterListPreprocessError::kMalformedDirective:
+      return "malformed_directive";
+  }
+}
+
+bool LoadCachedEngine(const base::FilePath& directory,
+                      std::string_view fingerprint,
+                      CompiledGeneration* result) {
+  std::optional<std::string> manifest_json = ReadUTF8File(
+      directory.AppendASCII("generation.json"), kMaximumAdBlockManifestSize);
+  if (!manifest_json) {
+    return false;
+  }
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(*manifest_json, base::JSON_PARSE_RFC);
+  const base::DictValue* manifest = parsed ? parsed->GetIfDict() : nullptr;
+  if (!manifest || GetString(*manifest, "fingerprint") != fingerprint ||
+      manifest->FindInt("format_version") !=
+          kAdBlockGenerationFormatVersion ||
+      GetString(*manifest, "engine_version") != kEngineVersion) {
+    return false;
+  }
+  std::string engine_bytes;
+  if (!base::ReadFileToStringWithMaxSize(
+          directory.AppendASCII("engine.bin"), &engine_bytes,
+          kMaximumSerializedAdBlockEngineSize) ||
+      GetString(*manifest, "engine_digest") != Digest(engine_bytes)) {
+    return false;
+  }
+  result->serialized_engine.assign(engine_bytes.begin(), engine_bytes.end());
+  return true;
+}
+
+}  // namespace
+
+std::string_view GenerationFailureName(GenerationFailure failure) {
+  switch (failure) {
+    case GenerationFailure::kNone:
+      return std::string_view();
+    case GenerationFailure::kBundledAssets:
+      return "bundled_assets";
+    case GenerationFailure::kCatalog:
+      return "catalog";
+    case GenerationFailure::kDomainResolver:
+      return "domain_resolver";
+    case GenerationFailure::kFilterParse:
+      return "filter_parse";
+    case GenerationFailure::kResources:
+      return "resources";
+    case GenerationFailure::kActivation:
+      return "activation";
+    case GenerationFailure::kPersistence:
+      return "persistence";
+  }
+}
+
+CompiledGeneration BuildAdBlockGeneration(
+    base::FilePath directory,
+    base::FilePath assets_root,
+    HeliumAdBlockClient::BundledListReader bundled_lists,
+    EngineConfiguration configuration) {
+  CompiledGeneration result;
+  if (!install_domain_resolver()) {
+    result.failure = GenerationFailure::kDomainResolver;
+    result.failure_detail = "adblock-rust rejected Chromium's domain resolver";
+    return result;
+  }
+
+  SourceCache source_cache(directory.AppendASCII("Sources"));
+  std::optional<std::string> catalog_json = ReadBundledUTF8(
+      GetBundledCatalogPath(assets_root), kBundledCatalogResourcePath,
+      1024 * 1024, bundled_lists);
+  std::optional<std::string> resources_json = ReadBundledUTF8(
+      GetBundledResourcesPath(assets_root), kBundledResourcesResourcePath,
+      2 * 1024 * 1024, bundled_lists);
+  if (!catalog_json || !resources_json) {
+    result.failure = GenerationFailure::kBundledAssets;
+    return result;
+  }
+  std::optional<SourceCatalog> catalog = SourceCatalog::Parse(*catalog_json);
+  if (!catalog) {
+    result.failure = GenerationFailure::kCatalog;
+    return result;
+  }
+  if (configuration.mobile) {
+    catalog->PromoteMobileDefaults();
+  }
+
+  std::vector<SourceCacheMetadata> metadata = source_cache.LoadMetadata();
+  if (configuration.use_service_catalog) {
+    const SourceCacheMetadata* catalog_metadata =
+        FindMetadata(metadata, kCatalogCacheId);
+    std::optional<std::string> cached_catalog =
+        catalog_metadata ? source_cache.LoadContents(*catalog_metadata)
+                         : std::nullopt;
+    if (cached_catalog) {
+      if (std::optional<SourceCatalog> served =
+              SourceCatalog::Parse(*cached_catalog)) {
+        served->ApplyDefaultBaseline(*catalog);
+        catalog = std::move(served);
+        catalog_json = std::move(cached_catalog);
+      }
+    }
+  }
+  result.resources_json = *resources_json;
+
+  const base::Time now = base::Time::Now();
+  base::flat_set<std::string> regional;
+  if (!configuration.regional_defaults_initialized) {
+    std::vector<std::string> recommended =
+        catalog->RegionalDefaults(configuration.locale);
+    regional.insert(recommended.begin(), recommended.end());
+    result.regional_defaults = std::move(recommended);
+  }
+
+  struct EnabledContents {
+    size_t source_index;
+    std::string id;
+    std::string contents;
+    bool trusted = false;
+    GURL source_url;
+  };
+  std::vector<EnabledContents> enabled_contents;
+  std::string source_digest_input;
+
+  for (const SourceCatalogEntry& entry : catalog->entries()) {
+    SourceState state;
+    state.id = entry.id;
+    state.title = entry.title;
+    state.group = entry.group;
+    state.parent = entry.parent;
+    state.preferred = entry.preferred;
+    state.url = entry.remote_url;
+    state.catalog_default = entry.catalog_default;
+    state.update_after = entry.update_after;
+    auto override = configuration.overrides.find(entry.id);
+    if (override != configuration.overrides.end()) {
+      state.explicit_override = override->second;
+    }
+    state.effective_enabled =
+        state.explicit_override.value_or(entry.catalog_default) ||
+        regional.contains(entry.id);
+
+    const SourceCacheMetadata* cache_metadata = FindMetadata(metadata, entry.id);
+    std::optional<std::string> cached =
+        cache_metadata ? source_cache.LoadContents(*cache_metadata)
+                       : std::nullopt;
+    std::optional<std::string> bundled_list;
+    for (const std::string& candidate : entry.bundled_paths) {
+      if (bundled_lists.has.Run(candidate)) {
+        bundled_list = candidate;
+        break;
+      }
+    }
+    state.bundled_available = bundled_list.has_value();
+    state.update_state =
+        CacheState(cache_metadata, bundled_list.has_value(), now);
+    if (cache_metadata) {
+      state.last_successful_update = cache_metadata->last_success;
+      state.failure_category = SourceFailureName(cache_metadata->last_result);
+    }
+
+    std::optional<std::string> contents = std::move(cached);
+    if (!contents && bundled_list) {
+      contents = bundled_lists.read.Run(*bundled_list);
+    }
+    if (configuration.enabled && state.effective_enabled && contents) {
+      enabled_contents.push_back(
+          {result.sources.size(), entry.id, std::move(*contents),
+           entry.trusted_scriptlets,
+           entry.remote_url.value_or(
+               GURL("https://bundled.invalid/" + entry.id))});
+    }
+    result.sources.push_back(std::move(state));
+  }
+
+  for (const CustomSource& custom : configuration.custom_sources) {
+    SourceState state;
+    state.id = custom.id;
+    state.title = custom.title;
+    state.group = "custom";
+    state.url = custom.url;
+    state.built_in = false;
+    state.explicit_override = custom.enabled;
+    state.effective_enabled = custom.enabled;
+    const SourceCacheMetadata* cache_metadata = FindMetadata(metadata, custom.id);
+    std::optional<std::string> contents =
+        cache_metadata ? source_cache.LoadContents(*cache_metadata)
+                       : std::nullopt;
+    state.update_state = CacheState(cache_metadata, false, now);
+    if (cache_metadata) {
+      state.last_successful_update = cache_metadata->last_success;
+      state.failure_category = SourceFailureName(cache_metadata->last_result);
+    }
+    if (configuration.enabled && custom.enabled && contents) {
+      enabled_contents.push_back(
+          {result.sources.size(), custom.id, std::move(*contents), false,
+           custom.url});
+    }
+    result.sources.push_back(std::move(state));
+  }
+
+  struct ProcessedList {
+    std::string contents;
+    uint8_t permissions;
+  };
+  std::vector<ProcessedList> processed_lists;
+  const FilterListPreprocessorEnvironment environment = {
+      .mobile = configuration.mobile,
+      .ublock = true,
+  };
+  for (const EnabledContents& enabled : enabled_contents) {
+    auto processed =
+        PreprocessFilterList(enabled.contents, enabled.source_url, environment);
+    if (!processed.has_value()) {
+      SourceState& source = result.sources[enabled.source_index];
+      source.update_state = SourceUpdateState::kFailed;
+      source.failure_category =
+          "preprocess_" + PreprocessErrorName(processed.error());
+      LOG(WARNING) << "helium-adblock: skipped invalid source " << enabled.id
+                   << ": " << source.failure_category;
+      continue;
+    }
+    if (processed->unsupported_rule_count > 0) {
+      VLOG(1) << "helium-adblock: skipped "
+              << processed->unsupported_rule_count
+              << " unsupported rules from " << enabled.id;
+    }
+    if (processed->ignored_include_count > 0) {
+      VLOG(1) << "helium-adblock: ignored "
+              << processed->ignored_include_count
+              << " include directives from " << enabled.id;
+    }
+    AppendFingerprintField(enabled.id, &source_digest_input);
+    AppendFingerprintField(Digest(processed->contents), &source_digest_input);
+    processed_lists.push_back(
+        {std::move(processed->contents),
+         enabled.trusted ? kTrustedScriptletPermission : uint8_t{0}});
+  }
+
+  std::string fingerprint_input;
+  AppendFingerprintField(kEngineVersion, &fingerprint_input);
+  AppendFingerprintField(base::NumberToString(kAdBlockGenerationFormatVersion),
+                         &fingerprint_input);
+  AppendFingerprintField(Digest(*catalog_json), &fingerprint_input);
+  AppendFingerprintField(Digest(*resources_json), &fingerprint_input);
+  AppendFingerprintField(Digest(source_digest_input), &fingerprint_input);
+  AppendFingerprintField(configuration.mobile ? "mobile" : "desktop",
+                         &fingerprint_input);
+  result.fingerprint = Digest(fingerprint_input);
+
+  if (LoadCachedEngine(directory, result.fingerprint, &result)) {
+    result.from_cache = true;
+  } else {
+    auto engine_filters = new_filter_set();
+    for (const ProcessedList& list : processed_lists) {
+      rust::Slice<const uint8_t> rules(
+          reinterpret_cast<const uint8_t*>(list.contents.data()),
+          list.contents.size());
+      OperationResult operation =
+          engine_filters->add_filter_list(rules, list.permissions);
+      if (!operation.success) {
+        result.failure = GenerationFailure::kFilterParse;
+        result.failure_detail = static_cast<std::string>(operation.error);
+        return result;
+      }
+    }
+    auto engine = engine_from_filter_set(std::move(engine_filters));
+    OperationResult resources = engine->load_resources_json(*resources_json);
+    if (!resources.success) {
+      result.failure = GenerationFailure::kResources;
+      result.failure_detail = static_cast<std::string>(resources.error);
+      return result;
+    }
+    rust::Vec<uint8_t> serialized = engine->serialize();
+    result.serialized_engine.assign(serialized.begin(), serialized.end());
+  }
+
+  result.generation_id = result.fingerprint.substr(0, 20);
+  return result;
+}
+
+}  // namespace helium_adblock
