+#define COMPONENTS_HELIUM_ADBLOCK_CORE_ADBLOCK_ENGINE_BUILDER_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/flat_map.h"
+#include "base/containers/flat_set.h"
+#include "base/files/file_path.h"
+#include "components/helium_adblock/core/adblock_types.h"
