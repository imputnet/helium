+#include "url/gurl.h"
+
+namespace helium_adblock {
+
+inline constexpr int kAdBlockGenerationFormatVersion = 2;
+inline constexpr size_t kMaximumAdBlockManifestSize = 30 * 1024 * 1024;
+inline constexpr size_t kMaximumSerializedAdBlockEngineSize = 40 * 1024 * 1024;
+
+struct CustomSource {
+  std::string id;
+  GURL url;
+  std::string title;
+  bool enabled = true;
+};
+
+struct EngineConfiguration {
+  bool enabled = false;
+  bool mobile = false;
+  bool use_service_catalog = true;
+  bool regional_defaults_initialized = false;
+  std::string locale;
+  base::flat_map<std::string, bool> overrides;
+  std::vector<CustomSource> custom_sources;
+  base::flat_set<std::string> regular_exceptions;
+  base::flat_set<std::string> incognito_exceptions;
+};
+
+enum class GenerationFailure {
+  kNone,
+  kBundledAssets,
+  kCatalog,
+  kDomainResolver,
+  kFilterParse,
+  kResources,
+  kActivation,
+  kPersistence,
+};
+
+std::string_view GenerationFailureName(GenerationFailure failure);
+
+struct CompiledGeneration {
+  GenerationFailure failure = GenerationFailure::kNone;
+  std::string failure_detail;
+  bool from_cache = false;
+  std::string generation_id;
+  std::string fingerprint;
+  std::string resources_json;
+  std::vector<uint8_t> serialized_engine;
+  std::vector<SourceState> sources;
+  std::vector<std::string> regional_defaults;
+
+  bool success() const { return failure == GenerationFailure::kNone; }
+};
+
+CompiledGeneration BuildAdBlockGeneration(
+    base::FilePath directory,
+    base::FilePath assets_root,
+    HeliumAdBlockClient::BundledListReader bundled_lists,
+    EngineConfiguration configuration);
+
+}  // namespace helium_adblock
+
+#endif  // COMPONENTS_HELIUM_ADBLOCK_CORE_ADBLOCK_ENGINE_BUILDER_H_
