+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/helium_adblock/core/source/adblock_source_cache.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/json/values_util.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "crypto/sha2.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr size_t kMaximumSourceSize = 20 * 1024 * 1024;
+constexpr char kMetadataFilename[] = "sources.json";
+
+const char* ResultName(SourceResult result) {
+  switch (result) {
+    case SourceResult::kNever:
+      return "never";
+    case SourceResult::kSuccess:
+      return "success";
+    case SourceResult::kNotModified:
+      return "not_modified";
+    case SourceResult::kNetworkError:
+      return "network";
+    case SourceResult::kInvalidData:
+      return "invalid_data";
+    case SourceResult::kUnsupported:
+      return "unsupported";
+  }
+}
+
+SourceResult ParseResult(std::string_view value) {
+  if (value == "success") {
+    return SourceResult::kSuccess;
+  }
+  if (value == "not_modified") {
+    return SourceResult::kNotModified;
+  }
+  if (value == "network") {
+    return SourceResult::kNetworkError;
+  }
+  if (value == "invalid_data") {
+    return SourceResult::kInvalidData;
+  }
+  if (value == "unsupported") {
+    return SourceResult::kUnsupported;
+  }
+  return SourceResult::kNever;
+}
+
+void Upsert(SourceCacheMetadata metadata,
+            std::vector<SourceCacheMetadata>* all_metadata) {
+  auto existing =
+      std::ranges::find(*all_metadata, metadata.id, &SourceCacheMetadata::id);
+  if (existing == all_metadata->end()) {
+    all_metadata->push_back(std::move(metadata));
+  } else {
+    *existing = std::move(metadata);
+  }
+}
+
+std::string Digest(std::string_view contents) {
+  return base::HexEncodeLower(crypto::SHA256HashString(contents));
+}
+
+bool IsValidDigest(std::string_view digest) {
+  return digest.size() == crypto::kSHA256Length * 2 &&
+         std::ranges::all_of(digest, base::IsHexDigit<char>);
+}
+
+}  // namespace
+
+SourceCache::SourceCache(base::FilePath directory)
+    : directory_(std::move(directory)) {}
+
+SourceCache::~SourceCache() = default;
+
+std::vector<SourceCacheMetadata> SourceCache::LoadMetadata() const {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(
+          directory_.AppendASCII(kMetadataFilename), &json, 1024 * 1024)) {
+    return {};
+  }
+  std::optional<base::Value> root =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!root || !root->is_list()) {
+    DLOG(ERROR) << "helium-adblock: invalid source cache metadata";
+    return {};
+  }
+
+  std::vector<SourceCacheMetadata> result;
+  for (const base::Value& value : root->GetList()) {
+    const base::DictValue* item = value.GetIfDict();
+    const std::string* id = item ? item->FindString("id") : nullptr;
+    if (!id || !IsValidSourceId(*id)) {
+      continue;
+    }
+    SourceCacheMetadata metadata;
+    metadata.id = *id;
+    if (const std::string* digest = item->FindString("content_digest")) {
+      if (!IsValidDigest(*digest)) {
+        continue;
+      }
+      metadata.content_digest = *digest;
+    }
+    if (const std::string* etag = item->FindString("etag")) {
+      metadata.validators.etag = *etag;
+    }
+    if (const std::string* modified = item->FindString("last_modified")) {
+      metadata.validators.last_modified = *modified;
+    }
+    metadata.expiry =
+        base::ValueToTime(item->Find("expiry")).value_or(base::Time());
+    metadata.last_success =
+        base::ValueToTime(item->Find("last_success")).value_or(base::Time());
+    if (const std::string* last_result = item->FindString("last_result")) {
+      metadata.last_result = ParseResult(*last_result);
+    }
+    result.push_back(std::move(metadata));
+  }
+  return result;
+}
+
+std::optional<std::string> SourceCache::LoadContents(
+    const SourceCacheMetadata& metadata) const {
+  if (!IsValidSourceId(metadata.id)) {
+    return std::nullopt;
+  }
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(ContentPath(metadata), &contents,
+                                         kMaximumSourceSize) ||
+      !base::IsStringUTF8(contents) ||
+      (!metadata.content_digest.empty() &&
+       Digest(contents) != metadata.content_digest)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+bool SourceCache::Commit(SourceCacheMetadata metadata,
+                         std::string_view validated_contents,
+                         std::vector<SourceCacheMetadata>* all_metadata) const {
+  if (!IsValidSourceId(metadata.id) ||
+      validated_contents.size() > kMaximumSourceSize ||
+      !base::IsStringUTF8(validated_contents) ||
+      !base::CreateDirectory(directory_)) {
+    return false;
+  }
+  const auto previous =
+      std::ranges::find(*all_metadata, metadata.id, &SourceCacheMetadata::id);
+  const base::FilePath previous_path =
+      previous == all_metadata->end() ? base::FilePath()
+                                      : ContentPath(*previous);
+
+  metadata.content_digest = Digest(validated_contents);
+  const base::FilePath content_path = ContentPath(metadata);
+  if (!base::ImportantFileWriter::WriteFileAtomically(
+          content_path, validated_contents, "HeliumAdBlockSource")) {
+    return false;
+  }
+
+  std::vector<SourceCacheMetadata> updated = *all_metadata;
+  Upsert(std::move(metadata), &updated);
+  if (!WriteMetadata(updated)) {
+    if (content_path != previous_path) {
+      base::DeleteFile(content_path);
+    }
+    return false;
+  }
+  *all_metadata = std::move(updated);
+  if (!previous_path.empty() && previous_path != content_path) {
+    base::DeleteFile(previous_path);
+  }
+  return true;
+}
+
+bool SourceCache::RecordResult(
+    SourceCacheMetadata metadata,
+    std::vector<SourceCacheMetadata>* all_metadata) const {
+  if (!IsValidSourceId(metadata.id) || !base::CreateDirectory(directory_)) {
+    return false;
+  }
+  const auto previous =
+      std::ranges::find(*all_metadata, metadata.id, &SourceCacheMetadata::id);
+  if (previous != all_metadata->end() && metadata.content_digest.empty()) {
+    metadata.content_digest = previous->content_digest;
+  }
+  std::vector<SourceCacheMetadata> updated = *all_metadata;
+  Upsert(std::move(metadata), &updated);
+  if (!WriteMetadata(updated)) {
+    return false;
+  }
+  *all_metadata = std::move(updated);
+  return true;
+}
+
+bool SourceCache::Remove(
+    std::string_view source_id,
+    std::vector<SourceCacheMetadata>* all_metadata) const {
+  if (!IsValidSourceId(source_id)) {
+    return false;
+  }
+  const auto found =
+      std::ranges::find(*all_metadata, source_id, &SourceCacheMetadata::id);
+  const base::FilePath content_path =
+      found == all_metadata->end() ? base::FilePath() : ContentPath(*found);
+  std::vector<SourceCacheMetadata> updated = *all_metadata;
+  std::erase_if(updated, [&](const SourceCacheMetadata& metadata) {
+    return metadata.id == source_id;
+  });
+  if (!WriteMetadata(updated)) {
+    return false;
+  }
+  *all_metadata = std::move(updated);
+  if (!content_path.empty()) {
+    base::DeleteFile(content_path);
+  }
+  return true;
+}
+
+bool SourceCache::WriteMetadata(
+    const std::vector<SourceCacheMetadata>& all_metadata) const {
+  base::ListValue list;
+  for (const SourceCacheMetadata& metadata : all_metadata) {
+    if (!IsValidSourceId(metadata.id)) {
+      continue;
+    }
+    base::DictValue item;
+    item.Set("id", metadata.id);
+    item.Set("content_digest", metadata.content_digest);
+    item.Set("etag", metadata.validators.etag);
+    item.Set("last_modified", metadata.validators.last_modified);
+    item.Set("expiry", base::TimeToValue(metadata.expiry));
+    item.Set("last_success", base::TimeToValue(metadata.last_success));
+    item.Set("last_result", ResultName(metadata.last_result));
+    list.Append(std::move(item));
+  }
+  std::string json;
+  if (!base::JSONWriter::Write(list, &json)) {
+    return false;
+  }
+  return base::ImportantFileWriter::WriteFileAtomically(
+      directory_.AppendASCII(kMetadataFilename), json, "HeliumAdBlockMetadata");
+}
+
+base::FilePath SourceCache::ContentPath(
+    const SourceCacheMetadata& metadata) const {
+  std::string filename = metadata.id;
+  if (!metadata.content_digest.empty()) {
+    filename.append(".").append(metadata.content_digest);
+  }
+  return directory_.AppendASCII(filename + ".txt");
+}
+
+// static
+bool SourceCache::IsValidSourceId(std::string_view source_id) {
+  return !source_id.empty() && source_id.size() <= 128 &&
+         std::ranges::all_of(source_id, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_' ||
+                  c == '.';
+         });
+}
+
+}  // namespace helium_adblock
