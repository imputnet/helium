+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/helium_adblock/core/source/adblock_filter_list_preprocessor.h"
+
+#include <optional>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr size_t kMaximumFilterListSize = 20 * 1024 * 1024;
+
+class ConditionParser {
+ public:
+  ConditionParser(std::string_view input,
+                  const FilterListPreprocessorEnvironment& environment)
+      : input_(input), environment_(environment) {}
+
+  std::optional<bool> Parse() {
+    std::optional<bool> result = ParseOr();
+    SkipWhitespace();
+    if (!result.has_value() || position_ != input_.size()) {
+      return std::nullopt;
+    }
+    return result;
+  }
+
+ private:
+  std::optional<bool> ParseOr() {
+    std::optional<bool> result = ParseAnd();
+    if (!result.has_value()) {
+      return std::nullopt;
+    }
+    while (Consume("||")) {
+      const std::optional<bool> right = ParseAnd();
+      if (!right.has_value()) {
+        return std::nullopt;
+      }
+      *result = *result || *right;
+    }
+    return result;
+  }
+
+  std::optional<bool> ParseAnd() {
+    std::optional<bool> result = ParseUnary();
+    if (!result.has_value()) {
+      return std::nullopt;
+    }
+    while (Consume("&&")) {
+      const std::optional<bool> right = ParseUnary();
+      if (!right.has_value()) {
+        return std::nullopt;
+      }
+      *result = *result && *right;
+    }
+    return result;
+  }
+
+  std::optional<bool> ParseUnary() {
+    if (Consume("!")) {
+      const std::optional<bool> value = ParseUnary();
+      if (!value.has_value()) {
+        return std::nullopt;
+      }
+      return !*value;
+    }
+    if (Consume("(")) {
+      const std::optional<bool> value = ParseOr();
+      if (!value.has_value() || !Consume(")")) {
+        return std::nullopt;
+      }
+      return value;
+    }
+    return ParseCapability();
+  }
+
+  std::optional<bool> ParseCapability() {
+    SkipWhitespace();
+    const size_t start = position_;
+    while (position_ < input_.size()) {
+      const char c = input_[position_];
+      if (!base::IsAsciiAlphaNumeric(c) && c != '_') {
+        break;
+      }
+      ++position_;
+    }
+    if (start == position_) {
+      return std::nullopt;
+    }
+    const std::string_view capability =
+        input_.substr(start, position_ - start);
+    if (capability == "env_chromium") {
+      return environment_.chromium;
+    }
+    if (capability == "env_mobile") {
+      return environment_.mobile;
+    }
+    if (capability == "ext_ublock") {
+      return environment_.ublock;
+    }
+    return false;
+  }
+
+  bool Consume(std::string_view token) {
+    SkipWhitespace();
+    if (!input_.substr(position_).starts_with(token)) {
+      return false;
+    }
+    position_ += token.size();
+    return true;
+  }
+
+  void SkipWhitespace() {
+    while (position_ < input_.size() &&
+           base::IsAsciiWhitespace(input_[position_])) {
+      ++position_;
+    }
+  }
+
+  std::string_view input_;
+  const FilterListPreprocessorEnvironment& environment_;
+  size_t position_ = 0;
+};
+
+bool HasUnsupportedNetworkModifier(std::string_view line) {
+  const size_t options = line.rfind('$');
+  if (options == std::string_view::npos) {
+    return false;
+  }
+  for (std::string_view option : base::SplitStringPiece(
+           line.substr(options + 1), ",", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (option.starts_with("~")) {
+      option.remove_prefix(1);
+    }
+    option = option.substr(0, option.find('='));
+    if (option == "csp" || option == "header" || option == "ipaddress") {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsUnsupportedRule(std::string_view line) {
+  return !line.starts_with("!") &&
+         (line.find("##^") != std::string_view::npos ||
+          HasUnsupportedNetworkModifier(line));
+}
+
+struct ConditionalFrame {
+  bool parent_enabled;
+  bool condition;
+  bool saw_else = false;
+};
+
+base::expected<PreprocessedFilterList, FilterListPreprocessError>
+ProcessContents(std::string_view contents,
+                const FilterListPreprocessorEnvironment& environment) {
+  PreprocessedFilterList output;
+  bool enabled = true;
+  std::vector<ConditionalFrame> conditionals;
+  for (std::string_view line : base::SplitStringPiece(
+           contents, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    const std::string_view trimmed =
+        base::TrimWhitespaceASCII(line, base::TRIM_ALL);
+    if (base::StartsWith(trimmed, "!#if")) {
+      if (!base::StartsWith(trimmed, "!#if ")) {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      const std::optional<bool> condition =
+          ConditionParser(trimmed.substr(5), environment).Parse();
+      if (!condition.has_value()) {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      conditionals.push_back({enabled, *condition});
+      enabled = enabled && *condition;
+      continue;
+    }
+    if (base::StartsWith(trimmed, "!#else")) {
+      if (trimmed != "!#else") {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      if (conditionals.empty() || conditionals.back().saw_else) {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      conditionals.back().saw_else = true;
+      enabled = conditionals.back().parent_enabled &&
+                !conditionals.back().condition;
+      continue;
+    }
+    if (base::StartsWith(trimmed, "!#endif")) {
+      if (trimmed != "!#endif") {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      if (conditionals.empty()) {
+        return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+      }
+      enabled = conditionals.back().parent_enabled;
+      conditionals.pop_back();
+      continue;
+    }
+    if (!enabled) {
+      continue;
+    }
+    if (base::StartsWith(trimmed, "!#include")) {
+      ++output.ignored_include_count;
+      continue;
+    }
+    if (IsUnsupportedRule(trimmed)) {
+      ++output.unsupported_rule_count;
+      continue;
+    }
+    if (output.contents.size() + line.size() + 1 > kMaximumFilterListSize) {
+      return base::unexpected(FilterListPreprocessError::kInputTooLarge);
+    }
+    output.contents.append(line);
+    output.contents.push_back('\n');
+  }
+
+  if (!conditionals.empty()) {
+    return base::unexpected(FilterListPreprocessError::kMalformedDirective);
+  }
+  return output;
+}
+
+}  // namespace
+
+base::expected<PreprocessedFilterList, FilterListPreprocessError>
+PreprocessFilterList(
+    std::string_view contents,
+    const GURL& source_url,
+    const FilterListPreprocessorEnvironment& environment) {
+  if (!source_url.is_valid() || !source_url.SchemeIs("https")) {
+    return base::unexpected(FilterListPreprocessError::kInvalidSourceUrl);
+  }
+  if (contents.size() > kMaximumFilterListSize) {
+    return base::unexpected(FilterListPreprocessError::kInputTooLarge);
+  }
+  return ProcessContents(contents, environment);
+}
+
+}  // namespace helium_adblock
