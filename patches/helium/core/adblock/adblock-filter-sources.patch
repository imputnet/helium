+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/helium_adblock/core/source/adblock_source_downloader.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "net/base/ip_address.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr size_t kMaximumSourceSize = 20 * 1024 * 1024;
+constexpr size_t kMaximumRedirects = 3;
+constexpr int kMaximumRetries = 2;
+constexpr base::TimeDelta kDownloadTimeout = base::Seconds(30);
+
+std::optional<std::string> ReadDownloadedFile(const base::FilePath& path) {
+  std::string contents;
+  if (path.empty() ||
+      !base::ReadFileToStringWithMaxSize(path, &contents, kMaximumSourceSize) ||
+      !base::IsStringUTF8(contents)) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+std::string GetFirstHeaderValue(const net::HttpResponseHeaders& headers,
+                                std::string_view name) {
+  const std::optional<std::string_view> value =
+      headers.EnumerateHeader(nullptr, name);
+  return value ? std::string(*value) : std::string();
+}
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("helium_adblock_filter_download", R"(
+      semantics {
+        sender: "Helium ad and tracker blocking"
+        description:
+          "Downloads user-enabled filter-list subscriptions."
+        trigger:
+          "A stale enabled subscription, app foregrounding, or Update now."
+        data: "No user data. Conditional HTTP cache validators may be sent."
+        destination: OTHER
+        destination_other: "The filter-list URL selected by the user/catalog."
+      }
+      policy {
+        cookies_allowed: NO
+        setting:
+          "Controlled by Ad & tracker blocking source settings."
+        policy_exception_justification: "Not implemented."
+      })");
+
+}  // namespace
+
+SourceDownloader::SourceDownloader(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : url_loader_factory_(std::move(url_loader_factory)) {}
+
+SourceDownloader::~SourceDownloader() = default;
+
+void SourceDownloader::Download(const GURL& url,
+                                SourceKind source_kind,
+                                SourceValidators validators,
+                                CompletionCallback callback) {
+  Cancel();
+  GURL request_url = url;
+  if (request_url.has_ref()) {
+    // Catalog URLs may carry informational fragments; they are never sent on
+    // the wire.
+    GURL::Replacements replacements;
+    replacements.ClearRef();
+    request_url = request_url.ReplaceComponents(replacements);
+  }
+  if (!IsSafeDownloadURL(request_url, source_kind)) {
+    VLOG(1) << "helium-adblock: rejected unsafe download URL "
+            << request_url.possibly_invalid_spec();
+    SourceDownloadResult result;
+    result.status = SourceDownloadResult::Status::kInvalidData;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  source_kind_ = source_kind;
+  callback_ = std::move(callback);
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = request_url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  // Conditional validators do the caching; the HTTP cache would hide list
+  // updates behind heuristic freshness.
+  request->load_flags = net::LOAD_BYPASS_CACHE;
+  // Content encoding is negotiated (and decoded) by the network stack;
+  // Accept-Encoding is a forbidden header that would get the request
+  // rejected by the network service if set here.
+  if (!validators.etag.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfNoneMatch,
+                               validators.etag);
+  }
+  if (!validators.last_modified.empty()) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kIfModifiedSince,
+                               validators.last_modified);
+  }
+
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->SetRetryOptions(kMaximumRetries,
+                           network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE);
+  // A hung request must never wedge the refresh cycle (and the UI's
+  // updating state) forever.
+  loader_->SetTimeoutDuration(kDownloadTimeout);
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      &SourceDownloader::OnRedirect, weak_factory_.GetWeakPtr()));
+  loader_->DownloadToTempFile(
+      url_loader_factory_.get(),
+      base::BindOnce(&SourceDownloader::OnTempFileReady,
+                     weak_factory_.GetWeakPtr()),
+      kMaximumSourceSize);
+}
+
+void SourceDownloader::Cancel() {
+  weak_factory_.InvalidateWeakPtrs();
+  loader_.reset();
+  callback_.Reset();
+  redirect_count_ = 0;
+  redirect_rejected_ = false;
+}
+
+// static
+bool SourceDownloader::IsSafeDownloadURL(const GURL& url,
+                                         SourceKind source_kind) {
+  if (!url.is_valid() || !url.SchemeIs("https") || url.has_username() ||
+      url.has_password() || url.has_ref()) {
+    return false;
+  }
+  if (source_kind == SourceKind::kBuiltIn) {
+    return true;
+  }
+  if (url.HostIsIPAddress()) {
+    const std::optional<net::IPAddress> address =
+        net::IPAddress::FromIPLiteral(url.HostNoBrackets());
+    return address && address->IsPubliclyRoutable();
+  }
+  return !url.DomainIs("localhost") && !url.DomainIs("local");
+}
+
+void SourceDownloader::OnRedirect(
+    const GURL&,
+    const net::RedirectInfo& redirect_info,
+    const network::mojom::URLResponseHead&,
+    std::vector<std::string>*) {
+  if (++redirect_count_ > kMaximumRedirects ||
+      !IsSafeDownloadURL(redirect_info.new_url, source_kind_)) {
+    VLOG(1) << "helium-adblock: rejected redirect to "
+            << redirect_info.new_url.possibly_invalid_spec();
+    redirect_rejected_ = true;
+    loader_.reset();
+    if (callback_) {
+      SourceDownloadResult result;
+      result.status = SourceDownloadResult::Status::kInvalidData;
+      std::move(callback_).Run(std::move(result));
+    }
+  }
+}
+
+void SourceDownloader::OnTempFileReady(base::FilePath path) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&ReadDownloadedFile, std::move(path)),
+      base::BindOnce(&SourceDownloader::OnComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SourceDownloader::OnComplete(std::optional<std::string> response_body) {
+  if (redirect_rejected_ || !callback_) {
+    return;
+  }
+
+  SourceDownloadResult result;
+  const network::mojom::URLResponseHead* response = loader_->ResponseInfo();
+  int response_code = 0;
+  if (response && response->headers) {
+    response_code = response->headers->response_code();
+    result.http_status = response_code;
+    if (response_code == net::HTTP_NOT_MODIFIED) {
+      result.status = SourceDownloadResult::Status::kNotModified;
+    } else if (response_code == net::HTTP_OK && response_body) {
+      result.status = SourceDownloadResult::Status::kSuccess;
+      result.contents = std::move(*response_body);
+      result.validators.etag =
+          GetFirstHeaderValue(*response->headers, "ETag");
+      result.validators.last_modified = GetFirstHeaderValue(
+          *response->headers, net::HttpResponseHeaders::kLastModified);
+    } else if (response_code == net::HTTP_OK) {
+      // A 200 whose body is missing or not valid UTF-8.
+      result.status = SourceDownloadResult::Status::kInvalidData;
+    } else {
+      result.status = SourceDownloadResult::Status::kNetworkError;
+    }
+  }
+  result.net_error = loader_->NetError();
+  if (result.net_error != net::OK) {
+    result.status = SourceDownloadResult::Status::kNetworkError;
+  }
+  if (result.status != SourceDownloadResult::Status::kSuccess &&
+      result.status != SourceDownloadResult::Status::kNotModified) {
+    VLOG(1) << "helium-adblock: download failed, net_error="
+            << result.net_error << " http_status=" << response_code
+            << " body_bytes="
+            << (response_body ? response_body->size() : size_t{0});
+  }
+  loader_.reset();
+  std::move(callback_).Run(std::move(result));
+}
+
+}  // namespace helium_adblock
