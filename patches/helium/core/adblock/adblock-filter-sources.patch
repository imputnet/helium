+
+#include "base/rand_util.h"
+
+namespace helium_adblock {
+namespace {
+
+constexpr base::TimeDelta kMinimumRefreshInterval = base::Hours(4);
+constexpr base::TimeDelta kDefaultRefreshInterval = base::Days(7);
+constexpr base::TimeDelta kMaximumRefreshInterval = base::Days(30);
+
+}  // namespace
+
+base::TimeDelta ClampRefreshInterval(base::TimeDelta value) {
+  if (!value.is_positive()) {
+    value = kDefaultRefreshInterval;
+  }
+  return std::clamp(value, kMinimumRefreshInterval, kMaximumRefreshInterval);
+}
+
+base::Time GetJitteredRefreshTime(base::Time now,
+                                  base::TimeDelta refresh_interval) {
+  const base::TimeDelta interval = ClampRefreshInterval(refresh_interval);
+  const double multiplier = 0.9 + base::RandDouble() * 0.2;
+  return now + interval * multiplier;
+}
+
+}  // namespace helium_adblock
