+struct SourceCatalogEntry {
+  std::string id;
+  std::string title;
+  // Display group from the catalog's "group2" key when present, otherwise
+  // "group".
+  std::string group;
+  // Optional display cluster within the group ("parent" in the catalog).
+  std::string parent;
+  std::vector<std::string> tags;
+  std::vector<std::string> languages;
+  bool catalog_default = false;
+  // Declares a mobile user agent ("ua" in the catalog).
+  bool mobile = false;
+  // Pinned first within its group or cluster.
+  bool preferred = false;
+  // Bundled fallback candidates in catalog order; not every candidate is
+  // present in the shipped assets, so consumers use the first that exists.
+  std::vector<std::string> bundled_paths;
+  std::optional<GURL> remote_url;
+  base::TimeDelta update_after;
+  bool trusted_scriptlets = false;
+};
+
+class SourceCatalog {
+ public:
+  static std::optional<SourceCatalog> Parse(std::string_view json);
+
+  // Restricts which lists are on by default and which may run trusted
+  // scriptlets to what `baseline` (the catalog shipped with the app)
+  // declares, and inherits the baseline's bundled fallback paths. Entries
+  // absent from the baseline become opt-in and untrusted.
+  void ApplyDefaultBaseline(const SourceCatalog& baseline);
+
+  // Marks lists that declare a mobile user agent as on by default.
+  void PromoteMobileDefaults();
+
+  const std::vector<SourceCatalogEntry>& entries() const { return entries_; }
+  const SourceCatalogEntry* Find(std::string_view id) const;
+  std::vector<std::string> RegionalDefaults(std::string_view locale) const;
+
+ private:
+  std::vector<SourceCatalogEntry> entries_;
+};
+
+}  // namespace helium_adblock
+
