+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/helium_adblock/core/source/adblock_source_catalog.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/containers/flat_map.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "components/helium_adblock/core/source/adblock_refresh_schedule.h"
+
+namespace helium_adblock {
+namespace {
+
+const base::ListValue* FindList(const base::DictValue& value,
+                                std::string_view first,
+                                std::string_view second) {
+  if (const base::ListValue* list = value.FindList(first)) {
+    return list;
+  }
+  return value.FindList(second);
+}
+
+std::vector<std::string> SplitWords(const std::string* words) {
+  if (!words) {
+    return {};
+  }
+  return base::SplitString(*words, base::kWhitespaceASCII,
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+}
+
+bool IsBundledFilterPath(std::string_view value) {
+  if (!value.starts_with("assets/filters/") || value.starts_with('/') ||
+      value.find('\\') != std::string_view::npos) {
+    return false;
+  }
+  for (std::string_view component : base::SplitStringPiece(
+           value, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (component.empty() || component == "." || component == "..") {
+      return false;
+    }
+  }
+  return true;
+}
+
+void ConsiderURL(const std::string& candidate, SourceCatalogEntry* entry) {
+  GURL url(candidate);
+  if (url.is_valid() && url.has_scheme()) {
+    if (!entry->remote_url && url.SchemeIs("https") &&
+        !url.has_username() && !url.has_password() && !url.has_ref()) {
+      entry->remote_url = std::move(url);
+    }
+    return;
+  }
+  // Only helium_filters snapshot paths are packaged as built-in lists.
+  // Other relative paths in uBO-compatible catalogs are fallback metadata.
+  if (IsBundledFilterPath(candidate)) {
+    entry->bundled_paths.push_back(candidate);
+  }
+}
+
+}  // namespace
+
+// static
+std::optional<SourceCatalog> SourceCatalog::Parse(std::string_view json) {
+  std::optional<base::Value> root =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!root || !root->is_dict()) {
+    return std::nullopt;
+  }
+
+  SourceCatalog result;
+  for (const auto [id, raw_entry] : root->GetDict()) {
+    const base::DictValue* value = raw_entry.GetIfDict();
+    if (!value) {
+      continue;
+    }
+    const std::string* content = value->FindString("content");
+    if (!content || *content != "filters") {
+      continue;
+    }
+
+    SourceCatalogEntry entry;
+    entry.id = id;
+    const std::string* title = value->FindString("title");
+    const std::string* group = value->FindString("group2");
+    if (!group) {
+      group = value->FindString("group");
+    }
+    entry.title = title ? *title : id;
+    entry.group = group ? *group : "custom";
+    // Some upstream entries carry a literal "None" parent to opt out of
+    // clustering.
+    if (const std::string* parent = value->FindString("parent");
+        parent && *parent != "None") {
+      entry.parent = *parent;
+    }
+    entry.tags = SplitWords(value->FindString("tags"));
+    entry.languages = SplitWords(value->FindString("lang"));
+    entry.catalog_default = !value->FindBool("off").value_or(false);
+    if (const std::string* ua = value->FindString("ua")) {
+      entry.mobile = *ua == "mobile";
+    }
+    entry.preferred = value->FindBool("preferred").value_or(false);
+
+    // uBlock Origin's assets.json expresses "updateAfter" in days.
+    const int update_days = value->FindInt("updateAfter").value_or(7);
+    entry.update_after = ClampRefreshInterval(base::Days(update_days));
+
+    if (const std::string* content_url = value->FindString("contentURL")) {
+      ConsiderURL(*content_url, &entry);
+    } else if (const base::ListValue* content_urls =
+                   value->FindList("contentURL")) {
+      for (const base::Value& item : *content_urls) {
+        if (const std::string* url = item.GetIfString()) {
+          ConsiderURL(*url, &entry);
+        }
+      }
+    }
+    if (const base::ListValue* urls = FindList(*value, "cdnURLs", "^cdnURLs")) {
+      for (const base::Value& item : *urls) {
+        if (const std::string* url = item.GetIfString()) {
+          ConsiderURL(*url, &entry);
+        }
+      }
+    }
+
+    // Trusted resources are never granted based on data from the catalog.
+    // This allowlist contains only Helium and uBO-owned built-in source IDs.
+    entry.trusted_scriptlets = base::StartsWith(entry.id, "helium-") ||
+                               base::StartsWith(entry.id, "ublock-");
+    result.entries_.push_back(std::move(entry));
+  }
+
+  return result;
+}
+
+const SourceCatalogEntry* SourceCatalog::Find(std::string_view id) const {
+  const auto it = std::ranges::find(entries_, id, &SourceCatalogEntry::id);
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+void SourceCatalog::ApplyDefaultBaseline(const SourceCatalog& baseline) {
+  base::flat_map<std::string_view, const SourceCatalogEntry*> by_id;
+  for (const SourceCatalogEntry& entry : baseline.entries_) {
+    by_id.emplace(entry.id, &entry);
+  }
+  for (SourceCatalogEntry& entry : entries_) {
+    const auto found = by_id.find(entry.id);
+    const SourceCatalogEntry* baseline_entry =
+        found == by_id.end() ? nullptr : found->second;
+    entry.catalog_default = baseline_entry && baseline_entry->catalog_default;
+    entry.trusted_scriptlets =
+        baseline_entry && baseline_entry->trusted_scriptlets;
+    if (entry.bundled_paths.empty() && baseline_entry) {
+      entry.bundled_paths = baseline_entry->bundled_paths;
+    }
+  }
+}
+
+void SourceCatalog::PromoteMobileDefaults() {
+  for (SourceCatalogEntry& entry : entries_) {
+    if (entry.mobile) {
+      entry.catalog_default = true;
+    }
+  }
+}
+
+std::vector<std::string> SourceCatalog::RegionalDefaults(
+    std::string_view locale) const {
+  std::string language(locale.substr(0, locale.find_first_of("-_")));
+  language = base::ToLowerASCII(language);
+  std::vector<std::string> result;
+  for (const SourceCatalogEntry& entry : entries_) {
+    if (std::ranges::find(entry.languages, language) != entry.languages.end()) {
+      result.push_back(entry.id);
+    }
+  }
+  return result;
+}
+
+}  // namespace helium_adblock
