+  bool Commit(SourceCacheMetadata metadata,
+              std::string_view validated_contents,
+              std::vector<SourceCacheMetadata>* all_metadata) const;
+  bool RecordResult(SourceCacheMetadata metadata,
+                    std::vector<SourceCacheMetadata>* all_metadata) const;
