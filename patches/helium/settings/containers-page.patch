+<!-- Copyright 2026 The Helium Authors
+     You can use, redistribute, and/or modify this source code under
+     the terms of the GPL-3.0 license that can be found in the LICENSE file. -->
+
+<style include="cr-shared-style settings-shared md-select">
+  #description {
+    padding: var(--cr-section-vertical-padding) var(--cr-section-padding);
+  }
+
+  .container-row {
+    gap: 12px;
+  }
+
+  .container-icon {
+    --iron-icon-height: 20px;
+    --iron-icon-width: 20px;
+    flex-shrink: 0;
+  }
+
+  .container-name {
+    flex: 1;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  /* Labels of the dialog's fields, lighter than cr-input's own. */
+  .field-label {
+    color: var(--cr-form-field-label-color);
+    font-size: var(--cr-form-field-label-font-size);
+    line-height: var(--cr-form-field-label-line-height);
+    margin-block: 16px 8px;
+  }
+
+  #nameLabel {
+    margin-top: 0;
+  }
+
+  /* The name can't be invalid, so there's no error message to make room for. */
+  #nameInput {
+    --cr-input-error-display: none;
+  }
+
+  .choices {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 8px;
+  }
+
+  .color-choice {
+    border: none;
+    border-radius: 50%;
+    cursor: pointer;
+    height: 24px;
+    outline: none;
+    padding: 0;
+    width: 24px;
+  }
+
+  /* A ring in the color itself, with a gap, like the tab group colors. */
+  .color-choice[aria-pressed='true'] {
+    outline: 2px solid currentColor;
+    outline-offset: 2px;
+  }
+
+  .color-choice:focus-visible {
+    outline: 2px solid var(--cr-focus-outline-color);
+    outline-offset: 2px;
+  }
+
+  /* Round like the color choices, when hovered and when selected. */
+  .icon-choice {
+    --cr-icon-button-icon-size: 20px;
+    --cr-icon-button-margin-start: 0;
+    --cr-icon-button-margin-end: 0;
+    border-radius: 50%;
+  }
+
+  /* A ring and glyph in the chosen color, as large as the color rings. */
+  .icon-choice[aria-pressed='true'] {
+    box-shadow: inset 0 0 0 2px currentColor;
+  }
+
+  /* cr-icon-button's own focus ring, which the selected ring would hide. */
+  .icon-choice:focus-visible {
+    box-shadow: inset 0 0 0 2px var(--cr-focus-outline-color);
+  }
+
+  #editPreview {
+    --iron-icon-height: 20px;
+    --iron-icon-width: 20px;
+    margin-inline-end: 8px;
+  }
+</style>
+
+<settings-subpage page-title="$i18n{containersTitle}"
+    route-path$="[[routePath]]">
+  <cr-button id="addButton" class="secondary-button"
+      slot="subpage-title-extra" on-click="onAddClick_"
+      hidden="[[!enabledPref_.value]]">
+    $i18n{containersAdd}
+  </cr-button>
+
+  <settings-toggle-button id="enabledToggle"
+      pref-key="helium.containers.enabled"
+      label="$i18n{containersEnable}">
+  </settings-toggle-button>
+
+  <div id="description" class="cr-secondary-text">
+    $i18n{containersDescription}
+  </div>
+
+  <template is="dom-if" if="[[enabledPref_.value]]"
+      on-dom-change="syncNewTabTargetSelect_">
+    <div class="cr-row first">
+      <div class="flex cr-padded-text" aria-hidden="true">
+        $i18n{containersNewTabTarget}
+      </div>
+      <select id="newTabTarget" class="md-select"
+          aria-label="$i18n{containersNewTabTarget}"
+          on-change="onNewTabTargetChange_">
+        <option value="none">$i18n{containersNoContainer}</option>
+        <template is="dom-repeat" items="[[containers_]]" as="container">
+          <option value="[[getNewTabTargetValue_(container)]]">
+            [[container.name]]
+          </option>
+        </template>
+        <option value="temporary">$i18n{containersNewTemporary}</option>
+      </select>
+    </div>
+
+    <template is="dom-repeat" items="[[containers_]]">
+      <div class="cr-row container-row">
+        <cr-icon class="container-icon" icon="[[getIcon_(item.icon)]]"
+            style$="[[getContainerIconStyle_(item)]]" aria-hidden="true">
+        </cr-icon>
+        <div class="container-name">[[item.name]]</div>
+        <cr-icon-button class="icon-edit" iron-icon="cr:edit-filled"
+            title="$i18n{edit}" aria-label$="[[getEditLabel_(item)]]"
+            on-click="onEditClick_">
+        </cr-icon-button>
+        <cr-icon-button class="icon-delete-gray"
+            title="$i18n{remove}" aria-label$="[[getRemoveLabel_(item)]]"
+            on-click="onRemoveClick_">
+        </cr-icon-button>
+      </div>
+    </template>
+  </template>
+
+  <template is="dom-if" if="[[edited_]]" restamp>
+    <cr-dialog id="editDialog" show-on-attach on-close="onEditDialogClose_">
+      <div slot="title">[[getEditDialogTitle_(edited_)]]</div>
+      <div slot="body">
+        <div class="field-label" id="nameLabel" aria-hidden="true">
+          $i18n{containersName}
+        </div>
+        <cr-input id="nameInput" aria-label="$i18n{containersName}"
+            value="[[edited_.name]]" on-input="onNameInput_" autofocus
+            spellcheck="false">
+          <cr-icon id="editPreview" slot="inline-prefix"
+              icon="[[getIcon_(edited_.icon)]]"
+              style$="[[getEditedIconStyle_(edited_)]]" aria-hidden="true">
+          </cr-icon>
+        </cr-input>
+        <div class="field-label" id="colorLabel">$i18n{containersColor}</div>
+        <div class="choices" role="group" aria-labelledby="colorLabel">
+          <template is="dom-repeat" items="[[colors_]]">
+            <button class="color-choice" style$="[[getColorStyle_(item)]]"
+                aria-pressed$="[[isColorSelected_(item, edited_)]]"
+                on-click="onColorClick_">
+            </button>
+          </template>
+        </div>
+        <div class="field-label" id="iconLabel">$i18n{containersIcon}</div>
+        <div class="choices" role="group" aria-labelledby="iconLabel">
+          <template is="dom-repeat" items="[[icons_]]">
+            <cr-icon-button class="icon-choice" iron-icon="[[getIcon_(item)]]"
+                style$="[[getIconChoiceStyle_(item, edited_)]]"
+                aria-pressed$="[[isIconSelected_(item, edited_)]]"
+                on-click="onIconClick_">
+            </cr-icon-button>
+          </template>
+        </div>
+      </div>
+      <div slot="button-container">
+        <cr-button class="cancel-button" on-click="onCancelClick_">
+          $i18n{cancel}
+        </cr-button>
+        <cr-button class="action-button" disabled="[[!canSave_(edited_)]]"
+            on-click="onSaveClick_">
+          $i18n{save}
+        </cr-button>
+      </div>
+    </cr-dialog>
+  </template>
+
+  <template is="dom-if" if="[[removed_]]" restamp>
+    <cr-dialog id="removeDialog" show-on-attach
+        on-close="onRemoveDialogClose_">
+      <div slot="title">[[getRemoveDialogTitle_(removed_)]]</div>
+      <div slot="body">$i18n{containersRemoveDescription}</div>
+      <div slot="button-container">
+        <cr-button class="cancel-button" on-click="onCancelClick_">
+          $i18n{cancel}
+        </cr-button>
+        <cr-button class="action-button" on-click="onRemoveConfirm_">
+          $i18n{remove}
+        </cr-button>
+      </div>
+    </cr-dialog>
+  </template>
+</settings-subpage>
