+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon/cr_icon.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import '/shared/settings/md_select.css.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_subpage.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import {PrefServiceObserverMixin} from '/shared/settings/prefs2/pref_service_observer_mixin.js';
+
+import type {Container, NewTabTarget} from '../containers.mojom-webui.js';
+import {ContainersSettingsHandler, ContainersSettingsUIReceiver, Icon} from '../containers.mojom-webui.js';
+import {loadTimeData} from '../i18n_setup.js';
+import {SettingsViewMixin} from '../settings_page/settings_view_mixin.js';
+
+import {getTemplate} from './containers_page.html.js';
+
+// The colors offered for containers: the tab group colors, as in
+// //brave/components/containers/core/browser/default_containers_list.h.
+const COLORS: number[] = [
+  0x5f6368,
+  0x5578f4,
+  0xd93025,
+  0xf9ab00,
+  0x188038,
+  0xd01884,
+  0xa142f4,
+  0x007b83,
+  0xfa903e,
+];
+
+// Icons for mojom.Icon, close to the ones used in the browser UI.
+const ICONS = new Map<Icon, string>([
+  [Icon.kPersonal, 'settings20:account-circle'],
+  [Icon.kWork, 'settings20:work'],
+  [Icon.kShopping, 'settings20:orders'],
+  [Icon.kSocial, 'cr:group-filled'],
+  [Icon.kEvents, 'cr:schedule'],
+  [Icon.kBanking, 'settings20:credit-card'],
+  [Icon.kStar, 'cr:star-filled'],
+  [Icon.kTravel, 'settings20:travel'],
+  [Icon.kSchool, 'settings20:lightbulb-2'],
+  [Icon.kPrivate, 'settings20:incognito'],
+  [Icon.kMessaging, 'settings:mail-filled'],
+]);
+
+// Values of the "open new tabs in" menu.
+const NO_CONTAINER = 'none';
+const TEMPORARY_CONTAINER = 'temporary';
+const CONTAINER_PREFIX = 'container:';
+
+function toCssColor(color: number): string {
+  return '#' + (color & 0xffffff).toString(16).padStart(6, '0');
+}
+
+// Whether the containers' controls are shown in menus.
+const ENABLED_PREF = 'helium.containers.enabled';
+
+interface EditedContainer {
+  id: string;
+  name: string;
+  icon: Icon;
+  color: number;
+}
+
+const SettingsContainersPageElementBase =
+    SettingsViewMixin(PrefServiceObserverMixin(PolymerElement));
+
+export class SettingsContainersPageElement extends
+    SettingsContainersPageElementBase {
+  static get is() {
+    return 'settings-containers-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      routePath: String,
+      enabledPref_: Object,
+      containers_: {
+        type: Array,
+        value: () => [],
+      },
+      newTabTarget_: {
+        type: String,
+        value: NO_CONTAINER,
+      },
+      edited_: {
+        type: Object,
+        value: null,
+      },
+      removed_: {
+        type: Object,
+        value: null,
+      },
+      colors_: {
+        type: Array,
+        value: () => COLORS,
+      },
+      icons_: {
+        type: Array,
+        value: () => [...ICONS.keys()],
+      },
+    };
+  }
+
+  declare routePath: string;
+  declare private enabledPref_: chrome.settingsPrivate.PrefObject<boolean>;
+  declare private containers_: Container[];
+  declare private newTabTarget_: string;
+  declare private edited_: EditedContainer|null;
+  declare private removed_: Container|null;
+  declare private colors_: number[];
+  declare private icons_: Icon[];
+
+  private handler_ = ContainersSettingsHandler.getRemote();
+  private uiReceiver_ = new ContainersSettingsUIReceiver({
+    onContainersChanged: (containers: Container[]) => {
+      this.containers_ = containers;
+      this.syncNewTabTargetSelect_();
+    },
+    onNewTabTargetChanged: (target: NewTabTarget|null) => {
+      this.setNewTabTarget_(target);
+    },
+  });
+
+  override async connectedCallback() {
+    super.connectedCallback();
+    this.mirrorPref(ENABLED_PREF, 'enabledPref_');
+    this.handler_.bindUI(this.uiReceiver_.$.bindNewPipeAndPassRemote());
+    this.containers_ = (await this.handler_.getContainers()).containers;
+    this.setNewTabTarget_((await this.handler_.getNewTabTarget()).target);
+  }
+
+  override focusBackButton() {
+    this.shadowRoot!.querySelector('settings-subpage')!.focusBackButton();
+  }
+
+  private setNewTabTarget_(target: NewTabTarget|null) {
+    if (target?.containerId) {
+      this.newTabTarget_ = CONTAINER_PREFIX + target.containerId;
+    } else if (target?.temporaryContainer) {
+      this.newTabTarget_ = TEMPORARY_CONTAINER;
+    } else {
+      this.newTabTarget_ = NO_CONTAINER;
+    }
+    this.syncNewTabTargetSelect_();
+  }
+
+  // The options change with the containers, and the select is only there
+  // while containers are on, so its value is set once it's rendered.
+  protected syncNewTabTargetSelect_() {
+    requestAnimationFrame(() => {
+      const select =
+          this.shadowRoot!.querySelector<HTMLSelectElement>('#newTabTarget');
+      if (select) {
+        select.value = this.newTabTarget_;
+      }
+    });
+  }
+
+  protected onNewTabTargetChange_(e: Event) {
+    const value = (e.target as HTMLSelectElement).value;
+    let target: NewTabTarget|null = null;
+    if (value === TEMPORARY_CONTAINER) {
+      target = {temporaryContainer: true};
+    } else if (value.startsWith(CONTAINER_PREFIX)) {
+      target = {containerId: value.substring(CONTAINER_PREFIX.length)};
+    }
+    this.newTabTarget_ = value;
+    this.handler_.setNewTabTarget(target);
+  }
+
+  protected getNewTabTargetValue_(container: Container): string {
+    return CONTAINER_PREFIX + container.id;
+  }
+
+  protected getIcon_(icon: Icon): string {
+    return ICONS.get(icon) || ICONS.get(Icon.kDefault)!;
+  }
+
+  protected getContainerIconStyle_(container: Container): string {
+    return `--iron-icon-fill-color: ${
+        toCssColor(container.backgroundColor.value)}`;
+  }
+
+  // The color is also the current color, for the ring of the selected one.
+  protected getColorStyle_(color: number): string {
+    const cssColor = toCssColor(color);
+    return `background-color: ${cssColor}; color: ${cssColor}`;
+  }
+
+  // The selected icon is in the chosen color, others keep their own.
+  protected getIconChoiceStyle_(icon: Icon, edited: EditedContainer|null):
+      string {
+    return edited?.icon === icon ? `color: ${toCssColor(edited.color)}` : '';
+  }
+
+  protected getEditedIconStyle_(edited: EditedContainer|null): string {
+    return edited ? `--iron-icon-fill-color: ${toCssColor(edited.color)}` : '';
+  }
+
+  // For aria-pressed, which needs "true" or "false".
+  protected isColorSelected_(color: number, edited: EditedContainer|null):
+      string {
+    return String(
+        !!edited && (edited.color & 0xffffff) === (color & 0xffffff));
+  }
+
+  protected isIconSelected_(icon: Icon, edited: EditedContainer|null):
+      string {
+    return String(!!edited && edited.icon === icon);
+  }
+
+  protected getEditDialogTitle_(edited: EditedContainer|null): string {
+    return loadTimeData.getString(
+        edited?.id ? 'containersEditTitle' : 'containersAddTitle');
+  }
+
+  protected getRemoveDialogTitle_(removed: Container|null): string {
+    return removed ?
+        loadTimeData.getStringF('containersRemoveTitle', removed.name) :
+        '';
+  }
+
+  protected getEditLabel_(container: Container): string {
+    return loadTimeData.getStringF('containersEditLabel', container.name);
+  }
+
+  protected getRemoveLabel_(container: Container): string {
+    return loadTimeData.getStringF('containersRemoveLabel', container.name);
+  }
+
+  protected canSave_(edited: EditedContainer|null): boolean {
+    return !!edited && edited.name.trim().length > 0;
+  }
+
+  protected onAddClick_() {
+    // Suggest the first color that's not taken yet, leaving grey for last as
+    // it looks like no color.
+    const used = new Set(
+        this.containers_.map(c => c.backgroundColor.value & 0xffffff));
+    const [grey, ...colors] = COLORS;
+    this.edited_ = {
+      id: '',
+      name: '',
+      icon: Icon.kDefault,
+      color: [...colors, grey].find(c => !used.has(c)) ?? colors[0],
+    };
+  }
+
+  protected onEditClick_(e: {model: {item: Container}}) {
+    const container = e.model.item;
+    this.edited_ = {
+      id: container.id,
+      name: container.name,
+      icon: container.icon,
+      color: container.backgroundColor.value & 0xffffff,
+    };
+  }
+
+  protected onNameInput_(e: Event) {
+    this.edited_ = {...this.edited_!, name: (e.target as HTMLInputElement).value};
+  }
+
+  protected onColorClick_(e: {model: {item: number}}) {
+    this.edited_ = {...this.edited_!, color: e.model.item};
+  }
+
+  protected onIconClick_(e: {model: {item: Icon}}) {
+    this.edited_ = {...this.edited_!, icon: e.model.item};
+  }
+
+  protected async onSaveClick_() {
+    const edited = this.edited_;
+    if (!edited || !this.canSave_(edited)) {
+      return;
+    }
+    const container: Container = {
+      id: edited.id,
+      name: edited.name.trim(),
+      icon: edited.icon,
+      // Opaque, as SkColor.
+      backgroundColor: {value: (0xff000000 | edited.color) >>> 0},
+    };
+    if (edited.id) {
+      await this.handler_.updateContainer(container);
+    } else {
+      await this.handler_.addContainer(container);
+    }
+    this.closeDialog_('#editDialog');
+  }
+
+  protected onRemoveClick_(e: {model: {item: Container}}) {
+    this.removed_ = e.model.item;
+  }
+
+  protected async onRemoveConfirm_() {
+    if (this.removed_) {
+      await this.handler_.removeContainer(this.removed_.id);
+    }
+    this.closeDialog_('#removeDialog');
+  }
+
+  protected onCancelClick_(e: Event) {
+    const dialog = (e.target as HTMLElement).closest('cr-dialog');
+    dialog?.cancel();
+  }
+
+  protected onEditDialogClose_() {
+    this.edited_ = null;
+  }
+
+  protected onRemoveDialogClose_() {
+    this.removed_ = null;
+  }
+
+  private closeDialog_(selector: string) {
+    this.shadowRoot!.querySelector<CrDialogElement>(selector)?.close();
+  }
+}
