+    this.pushServerMode_ = server ? 'custom' : 'helium';
+  }
+
+  private isCustomPushServer_(mode: string) {
+    return mode === 'custom';
+  }
+
+  private onPushServerModeChange_(event: CustomEvent<{value: string}>) {
+    this.pushServerMode_ = event.detail.value;
+    if (!this.isCustomPushServer_(this.pushServerMode_)) {
+      PrefService.getInstance().setPrefValue('helium.services.push_server', '');
+    }
+  }
+
+  private onPushServerChange_(event: Event) {
