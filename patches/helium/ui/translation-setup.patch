+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/translate/translation_setup_dialog.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/ref_counted.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/actions/chrome_action_id.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/dialogs/browser_dialogs.h"
+#include "chrome/browser/ui/views/chrome_layout_provider.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/toolbar_button_provider.h"
+#include "chrome/browser/ui/views/translate/translate_bubble_controller.h"
+#include "components/strings/grit/components_strings.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/dialog_model_host.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/text/bytes_formatting.h"
+#include "ui/color/color_id.h"
+#include "ui/views/bubble/bubble_dialog_model_host.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/progress_bar.h"
+#include "ui/views/layout/box_layout_view.h"
+
+namespace {
+
+using PrepareCallback = translate::TranslationProvider::PrepareCallback;
+using PrepareResult = translate::TranslationProvider::PrepareResult;
+using Setup = translate::TranslationProvider::Setup;
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kAcceptButtonId);
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kProgressId);
+
+// Shared by the dialog and the setup, which can outlive each other.
+class SetupState : public base::RefCounted<SetupState> {
+ public:
+  SetupState(translate::TranslationProvider::StartSetupCallback start_setup,
+             int in_progress_message_id,
+             PrepareCallback callback)
+      : start_setup_(std::move(start_setup)),
+        in_progress_message_id_(in_progress_message_id),
+        callback_(std::move(callback)) {}
+
+  void SetDialog(ui::DialogModel* model,
+                 views::ProgressBar* progress_bar,
+                 views::Label* progress_label) {
+    model_ = model;
+    progress_bar_ = progress_bar;
+    progress_label_ = progress_label;
+  }
+
+  // Starts setup and keeps the dialog open to show its progress.
+  bool OnAcceptPressed() {
+    if (start_setup_) {
+      ui::DialogModel::Button* button =
+          model_->GetButtonByUniqueId(kAcceptButtonId);
+      model_->SetButtonEnabled(button, false);
+      model_->SetButtonLabel(
+          button, l10n_util::GetStringUTF16(in_progress_message_id_));
+      model_->SetVisible(kProgressId, true);
+      std::move(start_setup_)
+          .Run(base::BindRepeating(&SetupState::OnProgress, this),
+               base::BindOnce(&SetupState::OnSetUp, this));
+    }
+
+    return false;
+  }
+
+  // Setup can't be stopped, but the page isn't translated after it.
+  void OnCancelled() { Finish(PrepareResult::kDeclined); }
+
+  // Like other bubbles, this one closes when it loses focus, which only means
+  // the user doesn't want the setup if it hasn't started.
+  void OnClosed() {
+    if (start_setup_) {
+      OnCancelled();
+    }
+  }
+
+  void OnDialogDestroying() {
+    model_ = nullptr;
+    progress_bar_ = nullptr;
+    progress_label_ = nullptr;
+  }
+
+ private:
+  friend class base::RefCounted<SetupState>;
+  ~SetupState() = default;
+
+  void OnProgress(base::ByteSize done, base::ByteSize total) {
+    if (!progress_bar_ || total.is_zero()) {
+      return;
+    }
+
+    progress_bar_->SetValue(done.InBytesF() / total.InBytesF());
+    const ui::DataUnits units = ui::GetByteDisplayUnits(total);
+    progress_label_->SetText(l10n_util::GetStringFUTF16(
+        IDS_TRANSLATE_SETUP_DOWNLOAD_PROGRESS,
+        ui::FormatBytesWithUnits(done, units, /*show_units=*/false),
+        ui::FormatBytesWithUnits(total, units, /*show_units=*/true)));
+  }
+
+  void OnSetUp(bool success) {
+    Finish(success ? PrepareResult::kReady : PrepareResult::kFailed);
+    if (model_ && model_->host()) {
+      model_->host()->Close();
+    }
+  }
+
+  void Finish(PrepareResult result) {
+    if (callback_) {
+      std::move(callback_).Run(result);
+    }
+  }
+
+  translate::TranslationProvider::StartSetupCallback start_setup_;
+  const int in_progress_message_id_;
+  PrepareCallback callback_;
+  raw_ptr<ui::DialogModel> model_;
+  raw_ptr<views::ProgressBar> progress_bar_;
+  raw_ptr<views::Label> progress_label_;
+};
+
+}  // namespace
+
+void ShowTranslationSetupDialog(
+    content::WebContents* web_contents,
+    const std::u16string& source_language,
+    const std::u16string& target_language,
+    const Setup& setup,
+    translate::TranslationProvider::StartSetupCallback start_setup,
+    PrepareCallback callback) {
+  const bool is_download = setup.kind == Setup::Kind::kDownload;
+  const std::u16string message =
+      is_download
+          ? l10n_util::GetStringFUTF16(IDS_TRANSLATE_SETUP_DOWNLOAD_MESSAGE,
+                                       source_language, target_language,
+                                       ui::FormatBytes(setup.download_size))
+          : l10n_util::GetStringFUTF16(IDS_TRANSLATE_SETUP_SYSTEM_MESSAGE,
+                                       source_language, target_language);
+  auto state = base::MakeRefCounted<SetupState>(
+      std::move(start_setup),
+      is_download ? IDS_TRANSLATE_SETUP_DOWNLOAD_IN_PROGRESS
+                  : IDS_TRANSLATE_SETUP_SYSTEM_IN_PROGRESS,
+      std::move(callback));
+
+  auto progress = std::make_unique<views::BoxLayoutView>();
+  progress->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  progress->SetBetweenChildSpacing(8);
+  auto* progress_bar =
+      progress->AddChildView(std::make_unique<views::ProgressBar>());
+  progress_bar->SetPreferredHeight(6);
+  // Indeterminate until setup reports how far it is, if it ever does.
+  progress_bar->SetValue(-1);
+  auto* progress_label = progress->AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_DIALOG_BODY_TEXT,
+      views::style::STYLE_SECONDARY));
+  progress_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+  std::unique_ptr<ui::DialogModel> model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringUTF16(
+              is_download ? IDS_TRANSLATE_SETUP_DOWNLOAD_TITLE
+                          : IDS_TRANSLATE_SETUP_SYSTEM_TITLE))
+          .SetIcon(ui::ImageModel::FromVectorIcon(kGTranslateIcon,
+                                                  ui::kColorIcon, 20))
+          .AddParagraph(ui::DialogModelLabel(message))
+          .AddCustomField(
+              std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                  std::move(progress),
+                  views::BubbleDialogModelHost::FieldType::kText),
+              kProgressId)
+          .AddOkButton(
+              base::BindRepeating(&SetupState::OnAcceptPressed, state),
+              ui::DialogModel::Button::Params()
+                  .SetId(kAcceptButtonId)
+                  .SetLabel(l10n_util::GetStringUTF16(
+                      is_download ? IDS_TRANSLATE_SETUP_DOWNLOAD_ACCEPT
+                                  : IDS_TRANSLATE_SETUP_SYSTEM_ACCEPT)))
+          .AddCancelButton(base::BindOnce(&SetupState::OnCancelled, state))
+          .SetCloseActionCallback(base::BindOnce(&SetupState::OnClosed, state))
+          .SetDialogDestroyingCallback(
+              base::BindOnce(&SetupState::OnDialogDestroying, state))
+          .Build();
+  model->SetVisible(kProgressId, false);
+  state->SetDialog(model.get(), progress_bar, progress_label);
+
+  // Takes the place of the translate bubble, anchored to the same button.
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents);
+  BrowserWindowInterface* window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  BrowserView* browser_view =
+      window ? BrowserView::GetBrowserViewForBrowser(window) : nullptr;
+  if (!browser_view) {
+    chrome::ShowTabModal(std::move(model), web_contents);
+    return;
+  }
+
+  if (auto* controller = TranslateBubbleController::From(window)) {
+    controller->CloseBubble();
+  }
+
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model),
+      browser_view->toolbar_button_provider()->GetBubbleAnchor(
+          kActionShowTranslate),
+      views::BubbleBorder::TOP_RIGHT);
+  bubble->set_fixed_width(ChromeLayoutProvider::Get()->GetDistanceMetric(
+      DISTANCE_STANDALONE_BUBBLE_PREFERRED_WIDTH));
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
