+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/dragging/helium_pins_drag_util.h"
+
+#include <algorithm>
+#include <optional>
+
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/dragging/drag_session_data.h"
+
+namespace helium_pins {
+
+namespace {
+
+// Returns the sorted indices of the dragged tabs in `model`. With
+// `pinned_at_start`, only of the ones that were pinned, or unpinned if it's
+// false, when the drag started.
+std::vector<int> GetDraggedTabIndices(
+    const TabStripModel& model,
+    const std::vector<TabDragData>& tab_drag_data,
+    std::optional<bool> pinned_at_start = std::nullopt) {
+  std::vector<int> indices;
+  for (const TabDragData& tab_data : tab_drag_data) {
+    if (!tab_data.contents ||
+        (pinned_at_start && *pinned_at_start != tab_data.pinned_at_start)) {
+      continue;
+    }
+
+    const int index = model.GetIndexOfWebContents(tab_data.contents);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+
+  std::ranges::sort(indices);
+  return indices;
+}
+
+}  // namespace
+
+void SetDraggedTabsPinned(TabStripModel& model,
+                          const std::vector<TabDragData>& tab_drag_data,
+                          bool pinned) {
+  model.SetTabsPinned(GetDraggedTabIndices(model, tab_drag_data), pinned);
+}
+
+void RestoreDraggedTabsPinned(TabStripModel& model,
+                              const std::vector<TabDragData>& tab_drag_data) {
+  // Unpinning moves tabs, so the tabs to pin are looked up afterwards.
+  model.SetTabsPinned(GetDraggedTabIndices(model, tab_drag_data, false), false);
+  model.SetTabsPinned(GetDraggedTabIndices(model, tab_drag_data, true), true);
+}
+
+}  // namespace helium_pins
