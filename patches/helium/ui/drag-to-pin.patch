+
+void SetDraggedTabsPinned(TabStripModel& model,
+                          const std::vector<TabDragData>& tab_drag_data,
+                          std::optional<bool> pinned) {
+  // Returns the sorted indices of the tabs that should be pinned, or unpinned
+  // if `pin` is false. SetTabsPinned() skips the ones that already are.
+  const auto get_indices_to_change = [&](bool pin) {
+    std::vector<int> indices;
+    for (const TabDragData& tab_data : tab_drag_data) {
+      const int index = tab_data.contents
+                            ? model.GetIndexOfWebContents(tab_data.contents)
+                            : TabStripModel::kNoTab;
+      if (index != TabStripModel::kNoTab &&
+          pinned.value_or(tab_data.pinned_at_start) == pin) {
+        indices.push_back(index);
+      }
+    }
+    std::ranges::sort(indices);
+    return indices;
+  };
+
+  // Unpinning moves tabs, so the tabs to pin are looked up afterwards.
+  model.SetTabsPinned(get_indices_to_change(false), false);
+  model.SetTabsPinned(get_indices_to_change(true), true);
+}
+
+}  // namespace helium_pins
