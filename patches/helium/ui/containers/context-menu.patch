+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/containers/containers_open_menu.h"
+
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "brave/browser/containers/containers_service_factory.h"
+#include "brave/components/containers/content/browser/storage_partition_utils.h"
+#include "brave/components/containers/core/browser/containers_service.h"
+#include "brave/components/containers/core/common/features.h"
+#include "brave/components/containers/core/mojom/containers.mojom.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace containers {
+
+void OpenInContainer(BrowserWindowInterface* browser,
+                     const std::vector<GURL>& urls,
+                     const std::string& container_id,
+                     std::optional<url::Origin> link_initiator_origin) {
+  Profile* profile = browser->GetProfile();
+  const bool is_link = link_initiator_origin.has_value();
+  for (const GURL& url : urls) {
+    if (!url.is_valid()) {
+      continue;
+    }
+    NavigateParams params(browser, url,
+                          is_link ? ui::PAGE_TRANSITION_LINK
+                                  : ui::PAGE_TRANSITION_TYPED);
+    params.disposition = WindowOpenDisposition::kNewForegroundTab;
+    params.initiator_origin = link_initiator_origin;
+    params.started_from_context_menu = is_link;
+    if (!container_id.empty()) {
+      params.storage_partition_config = content::StoragePartitionConfig::Create(
+          profile, kContainersStoragePartitionDomain, container_id,
+          profile->IsOffTheRecord());
+    }
+    Navigate(&params);
+  }
+}
+
+ContainersOpenMenu::Params::Params() = default;
+ContainersOpenMenu::Params::Params(Params&&) = default;
+ContainersOpenMenu::Params& ContainersOpenMenu::Params::operator=(Params&&) =
+    default;
+ContainersOpenMenu::Params::~Params() = default;
+
+// static
+std::unique_ptr<ContainersOpenMenu> ContainersOpenMenu::MaybeCreate(
+    BrowserWindowInterface* browser,
+    Params params) {
+  if (!base::FeatureList::IsEnabled(features::kContainers) || !browser ||
+      params.urls.empty()) {
+    return nullptr;
+  }
+  auto* service = ContainersServiceFactory::GetForProfile(browser->GetProfile());
+  if (!service || !service->ShouldShowContainerControls()) {
+    return nullptr;
+  }
+
+  auto menu =
+      base::WrapUnique(new ContainersOpenMenu(browser, std::move(params)));
+  menu->model_ = std::make_unique<ContainersMenuModel>(*menu, *service);
+  return menu;
+}
+
+ContainersOpenMenu::ContainersOpenMenu(BrowserWindowInterface* browser,
+                                       Params params)
+    : browser_(browser), params_(std::move(params)) {}
+
+ContainersOpenMenu::~ContainersOpenMenu() = default;
+
+void ContainersOpenMenu::OnContainerSelected(
+    const mojom::ContainerPtr& container) {
+  OpenInContainer(browser_, params_.urls, container->id,
+                  params_.link_initiator_origin);
+}
+
+void ContainersOpenMenu::OnNoContainerSelected() {
+  OpenInContainer(browser_, params_.urls, std::string(),
+                  params_.link_initiator_origin);
+}
+
+void ContainersOpenMenu::OnNewTemporaryContainerSelected() {
+  auto* service = ContainersServiceFactory::GetForProfile(browser_->GetProfile());
+  CHECK(service);
+  // The URLs share one new temporary container.
+  OpenInContainer(browser_, params_.urls,
+                  service->CreateAndPersistTemporaryContainer()->id,
+                  params_.link_initiator_origin);
+}
+
+base::flat_set<std::string> ContainersOpenMenu::GetCurrentContainerIds() {
+  return params_.current_container_ids;
+}
+
+BrowserWindowInterface* ContainersOpenMenu::GetBrowserToOpenSettings() {
+  return browser_;
+}
+
+float ContainersOpenMenu::GetScaleFactor() {
+  return params_.scale_factor;
+}
+
+}  // namespace containers
