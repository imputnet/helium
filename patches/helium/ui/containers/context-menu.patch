+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_CONTAINERS_CONTAINERS_OPEN_MENU_H_
+#define CHROME_BROWSER_UI_CONTAINERS_CONTAINERS_OPEN_MENU_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/memory/raw_ptr.h"
+#include "brave/browser/ui/containers/containers_menu_model.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+class BrowserWindowInterface;
+
+namespace containers {
+
+// Opens |urls| in new tabs in the container |container_id|, or outside of
+// containers if it's empty. |link_initiator_origin| is set when opening a link,
+// to the origin of the page it's on.
+void OpenInContainer(
+    BrowserWindowInterface* browser,
+    const std::vector<GURL>& urls,
+    const std::string& container_id,
+    std::optional<url::Origin> link_initiator_origin = std::nullopt);
+
+// A containers menu that opens URLs in new tabs in the chosen container,
+// such as a link from the page context menu, the selected tabs from the tab
+// context menu, or a new tab from the new tab button.
+class ContainersOpenMenu : public ContainersMenuModel::Delegate {
+ public:
+  struct Params {
+    Params();
+    Params(Params&&);
+    Params& operator=(Params&&);
+    ~Params();
+
+    std::vector<GURL> urls;
+    // Containers the URLs are currently shown in, checked in the menu.
+    base::flat_set<std::string> current_container_ids;
+    // Set when opening a link, to the origin of the page it's on.
+    std::optional<url::Origin> link_initiator_origin;
+    float scale_factor = 1.0f;
+  };
+
+  // Returns null when container controls are disabled for the profile.
+  static std::unique_ptr<ContainersOpenMenu> MaybeCreate(
+      BrowserWindowInterface* browser,
+      Params params);
+
+  ContainersOpenMenu(const ContainersOpenMenu&) = delete;
+  ContainersOpenMenu& operator=(const ContainersOpenMenu&) = delete;
+  ~ContainersOpenMenu() override;
+
+  ui::MenuModel* model() { return model_.get(); }
+
+  // ContainersMenuModel::Delegate:
+  void OnContainerSelected(const mojom::ContainerPtr& container) override;
+  void OnNoContainerSelected() override;
+  void OnNewTemporaryContainerSelected() override;
+  base::flat_set<std::string> GetCurrentContainerIds() override;
+  BrowserWindowInterface* GetBrowserToOpenSettings() override;
+  float GetScaleFactor() override;
+
+ private:
+  ContainersOpenMenu(BrowserWindowInterface* browser, Params params);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const Params params_;
+  std::unique_ptr<ContainersMenuModel> model_;
+};
+
+}  // namespace containers
+
+#endif  // CHROME_BROWSER_UI_CONTAINERS_CONTAINERS_OPEN_MENU_H_
