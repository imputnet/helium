+#ifndef CHROME_BROWSER_UI_CONTAINERS_ACTIVE_TAB_CONTAINER_TRACKER_H_
+#define CHROME_BROWSER_UI_CONTAINERS_ACTIVE_TAB_CONTAINER_TRACKER_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/scoped_observation.h"
+#include "brave/components/containers/core/browser/containers_service.h"
+#include "brave/components/containers/core/browser/containers_service_observer.h"
+#include "brave/components/containers/core/mojom/containers.mojom.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+
+class BrowserWindowInterface;
+
+// Follows the container of the active tab of a browser window, for UI that
+// shows it.
+class ActiveTabContainerTracker : public TabStripModelObserver,
+                                  public containers::ContainersServiceObserver {
+ public:
+  // Runs |on_changed| when the container, or its name, icon or color,
+  // changes.
+  ActiveTabContainerTracker(BrowserWindowInterface& browser,
+                            base::RepeatingClosure on_changed);
+  ActiveTabContainerTracker(const ActiveTabContainerTracker&) = delete;
+  ActiveTabContainerTracker& operator=(const ActiveTabContainerTracker&) =
+      delete;
+  ~ActiveTabContainerTracker() override;
+
+  // The container of the active tab, or null if it isn't in one.
+  const containers::mojom::ContainerPtr& container() const {
+    return container_;
+  }
+
+ private:
+  void Update();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+
+  // containers::ContainersServiceObserver:
+  void OnContainersListChanged() override;
+
+  const raw_ref<BrowserWindowInterface> browser_;
+  const base::RepeatingClosure on_changed_;
+  containers::mojom::ContainerPtr container_;
+  base::ScopedObservation<containers::ContainersService,
+                          containers::ContainersServiceObserver>
+      service_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_CONTAINERS_ACTIVE_TAB_CONTAINER_TRACKER_H_
