+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/containers/active_tab_container_tracker.h"
+
+#include <string>
+#include <utility>
+
+#include "brave/browser/containers/containers_service_factory.h"
+#include "brave/components/containers/content/browser/storage_partition_utils.h"
+#include "brave/components/containers/core/common/features.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+
+ActiveTabContainerTracker::ActiveTabContainerTracker(
+    BrowserWindowInterface& browser,
+    base::RepeatingClosure on_changed)
+    : browser_(browser), on_changed_(std::move(on_changed)) {
+  if (!base::FeatureList::IsEnabled(containers::features::kContainers)) {
+    return;
+  }
+  auto* service = ContainersServiceFactory::GetForProfile(browser.GetProfile());
+  if (!service) {
+    return;
+  }
+  service_observation_.Observe(service);
+  browser.GetTabStripModel()->AddObserver(this);
+  Update();
+}
+
+ActiveTabContainerTracker::~ActiveTabContainerTracker() = default;
+
+void ActiveTabContainerTracker::Update() {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  const std::string id =
+      contents ? containers::GetContainerIdForWebContents(contents)
+               : std::string();
+  containers::mojom::ContainerPtr container =
+      id.empty() ? nullptr
+                 : service_observation_.GetSource()->GetRuntimeContainerById(id);
+  if (container == container_) {
+    return;
+  }
+  container_ = std::move(container);
+  on_changed_.Run();
+}
+
+void ActiveTabContainerTracker::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed() ||
+      change.type() == TabStripModelChange::kReplaced) {
+    Update();
+  }
+}
+
+void ActiveTabContainerTracker::OnContainersListChanged() {
+  Update();
+}
