+        profile_mgmt_heading_, ax::mojom::NameFrom::kAttribute);
+  }
+
+  std::unique_ptr<views::View> check;
+  if (is_active) {
+    check = std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+        views::kCheckIcon, ui::kColorMenuIcon, kOtherProfileImageSize));
