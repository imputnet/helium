+
+void ProfileMenuView::BuildCurrentProfileTree() {
+  ProfileAttributesEntry* entry =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetProfileAttributesWithPath(profile().GetPath());
+  if (!entry) {
+    return;
+  }
+  const std::string current_id = containers::GetContainerIdForWebContents(
+      browser().GetTabStripModel()->GetActiveWebContents());
+
+  // The profile itself stands for no container.
+  AddCurrentProfileRow(
+      ProfileMenuViewBase::GetCircularSizedImage(
+          ui::ImageModel::FromImage(entry->GetAvatarIcon(
+              kOtherProfileImageSize, /*use_high_res_file=*/true,
+              GetPlaceholderAvatarIconParamsVisibleAgainstColor(
+                  ColorProviderBrowserHelper::From(&browser())
+                      ->color_provider_source()
+                      ->GetColorProvider()
+                      ->GetColor(ui::kColorMenuBackground)))),
+          kOtherProfileImageSize),
+      entry->GetName(), /*is_container=*/false,
+      /*is_active=*/current_id.empty(),
+      base::BindRepeating(&ProfileMenuView::OnContainerButtonClicked,
+                          base::Unretained(this), std::string()));
+  for (const auto& container : GetContainersService()->GetContainers()) {
+    AddCurrentProfileRow(
+        ui::ImageModel::FromImageSkia(
+            containers::GenerateContainerForegroundIcon(
+                container->id, container->icon, kOtherProfileImageSize,
+                /*scale_factor=*/1.0f, container->background_color)),
+        base::UTF8ToUTF16(container->name), /*is_container=*/true,
+        /*is_active=*/container->id == current_id,
+        base::BindRepeating(&ProfileMenuView::OnContainerButtonClicked,
+                            base::Unretained(this), container->id));
+  }
+  AddCurrentProfileRow(
+      ui::ImageModel::FromVectorIcon(kAddIcon, ui::kColorMenuIcon,
+                                     kOtherProfileImageSize),
+      l10n_util::GetStringUTF16(IDS_CXMENU_NEW_TEMPORARY_CONTAINER),
+      /*is_container=*/true, /*is_active=*/false,
+      base::BindRepeating(&ProfileMenuView::OnTemporaryContainerButtonClicked,
+                          base::Unretained(this)));
+}
+
+void ProfileMenuView::OnContainerButtonClicked(
+    const std::string& container_id) {
+  if (!perform_menu_actions()) {
+    return;
+  }
+  content::WebContents* contents =
+      browser().GetTabStripModel()->GetActiveWebContents();
+  // Nothing to do when the page is already there.
+  if (contents &&
+      container_id != containers::GetContainerIdForWebContents(contents)) {
+    containers::OpenInContainer(&browser(), {contents->GetLastCommittedURL()},
+                                container_id);
+  }
+  GetWidget()->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+}
+
+void ProfileMenuView::OnTemporaryContainerButtonClicked() {
+  if (auto* service = ContainersServiceFactory::GetForProfile(&profile())) {
+    OnContainerButtonClicked(service->CreateAndPersistTemporaryContainer()->id);
+  }
+}
+
+void ProfileMenuView::OnManageContainersButtonClicked() {
+  if (!perform_menu_actions()) {
+    return;
+  }
+  chrome::ShowSettingsSubPage(&browser(), "containers");
+}
