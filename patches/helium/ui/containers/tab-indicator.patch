+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_CONTAINER_TAB_ACCENT_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_CONTAINER_TAB_ACCENT_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ref.h"
+#include "base/scoped_observation.h"
+#include "brave/components/containers/core/browser/containers_service.h"
+#include "brave/components/containers/core/browser/containers_service_observer.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class SkPath;
+
+namespace gfx {
+class Canvas;
+}  // namespace gfx
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace views {
+class View;
+}  // namespace views
+
+// Outlines the inside of the tab view of a tab in a container with the
+// container's color, and keeps it up to date when the container is edited.
+class ContainerTabAccent : public containers::ContainersServiceObserver {
+ public:
+  explicit ContainerTabAccent(views::View& tab_view);
+  ContainerTabAccent(const ContainerTabAccent&) = delete;
+  ContainerTabAccent& operator=(const ContainerTabAccent&) = delete;
+  ~ContainerTabAccent() override;
+
+  // Looks up the container of |tab|'s contents.
+  void Update(tabs::TabInterface* tab);
+
+  // Paints the outline just inside |highlight_path|, given in pixels for the
+  // canvas' image scale.
+  void Paint(gfx::Canvas* canvas,
+             const SkPath& highlight_path,
+             bool is_active) const;
+
+  // The name of the tab's container, or empty if it isn't in one.
+  const std::u16string& container_name() const { return name_; }
+
+ private:
+  // Reads the name and color of `container_id_`.
+  void ReadContainer();
+
+  // containers::ContainersServiceObserver:
+  void OnContainersListChanged() override;
+
+  const raw_ref<views::View> tab_view_;
+  std::string container_id_;
+  std::u16string name_;
+  std::optional<SkColor> color_;
+  base::ScopedObservation<containers::ContainersService,
+                          containers::ContainersServiceObserver>
+      service_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_CONTAINER_TAB_ACCENT_H_
