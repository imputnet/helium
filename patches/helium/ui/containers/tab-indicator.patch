+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/container_tab_accent.h"
+
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "brave/browser/containers/containers_service_factory.h"
+#include "brave/components/containers/content/browser/storage_partition_utils.h"
+#include "brave/components/containers/core/common/features.h"
+#include "brave/components/containers/core/mojom/containers.mojom.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/views/view.h"
+
+namespace {
+
+// The outline is softer on tabs that aren't active.
+constexpr SkAlpha kActiveOutlineAlpha = 0xb0;
+constexpr SkAlpha kInactiveOutlineAlpha = 0x70;
+
+}  // namespace
+
+ContainerTabAccent::ContainerTabAccent(views::View& tab_view)
+    : tab_view_(tab_view) {}
+
+ContainerTabAccent::~ContainerTabAccent() = default;
+
+void ContainerTabAccent::Update(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  containers::ContainersService* service =
+      contents && base::FeatureList::IsEnabled(containers::features::kContainers)
+          ? ContainersServiceFactory::GetForProfile(
+                Profile::FromBrowserContext(contents->GetBrowserContext()))
+          : nullptr;
+
+  if (!service) {
+    service_observation_.Reset();
+  } else if (!service_observation_.IsObservingSource(service)) {
+    service_observation_.Reset();
+    service_observation_.Observe(service);
+  }
+
+  std::string container_id =
+      service ? containers::GetContainerIdForWebContents(contents)
+              : std::string();
+  if (container_id == container_id_) {
+    return;
+  }
+  container_id_ = std::move(container_id);
+  ReadContainer();
+}
+
+void ContainerTabAccent::Paint(gfx::Canvas* canvas,
+                               const SkPath& highlight_path,
+                               bool is_active) const {
+  if (!color_) {
+    return;
+  }
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+
+  // Only the inner half of the stroke is inside the clip, which leaves a 1dp
+  // outline flush with the inside of the tab's shape.
+  canvas->ClipPath(highlight_path, true);
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(2 * scale);
+  flags.setColor(SkColorSetA(
+      *color_, is_active ? kActiveOutlineAlpha : kInactiveOutlineAlpha));
+  canvas->DrawPath(highlight_path, flags);
+}
+
+void ContainerTabAccent::ReadContainer() {
+  containers::mojom::ContainerPtr container;
+  if (!container_id_.empty()) {
+    container =
+        service_observation_.GetSource()->GetRuntimeContainerById(container_id_);
+  }
+  name_ = container ? base::UTF8ToUTF16(container->name) : std::u16string();
+  color_ = container ? std::optional<SkColor>(container->background_color)
+                     : std::nullopt;
+  tab_view_->SchedulePaint();
+}
+
+void ContainerTabAccent::OnContainersListChanged() {
+  // The container may have been renamed or recolored.
+  ReadContainer();
+}
