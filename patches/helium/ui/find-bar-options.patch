+void FindBarView::ToggleOptions() {
+  if (options_animation_.IsShowing()) {
+    options_animation_.Hide();
+    return;
+  }
+
+  if (FindBarState* state = GetFindBarState()) {
+    match_case_toggle_->SetIsOn(state->ShouldMatchCase());
+    whole_word_toggle_->SetIsOn(state->ShouldMatchWholeWord());
+  }
+  options_container_->SetVisible(true);
+  options_animation_.Show();
+}
+
+void FindBarView::OnMatchCaseChanged() {
+  if (FindBarState* state = GetFindBarState()) {
+    state->SetMatchCase(match_case_toggle_->GetIsOn());
+  }
+}
+
+void FindBarView::OnWholeWordChanged() {
+  if (FindBarState* state = GetFindBarState()) {
+    state->SetWholeWord(whole_word_toggle_->GetIsOn());
+  }
+}
+
+FindBarState* FindBarView::GetFindBarState() {
+  if (find_bar_state_observation_.IsObserving()) {
+    return find_bar_state_observation_.GetSource();
+  }
+
+  content::WebContents* web_contents =
+      find_bar_host_ ? find_bar_host_->GetFindBarController()->web_contents()
+                     : nullptr;
+  if (!web_contents) {
+    return nullptr;
+  }
+
+  FindBarState* state = FindBarStateFactory::GetForBrowserContext(
+      web_contents->GetBrowserContext());
+  if (state) {
+    find_bar_state_observation_.Observe(state);
+  }
+  return state;
+}
