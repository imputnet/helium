+void LanguagesHandler::HandleGetTranslationModels(const base::ListValue& args) {
+  AllowJavascript();
+  translate::TranslationProvider* provider = translate::GetTranslationProvider(
+      *Profile::FromWebUI(web_ui())->GetPrefs());
+  if (!provider) {
+    ResolveJavascriptCallback(args[0], base::ListValue());
+    return;
+  }
+
+  provider->GetDownloadedModels(
+      base::BindOnce(&LanguagesHandler::OnGotTranslationModels,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void LanguagesHandler::OnGotTranslationModels(
+    base::Value callback_id,
+    std::vector<translate::TranslationProvider::DownloadedModel> models) {
+  const std::string& locale = g_browser_process->GetApplicationLocale();
+  base::ListValue list;
+  for (const auto& model : models) {
+    // Usage is recorded when a translation starts, so it's never quite now.
+    const base::TimeDelta unused_for =
+        std::max(base::Time::Now() - model.last_used, base::Minutes(1));
+    list.Append(
+        base::DictValue()
+            .Set("sourceLanguage", model.source_lang)
+            .Set("targetLanguage", model.target_lang)
+            .Set("name", l10n_util::GetStringFUTF16(
+                             IDS_TRANSLATE_MODELS_NAME,
+                             l10n_util::GetDisplayNameForLocale(
+                                 model.source_lang, locale, true),
+                             l10n_util::GetDisplayNameForLocale(
+                                 model.target_lang, locale, true)))
+            .Set("details",
+                 l10n_util::GetStringFUTF16(
+                     IDS_TRANSLATE_MODELS_DETAILS, ui::FormatBytes(model.size),
+                     ui::TimeFormat::Simple(ui::TimeFormat::FORMAT_ELAPSED,
+                                            ui::TimeFormat::LENGTH_LONG,
+                                            unused_for))));
+  }
+
+  ResolveJavascriptCallback(callback_id, list);
+}
+
+void LanguagesHandler::HandleRemoveTranslationModel(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(3U, args.size());
+  translate::TranslationProvider* provider = translate::GetTranslationProvider(
+      *Profile::FromWebUI(web_ui())->GetPrefs());
+  if (!provider) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+
+  provider->RemoveDownloadedModel(
+      args[1].GetString(), args[2].GetString(),
+      base::BindOnce(&LanguagesHandler::OnTranslationModelRemoved,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void LanguagesHandler::OnTranslationModelRemoved(base::Value callback_id) {
+  ResolveJavascriptCallback(callback_id, base::Value());
+}
+
 }  // namespace settings
