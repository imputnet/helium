+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import '../controls/controlled_radio_button.js';
+import '../controls/settings_radio_group.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+
+import {getCss} from './appearance_layout_page.css.js';
+import {getHtml} from './appearance_layout_page.html.js';
+
+type PrefObject<T> = chrome.settingsPrivate.PrefObject<T>;
+
+// This must be kept in sync with the HeliumLayoutType enum in
+// chrome/browser/ui/helium/helium_layout_state_controller.h.
+enum BrowserLayout {
+  CLASSIC = 0,
+  COMPACT = 1,
+  VERTICAL = 2,
+  DYNAMIC = 3,
+}
+
+interface BrowserLayoutOption {
+  value: BrowserLayout;
+  name: string;
+  preview: string;
+}
+
+const SettingsAppearanceLayoutPageElementBase =
+    PrefServiceObserverMixinLit(CrLitElement);
+
+export class SettingsAppearanceLayoutPageElement extends
+    SettingsAppearanceLayoutPageElementBase {
+  static get is() {
+    return 'settings-appearance-layout-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      browserLayoutPref_: {type: Object},
+      browserLayoutOptions_: {type: Array},
+      showVerticalTabsExpandOnHoverEnabled_: {type: Boolean},
+    };
+  }
+
+  protected accessor browserLayoutPref_: PrefObject<number>|undefined =
+      undefined;
+
+  protected accessor browserLayoutOptions_: BrowserLayoutOption[] = [
+    {
+      value: BrowserLayout.CLASSIC,
+      name: loadTimeData.getString('browserLayoutClassic'),
+      preview: 'classic',
+    },
+    {
+      value: BrowserLayout.DYNAMIC,
+      name: loadTimeData.getString('browserLayoutDynamic'),
+      preview: 'dynamic',
+    },
+    {
+      value: BrowserLayout.COMPACT,
+      name: loadTimeData.getString('browserLayoutCompact'),
+      preview: 'compact',
+    },
+    {
+      value: BrowserLayout.VERTICAL,
+      name: loadTimeData.getString('browserLayoutVertical'),
+      preview: 'vertical',
+    },
+  ];
+
+  protected accessor showVerticalTabsExpandOnHoverEnabled_: boolean =
+      loadTimeData.getBoolean('showVerticalTabsExpandOnHoverEnabled');
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.mirrorPrefs({
+      'helium.browser.layout': 'browserLayoutPref_',
+    });
+  }
+
+  protected showVerticalSettings_(): boolean {
+    return this.browserLayoutPref_?.value === BrowserLayout.VERTICAL;
+  }
+
+  protected showVerticalTabsExpandOnHoverSetting_(): boolean {
+    return this.showVerticalTabsExpandOnHoverEnabled_ &&
+        this.showVerticalSettings_();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-appearance-layout-page': SettingsAppearanceLayoutPageElement;
+  }
+}
+
+customElements.define(
+    SettingsAppearanceLayoutPageElement.is,
+    SettingsAppearanceLayoutPageElement);
