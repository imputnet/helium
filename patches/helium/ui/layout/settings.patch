+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsAppearanceLayoutPageElement} from './appearance_layout_page.js';
+
+export function getHtml(this: SettingsAppearanceLayoutPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-section page-title="$i18n{layoutPageTitle}">
+  <settings-radio-group id="browserLayout" is-horizontal
+      pref-key="helium.browser.layout"
+      group-aria-label="$i18n{browserLayout}">
+    ${this.browserLayoutOptions_.map(item => html`
+      <controlled-radio-button class="browser-layout-option"
+          name="${item.value}" pref-key="helium.browser.layout"
+          label="${item.name}" hide-label-text no-extension-indicator>
+        <div class="browser-layout-preview ${item.preview}"
+            aria-hidden="true">
+          <div class="preview-tabs"><div></div><div></div><div></div></div>
+          <div class="preview-toolbar"></div>
+          <div class="preview-content"></div>
+        </div>
+        <div aria-hidden="true">${item.name}</div>
+      </controlled-radio-button>
+    `)}
+  </settings-radio-group>
+  <settings-toggle-button class="hr"
+      ?hidden="${!this.showVerticalSettings_()}"
+      pref-key="helium.browser.vertical_right_aligned"
+      label="$i18n{tabStripRightAlign}">
+  </settings-toggle-button>
+  <settings-toggle-button class="hr" id="showVerticalTabsExpandOnHover"
+      ?hidden="${!this.showVerticalTabsExpandOnHoverSetting_()}"
+      pref-key="vertical_tabs.expand_on_hover"
+      label="$i18n{showVerticalTabsExpandOnHover}">
+  </settings-toggle-button>
+</settings-section>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
