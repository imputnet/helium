+/* Copyright 2026 The Helium Authors
+ * You can use, redistribute, and/or modify this source code under
+ * the terms of the GPL-3.0 license that can be found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #import=chrome://resources/cr_elements/cr_shared_style_lit.css.js
+ * #import=../settings_shared_lit.css.js
+ * #include=cr-shared-style-lit settings-shared-lit
+ * #css_wrapper_metadata_end */
+
+#browserLayout {
+  display: block;
+  padding: 8px calc(var(--cr-section-padding) - 12px);
+}
+
+.browser-layout-option {
+  border-radius: var(--cr-card-border-radius);
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 0;
+  padding: 12px;
+}
+
+.browser-layout-option:hover {
+  background-color: var(--cr-hover-background-color);
+}
+
+.browser-layout-option::part(labelWrapper) {
+  align-self: stretch;
+  text-align: center;
+}
+
+.browser-layout-option::part(disc) {
+  order: 1;
+}
+
+.browser-layout-preview {
+  --preview-bar-height: 8px;
+  --preview-radius: 3px;
+  --preview-spacing: 2px;
+  aspect-ratio: 16 / 10;
+  background-color: var(--cr-fallback-color-neutral-container);
+  border: var(--cr-separator-line);
+  border-radius: calc(var(--preview-radius) + var(--preview-spacing) +
+                      var(--cr-separator-height));
+  box-sizing: border-box;
+  display: grid;
+  gap: var(--preview-spacing);
+  grid-template-areas: 'tabs' 'toolbar' 'content';
+  grid-template-rows: var(--preview-bar-height) var(--preview-bar-height) 1fr;
+  margin-bottom: 8px;
+  outline: 2px solid transparent;
+  padding: var(--preview-spacing);
+}
+
+.browser-layout-option[checked] .browser-layout-preview {
+  outline-color: var(--cr-checked-color);
+}
+
+.browser-layout-preview.dynamic {
+  grid-template-areas: 'toolbar' 'tabs' 'content';
+}
+
+.browser-layout-preview.compact {
+  grid-template-areas: 'toolbar tabs' 'content content';
+  grid-template-columns: 2fr 3fr;
+  grid-template-rows: var(--preview-bar-height) 1fr;
+}
+
+.browser-layout-preview.vertical {
+  grid-template-areas: 'toolbar toolbar' 'tabs content';
+  grid-template-columns: 25% 1fr;
+  grid-template-rows: var(--preview-bar-height) 1fr;
+}
+
+.preview-tabs {
+  display: flex;
+  gap: var(--preview-spacing);
+  grid-area: tabs;
+}
+
+.vertical .preview-tabs {
+  flex-direction: column;
+}
+
+.preview-tabs div,
+.preview-toolbar,
+.preview-content {
+  border-radius: var(--preview-radius);
+}
+
+.preview-tabs div,
+.preview-toolbar {
+  background-color: var(--cr-fallback-color-neutral-outline);
+}
+
+.preview-tabs div {
+  width: 25%;
+}
+
+.vertical .preview-tabs div {
+  height: var(--preview-bar-height);
+  width: auto;
+}
+
+.preview-toolbar {
+  grid-area: toolbar;
+}
+
+.preview-content {
+  background-color: var(--cr-fallback-color-surface);
+  grid-area: content;
+}
