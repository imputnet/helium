+gfx::Size TabScrollButtonContainer::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // The spacer between the scroll buttons fills any available width, so only
+  // measure the buttons.
+  gfx::Size size = views::View::CalculatePreferredSize(views::SizeBounds());
+  // The buttons overlap the empty edges of the scrollable area, to be as close
+  // to the tabs as the new tab button.
+  const int overlap =
+      TabStyle::Get()->GetBottomExtensionWidth() -
+      GetLayoutConstant(LayoutConstant::kTabStripPadding) -
+      GetLayoutConstant(LayoutConstant::kNewTabButtonLeadingMargin);
+  size.Enlarge(-2 * overlap, 0);
+  return size;
+}
