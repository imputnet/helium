+
+void TabDragController::MorphSystemDnDDragImageOutOfTab() {
+  // Grow out of the dragged tab into the page thumbnail. Until the thumbnail
+  // is available, the tab stays in place, so that the morph happens at once
+  // instead of in two steps. OnTabThumbnailAvailable() calls this again.
+  if (!dragged_tab_image_.isNull()) {
+    SetSystemDnDDragImage(dragged_tab_image_, dragged_tab_image_offset_);
+  }
+  if (!drag_image_.isNull()) {
+    MorphSystemDnDDragImage(drag_image_,
+                            GetDefaultDragImageOffset(drag_image_.size()),
+                            /*view_to_reveal=*/nullptr, base::DoNothing());
+  }
+}
+
+void TabDragController::MorphSystemDnDDragImageIntoTab() {
+  views::View* const view = drag_data_.source_view_drag_data()->attached_view;
+  if (!view || dragged_tab_image_.isNull()) {
+    SetSystemDnDDragImage({}, {});
+    return;
+  }
+
+  // Keep the tab hidden while the drag image shrinks into it, then hide the
+  // drag image.
+  if (view->layer()) {
+    view->layer()->SetOpacity(0.0f);
+  }
+  MorphSystemDnDDragImage(
+      dragged_tab_image_,
+      view->GetBoundsInScreen().origin() -
+          display::Screen::Get()->GetCursorScreenPoint(),
+      view,
+      base::BindOnce(&TabDragController::SetSystemDnDDragImage,
+                     weak_factory_.GetWeakPtr(), gfx::ImageSkia(),
+                     gfx::Vector2d()));
+}
