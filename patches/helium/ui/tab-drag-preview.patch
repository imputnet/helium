+
+void TabDragController::MorphSystemDnDDragImage(const gfx::ImageSkia& image,
+                                                const gfx::Vector2d& offset,
+                                                views::View* view_to_reveal,
+                                                base::OnceClosure done) {
+  // Replacing a morph reveals the view it was hiding.
+  drag_image_morph_ = std::make_unique<DragImageMorph>(
+      current_drag_image_, current_drag_image_offset_, image, offset,
+      views::ScaleFactorForDragFromWidget(system_drag_and_drop_widget_.get()),
+      view_to_reveal,
+      base::BindRepeating(&TabDragController::SetSystemDnDDragImage,
