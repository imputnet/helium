+
+void ContentsWebView::SetCanShowNativeFrameMaterial(bool can_show) {
+  if (can_show_native_frame_material_ == can_show) {
+    return;
+  }
+
+  can_show_native_frame_material_ = can_show;
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
+}
+
+bool ContentsWebView::ShowsNativeFrameMaterial() const {
+  if (!web_contents() || !can_show_native_frame_material_) {
+    return false;
+  }
+
+  // The visible entry, so a new tab is transparent before its page commits.
+  // Its actual URL, as an extension that replaces the page keeps the shown one,
+  // and only the page that can be transparent, not the incognito one.
+  const content::NavigationEntry* const entry =
+      web_contents()->GetController().GetVisibleEntry();
+  if (!entry) {
+    return false;
+  }
+  const GURL& url = entry->GetURL();
+  if (!url.SchemeIs(content::kChromeUIScheme) ||
+      url.host() != chrome::kChromeUINewTabPageHost) {
+    return false;
+  }
+
+  // Like the page itself, unless it shows an image over its background.
+  const ui::ThemeProvider* const theme_provider = GetThemeProvider();
+  if (theme_provider &&
+      theme_provider->HasCustomImage(IDR_THEME_NTP_BACKGROUND)) {
+    return false;
+  }
+  NtpCustomBackgroundService* const custom_background_service =
+      NtpCustomBackgroundServiceFactory::GetForProfile(
+          Profile::FromBrowserContext(web_contents()->GetBrowserContext()));
+  return !custom_background_service ||
+         !custom_background_service->GetCustomBackground().has_value();
+}
+
+void ContentsWebView::PrimaryPageChanged(content::Page& page) {
+  views::WebView::PrimaryPageChanged(page);
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
 }
 
