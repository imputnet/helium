+void NewTabPageHandler::OnSplitTabChanged(const SplitTabChange& change) {
+  // The page is solid in a split, so its theme changes with its own.
+  const std::vector<std::pair<tabs::TabInterface*, int>>* tabs = nullptr;
+  if (change.type == SplitTabChange::Type::kAdded) {
+    tabs = &change.GetAddedChange()->tabs();
+  } else if (change.type == SplitTabChange::Type::kRemoved) {
+    tabs = &change.GetRemovedChange()->tabs();
+  }
+
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(web_contents_);
+  if (tabs && std::ranges::contains(
+                  *tabs, tab, &std::pair<tabs::TabInterface*, int>::first)) {
+    OnThemeChanged();
+  }
+}
+
+void NewTabPageHandler::ObserveSplitTabs() {
+  TabStripModelObserver::StopObservingAll(this);
+  if (auto* const browser = webui::GetBrowserWindowInterface(web_contents_)) {
+    browser->GetTabStripModel()->AddObserver(this);
+  }
+}
+
+void NewTabPageHandler::OnNativeFrameMaterialWindowChanged() {
+  ObserveSplitTabs();
+  OnThemeChanged();
+}
