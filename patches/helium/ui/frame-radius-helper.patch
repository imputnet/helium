+
+assert(!is_android)
+
+source_set("frame_corner_radius") {
+  sources = [
+    "frame_corner_radius.cc",
+    "frame_corner_radius.h",
+  ]
+
+  deps = [
+    "//build:buildflag_header_h",
+    "//chrome/browser/ui:layout_constants",
+  ]
+
+  if (is_mac) {
+    sources += [ "frame_corner_radius_mac.mm" ]
+  }
+}
