+TEST_P(MultiContentsViewDropTargetControllerParamTest,
+       TabDropAreaScalesWithViewport) {
+  const auto [side, rtl] = GetParam();
+  for (int size : {400, 2000, 4000}) {
+    SCOPED_TRACE(size);
+    drop_target_view().parent()->SetSize(gfx::Size(size, size));
+
+    const auto point_at_inset = [&](int percentage) {
+      const int inset = size * percentage / 100;
+      if (side == DropSide::BOTTOM) {
+        return gfx::Point(size / 2, size - inset);
+      }
+      const bool is_left = (side == DropSide::START) != rtl;
+      return gfx::Point(is_left ? inset : size - inset, size / 2);
+    };
+
+    // Both the trigger and the visible target extend to 35% of the viewport.
+    DragTabTo(point_at_inset(34));
+    FastForward(base::Seconds(2));
+    ASSERT_TRUE(drop_target_view().IsVisibleAndNotClosing());
+    EXPECT_EQ(side, drop_target_view().side());
+    EXPECT_TRUE(controller().CanDropTab());
+    EXPECT_EQ(size * 35 / 100,
+              drop_target_view().GetSizeForAvailableSpace(size));
+
+    // Moving past the boundary returns to ordinary tab dragging.
+    DragTabTo(point_at_inset(36));
+    FastForward(base::Seconds(2));
+    EXPECT_FALSE(drop_target_view().GetVisible());
+    EXPECT_FALSE(controller().CanDropTab());
+  }
+}
