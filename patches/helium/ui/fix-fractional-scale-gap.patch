+// At fractional scales, the bottom edges of the top chrome and of the 1 DIP
+// separator above the contents can fall mid-pixel, while the layers below them
+// snap to the next pixel, which leaves a row of device pixels unpainted.
+// Returns the strip to fill behind that edge, from a DIP above it to a DIP
+// below the separator, or an empty rect if nothing is above the contents. It
+// spans the whole browser view, as side chrome like vertical tabs shares the
+// edge.
+gfx::Rect GetContentsTopEdgeBounds(const views::View* browser_view,
+                                   const views::View* multi_contents_view) {
+  if (!multi_contents_view || !multi_contents_view->GetVisible()) {
+    return gfx::Rect();
+  }
+  const int top = multi_contents_view->y();
+  if (top <= 0) {
+    return gfx::Rect();
+  }
+  return gfx::Rect(0, top - 1, browser_view->width(), 3);
+}
