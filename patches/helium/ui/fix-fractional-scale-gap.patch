+void BrowserView::OnPaint(gfx::Canvas* canvas) {
+  views::ClientView::OnPaint(canvas);
+
+  // Native frame materials show through the gap like they do around it.
+  const gfx::Rect edge_bounds =
+      GetContentsTopEdgeBounds(this, multi_contents_view_);
+  if (edge_bounds.IsEmpty() || helium::ShouldUseNativeFrameMaterials(this)) {
+    return;
+  }
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipRect(edge_bounds);
+  ThemedBackground::PaintBackground(canvas, this, this);
+}
