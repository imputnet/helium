+void MultiContentsView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+
+  // Native materials have no gap to fill.
+  if (helium::ShouldUseNativeFrameMaterials(browser_view_)) {
+    return;
+  }
+
+  // Fill the 1px gap below the toolbar at fractional scale factors.
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipRect(gfx::Rect(width(), 1));
+  ThemedBackground::PaintBackground(canvas, this, browser_view_);
+}
