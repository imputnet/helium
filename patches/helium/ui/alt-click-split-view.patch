+class SplitViewAltClickTest : public TabViewTest,
+                              public testing::WithParamInterface<bool> {
+ public:
+  void SetUpOnMainThread() override {
+    TabViewTest::SetUpOnMainThread();
+    if (!GetParam()) {
+      ExitVerticalTabsMode();
+    }
+  }
+
+  views::View* GetClickTarget(int index) {
+    RunScheduledLayouts();
+    if (GetParam()) {
+      return root_node()
+          ->GetNodeForHandle(
+              tab_strip_model()->GetTabAtIndex(index)->GetHandle())
+          ->view();
+    }
+    return BrowserView::GetBrowserViewForBrowser(browser())
+        ->horizontal_tab_strip_for_testing()
+        ->tab_at(index);
+  }
+
+  ui::MouseEvent MouseEvent(ui::EventType type,
+                            const gfx::Point& location,
+                            int modifiers = ui::EF_ALT_DOWN) {
+    return ui::MouseEvent(type, location, location, ui::EventTimeForNow(),
+                          ui::EF_LEFT_MOUSE_BUTTON | modifiers,
+                          ui::EF_LEFT_MOUSE_BUTTON);
+  }
+
+  void ClickTab(int index, int modifiers = ui::EF_ALT_DOWN) {
+    views::View* target = GetClickTarget(index);
+    const gfx::Point location = target->GetLocalBounds().CenterPoint();
+    target->OnMousePressed(
+        MouseEvent(ui::EventType::kMousePressed, location, modifiers));
+    target->OnMouseReleased(
+        MouseEvent(ui::EventType::kMouseReleased, location, modifiers));
+  }
+
+ private:
+  const gfx::AnimationTestApi::RenderModeResetter disable_rich_animations_ =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_DISABLED);
+};
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, CreateAndSeparateSplit) {
+  AppendTab();
+  AppendTab();
+  auto* active = tab_strip_model()->GetActiveTab();
+  auto* clicked = tab_strip_model()->GetTabAtIndex(0);
+  auto* other = tab_strip_model()->GetTabAtIndex(1);
+
+  ClickTab(0);
+
+  ASSERT_EQ(3, tab_strip_model()->count());
+  ASSERT_TRUE(active->IsSplit());
+  EXPECT_EQ(active->GetSplit(), clicked->GetSplit());
+  EXPECT_FALSE(other->IsSplit());
+  EXPECT_EQ(active, tab_strip_model()->GetActiveTab());
+
+  ClickTab(tab_strip_model()->GetIndexOfTab(clicked));
+
+  EXPECT_FALSE(active->IsSplit());
+  EXPECT_FALSE(clicked->IsSplit());
+  EXPECT_EQ(3, tab_strip_model()->count());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, ActiveTabOpensChooser) {
+  AppendTab();
+  auto* active = tab_strip_model()->GetActiveTab();
+
+  ClickTab(tab_strip_model()->active_index());
+
+  ASSERT_EQ(3, tab_strip_model()->count());
+  ASSERT_TRUE(active->IsSplit());
+  auto* chooser = tab_strip_model()->GetActiveTab();
+  EXPECT_NE(active, chooser);
+  EXPECT_EQ(active->GetSplit(), chooser->GetSplit());
+  ASSERT_TRUE(content::WaitForLoadStop(chooser->GetContents()));
+  EXPECT_EQ(GURL(chrome::kChromeUISplitViewNewTabPageURL),
+            chooser->GetContents()->GetLastCommittedURL());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, IgnoreOtherSelectedTabs) {
+  AppendTab();
+  AppendTab();
+  tab_strip_model()->AddSelectionFromAnchorTo(0);
+  ASSERT_EQ(3u, tab_strip_model()->selection_model().size());
+  auto* active = tab_strip_model()->GetActiveTab();
+  auto* clicked = tab_strip_model()->GetTabAtIndex(1);
+  auto* other = tab_strip_model()->GetTabAtIndex(2);
+
+  ClickTab(1);
+
+  ASSERT_TRUE(active->IsSplit());
+  EXPECT_EQ(active->GetSplit(), clicked->GetSplit());
+  EXPECT_FALSE(other->IsSplit());
+  EXPECT_EQ(3, tab_strip_model()->count());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, ReplaceActiveSplit) {
+  AppendTab();
+  AppendTab();
+  auto* active = tab_strip_model()->GetActiveTab();
+  auto* first = tab_strip_model()->GetTabAtIndex(0);
+  auto* second = tab_strip_model()->GetTabAtIndex(1);
+  ClickTab(0);
+  ASSERT_TRUE(active->IsSplit());
+
+  ClickTab(tab_strip_model()->GetIndexOfTab(second));
+
+  ASSERT_TRUE(active->IsSplit());
+  EXPECT_EQ(active->GetSplit(), second->GetSplit());
+  EXPECT_FALSE(first->IsSplit());
+  EXPECT_EQ(3, tab_strip_model()->count());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, OtherModifiersDoNotSplit) {
+  AppendTab();
+  for (int modifiers : {0, ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN,
+                        ui::EF_ALT_DOWN | ui::EF_CONTROL_DOWN,
+                        ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN,
+                        ui::EF_ALT_DOWN | ui::EF_ALTGR_DOWN}) {
+    ClickTab(0, modifiers);
+    EXPECT_EQ(2, tab_strip_model()->count());
+    EXPECT_TRUE(tab_strip_model()->ListSplits().empty());
+  }
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, DragDoesNotSplitOrSwitchTabs) {
+  AppendTab();
+  auto* active = tab_strip_model()->GetActiveTab();
+  views::View* target = GetClickTarget(0);
+  const gfx::Point origin = target->GetLocalBounds().CenterPoint();
+  const gfx::Point destination = origin + gfx::Vector2d(40, 0);
+  target->OnMousePressed(MouseEvent(ui::EventType::kMousePressed, origin));
+  target->OnMouseDragged(MouseEvent(ui::EventType::kMouseDragged, destination));
+  target->OnMouseDragged(MouseEvent(ui::EventType::kMouseDragged, origin));
+  target->OnMouseReleased(MouseEvent(ui::EventType::kMouseReleased, origin));
+
+  EXPECT_EQ(active, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(tab_strip_model()->ListSplits().empty());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, ReleasedModifierCancelsSplit) {
+  AppendTab();
+  auto* active = tab_strip_model()->GetActiveTab();
+  views::View* target = GetClickTarget(0);
+  const gfx::Point location = target->GetLocalBounds().CenterPoint();
+  target->OnMousePressed(MouseEvent(ui::EventType::kMousePressed, location));
+  target->OnMouseReleased(
+      MouseEvent(ui::EventType::kMouseReleased, location, 0));
+
+  EXPECT_EQ(active, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(tab_strip_model()->ListSplits().empty());
+  ClickTab(0, 0);
+  EXPECT_NE(active, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(tab_strip_model()->ListSplits().empty());
+}
+
+IN_PROC_BROWSER_TEST_P(SplitViewAltClickTest, LostCaptureCancelsSplit) {
+  AppendTab();
+  views::View* target = GetClickTarget(0);
+  const gfx::Point location = target->GetLocalBounds().CenterPoint();
+  target->OnMousePressed(MouseEvent(ui::EventType::kMousePressed, location));
+  target->OnMouseCaptureLost();
+
+  ClickTab(0, 0);
+
+  EXPECT_EQ(0, tab_strip_model()->active_index());
+  EXPECT_TRUE(tab_strip_model()->ListSplits().empty());
+}
+
+INSTANTIATE_TEST_SUITE_P(All, SplitViewAltClickTest, testing::Bool());
 
