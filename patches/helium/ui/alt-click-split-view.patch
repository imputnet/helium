+void TabStripModel::ToggleSplitForTab(int index) {
+  if (!ContainsIndex(index) || active_index() == kNoTab) {
+    return;
+  }
+
+  if (const auto split = GetSplitForTab(index)) {
+    RemoveSplit(*split);
+    return;
+  }
+
+  ExecuteAddToNewSplit({index}, split_tabs::SplitTabLayout::kSideBySide,
+                       split_tabs::SplitTabCreatedSource::kTabStripAltClick);
+}
