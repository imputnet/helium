@@ -0,0 +1,204 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/adaptive_tab_color.h"
+
+#include <algorithm>
+#include <optional>
+
+#include "base/containers/flat_map.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/browser/ui/views/frame/browser_widget.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/url_constants.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr base::TimeDelta kUpdateDelay = base::Milliseconds(100);
+// Samples again once the page settles after loading, e.g. the NTP background
+// image fades in over 700ms.
+constexpr base::TimeDelta kSettleDelay = base::Seconds(1);
+constexpr base::TimeDelta kSampleTimeout = base::Seconds(1);
+
+// Height of the strip sampled along the page's top edge, in DIPs.
+constexpr int kSampleHeight = 16;
+// Retries while there is no surface to copy yet, e.g. a tab just shown.
+constexpr int kMaxSampleRetries = 5;
+
+constexpr SkColor kTextOnDark = SkColorSetRGB(0xC6, 0xC6, 0xC6);
+constexpr SkColor kTextOnLight = SkColorSetRGB(0x47, 0x47, 0x47);
+
+constexpr size_t kMaxColorsPerTab = 64;
+
+SkColor Quantize(SkColor color) {
+  const auto level = [](unsigned c) { return (c >> 3) * 255 / 31; };
+  return SkColorSetRGB(level(SkColorGetR(color)), level(SkColorGetG(color)),
+                       level(SkColorGetB(color)));
+}
+
+// Most common color in `bitmap`, so text and logos don't skew the result.
+std::optional<SkColor> MostCommonColor(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) {
+    return std::nullopt;
+  }
+  base::flat_map<SkColor, int> counts;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      ++counts[Quantize(bitmap.getColor(x, y))];
+    }
+  }
+  return std::ranges::max_element(counts, {}, [](const auto& entry) {
+           return entry.second;
+         })->first;
+}
+
+}  // namespace
+
+AdaptiveTabColor::AdaptiveTabColor(BrowserWidget* widget,
+                                   TabStripModel* tab_strip_model)
+    : widget_(widget) {
+  tab_strip_model->AddObserver(this);
+  Observe(tab_strip_model->GetActiveWebContents());
+  Update();
+}
+
+AdaptiveTabColor::~AdaptiveTabColor() = default;
+
+void AdaptiveTabColor::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(selection.new_contents);
+    colors_seen_.clear();
+    last_rendered_.reset();
+    sample_retries_ = 0;
+    Update();
+  }
+}
+
+void AdaptiveTabColor::PrimaryPageChanged(content::Page& page) {
+  colors_seen_.clear();
+  last_rendered_.reset();
+  sample_retries_ = 0;
+  if (!CanAdapt()) {
+    Update();
+  }
+}
+
+void AdaptiveTabColor::DidFirstVisuallyNonEmptyPaint() {
+  ScheduleUpdate();
+}
+
+void AdaptiveTabColor::DidStopLoading() {
+  ScheduleUpdate();
+  settle_timer_.Start(FROM_HERE, kSettleDelay, this, &AdaptiveTabColor::Update);
+}
+
+void AdaptiveTabColor::DidChangeThemeColor() {
+  ScheduleUpdate();
+}
+
+void AdaptiveTabColor::OnBackgroundColorChanged() {
+  ScheduleUpdate();
+}
+
+bool AdaptiveTabColor::CanAdapt() const {
+  if (!web_contents()) {
+    return false;
+  }
+  const GURL& url = web_contents()->GetLastCommittedURL();
+  return url.SchemeIsHTTPOrHTTPS() ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          url.host_piece() == chrome::kChromeUINewTabPageHost);
+}
+
+void AdaptiveTabColor::ScheduleUpdate() {
+  update_timer_.Start(FROM_HERE, kUpdateDelay, this, &AdaptiveTabColor::Update);
+}
+
+void AdaptiveTabColor::Update() {
+  update_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+
+  content::RenderWidgetHostView* view =
+      CanAdapt() ? web_contents()->GetRenderWidgetHostView() : nullptr;
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    OnPageSampled(std::nullopt);
+    return;
+  }
+  gfx::Rect strip(view->GetViewBounds().size());
+  strip.set_height(std::min(strip.height(), kSampleHeight));
+  const gfx::Size output_size = gfx::ScaleToFlooredSize(strip.size(), 0.25f);
+  // An empty rect would copy the whole surface.
+  if (output_size.IsEmpty()) {
+    OnPageSampled(std::nullopt);
+    return;
+  }
+  view->CopyFromSurface(
+      strip, output_size, kSampleTimeout,
+      base::BindPostTaskToCurrentDefault(
+          base::BindOnce([](const content::CopyFromSurfaceResult& result) {
+            return result.has_value() ? MostCommonColor(result->bitmap)
+                                      : std::nullopt;
+          }).Then(base::BindOnce(&AdaptiveTabColor::OnPageSampled,
+                                 weak_factory_.GetWeakPtr()))));
+}
+
+void AdaptiveTabColor::OnPageSampled(std::optional<SkColor> rendered) {
+  if (!CanAdapt()) {
+    SetColor(std::nullopt);
+    return;
+  }
+  if (rendered) {
+    last_rendered_ = rendered;
+  } else if (sample_retries_++ < kMaxSampleRetries) {
+    ScheduleUpdate();
+  }
+
+  // theme-color wins unless the page renders with the opposite lightness, e.g.
+  // when restyled by Dark Reader. Pages without one use what's rendered along
+  // the top edge, which also covers the NTP background image.
+  std::optional<SkColor> color = web_contents()->GetThemeColor();
+  if (last_rendered_ &&
+      (!color ||
+       color_utils::IsDark(*color) != color_utils::IsDark(*last_rendered_))) {
+    color = last_rendered_;
+  }
+  if (!color) {
+    color = web_contents()->GetBackgroundColor();
+  }
+  SetColor(color);
+}
+
+void AdaptiveTabColor::SetColor(std::optional<SkColor> color) {
+  if (color) {
+    color = Quantize(SkColorSetA(*color, SK_AlphaOPAQUE));
+    color = color_utils::BlendForMinContrast(
+                *color, color_utils::IsDark(*color) ? kTextOnDark : kTextOnLight,
+                std::nullopt,
+                static_cast<float>(
+                    features::kHeliumAdaptiveTabColorMinContrast.Get()))
+                .color;
+    if (!colors_seen_.contains(*color)) {
+      if (colors_seen_.size() >= kMaxColorsPerTab) {
+        return;
+      }
+      colors_seen_.insert(*color);
+    }
+  }
+  widget_->SetAdaptiveColor(color);
+}
