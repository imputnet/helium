+ private:
+  bool CanAdapt() const;
+  void ScheduleUpdate();
+  void Update();
+  void OnPageSampled(std::optional<SkColor> rendered);
+  void SetColor(std::optional<SkColor> color);
+
+  const raw_ptr<BrowserWidget> widget_;
+  base::OneShotTimer update_timer_;
+  base::OneShotTimer settle_timer_;
+  base::flat_set<SkColor> colors_seen_;
+  // Last color rendered along the page's top edge, kept while copies fail
+  // (e.g. the window is occluded).
+  std::optional<SkColor> last_rendered_;
+  int sample_retries_ = 0;
+  base::WeakPtrFactory<AdaptiveTabColor> weak_factory_{this};
+};
