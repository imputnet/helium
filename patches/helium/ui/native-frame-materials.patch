+
+void MultiContentsView::UpdateSeparatorClip() {
+  for (views::View* const separator :
+       {contents_separators_.top_separator.get(),
+        contents_separators_.leading_separator.get(),
+        contents_separators_.trailing_separator.get()}) {
+    if (!separator || !separator->layer()) {
+      continue;
+    }
+
+    const gfx::Rect clip = ContentsContainerView::GetClipWithCutout(
+        this,
+        ContentsContainerView::GetCutoutBounds(separator_cutout_view_.view(),
+                                               this),
+        separator, gfx::Rect());
+    if (separator->layer()->clip_rect() != clip) {
+      separator->layer()->SetClipRect(clip);
+    }
+  }
+}
