+
 void ContentsContainerView::UpdateContentsClip() {
+  // Leaves out the part of |view| within the cutout, up to its edge that faces
+  // into |view|, starting from |clip| or all of |view| if that is empty.
+  const auto clip_cutout = [this](views::View* view, gfx::Rect clip) {
+    if (cutout_.IsEmpty()) {
+      return clip;
+    }
+    gfx::Rect shown = clip.IsEmpty() ? view->GetLocalBounds() : clip;
