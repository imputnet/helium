+
+// Matches the vertical tab strip expanding over the contents, which is what
+// shows the mirror.
+constexpr base::TimeDelta kFadeDuration = base::Milliseconds(250);
+
+// Towards the top of the view, the background fades in over what is behind
+// it, and the mirror over the background after it, so the view joins whatever
+// is above it smoothly.
+constexpr int kBackgroundFadeHeight = 48;
+constexpr int kTopFadeHeight = 128;
+
+// A copy of the contents fades out towards the bottom of the view too, into
+// whatever is below it.
+constexpr int kCopyBottomFadeHeight = 96;
+
+// The share of a fade in over which what covers the mirror fades in, before
+// the mirror fades in over the rest. Fading out, the reverse.
+constexpr float kCoverShare = 1.0f / 3;
+
+// A vertical gradient of |steps|, each a y in |bounds|' coordinates and an
+// alpha, scaled by |opacity|. Steps that would not increase are left out, as
+// where fades overlap.
+gfx::LinearGradient GetVerticalFade(
+    const gfx::Rect& bounds,
+    float opacity,
+    std::initializer_list<std::pair<int, float>> steps) {
+  gfx::LinearGradient gradient(/*angle=*/-90);
+  if (bounds.IsEmpty()) {
+    return gradient;
+  }
+  for (const auto& [y, alpha] : steps) {
+    const float fraction = std::clamp(
+        static_cast<float>(y - bounds.y()) / bounds.height(), 0.0f, 1.0f);
+    const size_t count = gradient.step_count();
+    if (!count || gradient.steps()[count - 1].fraction < fraction) {
+      gradient.AddStep(fraction, base::ClampRound<uint8_t>(alpha * opacity *
+                                                           SK_AlphaOPAQUE));
+    }
+  }
+  return gradient;
+}
+
+// Eases in from transparent at the top of |bounds| to |opacity| |height|
+// below.
+gfx::LinearGradient GetEasedFadeIn(const gfx::Rect& bounds,
+                                   int height,
+                                   float opacity) {
+  gfx::LinearGradient gradient(/*angle=*/-90);
+  if (bounds.IsEmpty()) {
+    return gradient;
+  }
+  const size_t last = kNativeFrameMaterialFadeIn.size() - 1;
+  for (size_t i = 0; i <= last; ++i) {
+    const float fraction =
+        std::min(1.0f, static_cast<float>(height * i) / last / bounds.height());
+    if (i && gradient.steps()[i - 1].fraction >= fraction) {
+      break;
+    }
+    gradient.AddStep(fraction,
+                     base::ClampRound<uint8_t>(kNativeFrameMaterialFadeIn[i] *
+                                               opacity * SK_AlphaOPAQUE));
+  }
+  return gradient;
+}
+
+// Mirrors |layer| and those below it, which keep their bounds in sync, unless
+// |sync_bounds| is false for |layer| itself.
+std::unique_ptr<ui::Layer> MirrorLayerTree(ui::Layer* layer, bool sync_bounds) {
+  std::unique_ptr<ui::Layer> mirror =
+      layer->Mirror({.sync_bounds = sync_bounds});
+  for (ui::Layer* const child : layer->children()) {
+    mirror->Add(MirrorLayerTree(child, /*sync_bounds=*/true).release());
+  }
+  return mirror;
+}
+
+}  // namespace
+
+ContentsReflection::ContentsReflection(views::View* view,
+                                       base::RepeatingClosure opacity_changed)
+    : view_(view), opacity_changed_(std::move(opacity_changed)) {
+  CHECK(view_->layer());
+  animation_.SetSlideDuration(kFadeDuration);
+  floating_animation_.SetSlideDuration(kFadeDuration);
+}
+
+ContentsReflection::~ContentsReflection() {
+  Detach();
+}
+
+void ContentsReflection::SetContents(
+    views::View* contents,
+    const gfx::RoundedCornersF& contents_radii) {
+  pending_contents_observation_.Reset();
+  contents_radii_ = contents_radii;
+  if (contents && !contents->layer()) {
+    pending_contents_observation_.Observe(contents);
+    contents = nullptr;
+  }
+  if (contents && contents != contents_) {
+    Detach();
+    Attach(contents);
+  }
+
+  // Nothing to fade before the view is shown.
+  const bool showing = contents;
+  if (!view_->IsDrawn()) {
+    animation_.Reset(showing ? 1 : 0);
+    if (!showing) {
+      Detach();
+    }
+    UpdateOpacity();
+  } else if (showing) {
+    animation_.Show();
+  } else if (contents_) {
+    animation_.Hide();
+  }
+  UpdateGeometry();
+}
+
+void ContentsReflection::SetBackgroundColor(SkColor color) {
+  // Just short of opaque, as the compositor would otherwise take the gradient
+  // masks it fades through to cut transparent holes, which show where the
+  // native frame material is painted below, as on Windows.
+  background_color_ = SkColorSetA(color, SK_AlphaOPAQUE - 1);
+  if (background_layer_) {
+    background_layer_->SetColor(SkColor4f::FromColor(background_color_));
+    contents_fade_layer_->SetColor(SkColor4f::FromColor(background_color_));
+  }
+}
+
+void ContentsReflection::SetFloating(bool floating) {
+  if (!view_->IsDrawn()) {
+    floating_animation_.Reset(floating ? 1 : 0);
+    UpdateOpacity();
+  } else if (floating) {
+    floating_animation_.Show();
+  } else {
+    floating_animation_.Hide();
+  }
+}
+
+void ContentsReflection::SetCopyOpacity(std::optional<float> opacity) {
+  if (copy_opacity_ == opacity) {
+    return;
+  }
+  const bool copy_changed = copy_opacity_.has_value() != opacity.has_value();
+  copy_opacity_ = opacity;
+  if (views::View* const contents = contents_; contents && copy_changed) {
+    Detach();
+    Attach(contents);
+  }
+  UpdateGeometry();
+}
+
+float ContentsReflection::GetOpacity() const {
+  return std::min(1.0f, GetFadeValue() / kCoverShare);
+}
+
+float ContentsReflection::GetMirrorOpacity() const {
+  return std::clamp((GetFadeValue() - kCoverShare) / (1 - kCoverShare), 0.0f,
+                    1.0f);
+}
+
+float ContentsReflection::GetFadeValue() const {
+  return contents_ ? animation_.GetCurrentValue() *
+                         floating_animation_.GetCurrentValue()
+                   : 0;
+}
+
+void ContentsReflection::Attach(views::View* contents) {
+  contents_ = contents;
+  contents_layer_observation_.Observe(contents_->layer());
+  clip_layer_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+  clip_layer_->SetName("ContentsReflection");
+  clip_layer_->SetMasksToBounds(true);
+
+  auto background_layer = std::make_unique<ui::LayerSolidColor>();
+  background_layer->SetName("ContentsReflectionBackground");
+  background_layer->SetColor(SkColor4f::FromColor(background_color_));
+  clip_layer_->Add(background_layer.get());
+  background_layer_ = std::move(background_layer);
+
+  auto contents_fade_layer = std::make_unique<ui::LayerSolidColor>();
+  contents_fade_layer->SetName("ContentsReflectionContentsFade");
+  contents_fade_layer->SetColor(SkColor4f::FromColor(background_color_));
+  clip_layer_->Add(contents_fade_layer.get());
+  contents_fade_layer_ = std::move(contents_fade_layer);
+
+  auto mirror_layer = std::make_unique<ui::LayerSolidColor>();
+  mirror_layer->SetName("ContentsReflectionMirror");
+  mirror_layer->SetShowReflectedLayerSubtree(contents_->layer());
+  clip_layer_->Add(mirror_layer.get());
+  mirror_layer_ = std::move(mirror_layer);
+
+  if (copy_opacity_) {
+    copy_layer_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+    copy_layer_->SetName("ContentsReflectionCopy");
+    // Blurred by itself, rather than by a blur of all below it, which would
+    // show what |view_| shows through itself twice.
+    copy_layer_->SetLayerBlur(kNativeFrameMaterialBlurRadius);
+    copy_tree_ = std::make_unique<ui::LayerTreeOwner>(
+        MirrorLayerTree(contents_->layer(), /*sync_bounds=*/false));
+    copy_layer_->Add(copy_tree_->root());
+    clip_layer_->Add(copy_layer_.get());
+  }
+
+  auto blur_layer = std::make_unique<ui::LayerSolidColor>();
+  blur_layer->SetName("ContentsReflectionBlur");
+  blur_layer->SetFillsBoundsOpaquely(false);
+  blur_layer->SetBackgroundBlur(kNativeFrameMaterialBlurRadius);
+  clip_layer_->Add(blur_layer.get());
+  blur_layer_ = std::move(blur_layer);
+  view_->AddLayerToRegion(clip_layer_.get(), views::LayerRegion::kBelow);
+
+  corner_clip_layer_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+  corner_clip_layer_->SetName("ContentsReflectionCorner");
+  corner_clip_layer_->SetMasksToBounds(true);
+  auto corner_layer = std::make_unique<ui::LayerSolidColor>();
+  corner_layer->SetShowReflectedLayerSubtree(contents_->layer());
+  corner_clip_layer_->Add(corner_layer.get());
+  corner_layer_ = std::move(corner_layer);
+  view_->AddLayerToRegion(corner_clip_layer_.get(), views::LayerRegion::kBelow);
+
+  // Both move when an ancestor of theirs does, up to the one they share.
+  for (views::View* ancestor = view_; ancestor; ancestor = ancestor->parent()) {
+    if (ancestor->Contains(contents_)) {
+      break;
+    }
+    Observe(ancestor);
+  }
+  for (views::View* ancestor = contents_; ancestor;
+       ancestor = ancestor->parent()) {
+    if (ancestor->Contains(view_)) {
+      break;
+    }
+    Observe(ancestor);
+  }
+}
+
+void ContentsReflection::Detach() {
+  observations_.RemoveAllObservations();
+  contents_layer_observation_.Reset();
+  if (clip_layer_) {
+    view_->RemoveLayerFromRegions(clip_layer_.get());
+    view_->RemoveLayerFromRegions(corner_clip_layer_.get());
+  }
+  corner_layer_.reset();
+  corner_clip_layer_.reset();
+  blur_layer_.reset();
+  copy_tree_.reset();
+  copy_layer_.reset();
+  mirror_layer_.reset();
+  contents_fade_layer_.reset();
+  background_layer_.reset();
+  clip_layer_.reset();
+  contents_ = nullptr;
+}
+
+void ContentsReflection::UpdateGeometry() {
+  if (!contents_) {
+    return;
+  }
+
+  // What covers the contents where |view_| floats over them, and a copy's
+  // blur, fade ahead of the mirror.
+  const float cover_opacity = GetOpacity();
+  // A copy of the contents shows what is below |view_| anyway, so it needs
+  // neither the background nor the corner that continue a mirror.
+  const bool copy = copy_opacity_.has_value();
+  const float opacity =
+      copy ? GetFadeValue() * *copy_opacity_ : GetMirrorOpacity();
+  // Hidden outright when transparent, as without GPU compositing the
+  // gradients that fade everything are ignored.
+  clip_layer_->SetVisible(cover_opacity > 0);
+  mirror_layer_->SetVisible(!copy && opacity > 0);
+  background_layer_->SetVisible(!copy && opacity > 0);
+  blur_layer_->SetVisible(!copy);
+  contents_fade_layer_->SetVisible(!copy);
+  corner_clip_layer_->SetVisible(!copy && opacity > 0);
+
+  // Covers |view_| exactly, so the mirror can be placed in its coordinates.
+  clip_layer_->SetBounds(view_->layer()->bounds());
+
+  const gfx::Rect contents_bounds = views::View::ConvertRectToTarget(
+      contents_, view_, contents_->GetLocalBounds());
+  mirror_layer_->SetBounds(contents_bounds);
+  if (copy_layer_) {
+    copy_layer_->SetVisible(copy && opacity > 0);
+    // Wider than the contents, so that their blur spreads past their edge
+    // before the gradient below cuts it off.
+    const int blur_margin = 2 * kNativeFrameMaterialBlurRadius;
+    gfx::Rect copy_bounds = contents_bounds;
+    copy_bounds.Outset(gfx::Outsets::VH(0, blur_margin));
+    copy_layer_->SetBounds(copy_bounds);
+    // Like the mirror, so the view joins what is above and below it smoothly.
+    const int view_bottom = clip_layer_->bounds().height();
+    const gfx::LinearGradient copy_gradient =
+        GetVerticalFade(copy_bounds, 1,
+                        {{0, 0},
+                         {kTopFadeHeight, 1},
+                         {view_bottom - kCopyBottomFadeHeight, 1},
+                         {view_bottom, 0}});
+    if (copy_layer_->gradient_mask() != copy_gradient) {
+      copy_layer_->SetGradientMask(copy_gradient);
+    }
+    copy_layer_->SetOpacity(opacity);
+    copy_tree_->root()->SetBounds(
+        gfx::Rect(gfx::Point(blur_margin, 0), contents_bounds.size()));
+  }
+
+  if (!contents_bounds.IsEmpty()) {
+    const gfx::LinearGradient gradient =
+        GetVerticalFade(contents_bounds, opacity,
+                        {{kBackgroundFadeHeight, 0}, {kTopFadeHeight, 1}});
+    if (mirror_layer_->gradient_mask() != gradient) {
+      mirror_layer_->SetGradientMask(gradient);
+    }
+  }
+
+  // Flip the contents over the edge that faces |view_|, so their edge is
+  // continued below it.
+  const bool contents_before =
+      contents_bounds.CenterPoint().x() < view_->width() / 2;
+  gfx::Transform transform;
+  if (!copy) {
+    if (contents_before) {
+      transform.Translate(2 * contents_bounds.width(), 0);
+    }
+    transform.Scale(-1, 1);
+  }
+  mirror_layer_->SetTransform(transform);
+
+  // Square off the corner the contents round at the bottom of the edge the
+  // mirror continues them along. Like |clip_layer_|, it is placed next to
+  // |view_|'s layer.
+  const int corner_radius =
+      base::ClampCeil(contents_before ? contents_radii_.lower_right()
+                                      : contents_radii_.lower_left());
+  gfx::Rect corner_bounds(
+      contents_before ? contents_bounds.right() - corner_radius
+                      : contents_bounds.x(),
+      contents_bounds.bottom() - corner_radius, corner_radius, corner_radius);
+  corner_bounds.Intersect(contents_bounds);
+  corner_layer_->SetBounds(contents_bounds - corner_bounds.OffsetFromOrigin());
+  const gfx::LinearGradient corner_gradient =
+      GetVerticalFade(gfx::Rect(contents_bounds.size()), opacity,
+                      {{0, 1}, {contents_bounds.height(), 1}});
+  if (corner_layer_->gradient_mask() != corner_gradient) {
+    corner_layer_->SetGradientMask(corner_gradient);
+  }
+  corner_bounds.Offset(view_->layer()->bounds().OffsetFromOrigin());
+  corner_clip_layer_->SetBounds(corner_bounds);
+
+  // Only below the mirror, as |view_| may float over the contents themselves.
+  gfx::Rect mirror_bounds =
+      transform.MapRect(gfx::Rect(contents_bounds.size()));
+  mirror_bounds.Offset(contents_bounds.OffsetFromOrigin());
+  mirror_bounds.Intersect(gfx::Rect(clip_layer_->bounds().size()));
+  blur_layer_->SetBounds(mirror_bounds);
+  background_layer_->SetBounds(mirror_bounds);
+  if (!copy && !mirror_bounds.IsEmpty()) {
+    const gfx::LinearGradient gradient =
+        GetEasedFadeIn(mirror_bounds, kBackgroundFadeHeight, opacity);
+    if (background_layer_->gradient_mask() != gradient) {
+      background_layer_->SetGradientMask(gradient);
+    }
+    // The blur is all there by the time a third of the mirror shows, so it
+    // never shows sharp, but goes no further than the mirror, as blurring the
+    // frame below it would change it where a native material shows through.
+    const float blur_opacity =
+        copy ? cover_opacity : std::min(1.0f, opacity / kCoverShare);
+    const gfx::LinearGradient blur_gradient =
+        GetEasedFadeIn(mirror_bounds, kBackgroundFadeHeight, blur_opacity);
+    if (blur_layer_->gradient_mask() != blur_gradient) {
+      blur_layer_->SetGradientMask(blur_gradient);
+    }
+  }
+
+  // The rest of |view_|, beside the mirror. The background is already there
+  // where the mirror starts to fade in, and fades out as it does.
+  gfx::Rect contents_fade_bounds(clip_layer_->bounds().size());
+  if (mirror_bounds.x() > contents_fade_bounds.x()) {
+    contents_fade_bounds.set_width(mirror_bounds.x());
+  } else {
+    contents_fade_bounds.Inset(
+        gfx::Insets::TLBR(0, mirror_bounds.right(), 0, 0));
+  }
+  contents_fade_layer_->SetBounds(contents_fade_bounds);
+  if (!contents_fade_bounds.IsEmpty()) {
+    const gfx::LinearGradient gradient = GetVerticalFade(
+        contents_fade_bounds, cover_opacity,
+        {{0, 1}, {kBackgroundFadeHeight, 1}, {kTopFadeHeight, 0}});
+    if (contents_fade_layer_->gradient_mask() != gradient) {
+      contents_fade_layer_->SetGradientMask(gradient);
+    }
+  }
+}
+
+void ContentsReflection::UpdateOpacity() {
+  // Through the gradients, as a mirror does not show inside anything with an
+  // opacity of its own.
+  UpdateGeometry();
+  opacity_changed_.Run();
+}
+
+void ContentsReflection::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateOpacity();
+}
+
+void ContentsReflection::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &animation_ && animation_.GetCurrentValue() == 0) {
+    Detach();
+  }
+  UpdateOpacity();
+}
+
+void ContentsReflection::Observe(views::View* view) {
+  if (!observations_.IsObservingSource(view)) {
+    observations_.AddObservation(view);
+  }
+}
+
+void ContentsReflection::OnViewBoundsChanged(views::View* observed_view) {
+  UpdateGeometry();
+}
+
+void ContentsReflection::AttachPendingContents() {
+  if (!pending_contents_observation_.IsObserving()) {
+    return;
+  }
+  views::View* const contents = pending_contents_observation_.GetSource();
+  if (contents->layer()) {
+    SetContents(contents, contents_radii_);
+  }
+}
+
+void ContentsReflection::OnViewLayerBoundsSet(views::View* observed_view) {
+  // Its layer is created along with its bounds, though what it holds may only
+  // be added to it after, which a copy of it needs.
+  if (pending_contents_observation_.IsObservingSource(observed_view)) {
+    if (observed_view->layer()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&ContentsReflection::AttachPendingContents,
+                                    weak_ptr_factory_.GetWeakPtr()));
+    }
+    return;
+  }
+  UpdateGeometry();
+}
+
+void ContentsReflection::LayerDestroyed(ui::Layer* layer) {
+  // The contents usually get another layer right after, so mirror them again
+  // once they have, unless the mirror was fading out anyway.
+  views::View* const contents = contents_;
+  Detach();
+  if (animation_.IsShowing()) {
+    pending_contents_observation_.Observe(contents);
+  }
+}
+
+void ContentsReflection::OnViewIsDeleting(views::View* observed_view) {
+  if (pending_contents_observation_.IsObservingSource(observed_view)) {
+    pending_contents_observation_.Reset();
+    return;
+  }
+  // Not worth telling |view_| about, as it may be going away too.
+  animation_.Reset(0);
+  Detach();
+}
+
+}  // namespace helium
