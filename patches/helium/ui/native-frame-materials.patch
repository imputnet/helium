+#include "ui/compositor/compositor.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_solid_color.h"
+#include "ui/compositor/layer_tree_owner.h"
+#include "ui/gfx/geometry/linear_gradient.h"
+#include "ui/gfx/geometry/outsets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/transform.h"
+
+namespace helium {
+namespace {
+
+// Matches the vertical tab strip expanding over the contents, which is what
+// shows the copy.
+constexpr base::TimeDelta kFadeDuration = base::Milliseconds(250);
+
+// The copy fades in from its top and out to its bottom, so the view joins
+// whatever is above and below it smoothly.
+constexpr int kTopFadeHeight = 128;
+constexpr int kBottomFadeHeight = 96;
+
+// A vertical gradient of |steps|, each an alpha and a y in the coordinates
+// |bounds| are in. Steps that would not increase are left out, as where fades
+// overlap.
+gfx::LinearGradient GetVerticalFade(
+    const gfx::Rect& bounds,
+    std::initializer_list<std::pair<int, float>> steps) {
+  gfx::LinearGradient gradient(/*angle=*/-90);
+  if (bounds.IsEmpty()) {
+    return gradient;
+  }
+  for (const auto& [y, alpha] : steps) {
+    const float fraction = std::clamp(
+        static_cast<float>(y - bounds.y()) / bounds.height(), 0.0f, 1.0f);
+    const size_t count = gradient.step_count();
+    if (!count || gradient.steps()[count - 1].fraction < fraction) {
+      gradient.AddStep(fraction,
+                       base::ClampRound<uint8_t>(alpha * SK_AlphaOPAQUE));
+    }
+  }
+  return gradient;
+}
+
+// Mirrors |layer| and those below it, which keep their bounds in sync, unless
+// |sync_bounds| is false for |layer| itself.
+std::unique_ptr<ui::Layer> MirrorLayerTree(ui::Layer* layer, bool sync_bounds) {
+  std::unique_ptr<ui::Layer> mirror =
+      layer->Mirror({.sync_bounds = sync_bounds});
+  for (ui::Layer* const child : layer->children()) {
+    mirror->Add(MirrorLayerTree(child, /*sync_bounds=*/true).release());
+  }
+  return mirror;
+}
+
+// The layers below |layer|, which MirrorLayerTree() mirrors along with it.
+std::vector<ui::Layer*> GetDescendants(ui::Layer* layer) {
+  std::vector<ui::Layer*> descendants;
+  for (ui::Layer* const child : layer->children()) {
+    descendants.push_back(child);
+    const std::vector<ui::Layer*> below = GetDescendants(child);
+    descendants.insert(descendants.end(), below.begin(), below.end());
+  }
+  return descendants;
+}
+
+}  // namespace
+
+ContentsReflection::ContentsReflection(views::View* view) : view_(view) {
+  CHECK(view_->layer());
+  animation_.SetSlideDuration(kFadeDuration);
+  floating_animation_.SetSlideDuration(kFadeDuration);
+}
+
+ContentsReflection::~ContentsReflection() {
+  Detach();
+}
+
+void ContentsReflection::SetContents(views::View* contents) {
+  pending_contents_observation_.Reset();
+  if (contents && !contents->layer()) {
+    pending_contents_observation_.Observe(contents);
+    contents = nullptr;
+  }
+  if (contents && contents != contents_) {
+    Detach();
+    Attach(contents);
+  }
+
+  // Nothing to fade before the view is shown.
+  const bool showing = contents;
+  if (!view_->IsDrawn()) {
+    animation_.Reset(showing ? 1 : 0);
+    if (!showing) {
+      Detach();
+    }
+  } else if (showing) {
+    animation_.Show();
+  } else if (contents_) {
+    animation_.Hide();
+  }
+  UpdateGeometry();
+}
+
+void ContentsReflection::SetFloating(bool floating) {
+  if (!view_->IsDrawn()) {
+    floating_animation_.Reset(floating ? 1 : 0);
+    UpdateGeometry();
+  } else if (floating) {
+    floating_animation_.Show();
+  } else {
+    floating_animation_.Hide();
+  }
+}
+
+void ContentsReflection::SetCopyOpacity(float opacity) {
+  if (copy_opacity_ == opacity) {
+    return;
+  }
+  copy_opacity_ = opacity;
+  UpdateGeometry();
+}
+
+void ContentsReflection::SetCopyTint(std::optional<SkColor> tint) {
+  if (copy_tint_ == tint) {
+    return;
+  }
+  const bool tinted_changed = copy_tint_.has_value() != tint.has_value();
+  copy_tint_ = tint;
+  if (copy_tint_layer_ && copy_tint_) {
+    copy_tint_layer_->SetColor(SkColor4f::FromColor(*copy_tint_));
+  }
+  if (contents_ && tinted_changed) {
+    Reattach();
+  }
+  UpdateGeometry();
+}
+
+float ContentsReflection::GetFadeValue() const {
+  return contents_ ? animation_.GetCurrentValue() *
+                         floating_animation_.GetCurrentValue()
+                   : 0;
+}
+
+void ContentsReflection::Attach(views::View* contents) {
+  contents_ = contents;
+  contents_layer_observation_.Observe(contents_->layer());
+  clip_layer_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+  clip_layer_->SetName("ContentsReflection");
+  clip_layer_->SetMasksToBounds(true);
+
+  copy_layer_ = ui::Layer::Create(ui::LAYER_NOT_DRAWN);
+  copy_layer_->SetName("ContentsReflectionCopy");
+  // Blurred by itself, rather than by a blur of all below it, which would
+  // show what |view_| shows through itself twice.
+  copy_layer_->SetLayerBlur(kNativeFrameMaterialBlurRadius);
+  copy_tree_ = std::make_unique<ui::LayerTreeOwner>(
+      MirrorLayerTree(contents_->layer(), /*sync_bounds=*/false));
+  copy_layer_->Add(copy_tree_->root());
+  if (copy_tint_) {
+    copy_mirror_tree_ = std::make_unique<ui::LayerTreeOwner>(
+        MirrorLayerTree(contents_->layer(), /*sync_bounds=*/false));
+    copy_layer_->Add(copy_mirror_tree_->root());
+
+    auto copy_tint_layer = std::make_unique<ui::LayerSolidColor>();
+    copy_tint_layer->SetName("ContentsReflectionCopyTint");
+    copy_tint_layer->SetColor(SkColor4f::FromColor(*copy_tint_));
+    copy_layer_->Add(copy_tint_layer.get());
+    copy_tint_layer_ = std::move(copy_tint_layer);
+  }
+  clip_layer_->Add(copy_layer_.get());
+  for (ui::Layer* const source : GetDescendants(contents_->layer())) {
+    copy_source_observations_.AddObservation(source);
+  }
+  view_->AddLayerToRegion(clip_layer_.get(), views::LayerRegion::kBelow);
+
+  // Both move when an ancestor of theirs does, up to the one they share.
+  for (views::View* ancestor = view_; ancestor; ancestor = ancestor->parent()) {
+    if (ancestor->Contains(contents_)) {
+      break;
+    }
+    Observe(ancestor);
+  }
+  for (views::View* ancestor = contents_; ancestor;
+       ancestor = ancestor->parent()) {
+    if (ancestor->Contains(view_)) {
+      break;
+    }
+    Observe(ancestor);
+  }
+}
+
+void ContentsReflection::Detach() {
+  observations_.RemoveAllObservations();
+  contents_layer_observation_.Reset();
+  copy_source_observations_.RemoveAllObservations();
+  compositor_observation_.Reset();
+  copy_stale_ = false;
+  if (clip_layer_) {
+    view_->RemoveLayerFromRegions(clip_layer_.get());
+  }
+  copy_tint_layer_.reset();
+  copy_mirror_tree_.reset();
+  copy_tree_.reset();
+  copy_layer_.reset();
+  clip_layer_.reset();
+  contents_ = nullptr;
+}
+
+void ContentsReflection::Reattach() {
+  views::View* const contents = contents_;
+  Detach();
+  Attach(contents);
+}
+
+void ContentsReflection::UpdateGeometry() {
+  if (!contents_) {
+    return;
+  }
+
+  // Hidden outright when transparent, as without GPU compositing the gradient
+  // that fades the copy is ignored.
+  const float opacity = GetFadeValue() * copy_opacity_;
+  clip_layer_->SetVisible(opacity > 0);
+  copy_layer_->SetOpacity(opacity);
+
+  // Covers |view_| exactly, so the copy can be placed in its coordinates.
+  clip_layer_->SetBounds(view_->layer()->bounds());
+
+  if (ui::Compositor* const compositor = contents_->layer()->GetCompositor();
+      compositor && !compositor_observation_.IsObserving()) {
+    compositor_observation_.Observe(compositor);
+  }
+
+  const gfx::Rect contents_bounds = views::View::ConvertRectToTarget(
+      contents_, view_, contents_->GetLocalBounds());
+  // Wider than the contents, so that their blur spreads past their edge
+  // before the gradient below cuts it off.
+  const int blur_margin = 2 * kNativeFrameMaterialBlurRadius;
+  gfx::Rect copy_bounds = contents_bounds;
+  copy_bounds.Outset(gfx::Outsets::VH(0, blur_margin));
+  if (copy_mirror_tree_) {
+    // All of |view_|, which the mirrored copy and the tint fill.
+    copy_bounds.SetHorizontalBounds(
+        std::min(copy_bounds.x(), -blur_margin),
+        std::max(copy_bounds.right(), view_->width() + blur_margin));
+  }
+  copy_layer_->SetBounds(copy_bounds);
+
+  // Eased in from the top of the copy and out to its bottom, within |view_|,
+  // over less where it is too short for both.
+  const int top = std::max(0, copy_bounds.y());
+  const int bottom =
+      std::min(clip_layer_->bounds().height(), copy_bounds.bottom());
+  const float fade_scale =
+      std::min(1.0f, static_cast<float>(bottom - top) /
+                         (kTopFadeHeight + kBottomFadeHeight));
+  const int top_fade = base::ClampFloor(kTopFadeHeight * fade_scale);
+  const int bottom_fade = base::ClampFloor(kBottomFadeHeight * fade_scale);
+  const gfx::LinearGradient gradient = GetVerticalFade(
+      copy_bounds,
+      {{top, 0},
+       {top + top_fade / 4, kNativeFrameMaterialFadeIn[1]},
+       {top + top_fade / 2, kNativeFrameMaterialFadeIn[2]},
+       {top + 3 * top_fade / 4, kNativeFrameMaterialFadeIn[3]},
+       {top + top_fade, 1},
+       {bottom - bottom_fade, 1},
+       {bottom, 0}});
+  if (copy_layer_->gradient_mask() != gradient) {
+    copy_layer_->SetGradientMask(gradient);
+  }
+
+  const gfx::Rect copy_contents_bounds =
+      contents_bounds - copy_bounds.OffsetFromOrigin();
+  copy_tree_->root()->SetBounds(copy_contents_bounds);
+  if (copy_mirror_tree_) {
+    // Flips the contents over the edge that faces |view_|, so their edge is
+    // continued below it.
+    gfx::Transform flip;
+    if (contents_bounds.CenterPoint().x() < view_->width() / 2) {
+      flip.Translate(2 * contents_bounds.width(), 0);
+    }
+    flip.Scale(-1, 1);
+    copy_mirror_tree_->root()->SetBounds(copy_contents_bounds);
+    copy_mirror_tree_->root()->SetTransform(flip);
+    copy_tint_layer_->SetBounds(gfx::Rect(copy_bounds.size()));
+  }
+}
+
+void ContentsReflection::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateGeometry();
+}
+
+void ContentsReflection::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &animation_ && animation_.GetCurrentValue() == 0) {
+    Detach();
+  }
+  UpdateGeometry();
+}
+
+void ContentsReflection::Observe(views::View* view) {
+  if (!observations_.IsObservingSource(view)) {
+    observations_.AddObservation(view);
+  }
+}
+
+void ContentsReflection::OnViewBoundsChanged(views::View* observed_view) {
+  UpdateGeometry();
+}
+
+void ContentsReflection::AttachPendingContents() {
+  if (!pending_contents_observation_.IsObserving()) {
+    return;
+  }
+  views::View* const contents = pending_contents_observation_.GetSource();
+  if (contents->layer()) {
+    SetContents(contents);
+  }
+}
+
+void ContentsReflection::OnViewLayerBoundsSet(views::View* observed_view) {
+  // Its layer is created along with its bounds, though what it holds may only
+  // be added to it after, which a copy of it needs.
+  if (pending_contents_observation_.IsObservingSource(observed_view)) {
+    if (observed_view->layer()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&ContentsReflection::AttachPendingContents,
+                                    weak_ptr_factory_.GetWeakPtr()));
+    }
+    return;
+  }
+  UpdateGeometry();
+}
+
+bool ContentsReflection::IsCopyCurrent() const {
+  const std::vector<ui::Layer*> sources = GetDescendants(contents_->layer());
+  return !copy_stale_ &&
+         sources.size() == copy_source_observations_.GetSourcesCount() &&
+         std::ranges::all_of(sources, [this](ui::Layer* source) {
+           return copy_source_observations_.IsObservingSource(source);
+         });
+}
+
+void ContentsReflection::UpdateStaleCopy() {
+  if (!contents_ || IsCopyCurrent()) {
+    return;
+  }
+  Reattach();
+  UpdateGeometry();
+}
+
+void ContentsReflection::OnCompositingDidCommit(ui::Compositor* compositor) {
+  // Not while committing, as copying the contents again changes the layers.
+  if (contents_ && !IsCopyCurrent()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ContentsReflection::UpdateStaleCopy,
+                                  weak_ptr_factory_.GetWeakPtr()));
+  }
+}
+
+void ContentsReflection::OnCompositingShuttingDown(ui::Compositor* compositor) {
+  compositor_observation_.Reset();
+}
+
+void ContentsReflection::LayerDestroyed(ui::Layer* layer) {
+  // Still below the contents' own, so they are copied again once it is not.
+  if (copy_source_observations_.IsObservingSource(layer)) {
+    copy_source_observations_.RemoveObservation(layer);
+    copy_stale_ = true;
+    return;
+  }
+
+  // The contents usually get another layer right after, so copy them again
+  // once they have, unless the copy was fading out anyway.
+  views::View* const contents = contents_;
+  Detach();
+  if (animation_.IsShowing()) {
+    pending_contents_observation_.Observe(contents);
+  }
+}
+
+void ContentsReflection::OnViewIsDeleting(views::View* observed_view) {
+  if (pending_contents_observation_.IsObservingSource(observed_view)) {
+    pending_contents_observation_.Reset();
+    return;
+  }
+  // Not worth telling |view_| about, as it may be going away too.
+  animation_.Reset(0);
+  Detach();
+}
+
