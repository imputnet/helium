+
+void VerticalTabStripRegionView::UpdateNativeFrameMaterialBackground() {
+  // Collapsed, the contents next to the tab strip are mirrored below it, so
+  // that it looks the same whether or not it floats over them. The mirror
+  // fades in as soon as the tab strip starts collapsing.
+  const bool has_material_color =
+      helium::GetNativeFrameMaterialFloatingColor(this).has_value();
+  // The material stands in for the toolbar color.
+  if (has_material_color) {
+    contents_reflection_->SetBackgroundColor(
+        GetColorProvider()->GetColor(kColorToolbar));
+  }
+  contents_reflection_->SetFloating(floating_style_ != FloatingStyle::kNone);
+  // Without a vibrant material, the contents are cut out below the floating
+  // tab strip, and a faint copy of them keeps it from looking like just more
+  // frame. It stays a copy while it fades out.
+  const bool clip_contents = ShouldClipContents();
+  const bool copy_contents = !helium::HasVibrantNativeFrameMaterial();
+  contents_reflection_->SetCopyOpacity(
+      copy_contents ? std::make_optional(kClippedContentsCopyOpacity)
+                    : std::nullopt);
+  // The mirror and what covers it fade through gradient masks, which only GPU
+  // compositing draws, and would cover the contents outright without them.
+  ContentsWebView* const contents =
+      has_material_color && helium::HasGpuCompositing() &&
+              (clip_contents || (helium::HasVibrantNativeFrameMaterial() &&
+                                 floating_style_ != FloatingStyle::kDetached &&
+                                 target_collapse_state_.collapsed))
+          ? GetAdjacentContents()
+          : nullptr;
+  if (contents) {
+    contents_reflection_->SetContents(contents->holder(),
+                                      contents->GetBackgroundRadii());
+  } else {
+    contents_reflection_->SetContents(nullptr);
+  }
+  UpdateContentsClip();
+  UpdateNativeFrameMaterialPaint();
+}
+
+bool VerticalTabStripRegionView::ShouldClipContents() const {
+  // A plain compositor blur shows the desktop in its own colors, which nothing
+  // painted over the contents could match. So instead the tab strip shows the
+  // frame material where it floats over them, like the rest of the frame.
+  return floating_style_ != FloatingStyle::kNone &&
+         floating_style_ != FloatingStyle::kDetached &&
+         !helium::HasVibrantNativeFrameMaterial() &&
+         helium::ShouldUseNativeFrameMaterials(this);
+}
+
+void VerticalTabStripRegionView::UpdateContentsClip() {
+  // The contents are cut out up to the edge of the tab strip that faces away
+  // from the window edge.
+  ContentsWebView* const contents =
+      ShouldClipContents() ? GetAdjacentContents() : nullptr;
+  auto* const container =
+      contents ? views::AsViewClass<ContentsContainerView>(contents->parent())
+               : nullptr;
+  if (auto* const clipped =
+          views::AsViewClass<ContentsContainerView>(clipped_container_.view());
+      clipped && clipped != container) {
+    clipped->SetCutout(gfx::Rect());
+  }
+  clipped_container_.SetView(container);
+  if (container) {
+    container->SetCutout(
+        views::View::ConvertRectToTarget(this, container, GetLocalBounds()));
+  }
+}
+
+void VerticalTabStripRegionView::UpdateNativeFrameMaterialPaint() {
+  auto* const custom_background =
+      background() ? background()->AsA<CustomCornersBackground>() : nullptr;
+  if (!custom_background) {
+    return;
+  }
+
+  // Without the material tint the tab strip stays opaque, so there is nothing
+  // to blur.
+  const bool has_material_color =
+      helium::GetNativeFrameMaterialFloatingColor(this).has_value();
+  const bool floating = floating_style_ != FloatingStyle::kNone;
+  // Docked, the tab strip is solid like the rest of the frame. Floating, the
+  // material is there right away, as the tab strip covers the contents at
+  // once. Once docked again, it fades out with the mirror, as the frame below
+  // it has the tint already, which would otherwise show twice.
+  // Where the tab strip shows the frame material, as without a vibrant one, it
+  // paints none of its own, which would show twice.
+  const bool shows_frame_material = !helium::HasVibrantNativeFrameMaterial() &&
+                                    floating_style_ != FloatingStyle::kDetached;
+  const float material_opacity =
+      shows_frame_material
+          ? 0.0f
+          : (floating ? 1.0f : contents_reflection_->GetMirrorOpacity());
+  const bool paint_material = material_opacity > 0;
+  custom_background->SetNativeFrameMaterialOpacity(material_opacity);
+  custom_background->SetPaintWithNativeFrameMaterials(paint_material);
+  // Below the contents, the frame is transparent where the native material
+  // shows, which the blur would take in and let the contents show through
+  // sharp along the bottom. So it stops where they do.
+  std::optional<gfx::Rect> blur_clip;
+  if (ContentsWebView* const contents = GetAdjacentContents()) {
+    const gfx::Rect contents_bounds = views::View::ConvertRectToTarget(
+        contents->holder(), this, contents->holder()->GetLocalBounds());
+    blur_clip = gfx::Rect(0, 0, width(), contents_bounds.bottom());
+  }
+  custom_background->SetUseBackgroundBlur(paint_material && has_material_color,
+                                          blur_clip);
+}
+
+ContentsWebView* VerticalTabStripRegionView::GetAdjacentContents() const {
+  const MultiContentsView* const multi_contents_view =
+      browser_view()->multi_contents_view();
+  if (!multi_contents_view) {
+    return nullptr;
+  }
+
+  const gfx::Rect bounds = GetBoundsInScreen();
+  ContentsWebView* adjacent_contents = nullptr;
+  int adjacent_distance = 0;
+  for (ContentsContainerView* container :
+       multi_contents_view->contents_container_views()) {
+    if (!container->GetVisible()) {
+      continue;
+    }
+
+    ContentsWebView* const contents = container->contents_view();
+    const gfx::Rect contents_bounds = contents->holder()->GetBoundsInScreen();
+    const int distance = contents_bounds.x() >= bounds.right()
+                             ? contents_bounds.x() - bounds.right()
+                             : bounds.x() - contents_bounds.right();
+    if (!adjacent_contents || distance < adjacent_distance) {
+      adjacent_contents = contents;
+      adjacent_distance = distance;
+    }
+  }
+
+  return adjacent_contents;
+}
