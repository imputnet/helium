+// Shows a blurred copy of the contents next to a translucent view below it,
+// where the view shows something else than them through itself, like the
+// native frame material.
+class ContentsReflection : public views::ViewObserver,
+                           public ui::LayerObserver,
+                           public ui::CompositorObserver,
+                           public gfx::AnimationDelegate {
+ public:
+  // |view| must paint to a layer.
+  explicit ContentsReflection(views::View* view);
+  ContentsReflection(const ContentsReflection&) = delete;
+  ContentsReflection& operator=(const ContentsReflection&) = delete;
+  ~ContentsReflection() override;
+
+  // Copies |contents|, which has a layer that holds what it shows, like the
+  // holder of a WebView. Fades the copy in, or out if null.
+  void SetContents(views::View* contents);
+
+  // Shows the copy while |view_| floats over the contents next to it, fading
+  // it in and out. Otherwise |view_| looks like the rest of the frame.
+  void SetFloating(bool floating);
+
+  // How much of the copy shows, from 0 to 1.
+  void SetCopyOpacity(float opacity);
+
+  // Paints |tint| over the copy, and continues it mirrored beside the
+  // contents, as where the copy is all that |view_| shows over what is below
+  // it.
+  void SetCopyTint(std::optional<SkColor> tint);
+
+ private:
+  void Attach(views::View* contents);
+  void Detach();
+  // Builds the layers for the same contents again.
+  void Reattach();
+  // Keeps the copy over the contents as either of them moves.
+  void UpdateGeometry();
+  // How far the copy has faded in, from 0 to 1.
+  float GetFadeValue() const;
+  void Observe(views::View* view);
+  // Copies the contents that had no layer to copy yet, once they have.
+  void AttachPendingContents();
+  // Whether the copy still mirrors all the layers below the contents' own.
+  bool IsCopyCurrent() const;
+  // Copies the contents again if their layers changed since.
+  void UpdateStaleCopy();
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewLayerBoundsSet(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // ui::LayerObserver:
+  void LayerDestroyed(ui::Layer* layer) override;
+
+  // ui::CompositorObserver:
+  void OnCompositingDidCommit(ui::Compositor* compositor) override;
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
+
+  const raw_ptr<views::View> view_;
+  // Stays set while the copy fades out.
+  raw_ptr<views::View> contents_ = nullptr;
+  // Clips the copy to |view_|, below which it is added.
+  std::unique_ptr<ui::Layer> clip_layer_;
+  // Holds a copy of the layers of the contents, as a reflection of them would
+  // be cut out along with them.
+  std::unique_ptr<ui::Layer> copy_layer_;
+  std::unique_ptr<ui::LayerTreeOwner> copy_tree_;
+  // Continues a tinted copy beside the contents, flipped over their edge.
+  std::unique_ptr<ui::LayerTreeOwner> copy_mirror_tree_;
+  std::unique_ptr<ui::LayerSolidColor> copy_tint_layer_;
+  // Set once a layer that the copy mirrors is gone.
+  bool copy_stale_ = false;
+  float copy_opacity_ = 1.0f;
+  std::optional<SkColor> copy_tint_;
+  gfx::SlideAnimation animation_{this};
+  gfx::SlideAnimation floating_animation_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      observations_{this};
+  // The layer of the contents is destroyed when what a NativeViewHost hosts
+  // changes, so they are copied again once they have another.
+  base::ScopedObservation<ui::Layer, ui::LayerObserver>
+      contents_layer_observation_{this};
+  // The layers below the contents' own that the copy mirrors. They change
+  // without it when what a NativeViewHost hosts does on macOS, which only
+  // shows in what is committed.
+  base::ScopedMultiSourceObservation<ui::Layer, ui::LayerObserver>
+      copy_source_observations_{this};
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver>
+      compositor_observation_{this};
+  // Contents without a layer to copy yet, like a NativeViewHost between what
+  // it hosts, to copy once they have one.
+  base::ScopedObservation<views::View, views::ViewObserver>
+      pending_contents_observation_{this};
+  base::WeakPtrFactory<ContentsReflection> weak_ptr_factory_{this};
+};
+
+}  // namespace helium
