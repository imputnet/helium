+// static
+gfx::Rect ContentsContainerView::GetClipWithCutout(const views::View* source,
+                                                   const gfx::Rect& cutout,
+                                                   const views::View* target,
+                                                   const gfx::Rect& clip) {
+  gfx::Rect shown = clip.IsEmpty() ? target->GetLocalBounds() : clip;
+  const gfx::Rect target_cutout =
+      views::View::ConvertRectToTarget(source, target, cutout);
+  if (!target_cutout.Intersects(shown)) {
+    return clip;
+  }
+
+  if (target_cutout.CenterPoint().x() < shown.CenterPoint().x()) {
+    shown.SetByBounds(std::min(target_cutout.right(), shown.right()), shown.y(),
+                      shown.right(), shown.bottom());
+  } else {
+    shown.SetByBounds(shown.x(), shown.y(),
+                      std::max(target_cutout.x(), shown.x()), shown.bottom());
+  }
+  // An empty clip would show everything.
+  return shown.IsEmpty() ? gfx::Rect(-2, -2, 1, 1) : shown;
+}
