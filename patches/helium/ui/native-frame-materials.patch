+
+void VerticalTabStripRegionView::UpdateNativeFrameMaterialBackground() {
+  // Floating over the contents, the tab strip shows the frame material with a
+  // blurred copy of them on top, which fades in and out as it does.
+  const std::optional<SkColor> material_color =
+      helium::GetNativeFrameMaterialFloatingColor(this);
+  const bool vibrant = helium::HasVibrantNativeFrameMaterial();
+  const std::vector<ContentsWebView*> adjacent_contents = GetAdjacentContents();
+  // The copies fade through gradient masks, which only GPU compositing draws,
+  // and would cover the frame material outright without them. Kept while
+  // collapsed too, as a new copy only shows once the contents draw again.
+  std::vector<ContentsWebView*> contents;
+  if (material_color && helium::HasGpuCompositing() &&
+      (ShouldClipContents() ||
+       (vibrant && floating_style_ != FloatingStyle::kDetached &&
+        target_collapse_state_.collapsed))) {
+    contents = adjacent_contents;
+  }
+  // With docked DevTools or a side panel next to the contents, a copy of them
+  // would not match what is around it, so the tab strip shows the material
+  // alone.
+  SidePanel* const side_panel = browser_view()->side_panel();
+  ObserveViewNextToContents(side_panel);
+  if (const MultiContentsView* const multi_contents_view =
+          browser_view()->multi_contents_view()) {
+    for (ContentsContainerView* const container :
+         multi_contents_view->contents_container_views()) {
+      ObserveViewNextToContents(container->devtools_web_view());
+    }
+  }
+  if ((side_panel && side_panel->GetVisible()) ||
+      std::ranges::any_of(contents, [](ContentsWebView* web_view) {
+        auto* const container =
+            views::AsViewClass<ContentsContainerView>(web_view->parent());
+        return container && container->devtools_web_view()->GetVisible();
+      })) {
+    contents.clear();
+  }
+
+  while (contents_reflections_.size() < contents.size()) {
+    contents_reflections_.push_back(
+        std::make_unique<helium::ContentsReflection>(this));
+  }
+  for (size_t i = 0; i < contents_reflections_.size(); ++i) {
+    helium::ContentsReflection* const reflection =
+        contents_reflections_[i].get();
+    reflection->SetFloating(floating_style_ != FloatingStyle::kNone);
+    // A vibrant material takes a tinted copy in full, a plain blur only a
+    // faint one.
+    reflection->SetCopyOpacity(vibrant ? 1.0f : kClippedContentsCopyOpacity);
+    reflection->SetCopyTint(vibrant ? material_color : std::nullopt);
+    reflection->SetContents(i < contents.size() ? contents[i]->holder()
+                                                : nullptr);
+  }
+
+  UpdateContentsClip(adjacent_contents);
+  UpdateNativeFrameMaterialPaint(adjacent_contents);
+}
+
+bool VerticalTabStripRegionView::ShouldClipContents() const {
+  return ShouldClipContents(floating_style_);
+}
+
+bool VerticalTabStripRegionView::ShouldClipContents(FloatingStyle style) const {
+  // The frame material shows what is behind the window, which nothing painted
+  // over the contents could match. So instead the tab strip shows the material
+  // itself where it floats over them, and joins the rest of the frame.
+  return style != FloatingStyle::kNone && style != FloatingStyle::kDetached &&
+         helium::ShouldUseNativeFrameMaterials(this);
+}
+
+void VerticalTabStripRegionView::UpdateContentsClip(
+    const std::vector<ContentsWebView*>& adjacent_contents) {
+  // The contents are cut out up to the edge of the tab strip that faces away
+  // from the window edge.
+  std::vector<ContentsContainerView*> containers;
+  if (ShouldClipContents()) {
+    for (ContentsWebView* const contents : adjacent_contents) {
+      if (auto* const container =
+              views::AsViewClass<ContentsContainerView>(contents->parent())) {
+        containers.push_back(container);
+      }
+    }
+  }
+
+  for (const auto& tracker : clipped_containers_) {
+    auto* const clipped =
+        views::AsViewClass<ContentsContainerView>(tracker->view());
+    if (clipped && !std::ranges::contains(containers, clipped)) {
+      clipped->SetCutoutView(nullptr);
+    }
+  }
+  clipped_containers_.clear();
+
+  for (ContentsContainerView* const container : containers) {
+    clipped_containers_.push_back(
+        std::make_unique<views::ViewTracker>(container));
+    container->SetCutoutView(this);
+  }
+
+  // The separators around the contents would show through the tab strip too.
+  if (MultiContentsView* const multi_contents_view =
+          browser_view()->multi_contents_view()) {
+    multi_contents_view->SetSeparatorCutoutView(containers.empty() ? nullptr
+                                                                   : this);
+  }
+}
+
+void VerticalTabStripRegionView::UpdateNativeFrameMaterialPaint(
+    const std::vector<ContentsWebView*>& adjacent_contents) {
+  auto* const custom_background =
+      background() ? background()->AsA<CustomCornersBackground>() : nullptr;
+  if (!custom_background) {
+    return;
+  }
+
+  // Unless detached, the tab strip shows the frame material, so it paints none
+  // of its own, which would show twice.
+  const bool detached = floating_style_ == FloatingStyle::kDetached;
+  custom_background->SetPaintNativeFrameMaterialTint(detached);
+  // Floating without a material of its own, it still paints its outline.
+  custom_background->SetPaintWithNativeFrameMaterials(floating_style_ !=
+                                                      FloatingStyle::kNone);
+  // Below the contents, the frame is transparent where the native material
+  // shows, which the blur would take in and let the contents show through
+  // sharp along the bottom. So it stops where they do.
+  std::optional<gfx::Rect> blur_clip;
+  if (!adjacent_contents.empty()) {
+    int contents_bottom = 0;
+    for (ContentsWebView* const contents : adjacent_contents) {
+      contents_bottom = std::max(
+          contents_bottom,
+          views::View::ConvertRectToTarget(contents->holder(), this,
+                                           contents->holder()->GetLocalBounds())
+              .bottom());
+    }
+    blur_clip = gfx::Rect(0, 0, width(), contents_bottom);
+  }
+  // Without the material tint the tab strip stays opaque, so there is nothing
+  // to blur.
+  custom_background->SetUseBackgroundBlur(
+      detached && helium::ShouldUseNativeFrameMaterials(this), blur_clip);
+}
+
+std::vector<ContentsWebView*> VerticalTabStripRegionView::GetAdjacentContents()
+    const {
+  const MultiContentsView* const multi_contents_view =
+      browser_view()->multi_contents_view();
+  if (!multi_contents_view) {
+    return {};
+  }
+
+  // All the contents the tab strip floats over, or else those closest to it,
+  // which are both of a stacked split.
+  const gfx::Rect bounds = GetBoundsInScreen();
+  std::vector<ContentsWebView*> covered_contents;
+  std::vector<ContentsWebView*> closest_contents;
+  int closest_distance = 0;
+  for (ContentsContainerView* container :
+       multi_contents_view->contents_container_views()) {
+    if (!container->GetVisible()) {
+      continue;
+    }
+
+    ContentsWebView* const contents = container->contents_view();
+    const gfx::Rect contents_bounds = contents->holder()->GetBoundsInScreen();
+    if (contents_bounds.Intersects(bounds)) {
+      covered_contents.push_back(contents);
+      continue;
+    }
+
+    const int distance = contents_bounds.x() >= bounds.right()
+                             ? contents_bounds.x() - bounds.right()
+                             : bounds.x() - contents_bounds.right();
+    if (!closest_contents.empty() && distance > closest_distance) {
+      continue;
+    }
+
+    if (distance < closest_distance) {
+      closest_contents.clear();
+    }
+    closest_contents.push_back(contents);
+    closest_distance = distance;
+  }
+
+  return covered_contents.empty() ? closest_contents : covered_contents;
+}
+
+void VerticalTabStripRegionView::ObserveViewNextToContents(views::View* view) {
+  if (view && !views_next_to_contents_observations_.IsObservingSource(view)) {
+    views_next_to_contents_observations_.AddObservation(view);
+  }
+}
