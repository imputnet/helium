+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/native_frame_materials.h"
+
+#include <algorithm>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/ui_features.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "third_party/material_color_utilities/src/cpp/cam/hct.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace helium {
+
+namespace {
+
+// Light material needs a stronger theme tint than dark material to avoid
+// looking washed out.
+constexpr float kDarkThemeAlpha = 0.55f;
+constexpr float kLightThemeAlpha = 0.8f;
+
+// Saturated theme colors mixed with a colorful backdrop turn muddy, so the
+// tint only keeps a hint of the theme hue at a tone that suits the mode.
+constexpr double kMaxThemeChroma = 10;
+constexpr double kDarkThemeMinTone = 6;
+constexpr double kDarkThemeMaxTone = 26;
+constexpr double kLightThemeMinTone = 88;
+constexpr double kLightThemeMaxTone = 100;
+
+// Without a vibrant material underneath, the regular near-opaque tab and
+// location bar colors hide the blur. Use a white veil instead.
+constexpr float kDarkThemeSurfaceAlpha = 0.1f;
+constexpr float kLightThemeSurfaceAlpha = 0.6f;
+
+SkColor GetToolbarColor(const views::View* view) {
+  return view->GetColorProvider()->GetColor(kColorToolbar);
+}
+
+// |color| with its chroma limited to that of the material tint.
+material_color_utilities::Hct GetMutedColor(SkColor color) {
+  material_color_utilities::Hct hct(SkColorSetA(color, SK_AlphaOPAQUE));
+  hct.set_chroma(std::min(hct.get_chroma(), kMaxThemeChroma));
+  return hct;
+}
+
+}  // namespace
+
+float GetNativeFrameMaterialThemeAlpha(bool is_dark) {
+  return is_dark ? kDarkThemeAlpha : kLightThemeAlpha;
+}
+
+bool ShouldUseNativeFrameMaterials(const BrowserView* browser_view) {
+  if (!features::HeliumNativeFrameAvailable() || !browser_view) {
+    return false;
+  }
+
+  // Web app windows use their app-defined frame appearance.
+  if (browser_view->GetIsWebAppType() ||
+      !PlatformSupportsNativeFrameMaterials(*browser_view)) {
+    return false;
+  }
+
+  const Profile* profile = browser_view->GetProfile();
+  return profile &&
+         profile->GetPrefs()->GetBoolean(prefs::kHeliumNativeFrameMaterials);
+}
+
+bool ShouldUseNativeFrameMaterials(const BrowserWindowInterface* browser) {
+  return ShouldUseNativeFrameMaterials(
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr);
+}
+
+bool ShouldUseNativeFrameMaterials(const views::View* view) {
+  const views::Widget* widget = view ? view->GetWidget() : nullptr;
+  return ShouldUseNativeFrameMaterials(
+      widget ? BrowserView::GetBrowserViewForNativeWindow(
+                   widget->GetNativeWindow())
+             : nullptr);
+}
+
+bool IsNativeFrameMaterialDark(SkColor toolbar_color) {
+  return color_utils::IsDark(toolbar_color);
+}
+
+SkColor GetNativeFrameMaterialThemeColor(SkColor toolbar_color, bool is_dark) {
+  const double min_tone = is_dark ? kDarkThemeMinTone : kLightThemeMinTone;
+  const double max_tone = is_dark ? kDarkThemeMaxTone : kLightThemeMaxTone;
+  material_color_utilities::Hct hct = GetMutedColor(toolbar_color);
+  hct.set_tone(std::clamp(hct.get_tone(), min_tone, max_tone));
+  return hct.ToInt();
+}
+
+SkColor GetNativeFrameMaterialTintColor(const views::View* view) {
+  const SkColor toolbar_color = GetToolbarColor(view);
+  const bool is_dark = IsNativeFrameMaterialDark(toolbar_color);
+
+  const float neutral_value = is_dark ? 0 : 1;
+  const SkColor4f neutral{neutral_value, neutral_value, neutral_value,
+                          kNativeFrameMaterialNeutralAlpha};
+  SkColor4f tint = SkColor4f::FromColor(
+      GetNativeFrameMaterialThemeColor(toolbar_color, is_dark));
+  tint.fA = GetNativeFrameMaterialThemeAlpha(is_dark);
+
+  const float alpha = tint.fA + neutral.fA * (1 - tint.fA);
+  const auto blend = [&](float t, float n) {
+    return (t * tint.fA + n * neutral.fA * (1 - tint.fA)) / alpha;
+  };
+
+  const SkColor4f color{blend(tint.fR, neutral.fR), blend(tint.fG, neutral.fG),
+                        blend(tint.fB, neutral.fB), alpha};
+  return color.toSkColor();
+}
+
+std::optional<SkColor> GetNativeFrameMaterialSurfaceColor(
+    const views::View* view,
+    SkColor color,
+    float emphasis) {
+  if (!ShouldUseNativeFrameMaterials(view)) {
+    return std::nullopt;
+  }
+
+  if (HasVibrantNativeFrameMaterial()) {
+    // Keep the regular color, but no more colorful than the frame tint, so
+    // custom color themes don't put saturated surfaces on a muted frame.
+    return SkColorSetA(GetMutedColor(color).ToInt(), SkColorGetA(color));
+  }
+
+  const bool is_dark = IsNativeFrameMaterialDark(GetToolbarColor(view));
+  const float alpha =
+      (is_dark ? kDarkThemeSurfaceAlpha : kLightThemeSurfaceAlpha) * emphasis;
+  return SkColorSetA(SK_ColorWHITE, std::clamp(alpha, 0.0f, 1.0f) * 255);
+}
+
+SkColor GetNativeFrameMaterialTabColor(const views::View* view,
+                                       SkColor color,
+                                       bool active) {
+  // Selected tabs stand out less than the active one.
+  const std::optional<SkColor> surface =
+      GetNativeFrameMaterialSurfaceColor(view, color, active ? 1.0f : 0.5f);
+  return surface.value_or(color);
+}
+
+std::optional<SkColor> GetNativeFrameMaterialFloatingColor(
+    const views::View* view) {
+  if (!ShouldUseNativeFrameMaterials(view)) {
+    return std::nullopt;
+  }
+
+  // The floating strip holds inactive tabs, whose text follows the theme's
+  // frame rather than its toolbar. Keep the frame color if the material tint
+  // would leave that text without contrast.
+  const bool is_dark = IsNativeFrameMaterialDark(GetToolbarColor(view));
+  const SkColor tab_text = view->GetColorProvider()->GetColor(
+      kColorTabForegroundInactiveFrameActive);
+  if (color_utils::IsDark(tab_text) == is_dark) {
+    return std::nullopt;
+  }
+
+  return GetNativeFrameMaterialTintColor(view);
+}
+
+bool PlatformSupportsNativeFrameMaterials(const BrowserView& browser_view) {
+  // Enabled by the platform patch that implements the material.
+  return false;
+}
+
+bool HasVibrantNativeFrameMaterial() {
+  return true;
+}
+
+}  // namespace helium
