+void VerticalTabStripRegionView::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  BaseTabStripRegionView::OnBoundsChanged(previous_bounds);
+  // Layout() covers a new size, but what is below the tab strip changes as it
+  // moves too, as when the window is resized.
+  if (size() == previous_bounds.size()) {
+    UpdateNativeFrameMaterialBackground();
+  }
+}
