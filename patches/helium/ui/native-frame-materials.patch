+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_FRAME_MATERIALS_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_FRAME_MATERIALS_H_
+
+#include <optional>
+
+#include "third_party/skia/include/core/SkColor.h"
+
+class BrowserView;
+class BrowserWindowInterface;
+
+namespace views {
+class View;
+}  // namespace views
+
+namespace helium {
+
+// The material tint is a black or white neutral overlay with the theme color
+// layered on top.
+inline constexpr float kNativeFrameMaterialNeutralAlpha = 0.2f;
+float GetNativeFrameMaterialThemeAlpha(bool is_dark);
+
+bool ShouldUseNativeFrameMaterials(const BrowserView* browser_view);
+bool ShouldUseNativeFrameMaterials(const BrowserWindowInterface* browser);
+bool ShouldUseNativeFrameMaterials(const views::View* view);
+
+// Whether the platform implements the material for |browser_view|.
+bool PlatformSupportsNativeFrameMaterials(const BrowserView& browser_view);
+
+// Whether the platform material has a vibrant base of its own, like
+// NSVisualEffectView or acrylic. A plain compositor blur has none, so surfaces
+// on the frame are drawn lighter to keep the blur visible.
+bool HasVibrantNativeFrameMaterial();
+
+// Whether the material should be dark. Follows the toolbar rather than the
+// browser color mode, since custom color themes pick their text colors from it.
+bool IsNativeFrameMaterialDark(SkColor toolbar_color);
+
+// Keeps the hue of |toolbar_color| but limits its chroma and tone, so that
+// loud theme colors don't fight with whatever is blurred behind the frame.
+SkColor GetNativeFrameMaterialThemeColor(SkColor toolbar_color, bool is_dark);
+
+// The neutral overlay and theme color composited into a single color.
+SkColor GetNativeFrameMaterialTintColor(const views::View* view);
+
+// Color for surfaces drawn on top of the frame material, such as the active
+// tab and the location bar, given their regular |color|. |emphasis| scales the
+// strength of the light veil used without a vibrant material, e.g. for hover.
+// Returns nullopt where these surfaces keep their regular colors.
+std::optional<SkColor> GetNativeFrameMaterialSurfaceColor(
+    const views::View* view,
+    SkColor color,
+    float emphasis = 1.0f);
+
+// The background of a selected tab with the regular |color| on the frame
+// material, or the regular color without the material.
+SkColor GetNativeFrameMaterialTabColor(const views::View* view,
+                                       SkColor color,
+                                       bool active);
+
+// Color for surfaces that float over web contents, such as the Frameless mode
+// tab strip. The native material only shows what is behind the window, so
+// these blur what is below them inside the window and paint this tint on top.
+// Returns nullopt where floating surfaces stay opaque.
+std::optional<SkColor> GetNativeFrameMaterialFloatingColor(
+    const views::View* view);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_NATIVE_FRAME_MATERIALS_H_
