+namespace helium {
+
+// Mirrors the contents next to a translucent view below it, so that the view
+// looks like it floats over the contents without them being resized. Like
+// SwiftUI's backgroundExtensionEffect on macOS. The mirror is blurred, as it
+// would look odd otherwise.
+class ContentsReflection : public views::ViewObserver,
+                           public ui::LayerObserver,
+                           public gfx::AnimationDelegate {
+ public:
+  // |view| must paint to a layer. |opacity_changed| runs as the mirror fades,
+  // so that the view can fade what it paints over it along with it.
+  ContentsReflection(views::View* view, base::RepeatingClosure opacity_changed);
+  ContentsReflection(const ContentsReflection&) = delete;
+  ContentsReflection& operator=(const ContentsReflection&) = delete;
+  ~ContentsReflection() override;
+
+  // Mirrors |contents|, which has a layer that holds what it shows, like the
+  // holder of a WebView, with the corners it is rounded with. Fades the mirror
+  // in, or out if null.
+  void SetContents(views::View* contents,
+                   const gfx::RoundedCornersF& contents_radii = {});
+
+  // Sets the color the mirror fades into, made opaque. Under a mirror that
+  // fades into transparency instead, its blur would thin out where what is
+  // next to it is transparent, like the native frame material, and let the
+  // sharp mirror show through. It should resemble whatever is above the view,
+  // which it fades into in turn.
+  void SetBackgroundColor(SkColor color);
+
+  // Shows the mirror while |view_| floats over the contents next to it,
+  // fading it in and out. Otherwise |view_| looks like the rest of the frame.
+  void SetFloating(bool floating);
+
+  // Shows a blurred copy of the contents as they are rather than mirrored, at
+  // |opacity|, as where |view_| shows something else than them through
+  // itself. Mirrors them again if null.
+  void SetCopyOpacity(std::optional<float> opacity);
+
+  // How much of the mirror shows, from 0 to 1. What |view_| paints over it
+  // should fade along with it, as it would add to the frame below otherwise.
+  float GetMirrorOpacity() const;
+
+ private:
+  // How much of what covers the mirror where |view_| floats over the contents
+  // shows, from 0 to 1. It fades ahead of the mirror, which only shows once it
+  // is all there, so that the mirror never shows barely covered.
+  float GetOpacity() const;
+  void Attach(views::View* contents);
+  void Detach();
+  // Keeps the mirror next to the contents as either of them moves.
+  void UpdateGeometry();
+  void UpdateOpacity();
+  // How far the mirror has faded in, from 0 to 1.
+  float GetFadeValue() const;
+  void Observe(views::View* view);
+  // Mirrors the contents that had no layer to mirror yet, once they have.
+  void AttachPendingContents();
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewLayerBoundsSet(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // ui::LayerObserver:
+  void LayerDestroyed(ui::Layer* layer) override;
+
+  const raw_ptr<views::View> view_;
+  const base::RepeatingClosure opacity_changed_;
+  // Stays set while the mirror fades out.
+  raw_ptr<views::View> contents_ = nullptr;
+  // Clips the mirror to |view_|, below which it is added.
+  std::unique_ptr<ui::Layer> clip_layer_;
+  std::unique_ptr<ui::LayerSolidColor> background_layer_;
+  // Where |view_| floats over the contents themselves, fades them in below
+  // whatever is above it, like the mirror.
+  std::unique_ptr<ui::LayerSolidColor> contents_fade_layer_;
+  std::unique_ptr<ui::Layer> mirror_layer_;
+  // Holds a copy of the layers of the contents, as a reflection of them would
+  // be cut out along with them.
+  std::unique_ptr<ui::Layer> copy_layer_;
+  std::unique_ptr<ui::LayerTreeOwner> copy_tree_;
+  // Blurs the mirror. Fades in from the top, as a blur darkens towards its
+  // edge.
+  std::unique_ptr<ui::Layer> blur_layer_;
+  // Shows the contents themselves in the bottom corner they round next to
+  // the mirror, as the mirror continues them square.
+  std::unique_ptr<ui::Layer> corner_clip_layer_;
+  std::unique_ptr<ui::Layer> corner_layer_;
+  gfx::RoundedCornersF contents_radii_;
+  std::optional<float> copy_opacity_;
+  SkColor background_color_ = SK_ColorTRANSPARENT;
+  gfx::SlideAnimation animation_{this};
+  gfx::SlideAnimation floating_animation_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      observations_{this};
+  // The mirror has to stop reflecting the layer of the contents before it is
+  // destroyed, as a NativeViewHost does when what it hosts changes.
+  base::ScopedObservation<ui::Layer, ui::LayerObserver>
+      contents_layer_observation_{this};
+  // Contents without a layer to mirror yet, like a NativeViewHost between
+  // what it hosts, to mirror once they have one.
+  base::ScopedObservation<views::View, views::ViewObserver>
+      pending_contents_observation_{this};
+  base::WeakPtrFactory<ContentsReflection> weak_ptr_factory_{this};
+};
+
+}  // namespace helium
