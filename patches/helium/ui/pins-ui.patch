+views::ProposedLayout
+PinnedTabContainerViewVerticalLayout::CalculateProposedLayout(
+    const views::SizeBounds& size_bounds) const {
+  views::ProposedLayout layouts;
+  const auto children =
+      PinnedTabContainerView().collection_node_
+          ? PinnedTabContainerView().collection_node_->GetDirectChildren()
+          : TabCollectionNode::ChildViews();
+
+  // Pins are laid out within the container's outline, if any.
+  const gfx::Insets insets = PinnedTabContainerView().GetInsets();
+
+  int total_width = 0;
+  int total_height = 0;
+
+  int y = insets.top();
+
+  if (children.empty()) {
+    layouts.host_size = gfx::Size();
+    return layouts;
+  }
+
+  // Pins share a uniform slot width, and pinned splits take two slots.
+  const auto get_slots = [](const views::View* child) {
+    return views::IsViewClass<SplitTabView>(child) ? 2 : 1;
+  };
+  int total_slots = 0;
+  for (const views::View* child : children) {
+    total_slots += get_slots(child);
+  }
+
+  // Pins are wider while uncollapsed, so that fewer of them share a row.
+  const auto collapse_state =
+      PinnedTabContainerView().GetTabStripCollapseState();
+  const int slot_width =
+      collapse_state == tabs::VerticalTabStripCollapseState::kCollapsed
+          ? GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth)
+          : PinnedTabContainerView::kUncollapsedTabMinWidth;
+  int slots_per_row = total_slots;
+  std::optional<int> row_width;
+
+  // If the width is bounded, calculate how many slots fit on a row, and spread
+  // the pins evenly over the rows they need, so that the last row isn't left
+  // with fewer of them.
+  if (size_bounds.width().is_bounded() && size_bounds.width().value() > 0) {
+    row_width = size_bounds.width().value() - insets.width();
+
+    // When we are in collapsed state, only one child should be shown per row.
+    // During collapse animation and other cases, fit as many as possible.
+    if (collapse_state == tabs::VerticalTabStripCollapseState::kCollapsed) {
+      slots_per_row = 1;
+    } else {
+      const int max_slots_per_row = std::max(
+          1, (*row_width - slot_width) /
+                     (slot_width + PinnedTabContainerView::kTabPadding) +
+                 1);
+      const int num_rows =
+          (total_slots + max_slots_per_row - 1) / max_slots_per_row;
+      slots_per_row = (total_slots + num_rows - 1) / num_rows;
+
+      // Splits can't be broken across rows, so widen the rows until the pins
+      // fit on as many rows as planned.
+      const auto count_rows = [&](int row_size) {
+        int rows = 1;
+        int used_slots = 0;
+        for (const views::View* child : children) {
+          const int slots = get_slots(child);
+          if (used_slots > 0 && used_slots + slots > row_size) {
+            ++rows;
+            used_slots = 0;
+          }
+          used_slots += slots;
+        }
+        return rows;
+      };
+      while (slots_per_row < max_slots_per_row &&
+             count_rows(slots_per_row) > num_rows) {
+        ++slots_per_row;
+      }
+    }
+  }
+
+  // Returns the left edge of the slot at `index` of a row. The rounding of the
+  // slot widths is spread over the row, so that the last pin of a full row
+  // ends right at its edge.
+  const auto get_slot_x = [&](int index) {
+    return insets.left() +
+           (row_width
+                ? index * (*row_width + PinnedTabContainerView::kTabPadding) /
+                      slots_per_row
+                : index * (slot_width + PinnedTabContainerView::kTabPadding));
+  };
+
+  int row_slots = 0;
+  for (auto* child : children) {
+    const int slots = get_slots(child);
+
+    auto drag_data =
+        PinnedTabContainerView().GetVisualDataForDraggedView(*child);
+    const bool should_show_child = !(drag_data && drag_data->should_hide);
+    if (!should_show_child) {
+      layouts.child_layouts.emplace_back(child, false, gfx::Rect());
+      continue;
+    }
+
+    // Start a new row if the child doesn't fit on this one.
+    const bool takes_space = !drag_data || !drag_data->should_float;
+    if (takes_space && row_slots > 0 && row_slots + slots > slots_per_row) {
+      y = total_height + PinnedTabContainerView::kTabPadding;
+      row_slots = 0;
+    }
+
+    // A split wider than the row takes all of it.
+    const int first_slot = takes_space ? row_slots : 0;
+    const int end_slot = std::min(first_slot + slots, slots_per_row);
+    const int child_width = get_slot_x(end_slot) -
+                            PinnedTabContainerView::kTabPadding -
+                            get_slot_x(first_slot);
+    gfx::Rect bounds =
+        gfx::Rect(child->GetPreferredSize(views::SizeBounds(child_width, {})));
+    bounds.set_width(child_width);
+
+    bounds.set_y(drag_data ? drag_data->offset.y() : y);
+    // Pins that can only be dragged vertically, i.e. while the tab strip is
+    // collapsed, stay within the outline instead of moving to the edge of the
+    // container. The drag offset is already where the pin is drawn, so it
+    // isn't padded from the pin before it, which would make a dropped pin jump
+    // aside before it animates into its slot.
+    if (drag_data && PinnedTabContainerView().drag_axes() !=
+                         PinnedTabContainerView::DragAxes::kVerticalOnly) {
+      bounds.set_x(drag_data->offset.x());
+    } else {
+      bounds.set_x(get_slot_x(first_slot));
+    }
+
+    if (takes_space) {
+      total_width = std::max(total_width, get_slot_x(first_slot) + child_width);
+      total_height = std::max(total_height, (y + bounds.height()));
+      row_slots += slots;
+    }
+
+    layouts.child_layouts.emplace_back(child, true, bounds);
+  }
+
+  // Make sure we snap to bounded width if defined. This is necessary as the
+  // `child_width` calculation above rounds width down and this can result in
+  // off-by-one width calculations when the number of children on a row changes.
+  // Changes in host width can be interpreted as a resize and animations may
+  // otherwise snap to target.
+  layouts.host_size =
+      gfx::Size(size_bounds.width().value_or(total_width + insets.right()),
+                total_height + insets.bottom());
+  return layouts;
+}
