+
+bool VisualTabSwitcher::Cycle(bool reverse) {
+  const bool starting = tabs_.empty();
+  if (starting) {
+    auto* model = browser_view_->browser()->tab_strip_model();
+    const bool mru = browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+        prefs::kTabCyclingMRU);
+    list_mode_ = browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+        prefs::kVisualTabSwitcherList);
+    int max_tabs = kDefaultMaxTabs;
+    int configured_max_tabs;
+    if (base::StringToInt(
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                "visual-tab-switcher-max-tabs"),
+            &configured_max_tabs) &&
+        (configured_max_tabs > 0 || configured_max_tabs == -1)) {
+      max_tabs = configured_max_tabs;
+    }
+    if (list_mode_) {
+      max_tabs = -1;
+    }
+    for (int i = 0; i < model->count(); ++i) {
+      if (mru || model->IsTabEligibleForSequentialCycling(i)) {
+        tabs_.push_back(model->GetWebContentsAt(i));
+      }
+    }
+    if (tabs_.size() < 2) {
+      tabs_.clear();
+      return false;
+    }
+    auto* active = model->GetActiveWebContents();
+    const bool limit_tabs =
+        max_tabs > 0 && tabs_.size() > static_cast<size_t>(max_tabs);
+    if (mru || limit_tabs) {
+      std::stable_sort(
+          tabs_.begin(), tabs_.end(), [active](const auto& a, const auto& b) {
+            if (a == active || b == active) {
+              return a == active && b != active;
+            }
+            return a->GetLastActiveTimeTicks() > b->GetLastActiveTimeTicks();
+          });
+    }
+    if (limit_tabs) {
+      tabs_.resize(max_tabs);
+      if (!mru) {
+        std::ranges::sort(tabs_, {}, [model](const auto& tab) {
+          return model->GetIndexOfWebContents(tab);
+        });
+      }
+    }
+    const auto active_tab = std::find(tabs_.begin(), tabs_.end(), active);
+    if (active_tab == tabs_.end()) {
+      tabs_.clear();
+      return false;
+    }
+    selected_ = active_tab - tabs_.begin();
+    observed_model_ = model;
+    model->AddObserver(this);
+    auto* browser_widget = browser_view_->GetWidget();
+    widget_observation_.Observe(browser_widget);
+    event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, browser_widget->GetNativeWindow(),
+        {ui::EventType::kKeyReleased, ui::EventType::kKeyPressed,
+         ui::EventType::kMousePressed});
+  }
+  selected_ = reverse ? (selected_ + tabs_.size() - 1) % tabs_.size()
+                      : (selected_ + 1) % tabs_.size();
+  if (starting) {
+    reveal_timer_.Start(
+        FROM_HERE, kRevealDelay,
+        base::BindOnce(&VisualTabSwitcher::Show, weak_factory_.GetWeakPtr()));
+  } else if (!widget_) {
+    reveal_timer_.Stop();
+    Show();
+  } else {
+    UpdateSelection();
+  }
+  return true;
+}
+
+void VisualTabSwitcher::Show() {
+  gfx::Rect bounds = browser_view_->GetWidget()->GetWindowBoundsInScreen();
+  bounds.Inset(kWindowInset);
+  const int width = std::max(
+      1, std::min(bounds.width(), list_mode_ ? kListMaxWidth : kStripMaxWidth));
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.SetParent(browser_view_->GetWidget());
+  params.activatable = views::Widget::InitParams::Activatable::kYes;
+  params.name = "HeliumVisualTabSwitcher";
+  params.bounds = bounds;
+  params.rounded_corners = gfx::RoundedCornersF(kPopupCornerRadius);
+  widget_ = std::make_unique<views::Widget>();
+  widget_->Init(std::move(params));
+
+  auto contents =
+      std::make_unique<SwitcherContents>(weak_factory_.GetWeakPtr());
+  contents_ = contents.get();
+  contents->SetBackground(views::CreateRoundedRectBackground(
+      ui::kColorSysSurface, kPopupCornerRadius));
+  auto* layout = contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(kContentPadding),
+      kContentSpacing));
+  auto* body = contents->AddChildView(std::make_unique<views::View>());
+  auto* body_layout = body->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      kPreviewSpacing));
+  layout->SetFlexForView(body, 1);
+  if (list_mode_) {
+    preview_ = body->AddChildView(
+        MakePreview(gfx::Size(width / 3, kListPreviewHeight)));
+    preview_->SetVerticalAlignment(views::ImageView::Alignment::kLeading);
+  }
+  auto scroll = std::make_unique<views::ScrollView>(
+      views::ScrollView::ScrollWithLayers::kEnabled);
+  scroll->SetUseContentsPreferredSize(!list_mode_);
+  if (list_mode_) {
+    scroll->ClipHeightTo(0, std::max(1, bounds.height()));
+  }
+  scroll->SetHorizontalScrollBarMode(
+      list_mode_ ? views::ScrollView::ScrollBarMode::kDisabled
+                 : views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+  scroll->SetVerticalScrollBarMode(
+      list_mode_ ? views::ScrollView::ScrollBarMode::kEnabled
+                 : views::ScrollView::ScrollBarMode::kDisabled);
+  auto items = std::make_unique<views::View>();
+  items->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      list_mode_ ? views::BoxLayout::Orientation::kVertical
+                 : views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets(), kItemSpacing));
+  for (size_t i = 0; i < tabs_.size(); ++i) {
+    const auto callback = base::BindRepeating(&VisualTabSwitcher::AcceptTab,
+                                              weak_factory_.GetWeakPtr(), i);
+    auto favicon =
+        TabUIHelper::From(tabs::TabInterface::GetFromContents(tabs_[i]))
+            ->GetFavicon();
+    views::Button* button;
+    if (list_mode_) {
+      auto row =
+          std::make_unique<views::LabelButton>(callback, GetTabTitle(tabs_[i]));
+      row->SetImageModel(views::Button::STATE_NORMAL, favicon);
+      row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      row->SetMinSize(gfx::Size(0, kListRowHeight));
+      button = items->AddChildView(std::move(row));
+    } else {
+      auto tile = std::make_unique<SwitcherButton>(callback);
+      tile->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical, gfx::Insets(kTilePadding),
+          kItemSpacing));
+      auto* image = tile->AddChildView(
+          MakePreview(gfx::Size(kThumbnailWidth, kThumbnailHeight)));
+      images_.push_back(image);
+      auto* label = tile->AddChildView(std::make_unique<views::LabelButton>(
+          views::Button::PressedCallback(), GetTabTitle(tabs_[i])));
+      label->SetImageModel(views::Button::STATE_NORMAL, favicon);
+      label->SetMaxSize(gfx::Size(kThumbnailWidth, kTileLabelHeight));
+      label->SetCanProcessEventsWithinSubtree(false);
+      label->SetFocusBehavior(views::View::FocusBehavior::NEVER);
+      label->GetViewAccessibility().SetIsIgnored(true);
+      button = items->AddChildView(std::move(tile));
+    }
+    button->SetFocusBehavior(views::View::FocusBehavior::ACCESSIBLE_ONLY);
+    button->GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+    button->GetViewAccessibility().SetName(GetTabTitle(tabs_[i]));
+    buttons_.push_back(button);
+  }
+  if (!list_mode_) {
+    subscriptions_.resize(tabs_.size());
+  }
+  scroll->SetContents(std::move(items));
+  auto* scroll_view = body->AddChildView(std::move(scroll));
+  body_layout->SetFlexForView(scroll_view, 1);
+  scroll_subscription_ = scroll_view->AddContentsScrolledCallback(
+      base::BindRepeating(&VisualTabSwitcher::UpdateVisibleThumbnails,
+                          weak_factory_.GetWeakPtr()));
+  scroll_view->RegisterPostLayoutCallback(base::BindRepeating(
+      [](base::WeakPtr<VisualTabSwitcher> switcher, views::ScrollView*) {
+        if (switcher) {
+          switcher->UpdateVisibleThumbnails();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  title_ = contents->AddChildView(
+      std::make_unique<views::Label>(GetTabTitle(tabs_[selected_])));
+  if (list_mode_) {
+    const int available_preview_height =
+        std::max(1, bounds.height() - layout->inside_border_insets().height() -
+                        layout->between_child_spacing() -
+                        title_->GetPreferredSize({}).height());
+    const gfx::Size preview_size(
+        width / 3, std::min(kListPreviewHeight, available_preview_height));
+    preview_->SetImageSize(preview_size);
+    preview_->SetPreferredSize(preview_size);
+  }
+  const int height =
+      std::max(1, std::min(bounds.height(),
+                           list_mode_ ? contents->GetPreferredSize({}).height()
+                                      : kStripHeight));
+  const int popup_width =
+      list_mode_ ? width
+                 : std::min(width, body->GetPreferredSize({}).width() +
+                                       layout->inside_border_insets().width());
+  bounds.ClampToCenteredSize(gfx::Size(popup_width, height));
+  widget_->SetContentsView(std::move(contents));
+  widget_->SetBounds(bounds);
+  widget_observation_.Reset();
+  widget_observation_.Observe(widget_.get());
+  event_monitor_.reset();
+  event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, widget_->GetNativeWindow(), {ui::EventType::kKeyReleased});
+  widget_->Show();
+  contents_->RequestFocus();
+  UpdateSelection();
+}
+
+void VisualTabSwitcher::UpdateSelection() {
+  for (size_t i = 0; i < buttons_.size(); ++i) {
+    buttons_[i]->SetBackground(
+        i == selected_
+            ? views::CreateRoundedRectBackground(ui::kColorSysPrimaryContainer,
+                                                 kSelectionCornerRadius)
+            : nullptr);
+    buttons_[i]->GetViewAccessibility().SetIsSelected(i == selected_);
+  }
+  contents_->GetViewAccessibility().SetActiveDescendant(*buttons_[selected_]);
+  title_->SetText(GetTabTitle(tabs_[selected_]));
+  buttons_[selected_]->ScrollViewToVisible();
+  if (preview_) {
+    subscriptions_.clear();
+    preview_->SetImage(ui::ImageModel());
+    subscriptions_.push_back(Subscribe(preview_, tabs_[selected_]));
+  } else {
+    UpdateVisibleThumbnails();
+  }
+}
+
+void VisualTabSwitcher::UpdateVisibleThumbnails() {
+  if (list_mode_ || !widget_) {
+    return;
+  }
+  for (size_t i = 0; i < images_.size(); ++i) {
+    if (!images_[i]->GetVisibleBounds().IsEmpty()) {
+      if (!subscriptions_[i]) {
+        subscriptions_[i] = Subscribe(images_[i], tabs_[i]);
+      }
+    } else if (subscriptions_[i]) {
+      subscriptions_[i].reset();
+      images_[i]->SetImage(ui::ImageModel());
+    }
+  }
+}
+
+std::unique_ptr<ThumbnailImage::Subscription> VisualTabSwitcher::Subscribe(
+    views::ImageView* image,
+    content::WebContents* contents) {
+  auto* helper = ThumbnailTabHelper::FromWebContents(contents);
+  if (!helper) {
+    return nullptr;
+  }
+  auto thumbnail = helper->thumbnail();
+  auto subscription = thumbnail->Subscribe();
+  subscription->SetSizeHint(image->GetPreferredSize({}));
+  subscription->SetUncompressedImageCallback(base::BindRepeating(
+      &VisualTabSwitcher::OnThumbnail, weak_factory_.GetWeakPtr(), image));
+  OnThumbnail(image, thumbnail->GetCachedPreview(image->GetPreferredSize({})));
+  helper->CaptureThumbnailForPreview();
+  thumbnail->RequestThumbnailImage();
+  return subscription;
+}
+
+void VisualTabSwitcher::OnThumbnail(views::ImageView* view,
+                                    gfx::ImageSkia image) {
+  if (!image.isNull()) {
+    const gfx::Size bounds = view->GetPreferredSize({});
+    const float scale =
+        std::min(static_cast<float>(bounds.width()) / image.width(),
+                 static_cast<float>(bounds.height()) / image.height());
+    gfx::Size size = gfx::ScaleToRoundedSize(image.size(), scale);
+    size.SetToMax(gfx::Size(1, 1));
+    if (view->GetImageBounds().size() != size) {
+      view->SetImageSize(size);
+    }
+  }
+  view->SetImage(ui::ImageModel::FromImageSkia(image));
+}
+
+bool VisualTabSwitcher::HandleKeyEvent(const ui::KeyEvent& event) {
+  if (tabs_.empty()) {
+    return false;
+  }
+  if (event.type() == ui::EventType::kKeyReleased) {
+    if (event.key_code() == ui::VKEY_CONTROL) {
+      Close(true);
+    }
+    return true;
+  }
+  switch (event.key_code()) {
+    case ui::VKEY_TAB: {
+      const ui::Accelerator accelerator(event);
+#if BUILDFLAG(IS_MAC)
+      const auto command = CommandForKeyEvent(event.native_event());
+      if (command.from_main_menu ||
+          !browser_view_->AcceleratorPressed(accelerator)) {
+        browser_view_->MaybeShowVisualTabSwitcher(command.chrome_command,
+                                                  accelerator);
+      }
+#else
+      browser_view_->AcceleratorPressed(accelerator);
+#endif
+      break;
+    }
+    case ui::VKEY_LEFT:
+      Cycle(!base::i18n::IsRTL());
+      break;
+    case ui::VKEY_UP:
+      Cycle(true);
+      break;
+    case ui::VKEY_RIGHT:
+      Cycle(base::i18n::IsRTL());
+      break;
+    case ui::VKEY_DOWN:
+      Cycle(false);
+      break;
+    case ui::VKEY_RETURN:
+      Close(true);
+      break;
+    case ui::VKEY_ESCAPE:
+      Close(false);
+      break;
+    default:
+      break;
+  }
+  return true;
+}
+
+void VisualTabSwitcher::AcceptTab(size_t index) {
+  selected_ = index;
+  Close(true);
+}
+
+void VisualTabSwitcher::Close(bool accept) {
+  if (tabs_.empty()) {
+    return;
+  }
+  auto* model = observed_model_.get();
+  const int index = accept && model
+                        ? model->GetIndexOfWebContents(tabs_[selected_])
+                        : TabStripModel::kNoTab;
+  weak_factory_.InvalidateWeakPtrs();
+  reveal_timer_.Stop();
+  event_monitor_.reset();
+  scroll_subscription_ = {};
+  TabStripModelObserver::StopObservingAll(this);
+  observed_model_ = nullptr;
+  widget_observation_.Reset();
+  subscriptions_.clear();
+  tabs_.clear();
+  buttons_.clear();
+  images_.clear();
+  contents_ = nullptr;
+  preview_ = nullptr;
+  title_ = nullptr;
+  auto widget = std::move(widget_);
+  if (widget) {
+    widget->Hide();
+    // Event callbacks can still refer to the contents view until they return.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(widget));
+  }
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index,
+                         TabStripUserGestureDetails(
+                             TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
+
+void VisualTabSwitcher::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Cancel before a tab change can invalidate the selection snapshot.
+  if (change.type() != TabStripModelChange::kSelectionOnly ||
+      selection.active_tab_changed()) {
+    Close(false);
+  }
+}
+
+void VisualTabSwitcher::TabGroupedStateChanged(
+    TabStripModel* model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  Close(false);
+}
+
+void VisualTabSwitcher::OnTabGroupChanged(const TabGroupChange& change) {
+  Close(false);
+}
+
+void VisualTabSwitcher::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  Close(false);
+}
+
+void VisualTabSwitcher::OnTabStripModelDestroyed(TabStripModel* model) {
+  Close(false);
+}
+
+void VisualTabSwitcher::OnWidgetActivationChanged(views::Widget* widget,
+                                                  bool active) {
+  if (!active) {
+    Close(false);
+  }
+}
+
+void VisualTabSwitcher::OnWidgetClosing(views::Widget* widget) {
+  Close(false);
+}
+
+void VisualTabSwitcher::OnEvent(const ui::Event& event) {
+  if (event.type() == ui::EventType::kKeyReleased) {
+    HandleKeyEvent(*event.AsKeyEvent());
+  } else if (!widget_ &&
+             (event.type() == ui::EventType::kMousePressed ||
+              (event.type() == ui::EventType::kKeyPressed &&
+               event.AsKeyEvent()->key_code() == ui::VKEY_ESCAPE))) {
+    Close(false);
+  }
+}
