+void ThumbnailImage::SetPreviewCachingEnabled(bool enabled) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (preview_caching_enabled_ == enabled) {
+    return;
+  }
+  preview_caching_enabled_ = enabled;
+  if (enabled) {
+    RequestThumbnailImage();
+  } else {
+    cached_preview_ = gfx::ImageSkia();
+    preview_request_id_.reset();
+  }
+}
+
+gfx::ImageSkia ThumbnailImage::GetCachedPreview(
+    const gfx::Size& minimum_size) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return cached_preview_.isNull()
+             ? gfx::ImageSkia()
+             : CropPreviewImage(cached_preview_, minimum_size,
+                                cached_preview_original_size_);
+}
+
+void ThumbnailImage::CachePreview(const gfx::ImageSkia& image) {
+  if (!preview_caching_enabled_ || image.isNull() ||
+      preview_request_id_ == thumbnail_id_) {
+    return;
+  }
+  preview_request_id_ = thumbnail_id_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ThumbnailImage::ResizePreview, *image.bitmap()),
+      base::BindOnce(&ThumbnailImage::StoreCachedPreview,
+                     weak_ptr_factory_.GetWeakPtr(), thumbnail_id_,
+                     image.size()));
+}
+
+// static
+gfx::ImageSkia ThumbnailImage::ResizePreview(SkBitmap bitmap) {
+  // Limit each decoded preview to at most one MiB of pixels.
+  constexpr int kMaxPreviewDimension = 512;
+  const float scale =
+      std::min(1.0f, static_cast<float>(kMaxPreviewDimension) /
+                         std::max(bitmap.width(), bitmap.height()));
+  gfx::Size size = gfx::ScaleToFlooredSize(
+      gfx::Size(bitmap.width(), bitmap.height()), scale);
+  size.SetToMax(gfx::Size(1, 1));
+  gfx::ImageSkia preview = gfx::ImageSkia::CreateFrom1xBitmap(
+      skia::ImageOperations::Resize(bitmap, skia::ImageOperations::RESIZE_GOOD,
+                                    size.width(), size.height()));
+  preview.MakeThreadSafe();
+  return preview;
+}
+
+void ThumbnailImage::StoreCachedPreview(base::Token thumbnail_id,
+                                        gfx::Size original_size,
+                                        gfx::ImageSkia image) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (preview_caching_enabled_ && thumbnail_id == thumbnail_id_) {
+    cached_preview_ = std::move(image);
+    cached_preview_original_size_ = original_size;
+    preview_was_available_ = !cached_preview_.isNull();
+  }
+}
