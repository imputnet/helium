From 9b9b64f0724f2ed7937a64b56185108cdba1abb2 Mon Sep 17 00:00:00 2001
From: rbpotter <rbpotter@chromium.org>
Date: Thu, 12 Nov 2026 09:43:49 -0800
Subject: [PATCH] Settings: Fix protocol handlers default radio group selection

The boolean handlersEnabled_ was bound to cr-radio-group
using a Polymer attribute binding (selected$="[[handlersEnabled_]]").
When handlersEnabled_ became true, Polymer serialized it as an HTML
boolean attribute (selected=""), setting the cr-radio-group string
selected property to empty string, unchecking the radio buttons, and
firing selected-changed (which reset handlersEnabled_ to false).

Bind the cr-radio-group selected property to a "true"/"false" string
instead, and expand the unit test to verify initial selection and
toggling between both radio buttons.

This regressed when protocol handlers was migrated from
settings-radio-group to cr-radio-group.

Fixed: 583399988
Change-Id: I5b3b22fbc5e5173a9bde2d2dcb67968a1132c957
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8797908
Commit-Queue: Rebekah Potter <rbpotter@chromium.org>
Reviewed-by: Demetrios Papadopoulos <dpapad@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1743105}
---
 .../site_settings/protocol_handlers.html      |  2 +-
 .../site_settings/protocol_handlers.ts        |  4 +++
 .../webui/settings/protocol_handlers_test.ts  | 33 ++++++++++++++++---
 3 files changed, 34 insertions(+), 5 deletions(-)

--- a/chrome/browser/resources/settings/site_settings/protocol_handlers.html
+++ b/chrome/browser/resources/settings/site_settings/protocol_handlers.html
@@ -47,7 +47,7 @@
       </div>
       <cr-radio-group
           id="protcolHandlersRadio"
-          selected$="[[handlersEnabled_]]"
+          selected="[[getSelectedValue_(handlersEnabled_)]]"
           on-selected-changed="onRadioGroupChange_"
           selectable-elements="settings-collapse-radio-button">
         <settings-collapse-radio-button no-collapse
--- a/chrome/browser/resources/settings/site_settings/protocol_handlers.ts
+++ b/chrome/browser/resources/settings/site_settings/protocol_handlers.ts
@@ -240,6 +240,10 @@ export class ProtocolHandlersElement ext
     this.actionMenuModel_ = null;
   }
 
+  private getSelectedValue_(): string {
+    return this.handlersEnabled_.toString();
+  }
+
   /**
    * A handler when the radio group selection changes.
    */
