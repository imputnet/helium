+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {HelpBubbleMixin} from 'chrome://resources/cr_components/help_bubble/help_bubble_mixin.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {OpeniumServicesChangeHandler} from './changelog_proxy.js';
+import {OpeniumServicesChangeHandlerImpl} from './changelog_proxy.js';
+import {getTemplate} from './services_page.html.js';
+
+const SettingsOpeniumServicesPageElementBase =
+    HelpBubbleMixin(I18nMixin(PrefsMixin(PolymerElement)));
+
+export class SettingsOpeniumServicesPageElement extends
+    SettingsOpeniumServicesPageElementBase {
+  private changeProxy_: OpeniumServicesChangeHandler =
+      OpeniumServicesChangeHandlerImpl.getInstance();
+
+  static get is() {
+    return 'settings-openium-services-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      ignoreChecked_: Boolean,
+      changes_: Array,
+    };
+  }
+
+  declare private changes_: string[];
+  declare private ignoreChecked_: boolean;
+
+  private toOrigin(thing: string) {
+    try {
+      return new URL(thing).origin;
+    } catch {
+      return null;
+    }
+  }
+
+  private updateChangelogState(changes: string[]) {
+    this.changes_ = changes.flatMap(ch => ch.split('\n'));
+  }
+
+  private requestChangelog() {
+    this.changeProxy_.requestChangelog().then(
+        this.updateChangelogState.bind(this));
+  }
+
+  private onAcknowledgedChangelog_() {
+    this.changeProxy_.acknowledgeChanges(this.ignoreChecked_);
+    this.requestChangelog();
+  }
+
+  override ready() {
+    super.ready();
+    this.requestChangelog();
+  }
+
+  protected onOriginOverrideKeydown_(event: KeyboardEvent) {
+    const target = event.target as CrInputElement;
+
+    if (event.key === 'Escape' || event.key === 'Enter') {
+      target.blur();
+    }
+  }
+
+  private onOriginOverrideChange_(event: Event) {
+    const target = event.target as CrInputElement;
+    if (target.invalid) {
+      return;
+    }
+
+    const origin = this.toOrigin(target.value);
+    if (origin) {
+      target.value = origin;
+    }
+
+    this.setPrefValue('openium.services.origin_override', target.value);
+  }
+}
+
+declare global {
+    interface HTMLElementTagNameMap {
+      'settings-openium-services-page': SettingsOpeniumServicesPageElement;
+    }
+}
+
+customElements.define(SettingsOpeniumServicesPageElement.is, SettingsOpeniumServicesPageElement);
